<%- include('partials/head', { pageTitle, pageDesc, canonicalUrl, activePage, ogTitle, ogDesc, ogImage, ogType, structuredData, loadBlogCss: true }) %>
<%- include('partials/navbar', { activePage, webUser: typeof webUser !== 'undefined' ? webUser : null }) %>

<nav class="blog-breadcrumb">
  <a href="/"><%= t('blog.breadcrumbHome') %></a>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
  <a href="/blog"><%= t('blog.breadcrumbBlog') %></a>
  <% if (post.category_name) { %>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
    <a href="/blog?categorie=<%= post.category_slug %>"><%= post.category_name %></a>
  <% } %>
</nav>

<% if (post.image_url) { %>
  <div class="blog-article-hero-wrap">
    <img src="<%= post.image_url %>" alt="<%= post.title %>" class="blog-article-hero" loading="lazy">
  </div>
<% } %>

<article class="blog-article">
  <header class="blog-article-header">
    <% if (post.category_name) { %>
      <a href="/blog?categorie=<%= post.category_slug %>" class="blog-article-category"><%= post.category_name %></a>
    <% } %>
    <h1 class="blog-article-title"><%= post.title %></h1>
    <div class="blog-article-meta">
      <span><%= post.author_name || t('blog.authorDefault') %></span>
      <span>&middot;</span>
      <span><%= post.published_at ? new Date(post.published_at).toLocaleDateString(t('common.locale') || 'ro-RO', { day: 'numeric', month: 'long', year: 'numeric' }) : '' %></span>
      <span>&middot;</span>
      <span class="blog-article-meta-reading">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
        <%= Math.max(1, Math.round((post.content || '').replace(/<[^>]+>/g, '').split(/\s+/).length / 200)) %> <%= t('blog.minRead') %>
      </span>
    </div>
  </header>

  <div class="blog-content">
    <%- post.content %>
  </div>

  <div class="blog-article-cta">
    <h3><%= t('blog.ctaTitle') %></h3>
    <p><%= t('blog.ctaDesc') %></p>
    <a href="/oferte"><%= t('blog.ctaLink') %> &rarr;</a>
  </div>

  <% if (related && related.length > 0) { %>
    <section class="blog-related">
      <h2><%= t('blog.relatedArticles') %></h2>
      <div class="blog-related-grid">
        <% related.forEach(r => { %>
          <a href="/blog/<%= r.slug %>" class="blog-card">
            <div class="blog-card-img-wrap">
              <% if (r.image_url) { %>
                <img src="<%= r.image_url %>" alt="<%= r.title %>" class="blog-card-img" loading="lazy">
              <% } else { %>
                <div class="blog-card-img-placeholder">
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
                </div>
              <% } %>
            </div>
            <div class="blog-card-body">
              <div class="blog-card-meta">
                <% if (r.category_name) { %>
                  <span class="blog-card-category"><%= r.category_name %></span>
                  <span>&middot;</span>
                <% } %>
                <span><%= r.published_at ? new Date(r.published_at).toLocaleDateString(t('common.locale') || 'ro-RO', { day: 'numeric', month: 'long', year: 'numeric' }) : '' %></span>
              </div>
              <h3 class="blog-card-title"><%= r.title %></h3>
            </div>
          </a>
        <% }); %>
      </div>
    </section>
  <% } %>
</article>

<%- include('partials/footer') %>
