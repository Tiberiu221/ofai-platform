<%- include('partials/head', { pageTitle: 'Înregistrare', activePage: null }) %>
<%- include('partials/navbar', { activePage: null, webUser: typeof webUser !== 'undefined' ? webUser : null }) %>

<!-- ═══════════════════════════════════════════════════════
     REGISTER PAGE
     ═══════════════════════════════════════════════════════ -->
<div class="auth-page">
  <canvas class="particle-canvas auth-particles"></canvas>
  <div class="auth-card">
    <!-- Logo -->
    <div class="auth-logo">
      <div class="auth-logo-icon">O</div>
      <span class="auth-logo-text">OFAI</span>
    </div>

    <!-- Title -->
    <h1 class="auth-title">Creeaz&#259; un cont</h1>
    <p class="auth-subtitle">Descoper&#259; oferte exclusive din ora&#537;ul t&#259;u</p>

    <!-- Error message -->
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="auth-error">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
        <%= error %>
      </div>
    <% } %>

    <!-- Register Form -->
    <form action="/register" method="POST" class="auth-form">
      <div class="auth-form-row">
        <div class="auth-form-group">
          <label for="first_name" class="auth-label">Prenume</label>
          <input
            type="text"
            id="first_name"
            name="first_name"
            class="auth-input"
            placeholder="Ion"
            required
            autocomplete="given-name"
          >
        </div>

        <div class="auth-form-group">
          <label for="last_name" class="auth-label">Nume</label>
          <input
            type="text"
            id="last_name"
            name="last_name"
            class="auth-input"
            placeholder="Popescu"
            required
            autocomplete="family-name"
          >
        </div>
      </div>

      <div class="auth-form-group">
        <label for="email" class="auth-label">Email</label>
        <input
          type="email"
          id="email"
          name="email"
          class="auth-input"
          placeholder="exemplu@email.com"
          required
          autocomplete="email"
        >
      </div>

      <div class="auth-form-group">
        <label for="password" class="auth-label">Parol&#259;</label>
        <input
          type="password"
          id="password"
          name="password"
          class="auth-input"
          placeholder="Minim 6 caractere"
          required
          minlength="6"
          autocomplete="new-password"
        >
        <span class="auth-hint">Parola trebuie s&#259; aib&#259; minim 6 caractere</span>
      </div>

      <button type="submit" class="btn btn-primary btn-lg auth-submit">
        Creeaz&#259; cont
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </button>
    </form>

    <!-- Login link -->
    <div class="auth-footer-link">
      Ai deja cont? <a href="/login" class="auth-link">Conecteaz&#259;-te</a>
    </div>
  </div>
</div>

<!-- Auth Page Styles -->
<style>
  .auth-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 120px 20px 80px;
    position: relative;
  }

  /* glow replaced by particle-canvas */

  .auth-card {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 440px;
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 24px;
    padding: 48px 40px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
  }

  .auth-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-bottom: 32px;
  }

  .auth-logo-icon {
    width: 40px;
    height: 40px;
    background: #fb923c;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 20px;
    color: #09090b;
  }

  .auth-logo-text {
    font-size: 24px;
    font-weight: 800;
    color: var(--text-primary, #fafafa);
    letter-spacing: -0.5px;
  }

  .auth-title {
    text-align: center;
    font-size: 28px;
    font-weight: 700;
    color: var(--text-primary, #fafafa);
    margin-bottom: 8px;
    letter-spacing: -0.5px;
  }

  .auth-subtitle {
    text-align: center;
    color: var(--text-secondary, #a1a1aa);
    font-size: 15px;
    margin-bottom: 32px;
  }

  .auth-error {
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.2);
    color: #fca5a5;
    padding: 12px 16px;
    border-radius: 12px;
    font-size: 14px;
    margin-bottom: 24px;
  }

  .auth-error svg {
    flex-shrink: 0;
    color: #f87171;
  }

  .auth-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .auth-form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .auth-form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .auth-label {
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary, #a1a1aa);
  }

  .auth-input {
    width: 100%;
    padding: 12px 16px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    color: var(--text-primary, #fafafa);
    font-size: 15px;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
    font-family: inherit;
  }

  .auth-input::placeholder {
    color: rgba(255, 255, 255, 0.25);
  }

  .auth-input:focus {
    border-color: #fb923c;
    box-shadow: 0 0 0 3px rgba(251, 146, 60, 0.1);
  }

  .auth-submit {
    width: 100%;
    margin-top: 8px;
    justify-content: center;
  }

  .auth-hint {
    font-size: 12px;
    color: var(--text-secondary, #a1a1aa);
    margin-top: 2px;
  }

  .auth-footer-link {
    text-align: center;
    margin-top: 28px;
    font-size: 14px;
    color: var(--text-secondary, #a1a1aa);
  }

  .auth-link {
    color: #fb923c;
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s;
  }

  .auth-link:hover {
    color: #f59e0b;
  }

  @media (max-width: 480px) {
    .auth-card {
      padding: 36px 24px;
      border-radius: 20px;
    }

    .auth-title {
      font-size: 24px;
    }

    .auth-form-row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
document.querySelector('.auth-form').addEventListener('submit', async (e) => {
  e.preventDefault();
  const form = e.target;
  const btn = form.querySelector('.auth-submit');

  const email = form.querySelector('#email').value;
  const password = form.querySelector('#password').value;
  const first_name = form.querySelector('#first_name').value;
  const last_name = form.querySelector('#last_name').value;

  const oldErr = form.parentElement.querySelector('.auth-error');
  if (oldErr) oldErr.remove();

  btn.disabled = true;
  btn.textContent = 'Se creează contul...';

  try {
    const resp = await fetch('/register', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email, password, first_name, last_name }),
    });
    const data = await resp.json();

    if (resp.ok && data.success) {
      window.location.href = data.redirect || '/cont';
    } else {
      const errDiv = document.createElement('div');
      errDiv.className = 'auth-error';
      errDiv.textContent = data.message || 'Eroare la înregistrare';
      form.parentElement.insertBefore(errDiv, form);
      btn.disabled = false;
      btn.textContent = 'Creează cont';
    }
  } catch (err) {
    btn.disabled = false;
    btn.textContent = 'Creează cont';
  }
});
</script>

<%- include('partials/footer') %>
