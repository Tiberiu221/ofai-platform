<%- include('partials/head', { pageTitle: 'Înregistrare', activePage: null }) %>
<%- include('partials/navbar', { activePage: null, webUser: typeof webUser !== 'undefined' ? webUser : null }) %>

<!-- ═══════════════════════════════════════════════════════
     REGISTER PAGE
     ═══════════════════════════════════════════════════════ -->
<div class="auth-page">
  <canvas class="particle-canvas auth-particles" data-shader="true"></canvas>
  <div class="auth-card">
    <!-- Logo -->
    <div class="auth-logo">
      <img src="/images/ofai-wordmark-nobg.png" alt="OFAI" style="display:block;margin:0 auto 16px;height:56px;width:auto">
    </div>

    <!-- Title -->
    <h1 class="auth-title"><%= t('auth.createAccount') %></h1>
    <p class="auth-subtitle"><%= t('auth.registerSubtitle') %></p>

    <!-- Error message -->
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="auth-error show">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
        <%= error %>
      </div>
    <% } %>

    <!-- Register Form -->
    <form class="auth-form" onsubmit="return false">
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
      <div class="auth-form-row">
        <div class="auth-form-group">
          <label for="first_name" class="auth-label"><%= t('auth.firstName') %></label>
          <input
            type="text"
            id="first_name"
            name="first_name"
            class="auth-input"
            placeholder="Ion"
            required
            autocomplete="given-name"
          >
        </div>

        <div class="auth-form-group">
          <label for="last_name" class="auth-label"><%= t('auth.lastName') %></label>
          <input
            type="text"
            id="last_name"
            name="last_name"
            class="auth-input"
            placeholder="Popescu"
            required
            autocomplete="family-name"
          >
        </div>
      </div>

      <div class="auth-form-group">
        <label for="email" class="auth-label"><%= t('auth.email') %></label>
        <input
          type="email"
          id="email"
          name="email"
          class="auth-input"
          placeholder="exemplu@email.com"
          required
          autocomplete="email"
        >
      </div>

      <div class="auth-form-group">
        <label for="password" class="auth-label"><%= t('auth.password') %></label>
        <div style="position: relative;">
          <input
            type="password"
            id="password"
            name="password"
            class="auth-input"
            placeholder="<%= t('auth.passwordHint') %>"
            required
            minlength="8"
            autocomplete="new-password"
            oninput="checkPasswordStrength(this.value)"
            style="padding-right: 44px;"
          >
          <button type="button" onclick="togglePasswordVisibility('password', this)" style="position:absolute; right:12px; top:50%; transform:translateY(-50%); background:none; border:none; color:var(--text-tertiary); cursor:pointer; padding:4px;" aria-label="<%= t('auth.showPassword') %>">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          </button>
        </div>
        <div id="password-strength" style="display:none; margin-top:6px;">
          <div style="display:flex; gap:4px; margin-bottom:4px;">
            <div id="str-bar-1" style="flex:1; height:3px; border-radius:2px; background:var(--border); transition:background 0.2s;"></div>
            <div id="str-bar-2" style="flex:1; height:3px; border-radius:2px; background:var(--border); transition:background 0.2s;"></div>
            <div id="str-bar-3" style="flex:1; height:3px; border-radius:2px; background:var(--border); transition:background 0.2s;"></div>
          </div>
          <span id="str-text" style="font-size:0.75rem; color:var(--text-tertiary);"></span>
        </div>
      </div>

      <!-- GDPR Consent -->
      <div class="auth-consent-group">
        <label class="auth-consent-label">
          <input type="checkbox" id="accept_gdpr" name="accept_gdpr" required>
          <span><%- t('auth.gdprConsent') %></span>
        </label>
      </div>

      <button type="submit" class="btn btn-primary btn-lg auth-submit">
        <%= t('auth.createButton') %>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </button>
    </form>

    <% if (typeof googleClientId !== 'undefined' && googleClientId) { %>
    <!-- Google Sign-In Divider -->
    <div class="auth-divider"><span><%= t('auth.or') %></span></div>

    <!-- Google button rendered here by GIS library -->
    <div class="google-btn-wrapper" id="google-btn-target"></div>
    <% } %>

    <!-- Login link -->
    <div class="auth-footer-link">
      <%= t('auth.hasAccount') %> <a href="/login" class="auth-link" id="login-link"><%= t('auth.loginLink') %></a>
    </div>
  </div>
</div>

<!-- Auth page styles are in main.css -->

<% if (typeof googleClientId !== 'undefined' && googleClientId) { %>
<script src="https://accounts.google.com/gsi/client" async defer></script>
<% } %>
<script nonce="<%= cspNonce %>">
// Read returnTo from URL once on page load
const _qs = new URLSearchParams(window.location.search);
const returnTo = _qs.get('returnTo') || '/onboarding';

// Propagate returnTo to login link immediately
if (returnTo !== '/cont') {
  const loginLink = document.getElementById('login-link');
  if (loginLink) loginLink.href = '/login?returnTo=' + encodeURIComponent(returnTo);
}

<% if (typeof googleClientId !== 'undefined' && googleClientId) { %>
// Initialize Google Sign-In and render button when library loads
(function waitForGoogle() {
  if (typeof google !== 'undefined' && google.accounts && google.accounts.id) {
    console.log('[Google] GIS library loaded, initializing...');
    google.accounts.id.initialize({
      client_id: '<%= googleClientId %>',
      callback: handleGoogleCallback,
      ux_mode: 'popup',
      log_level: 'debug'
    });
    const target = document.getElementById('google-btn-target');
    if (target) {
      google.accounts.id.renderButton(target, {
        theme: 'outline',
        size: 'large',
        text: 'signup_with',
        shape: 'rectangular',
        width: 360
      });
      console.log('[Google] Button rendered');
    }
  } else {
    setTimeout(waitForGoogle, 100);
  }
})();
<% } %>

// Google Sign-In callback
function handleGoogleCallback(response) {
  console.log('[Google] Callback fired, credential length:', response.credential ? response.credential.length : 'NONE');
  fetch('/auth/google', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || ''
    },
    body: JSON.stringify({ idToken: response.credential })
  })
  .then(function(r) {
    if (!r.ok) {
      return r.json().catch(function() {
        throw new Error('Eroare server (' + r.status + ')');
      }).then(function(data) {
        throw new Error(data.message || 'Eroare server (' + r.status + ')');
      });
    }
    return r.json();
  })
  .then(function(data) {
    if (data.success) {
      var card = document.querySelector('.auth-card');
      if (card) {
        card.style.transition = 'opacity 0.2s, transform 0.2s';
        card.style.opacity = '0';
        card.style.transform = 'scale(0.98)';
      }
      setTimeout(function() { window.location.href = data.redirect || '/cont'; }, 200);
    } else {
      var msg = data.message || 'Eroare la autentificarea Google';
      if (typeof showToast === 'function') showToast(msg, 'error');
      else alert(msg);
    }
  })
  .catch(function(err) {
    console.error('[Google] Auth error:', err);
    var msg = err.message || 'Eroare de rețea';
    if (typeof showToast === 'function') showToast(msg, 'error');
    else alert(msg);
  });
}

// Use shared auth form handler
document.addEventListener('DOMContentLoaded', () => {
  window.submitAuthForm({
    formEl: document.querySelector('.auth-form'),
    endpoint: '/register',
    getPayload: (form) => ({
      email: form.querySelector('#email').value,
      password: form.querySelector('#password').value,
      first_name: form.querySelector('#first_name').value,
      last_name: form.querySelector('#last_name').value,
      returnTo,
      accept_terms: form.querySelector('#accept_gdpr').checked,
      accept_privacy: form.querySelector('#accept_gdpr').checked,
    }),
    successRedirect: returnTo
  });
});

function checkPasswordStrength(val) {
  var el = document.getElementById('password-strength');
  if (!val) { el.style.display = 'none'; return; }
  el.style.display = '';
  var score = 0;
  if (val.length >= 8) score++;
  if (/\d/.test(val)) score++;
  if (/[A-Z]/.test(val) && /[a-z]/.test(val)) score++;
  var colors = ['#ef4444', '#f59e0b', '#22c55e'];
  var labels = ['<%= t("auth.strengthWeak") %>', '<%= t("auth.strengthMedium") %>', '<%= t("auth.strengthStrong") %>'];
  for (var i = 1; i <= 3; i++) {
    document.getElementById('str-bar-' + i).style.background = i <= score ? colors[Math.min(score, 3) - 1] : 'var(--border)';
  }
  document.getElementById('str-text').textContent = labels[Math.min(score, 3) - 1] || '';
  document.getElementById('str-text').style.color = colors[Math.min(score, 3) - 1] || 'var(--text-tertiary)';
}

function togglePasswordVisibility(fieldId, btn) {
  var input = document.getElementById(fieldId);
  var isPassword = input.type === 'password';
  input.type = isPassword ? 'text' : 'password';
  btn.innerHTML = isPassword
    ? '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>'
    : '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>';
}
</script>

<!-- WebGL shader background (THREE.js + auth-shader) -->
<script src="https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.min.js"></script>
<script src="/js/auth-shader.js?v=2"></script>

<%- include('partials/footer') %>
