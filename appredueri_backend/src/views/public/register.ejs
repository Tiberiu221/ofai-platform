<%- include('partials/head', { pageTitle: 'Înregistrare', activePage: null }) %>
<%- include('partials/navbar', { activePage: null, webUser: typeof webUser !== 'undefined' ? webUser : null }) %>

<!-- ═══════════════════════════════════════════════════════
     REGISTER PAGE
     ═══════════════════════════════════════════════════════ -->
<div class="auth-page">
  <canvas class="particle-canvas auth-particles"></canvas>
  <div class="auth-card">
    <!-- Logo -->
    <div class="auth-logo">
      <div class="auth-logo-icon">O</div>
      <span class="auth-logo-text">OFAI</span>
    </div>

    <!-- Title -->
    <h1 class="auth-title">Creeaz&#259; un cont</h1>
    <p class="auth-subtitle">Descoper&#259; oferte exclusive din ora&#537;ul t&#259;u</p>

    <!-- Error message -->
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="auth-error show">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
        <%= error %>
      </div>
    <% } %>

    <!-- Register Form -->
    <form class="auth-form" onsubmit="return false">
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
      <div class="auth-form-row">
        <div class="auth-form-group">
          <label for="first_name" class="auth-label">Prenume</label>
          <input
            type="text"
            id="first_name"
            name="first_name"
            class="auth-input"
            placeholder="Ion"
            required
            autocomplete="given-name"
          >
        </div>

        <div class="auth-form-group">
          <label for="last_name" class="auth-label">Nume</label>
          <input
            type="text"
            id="last_name"
            name="last_name"
            class="auth-input"
            placeholder="Popescu"
            required
            autocomplete="family-name"
          >
        </div>
      </div>

      <div class="auth-form-group">
        <label for="email" class="auth-label">Email</label>
        <input
          type="email"
          id="email"
          name="email"
          class="auth-input"
          placeholder="exemplu@email.com"
          required
          autocomplete="email"
        >
      </div>

      <div class="auth-form-group">
        <label for="password" class="auth-label">Parol&#259;</label>
        <input
          type="password"
          id="password"
          name="password"
          class="auth-input"
          placeholder="Minim 8 caractere, cel pu&#539;in o cifr&#259;"
          required
          minlength="8"
          autocomplete="new-password"
        >
        <span class="auth-hint">Parola trebuie s&#259; aib&#259; minim 8 caractere &#537;i cel pu&#539;in o cifr&#259;</span>
      </div>

      <!-- GDPR Consent -->
      <div class="auth-consent-group">
        <label class="auth-consent-label">
          <input type="checkbox" id="accept_gdpr" name="accept_gdpr" required>
          <span>Accept <a href="/termeni" target="_blank" class="auth-link">Termenii și Condițiile</a> și <a href="/confidentialitate" target="_blank" class="auth-link">Politica de Confidențialitate</a></span>
        </label>
      </div>

      <button type="submit" class="btn btn-primary btn-lg auth-submit">
        Creeaz&#259; cont
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </button>
    </form>

    <% if (typeof googleClientId !== 'undefined' && googleClientId) { %>
    <!-- Google Sign-In Divider -->
    <div class="auth-divider"><span>sau</span></div>

    <!-- Google Sign-In -->
    <div id="g_id_onload"
      data-client_id="<%= googleClientId %>"
      data-callback="handleGoogleCallback"
      data-auto_prompt="false">
    </div>
    <div class="google-btn-wrapper">
      <div id="g_id_signin"
        data-type="standard"
        data-shape="rectangular"
        data-theme="outline"
        data-text="signup_with"
        data-size="large"
        data-logo_alignment="left"
        data-width="360">
      </div>
    </div>
    <% } %>

    <!-- Login link -->
    <div class="auth-footer-link">
      Ai deja cont? <a href="/login" class="auth-link" id="login-link">Conecteaz&#259;-te</a>
    </div>
  </div>
</div>

<!-- Auth page styles are in main.css -->

<% if (typeof googleClientId !== 'undefined' && googleClientId) { %>
<script src="https://accounts.google.com/gsi/client" async defer></script>
<% } %>
<script>
// Read returnTo from URL once on page load
const _qs = new URLSearchParams(window.location.search);
const returnTo = _qs.get('returnTo') || '/onboarding';

// Propagate returnTo to login link immediately
if (returnTo !== '/cont') {
  const loginLink = document.getElementById('login-link');
  if (loginLink) loginLink.href = '/login?returnTo=' + encodeURIComponent(returnTo);
}

// Google Sign-In callback
function handleGoogleCallback(response) {
  fetch('/auth/google', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || ''
    },
    body: JSON.stringify({ idToken: response.credential })
  })
  .then(r => r.json())
  .then(data => {
    if (data.success) {
      const card = document.querySelector('.auth-card');
      if (card) {
        card.style.transition = 'opacity 0.2s, transform 0.2s';
        card.style.opacity = '0';
        card.style.transform = 'scale(0.98)';
      }
      setTimeout(() => { window.location.href = data.redirect || '/cont'; }, 200);
    } else {
      if (typeof showToast === 'function') showToast(data.message || 'Eroare la autentificarea Google', 'error');
    }
  })
  .catch(() => {
    if (typeof showToast === 'function') showToast('Eroare de rețea', 'error');
  });
}

// Use shared auth form handler
document.addEventListener('DOMContentLoaded', () => {
  window.submitAuthForm({
    formEl: document.querySelector('.auth-form'),
    endpoint: '/register',
    getPayload: (form) => ({
      email: form.querySelector('#email').value,
      password: form.querySelector('#password').value,
      first_name: form.querySelector('#first_name').value,
      last_name: form.querySelector('#last_name').value,
      returnTo,
      accept_terms: form.querySelector('#accept_gdpr').checked,
      accept_privacy: form.querySelector('#accept_gdpr').checked,
    }),
    successRedirect: returnTo
  });
});
</script>

<%- include('partials/footer') %>
