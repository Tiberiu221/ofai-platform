<%- include('partials/head', { pageTitle: 'Preferințe', activePage: 'preferinte' }) %>
<%- include('partials/navbar', { activePage: 'preferinte', webUser: webUser }) %>

<section class="page-header" style="padding-bottom: 24px;">
  <div class="page-header-glow"></div>
  <div class="container">
    <h1 class="page-title text-gradient">Preferințe</h1>
    <p class="page-subtitle">Alege orașele și categoriile tale preferate pentru oferte personalizate</p>
  </div>
</section>

<section class="section" style="padding-top: 0;">
  <div class="container" style="max-width: 640px;">

    <form id="preferences-form" onsubmit="return savePreferences(event)">

      <!-- City Selection (multi-select) -->
      <div class="settings-section reveal">
        <h2 class="settings-section-title">Orașele tale</h2>
        <p style="color: var(--text-secondary); font-size: 0.875rem; margin-bottom: 16px;">Poți selecta mai multe orașe</p>
        <div class="preferences-pills" id="city-pills">
          <%
            const selectedCities = Array.isArray(preferredCityIds) ? preferredCityIds.map(Number) : [];
          %>
          <button type="button" class="preference-pill<%= selectedCities.length === 0 ? ' active' : '' %>" data-city-id="0" onclick="selectAllCities(this)">
            Toate
          </button>
          <% cities.forEach(function(city) { %>
            <button type="button" class="preference-pill<%= selectedCities.includes(city.id) ? ' active' : '' %>" data-city-id="<%= city.id %>" onclick="toggleCity(this)">
              <%= city.name %>
            </button>
          <% }); %>
        </div>
      </div>

      <!-- Category Selection (multi-select) -->
      <div class="settings-section reveal">
        <h2 class="settings-section-title">Categorii preferate</h2>
        <p style="color: var(--text-secondary); font-size: 0.875rem; margin-bottom: 16px;">Poți selecta mai multe categorii</p>
        <div class="preferences-pills" id="category-pills">
          <%
            const selectedCats = Array.isArray(preferredCategoryIds) ? preferredCategoryIds.map(Number) : [];
          %>
          <button type="button" class="preference-pill<%= selectedCats.length === 0 ? ' active' : '' %>" data-category-id="0" onclick="selectAllCategories(this)">
            Toate
          </button>
          <% categories.forEach(function(cat) { %>
            <button type="button" class="preference-pill<%= selectedCats.includes(cat.id) ? ' active' : '' %>" data-category-id="<%= cat.id %>" onclick="toggleCategory(this)">
              <%= cat.name %>
            </button>
          <% }); %>
        </div>
      </div>

      <div id="pref-success" style="display: none; color: var(--success); font-size: 0.875rem; margin-bottom: 12px; text-align: center;"></div>

      <button type="submit" class="btn btn-primary btn-lg" style="width: 100%;">Salvează preferințele</button>

    </form>

    <a href="/cont" class="btn btn-ghost" style="width: 100%; margin-top: 12px; text-align: center;">Înapoi la cont</a>

  </div>
</section>

<script>
  let selectedCityIds = [<%= Array.isArray(preferredCityIds) ? preferredCityIds.join(',') : '' %>];
  let selectedCategoryIds = [<%= Array.isArray(preferredCategoryIds) ? preferredCategoryIds.join(',') : '' %>];

  function toggleCity(el) {
    // Deselect "Toate" when selecting individual city
    const toateBtn = document.querySelector('#city-pills .preference-pill[data-city-id="0"]');
    if (toateBtn) toateBtn.classList.remove('active');

    el.classList.toggle('active');
    const id = parseInt(el.dataset.cityId);
    if (el.classList.contains('active')) {
      if (!selectedCityIds.includes(id)) selectedCityIds.push(id);
    } else {
      selectedCityIds = selectedCityIds.filter(c => c !== id);
    }

    // If nothing selected, activate "Toate"
    if (selectedCityIds.length === 0 && toateBtn) toateBtn.classList.add('active');
  }

  function selectAllCities(el) {
    document.querySelectorAll('#city-pills .preference-pill').forEach(p => p.classList.remove('active'));
    el.classList.add('active');
    selectedCityIds = [];
  }

  function toggleCategory(el) {
    // Deselect "Toate" when selecting individual category
    const toateBtn = document.querySelector('#category-pills .preference-pill[data-category-id="0"]');
    if (toateBtn) toateBtn.classList.remove('active');

    el.classList.toggle('active');
    const id = parseInt(el.dataset.categoryId);
    if (el.classList.contains('active')) {
      if (!selectedCategoryIds.includes(id)) selectedCategoryIds.push(id);
    } else {
      selectedCategoryIds = selectedCategoryIds.filter(c => c !== id);
    }

    // If nothing selected, activate "Toate"
    if (selectedCategoryIds.length === 0 && toateBtn) toateBtn.classList.add('active');
  }

  function selectAllCategories(el) {
    document.querySelectorAll('#category-pills .preference-pill').forEach(p => p.classList.remove('active'));
    el.classList.add('active');
    selectedCategoryIds = [];
  }

  async function savePreferences(e) {
    e.preventDefault();
    const succEl = document.getElementById('pref-success');
    succEl.style.display = 'none';

    try {
      const csrfToken = document.querySelector('meta[name="csrf-token"]');
      const res = await fetch('/api/web/preferences', {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': csrfToken ? csrfToken.getAttribute('content') : ''
        },
        body: JSON.stringify({
          preferred_city_ids: selectedCityIds.filter(id => id),
          preferred_category_ids: selectedCategoryIds.filter(id => id)
        })
      });
      if (res.ok) {
        succEl.textContent = 'Preferințele au fost salvate!';
        succEl.style.display = '';
        if (typeof showToast === 'function') showToast('Preferințele au fost salvate!', 'success');
      }
    } catch(err) { console.error(err); }
    return false;
  }
</script>

<%- include('partials/footer') %>
