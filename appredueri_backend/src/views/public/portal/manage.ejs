  window.toggleGrouping = function(btn) {
    isWeekly = !isWeekly;
    if (isWeekly) {
      btn.classList.add('active');
      btn.textContent = 'Zilnic';
    } else {
      btn.classList.remove('active');
      btn.textContent = 'Săptămânal';
    }
    rerenderCharts();
  };

  function groupByWeek(dataArr, valueKey) {
    if (!dataArr || dataArr.length === 0) return [];
    var weeks = [];
    var weekSum = 0;
    var weekStart = dataArr[0].date || '';
    var weekEnd = '';
    var count = 0;

    dataArr.forEach(function(item, i) {
      weekSum += item[valueKey] || 0;
      weekEnd = item.date || '';
      count++;

      if (count === 7 || i === dataArr.length - 1) {
        var startParts = weekStart.split('-');
        var endParts = weekEnd.split('-');
        var label = startParts[2] + '/' + startParts[1] + '-' + endParts[2] + '/' + endParts[1];
        var entry = { date: label };
        entry[valueKey] = weekSum;
        weeks.push(entry);
        weekSum = 0;
        weekStart = (i + 1 < dataArr.length) ? (dataArr[i + 1].date || '') : '';
        count = 0;
      }
    });
    return weeks;
  }

  /* ── Chart.js instances ── */
  var chartInstances = {};

  function renderChart(canvasId, dataArr, label, valueKey) {
    // Destroy existing chart instance
    if (chartInstances[canvasId]) {
      chartInstances[canvasId].destroy();
      chartInstances[canvasId] = null;
    }

    var canvas = document.getElementById(canvasId);
    if (!canvas) return;

    if (!dataArr || dataArr.length === 0) {
      var parent = canvas.parentNode;
      parent.innerHTML = '<div class="chart-loading">Nu sunt date disponibile</div>';
      return;
    }

    // Build labels and values
    var labels = [];
    var values = [];
    dataArr.forEach(function(item) {
      var dateLabel = item.date || item.label || '';
      // Format short date: "2025-02-14" → "14/02"
      if (dateLabel && dateLabel.indexOf('-') !== -1 && dateLabel.length === 10) {
        var parts = dateLabel.split('-');
        dateLabel = parts[2] + '/' + parts[1];
      }
      labels.push(dateLabel);
      values.push((valueKey && item[valueKey] !== undefined) ? item[valueKey] : (item.count || item.value || 0));
    });

    var ctx = canvas.getContext('2d');
    chartInstances[canvasId] = new Chart(ctx, {
      type: 'bar',
      data: {
        labels: labels,
        datasets: [{
          label: label,
          data: values,
          backgroundColor: 'rgba(251, 146, 60, 0.7)',
          borderColor: '#fb923c',
          borderWidth: 1,
          borderRadius: 4,
          borderSkipped: 'bottom',
          maxBarThickness: 40,
          barPercentage: 0.8,
          categoryPercentage: 0.7,
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        layout: { padding: { right: 4, bottom: 4 } },
        plugins: {
          legend: { display: false },
          tooltip: {
            backgroundColor: '#27272a',
            titleColor: '#f4f4f5',
            bodyColor: '#f4f4f5',
            borderColor: 'rgba(255,255,255,0.1)',
            borderWidth: 1,
            cornerRadius: 6,
            padding: 8,
            displayColors: false,
            callbacks: {
              title: function(items) { return items[0].label || ''; },
              label: function(item) { return item.raw + ' ' + label; }
            }
          }
        },
        scales: {
          x: {
            grid: { display: false },
            ticks: {
              color: '#71717a',
              font: { size: 10 },
              maxRotation: 45,
              minRotation: 0,
              maxTicksLimit: 8,
              autoSkip: true,
            },
            border: { display: false }
          },
          y: {
            beginAtZero: true,
            grid: { color: 'rgba(255,255,255,0.04)' },
            ticks: {
              color: '#71717a',
              font: { size: 10 },
              precision: 0,
            },
            border: { display: false }
          }
        },
        animation: {
          duration: 400,
          easing: 'easeOutQuart'
        }
      }
    });
  }

  function rerenderCharts() {
    var vData = isWeekly ? groupByWeek(rawChartData.views, 'views') : rawChartData.views;
    var sData = isWeekly ? groupByWeek(rawChartData.subscribers, 'new_subscribers') : rawChartData.subscribers;
    var cData = isWeekly ? groupByWeek(rawChartData.clicks, 'clicks') : rawChartData.clicks;

    renderChart('views-chart', vData, 'vizualizări', 'views');
    renderChart('subscribers-chart', sData, 'abonați', 'new_subscribers');
    renderChart('clicks-chart', cData, 'click-uri', 'clicks');
  }

  function loadViewsChart(days) {
    var url;
    if (currentViewsMode === 'business') {
      url = '/api/web/portal/' + businessId + '/analytics/views?days=' + days;
    } else {
      var offerId = currentViewsMode.replace('offer-', '');
      url = '/api/web/portal/' + businessId + '/analytics/offer-views?days=' + days + '&offer_id=' + offerId;
    }
    apiFetch(url)
      .then(function(res) { return res.json(); })
      .then(function(data) {
        rawChartData.views = data.data || data || [];
        var displayData = isWeekly ? groupByWeek(rawChartData.views, 'views') : rawChartData.views;
        renderChart('views-chart', displayData, 'vizualizări', 'views');
      })
      .catch(function(err) { console.error('[Charts] Views error:', err); });
  }

  function loadSubscribersChart(days) {
    apiFetch('/api/web/portal/' + businessId + '/analytics/subscribers?days=' + days)
      .then(function(res) { return res.json(); })
      .then(function(data) {
        rawChartData.subscribers = data.data || data || [];
        var displayData = isWeekly ? groupByWeek(rawChartData.subscribers, 'new_subscribers') : rawChartData.subscribers;
        renderChart('subscribers-chart', displayData, 'abonați', 'new_subscribers');
      })
      .catch(function(err) { console.error('[Charts] Subscribers error:', err); });
  }

  function loadClicksChart(days) {
    apiFetch('/api/web/portal/' + businessId + '/analytics/clicks?days=' + days + '&action_type=' + currentClicksAction)
      .then(function(res) { return res.json(); })
      .then(function(data) {
        rawChartData.clicks = data.data || data || [];
        var displayData = isWeekly ? groupByWeek(rawChartData.clicks, 'clicks') : rawChartData.clicks;
        renderChart('clicks-chart', displayData, 'click-uri', 'clicks');
      })
      .catch(function(err) { console.error('[Charts] Clicks error:', err); });
  }

  function loadCharts(days) {
    currentPeriod = days;
    loadViewsChart(days);
    loadSubscribersChart(days);
    loadClicksChart(days);
  }

  window.onViewsDropdownChange = function(sel) {
