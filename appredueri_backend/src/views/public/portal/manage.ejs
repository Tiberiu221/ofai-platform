<%- include('../partials/head', { pageTitle: business.name + ' — Portal', activePage: 'portal' }) %>
<%- include('../partials/navbar', { activePage: 'portal', webUser: webUser }) %>


<!-- ═══════════════════════════════════════════════════════
     PAGE CONTENT
     ═══════════════════════════════════════════════════════ -->
<div class="portal-page">
  <div class="portal-container">

    <!-- Header -->
    <div class="portal-header">
      <div class="portal-header-left">
        <a href="/portal" class="portal-back">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
          Înapoi
        </a>
        <h1 class="portal-biz-name"><%= business.name %></h1>
      </div>
      <a href="/business/<%= business.id %>" class="portal-view-btn" target="_blank">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        Vizualizează
      </a>
    </div>

    <!-- Tab Navigation -->
    <div class="portal-tabs">
      <button class="portal-tab active" onclick="switchTab('info')">Info</button>
      <button class="portal-tab" onclick="switchTab('oferte')">
        Oferte<span class="portal-tab-badge"><%= offers.length %></span>
      </button>
      <button class="portal-tab" onclick="switchTab('recenzii')">
        Recenzii<span class="portal-tab-badge"><%= reviewCount %></span>
      </button>
      <button class="portal-tab" onclick="switchTab('statistici')">Statistici</button>
      <button class="portal-tab" onclick="switchTab('support')">Suport</button>
      <button class="portal-tab" onclick="switchTab('subscription')">Abonament</button>
    </div>

    <!-- ═══════════════════════════════════════
         TAB 1: INFO
         ═══════════════════════════════════════ -->
    <div class="tab-panel active" id="tab-info">
      <%- include("./partials/_tab-info") %>
    </div>
    <!-- /#tab-info -->

    <!-- ═══════════════════════════════════════
         TAB 2: OFERTE
         ═══════════════════════════════════════ -->
    <div class="tab-panel" id="tab-oferte">
      <%- include("./partials/_tab-oferte") %>
    </div>

    <!-- ═══════════════════════════════════════
         TAB 3: RECENZII
         ═══════════════════════════════════════ -->
    <div class="tab-panel" id="tab-recenzii">
      <%- include("./partials/_tab-recenzii") %>
    </div>

    <!-- ═══════════════════════════════════════
         TAB 4: STATISTICI
         ═══════════════════════════════════════ -->
    <div class="tab-panel" id="tab-statistici">
      <%- include("./partials/_tab-statistici") %>
    </div><!-- /tab-statistici -->

    <!-- ═══════════════════════════════════════
         TAB 5: SUPORT
         ═══════════════════════════════════════ -->
    <div class="tab-panel" id="tab-support">
      <%- include("./partials/_tab-support") %>
    </div><!-- /tab-support -->

    <!-- ═══════════════════════════════════════
         TAB 6: ABONAMENT
         ═══════════════════════════════════════ -->
    <div class="tab-panel" id="tab-subscription">
      <%- include("./partials/_tab-subscription") %>
    </div><!-- /tab-subscription -->

  </div><!-- /portal-container -->
</div><!-- /portal-page -->

<%- include('../partials/footer') %>

<script>
(function() {
  var businessId = '<%= business.id %>';
  var currentPeriod = 30;
  var currentViewsMode = 'business';
  var currentClicksAction = 'phone';

  // Server-side tier info for immediate UI gating
  var _serverTier = <%- JSON.stringify({
    tier: tier ? tier.tier : 'free',
    plan: tier && tier.plan ? {
      canUploadLogo: !!tier.plan.can_upload_logo,
      canUploadCover: !!tier.plan.can_upload_cover,
      maxGalleryImages: tier.plan.max_gallery_images,
      maxLocations: tier.plan.max_locations,
      maxActiveOffers: tier.plan.max_active_offers,
      hasBooking: !!tier.plan.has_booking,
      hasAnalyticsCharts: !!tier.plan.has_analytics_charts,
      canRespondReviews: !!tier.plan.can_respond_reviews,
      hasAiSummary: !!tier.plan.has_ai_summary,
      analyticsDays: tier.plan.analytics_days || 7,
    } : {}
  }).replace(/<\//g, '<\\/') %>;

  /* ── Toast ── */
  function showToast(message, type) {
    var existing = document.querySelector('.pm-toast');
    if (existing) existing.remove();
    var t = document.createElement('div');
    t.className = 'pm-toast ' + (type || 'success');
    t.textContent = message;
    document.body.appendChild(t);
    setTimeout(function() { if (t.parentNode) t.remove(); }, 3000);
  }

  /* ── Handle 403 upgrade-required errors ── */
  function handleUpgradeError(response) {
    if (response.status === 403) {
      return response.clone().json().then(function(data) {
        if (data.error === 'upgrade_required' || data.error === 'limit_reached') {
          showToast(data.message + ' Upgrade din tab-ul Abonament.', 'error');
        }
      }).catch(function() {});
    }
  }

  /* ── Auth-aware fetch with CSRF ── */
  function apiFetch(url, options) {
    var csrfToken = document.querySelector('meta[name="csrf-token"]');
    options = options || {};
    options.headers = options.headers || {};

    // Add CSRF token to headers (unless it's FormData, which can't have custom headers easily)
    if (!(options.body instanceof FormData)) {
      if (typeof options.headers === 'object' && !Array.isArray(options.headers)) {
        options.headers['X-CSRF-Token'] = csrfToken ? csrfToken.getAttribute('content') : '';
        // Auto-set Content-Type for JSON bodies
        if (typeof options.body === 'string' && !options.headers['Content-Type']) {
          options.headers['Content-Type'] = 'application/json';
        }
      }
    } else {
      // For FormData, we need to set headers differently
      var newHeaders = new Headers(options.headers);
      newHeaders.set('X-CSRF-Token', csrfToken ? csrfToken.getAttribute('content') : '');
      options.headers = newHeaders;
    }

    return fetch(url, options).then(function(res) {
      if (res.status === 401) {
        window.location.href = '/login';
        throw new Error('Unauthorized');
      }
      if (res.status === 403) {
        handleUpgradeError(res);
      }
      return res;
    });
  }

  /* ════════════════════════════════
     IMAGE UPLOAD / DELETE
     ════════════════════════════════ */
  window.uploadImage = function(type, input) {
    var file = input.files && input.files[0];
    if (!file) return;

    // Validate file size (max 5MB)
    if (file.size > 5 * 1024 * 1024) {
      showToast('Imaginea nu poate depăși 5MB', 'error');
      input.value = '';
      return;
    }

    var formData = new FormData();
    formData.append(type, file);

    var previewBox = document.getElementById(type + '-preview');
    previewBox.style.opacity = '0.5';

    apiFetch('/api/web/portal/' + businessId + '/' + type, {
      method: 'POST',
      body: formData
    })
    .then(function(res) { return res.json(); })
    .then(function(data) {
      previewBox.style.opacity = '1';
      if (data.url) {
        // Update preview image
        var existingImg = document.getElementById(type + '-img');
        var placeholder = document.getElementById(type + '-placeholder');

        if (existingImg) {
          existingImg.src = data.url;
        } else {
          // Create new img element
          var img = document.createElement('img');
          img.src = data.url;
          img.alt = type === 'logo' ? 'Logo' : 'Cover';
          img.id = type + '-img';
          previewBox.innerHTML = '';
          previewBox.appendChild(img);
        }

        // Show delete button if hidden
        var btnContainer = previewBox.parentNode.querySelector('div[style*="display: flex"]');
        if (btnContainer && !btnContainer.querySelector('.danger')) {
          var delBtn = document.createElement('button');
          delBtn.type = 'button';
          delBtn.className = 'btn-sm danger';
          delBtn.onclick = function() { deleteImage(type); };
          delBtn.innerHTML = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg> Șterge';
          btnContainer.appendChild(delBtn);
        }

        showToast(type === 'logo' ? 'Logo actualizat' : 'Copertă actualizată', 'success');
      } else {
        showToast(data.message || 'Eroare la încărcare', 'error');
      }
    })
    .catch(function() {
      previewBox.style.opacity = '1';
      showToast('Eroare la încărcarea imaginii', 'error');
    });

    input.value = '';
  };

  window.deleteImage = function(type) {
    if (!confirm('Sigur vrei să ștergi această imagine?')) return;

    var previewBox = document.getElementById(type + '-preview');
    previewBox.style.opacity = '0.5';

    apiFetch('/api/web/portal/' + businessId + '/' + type, {
      method: 'DELETE'
    })
    .then(function(res) { return res.json(); })
    .then(function(data) {
      previewBox.style.opacity = '1';
      if (data.success) {
        // Replace with placeholder
        var placeholderText = type === 'logo' ? 'Fără logo' : 'Fără copertă';
        previewBox.innerHTML = '<div class="img-preview-placeholder" id="' + type + '-placeholder">' +
          '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>' +
          placeholderText + '</div>';

        // Remove delete button
        var btnContainer = previewBox.parentNode.querySelector('div[style*="display: flex"]');
        if (btnContainer) {
          var delBtn = btnContainer.querySelector('.danger');
          if (delBtn) delBtn.remove();
        }

        showToast('Imaginea a fost ștearsă', 'success');
      } else {
        showToast(data.message || 'Eroare la ștergere', 'error');
      }
    })
    .catch(function() {
      previewBox.style.opacity = '1';
      showToast('Eroare la ștergerea imaginii', 'error');
    });
  };

  /* ════════════════════════════════
     GALLERY UPLOAD / DELETE
     ════════════════════════════════ */
  window.uploadGalleryImages = function(input) {
    var files = input.files;
    if (!files || !files.length) return;

    var grid = document.getElementById('gallery-grid');
    var currentCount = grid.querySelectorAll('.gallery-upload-item').length;

    // Check total limit (tier-based; null = unlimited for Premium)
    var galleryLimit = <%= tier && tier.plan && tier.plan.max_gallery_images != null ? tier.plan.max_gallery_images : 'null' %>;
    if (galleryLimit !== null && currentCount + files.length > galleryLimit) {
      showToast('Maximum ' + galleryLimit + ' imagini. Poți adăuga încă ' + (galleryLimit - currentCount) + '.', 'error');
      input.value = '';
      return;
    }

    var addBtn = document.getElementById('gallery-add-btn');

    Array.from(files).forEach(function(file) {
      // Validate size
      if (file.size > 5 * 1024 * 1024) {
        showToast('Fișierul "' + file.name + '" depășește 5MB', 'error');
        return;
      }

      var formData = new FormData();
      formData.append('image', file);

      // Create temporary loading placeholder
      var placeholder = document.createElement('div');
      placeholder.className = 'gallery-upload-item';
      placeholder.style.opacity = '0.5';
      placeholder.innerHTML = '<div style="display:flex;align-items:center;justify-content:center;width:100%;height:100%;color:var(--text-secondary);font-size:0.75rem;">Se încarcă...</div>';
      if (addBtn) grid.insertBefore(placeholder, addBtn);
      else grid.appendChild(placeholder);

      apiFetch('/api/web/portal/' + businessId + '/gallery', {
        method: 'POST',
        body: formData
      })
      .then(function(res) { return res.json(); })
      .then(function(data) {
        if (data.success && data.image) {
          placeholder.style.opacity = '1';
          placeholder.setAttribute('data-image-id', data.image.id);
          var img = document.createElement('img');
          img.src = data.image.url;
          img.alt = 'Galerie';
          img.width = 120;
          img.height = 80;
          img.loading = 'lazy';
          var btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'gallery-delete-btn';
          btn.title = 'Șterge imaginea';
          btn.setAttribute('aria-label', 'Șterge imaginea');
          btn.innerHTML = '&times;';
          btn.onclick = function() { deleteGalleryImage(data.image.id, this); };
          placeholder.innerHTML = '';
          placeholder.appendChild(img);
          placeholder.appendChild(btn);

          currentCount++;
          // Hide add button if at limit
          var galleryLimit = _serverTier && _serverTier.plan ? _serverTier.plan.maxGalleryImages : 8;
          if (galleryLimit !== null && currentCount >= galleryLimit && addBtn) {
            addBtn.style.display = 'none';
          }

          showToast('Imagine adăugată cu succes', 'success');
        } else {
          placeholder.remove();
          showToast(data.message || 'Eroare la încărcare', 'error');
        }
      })
      .catch(function() {
        placeholder.remove();
        showToast('Eroare la încărcarea imaginii', 'error');
      });
    });

    input.value = '';
  };

  window.deleteGalleryImage = function(imageId, btn) {
    if (!confirm('Sigur vrei să ștergi această imagine din galerie?')) return;

    var item = btn.closest('.gallery-upload-item');
    if (item) item.style.opacity = '0.5';

    apiFetch('/api/web/portal/' + businessId + '/gallery/' + imageId, {
      method: 'DELETE'
    })
    .then(function(res) { return res.json(); })
    .then(function(data) {
      if (data.success) {
        if (item) item.remove();

        // Show add button if was hidden
        var addBtn = document.getElementById('gallery-add-btn');
        if (addBtn) addBtn.style.display = '';

        showToast('Imaginea a fost ștearsă din galerie', 'success');
      } else {
        if (item) item.style.opacity = '1';
        showToast(data.message || 'Eroare la ștergere', 'error');
      }
    })
    .catch(function() {
      if (item) item.style.opacity = '1';
      showToast('Eroare la ștergerea imaginii', 'error');
    });
  };

  /* ════════════════════════════════
     LOCATION MANAGEMENT
     ════════════════════════════════ */

  window.loc_showAddForm = function() {
    document.getElementById('loc-add-form').style.display = '';
  };

  window.loc_hideAddForm = function() {
    var form = document.getElementById('loc-add-form');
    form.style.display = 'none';
    // Reset fields
    document.getElementById('loc-add-address').value = '';
    document.getElementById('loc-add-city').value = '';
    document.getElementById('loc-add-phone').value = '';
    document.getElementById('loc-add-maps-url').value = '';
    document.getElementById('loc-add-lat').value = '';
    document.getElementById('loc-add-lng').value = '';
  };

  window.loc_detectCoords = function(locIdOrAdd) {
    var mapsInput, latInput, lngInput;
    if (locIdOrAdd === 'add') {
      mapsInput = document.getElementById('loc-add-maps-url');
      latInput = document.getElementById('loc-add-lat');
      lngInput = document.getElementById('loc-add-lng');
    } else {
      var card = document.getElementById('loc-card-' + locIdOrAdd);
      mapsInput = card.querySelector('.loc-maps-url');
      latInput = card.querySelector('.loc-lat');
      lngInput = card.querySelector('.loc-lng');
    }

    var url = mapsInput.value.trim();
    if (!url) {
      showToast('Introdu un link Google Maps', 'error');
      return;
    }

    showToast('Se detectează coordonatele...', 'info');

    apiFetch('/api/web/parse-maps-link', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ url: url })
    })
    .then(function(res) { return res.json(); })
    .then(function(data) {
      if (data.error) {
        showToast(data.error, 'error');
        return;
      }
      latInput.value = data.lat;
      lngInput.value = data.lng;
      if (data.mapsUrl) mapsInput.value = data.mapsUrl;
      showToast('Coordonate detectate!', 'success');
    })
    .catch(function() {
      showToast('Eroare la detectarea coordonatelor', 'error');
    });
  };

  window.loc_create = function() {
    var address = document.getElementById('loc-add-address').value.trim();
    var cityId = document.getElementById('loc-add-city').value;
    var phone = document.getElementById('loc-add-phone').value.trim();
    var mapsUrl = document.getElementById('loc-add-maps-url').value.trim();
    var lat = document.getElementById('loc-add-lat').value.trim();
    var lng = document.getElementById('loc-add-lng').value.trim();

    if (!address || !cityId) {
      showToast('Adresa și orașul sunt obligatorii', 'error');
      return;
    }

    apiFetch('/api/web/portal/' + businessId + '/locations', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ address: address, city_id: cityId, phone: phone, maps_url: mapsUrl, lat: lat, lng: lng })
    })
    .then(function(res) { return res.json(); })
    .then(function(data) {
      if (data.success) {
        showToast(data.message || 'Locație adăugată!', 'success');
        // Reload page to refresh location list and counters
        setTimeout(function() { window.location.reload(); }, 500);
      } else {
        showToast(data.message || 'Eroare la adăugare', 'error');
      }
    })
    .catch(function() {
      showToast('Eroare la adăugarea locației', 'error');
    });
  };

  window.loc_update = function(locId) {
    var card = document.getElementById('loc-card-' + locId);
    var address = card.querySelector('.loc-address').value.trim();
    var cityId = card.querySelector('.loc-city').value;
    var phone = card.querySelector('.loc-phone').value.trim();
    var mapsUrl = card.querySelector('.loc-maps-url').value.trim();
    var lat = card.querySelector('.loc-lat').value.trim();
    var lng = card.querySelector('.loc-lng').value.trim();

    if (!address || !cityId) {
      showToast('Adresa și orașul sunt obligatorii', 'error');
      return;
    }

    apiFetch('/api/web/portal/' + businessId + '/locations/' + locId, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ address: address, city_id: cityId, phone: phone, maps_url: mapsUrl, lat: lat, lng: lng })
    })
    .then(function(res) { return res.json(); })
    .then(function(data) {
      if (data.success) {
        showToast(data.message || 'Locație actualizată!', 'success');
      } else {
        showToast(data.message || 'Eroare la actualizare', 'error');
      }
    })
    .catch(function() {
      showToast('Eroare la actualizarea locației', 'error');
    });
  };

  window.loc_delete = function(locId) {
    if (!confirm('Sigur vrei să ștergi această locație? Ofertele asociate vor fi actualizate.')) return;

    var card = document.getElementById('loc-card-' + locId);
    if (card) card.style.opacity = '0.5';

    apiFetch('/api/web/portal/' + businessId + '/locations/' + locId, {
      method: 'DELETE'
    })
    .then(function(res) { return res.json(); })
    .then(function(data) {
      if (data.success) {
        if (card) card.remove();
        showToast(data.message || 'Locație ștearsă!', data.affectedOffers > 0 ? 'info' : 'success');
        // If no more locations, show empty state
        var list = document.getElementById('loc-list');
        if (list && !list.querySelector('.loc-card')) {
          list.innerHTML = '<div id="loc-empty" style="text-align: center; padding: 24px; color: var(--text-secondary); font-size: 0.875rem;">' +
            '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin-bottom: 8px; opacity: 0.5;"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>' +
            '<p>Nicio locație adăugată.</p></div>';
        }
      } else {
        if (card) card.style.opacity = '1';
        showToast(data.message || 'Eroare la ștergere', 'error');
      }
    })
    .catch(function() {
      if (card) card.style.opacity = '1';
      showToast('Eroare la ștergerea locației', 'error');
    });
  };

  /* ════════════════════════════════
     SUBSCRIPTION MANAGEMENT
     ════════════════════════════════ */
  var _subscriptionLoaded = false;

  function loadSubscription() {
    apiFetch('/api/web/portal/' + businessId + '/subscription')
    .then(function(res) { return res.json(); })
    .then(function(data) {
      renderSubscriptionSection(data);
      applyTierGating(data);
    })
    .catch(function(err) {
      console.error('Load subscription error:', err);
      var c = document.getElementById('subscription-content');
      if (c) c.innerHTML = '<div class="glass-card" style="text-align: center; padding: 40px;"><p style="color: var(--text-tertiary);">Eroare la incarcarea informatiilor despre abonament.</p></div>';
    });
  }

  /**
   * Wraps a section in an upgrade overlay if the feature is not available
   */
  function gateSection(sectionId, hasAccess, featureName, requiredTier) {
    var section = document.getElementById(sectionId);
    if (!section) return;

    if (hasAccess) {
      var existing = section.querySelector('.tier-gate-overlay');
      if (existing) existing.remove();
      section.style.position = '';
      section.style.overflow = '';
      return;
    }

    section.style.position = 'relative';
    section.style.overflow = 'hidden';

    var overlay = document.createElement('div');
    overlay.className = 'tier-gate-overlay';
    overlay.innerHTML = '<div class="tier-gate-content">' +
      '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="' + (requiredTier === 'Premium' ? '#a78bfa' : '#fb923c') + '" stroke-width="1.5"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>' +
      '<p style="font-size: 0.9375rem; font-weight: 600; color: var(--text-primary); margin: 8px 0 4px;">' + featureName + '</p>' +
      '<p style="font-size: 0.8125rem; color: var(--text-tertiary); margin: 0 0 16px;">Disponibil cu planul ' + requiredTier + '+</p>' +
      '<a href="/pentru-business#preturi" style="display: inline-flex; align-items: center; gap: 6px; padding: 10px 24px; background: ' + (requiredTier === 'Premium' ? 'linear-gradient(135deg, #a78bfa, #8b5cf6)' : 'linear-gradient(135deg, #f97316, #fb923c)') + '; color: ' + (requiredTier === 'Premium' ? '#fff' : '#06060a') + '; border-radius: var(--radius-full); font-size: 0.875rem; font-weight: 600; text-decoration: none;">Upgrade &rarr;</a>' +
    '</div>';

    section.appendChild(overlay);
  }

  function applyTierGating(subscription) {
    var plan = subscription ? subscription.plan : {};

    // Images (logo + cover) — Standard+
    gateSection('images-upload-section', plan.canUploadLogo, 'Upload Imagini', 'Standard');

    // Gallery — limit enforced on backend, just show limit text
    var gallerySection = document.getElementById('gallery-section');
    if (gallerySection) {
      var maxImages = plan.maxGalleryImages;
      var limitP = gallerySection.querySelector('.section-title');
      if (limitP) {
        var galleryText = (maxImages === null || maxImages === undefined) ? 'nelimitat' : 'max ' + maxImages;
        limitP.innerHTML = 'Galerie foto <span style="font-size: 0.8rem; font-weight: 400; color: var(--text-tertiary);">(' + galleryText + ')</span>';
      }
    }

    // Booking — Standard+
