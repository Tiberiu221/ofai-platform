  /* ════════════════════════════════
     TAB SWITCHING
     ════════════════════════════════ */
  window.switchTab = function(tabName) {
    var panels = document.querySelectorAll('.tab-panel');
    var tabs = document.querySelectorAll('.portal-tab');
    panels.forEach(function(p) { p.classList.remove('active'); });
    tabs.forEach(function(t) { t.classList.remove('active'); });

    var panel = document.getElementById('tab-' + tabName);
    if (panel) panel.classList.add('active');

    // Find matching tab button
    var labels = { info: 'Info', oferte: 'Oferte', recenzii: 'Recenzii', statistici: 'Statistici', support: 'Suport', subscription: 'Abonament' };
    tabs.forEach(function(t) {
      if (t.textContent.trim().indexOf(labels[tabName]) === 0) {
        t.classList.add('active');
      }
    });

    // Load charts on first stats tab visit
    if (tabName === 'statistici' && !window._chartsLoaded) {
      window._chartsLoaded = true;
      loadCharts(currentPeriod);
    }

    // Load competitive insights and push history on stats tab
    if (tabName === 'statistici') {
      if (typeof loadCompetitiveInsights === 'function') loadCompetitiveInsights();
      if (typeof loadPushHistory === 'function') loadPushHistory();
    }

    // Load subscription on first visit
    if (tabName === 'subscription' && !_subscriptionLoaded) {
      _subscriptionLoaded = true;
      loadSubscription();
    }

    // Update URL hash
    history.replaceState(null, '', '#' + tabName);
  };

  // Restore tab from hash on load
  (function() {
    var hash = window.location.hash.replace('#', '');
    if (['info', 'oferte', 'recenzii', 'statistici', 'support', 'subscription'].indexOf(hash) !== -1) {
      switchTab(hash);
    }
  })();

