  /* ════════════════════════════════
     TAB 4: STATISTICS & CHARTS
     ════════════════════════════════ */
  var isWeekly = false;
  var rawChartData = { views: [], subscribers: [], clicks: [] };

  window.changePeriod = function(days, btn) {
    currentPeriod = days;
    var buttons = document.querySelectorAll('.period-btn');
    buttons.forEach(function(b) { b.classList.remove('active'); });
    if (btn) btn.classList.add('active');
