<%- include('../partials/head', { pageTitle: business.name + ' — Portal', activePage: 'portal' }) %>
<%- include('../partials/navbar', { activePage: 'portal', webUser: webUser }) %>


<!-- ═══════════════════════════════════════════════════════
     PAGE CONTENT
     ═══════════════════════════════════════════════════════ -->
<div class="portal-page">
  <div class="portal-container">

    <!-- Header -->
    <div class="portal-header">
      <div class="portal-header-left">
        <a href="/portal" class="portal-back">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
          Înapoi
        </a>
        <h1 class="portal-biz-name"><%= business.name %></h1>
      </div>
      <a href="/business/<%= business.id %>" class="portal-view-btn" target="_blank">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        Vizualizează
      </a>
    </div>

    <!-- Tab Navigation -->
    <div class="portal-tabs">
      <button class="portal-tab active" onclick="switchTab('info')">Info</button>
      <button class="portal-tab" onclick="switchTab('oferte')">
        Oferte<span class="portal-tab-badge"><%= offers.length %></span>
      </button>
      <button class="portal-tab" onclick="switchTab('catalog')">Catalog</button>
      <button class="portal-tab" onclick="switchTab('recenzii')">
        Recenzii<span class="portal-tab-badge"><%= reviewCount %></span>
      </button>
      <button class="portal-tab" onclick="switchTab('statistici')">Statistici</button>
      <button class="portal-tab" onclick="switchTab('support')">Suport</button>
      <button class="portal-tab" onclick="switchTab('subscription')">Abonament</button>
    </div>

    <!-- ═══════════════════════════════════════
         TAB 1: INFO
         ═══════════════════════════════════════ -->
    <div class="tab-panel active" id="tab-info">
      <%- include("./partials/_tab-info") %>
    </div>
    <!-- /#tab-info -->

    <!-- ═══════════════════════════════════════
         TAB 2: OFERTE
         ═══════════════════════════════════════ -->
    <div class="tab-panel" id="tab-oferte">
      <%- include("./partials/_tab-oferte") %>
    </div>

    <!-- ═══════════════════════════════════════
         TAB 2b: CATALOG
         ═══════════════════════════════════════ -->
    <div class="tab-panel" id="tab-catalog">
      <%- include("./partials/_tab-catalog") %>
    </div>

    <!-- ═══════════════════════════════════════
         TAB 3: RECENZII
         ═══════════════════════════════════════ -->
    <div class="tab-panel" id="tab-recenzii">
      <%- include("./partials/_tab-recenzii") %>
    </div>

    <!-- ═══════════════════════════════════════
         TAB 4: STATISTICI
         ═══════════════════════════════════════ -->
    <div class="tab-panel" id="tab-statistici">
      <%- include("./partials/_tab-statistici") %>
    </div><!-- /tab-statistici -->

    <!-- ═══════════════════════════════════════
         TAB 5: SUPORT
         ═══════════════════════════════════════ -->
    <div class="tab-panel" id="tab-support">
      <%- include("./partials/_tab-support") %>
    </div><!-- /tab-support -->

    <!-- ═══════════════════════════════════════
         TAB 6: ABONAMENT
         ═══════════════════════════════════════ -->
    <div class="tab-panel" id="tab-subscription">
      <%- include("./partials/_tab-subscription") %>
    </div><!-- /tab-subscription -->

  </div><!-- /portal-container -->

  <!-- ═══════════════════════════════════════
       CONCIERGE ONBOARDING MODAL (shared)
       ═══════════════════════════════════════ -->
  <div id="concierge-modal" class="portal-modal" style="display: none;">
    <div class="portal-modal-backdrop" onclick="concierge_close()"></div>
    <div class="portal-modal-content" style="max-width: 540px;">
      <div class="portal-modal-header">
        <h3 style="margin: 0;">Solicită ajutor Concierge</h3>
        <button class="portal-modal-close" onclick="concierge_close()">&times;</button>
      </div>
      <div class="portal-modal-body">
        <!-- Active request status -->
        <div id="concierge-active" style="display: none; margin-bottom: 16px;">
          <div style="background: rgba(34,197,94,0.08); border: 1px solid rgba(34,197,94,0.2); border-radius: 10px; padding: 14px;">
            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              <strong style="color: #22c55e; font-size: 14px;">Cerere activă</strong>
            </div>
            <p id="concierge-active-detail" style="margin: 0; font-size: 13px; color: var(--text-secondary);"></p>
          </div>
        </div>
        <!-- New request form -->
        <div id="concierge-form">
          <p style="color: var(--text-secondary); font-size: 14px; margin: 0 0 16px;">
            Echipa OFAI te poate ajuta să îți configurezi pagina business-ului. Descrie ce ai nevoie și vom reveni în maxim 48h.
          </p>
          <div class="form-group" style="margin-bottom: 12px;">
            <label class="form-label">Tip cerere *</label>
            <select id="concierge-type" class="form-select">
              <option value="full_setup">Setup complet (catalog + program)</option>
              <option value="catalog">Doar catalog (servicii/produse)</option>
              <option value="hours">Doar program de lucru</option>
            </select>
          </div>
          <div class="form-group" style="margin-bottom: 12px;">
            <label class="form-label">Mesaj (opțional)</label>
            <textarea id="concierge-message" class="form-textarea" rows="3" maxlength="2000" placeholder="Descrie serviciile, prețurile, programul... orice informații ne ajută."></textarea>
          </div>
          <div class="form-group" style="margin-bottom: 16px;">
            <label class="form-label">Fișiere atașate (opțional, max 5)</label>
            <p style="font-size: 12px; color: var(--text-tertiary); margin: 2px 0 8px;">PDF, imagini cu meniul, lista de prețuri, etc.</p>
            <input type="file" id="concierge-files" multiple accept=".pdf,image/jpeg,image/png,image/webp" style="font-size: 14px;">
          </div>
          <div style="display: flex; gap: 8px; justify-content: flex-end;">
            <button class="btn btn-secondary" onclick="concierge_close()">Anulează</button>
            <button class="btn btn-primary" id="concierge-submit-btn" onclick="concierge_submit()">Trimite cererea</button>
          </div>
        </div>
      </div>
    </div>
  </div>

</div><!-- /portal-page -->

<%- include('../partials/footer') %>

<script>
(function() {
  var businessId = '<%= business.id %>';
  var currentPeriod = 30;
  var currentViewsMode = 'business';
  var currentClicksAction = 'phone';

  // Server-side tier info for immediate UI gating
  var _serverTier = <%- JSON.stringify({
    tier: tier ? tier.tier : 'free',
    plan: tier && tier.plan ? {
      canUploadLogo: !!tier.plan.can_upload_logo,
      canUploadCover: !!tier.plan.can_upload_cover,
      maxGalleryImages: tier.plan.max_gallery_images,
      maxLocations: tier.plan.max_locations,
      maxActiveOffers: tier.plan.max_active_offers,
      hasBooking: !!tier.plan.has_booking,
      hasAnalyticsCharts: !!tier.plan.has_analytics_charts,
      canRespondReviews: !!tier.plan.can_respond_reviews,
      hasAiSummary: !!tier.plan.has_ai_summary,
      analyticsDays: tier.plan.analytics_days || 7,
      hasConcierge: !!tier.plan.has_concierge,
    } : {}
  }).replace(/<\//g, '<\\/') %>;

  /* ── Toast ── */
  function showToast(message, type) {
    var existing = document.querySelector('.pm-toast');
    if (existing) existing.remove();
    var t = document.createElement('div');
    t.className = 'pm-toast ' + (type || 'success');
    t.textContent = message;
    document.body.appendChild(t);
    setTimeout(function() { if (t.parentNode) t.remove(); }, 3000);
  }

  /* ── Handle 403 upgrade-required errors ── */
  function handleUpgradeError(response) {
    if (response.status === 403) {
      return response.clone().json().then(function(data) {
        if (data.error === 'upgrade_required' || data.error === 'limit_reached') {
          showToast(data.message + ' Upgrade din tab-ul Abonament.', 'error');
        }
      }).catch(function() {});
    }
  }

  /* ── Auth-aware fetch with CSRF ── */
  function apiFetch(url, options) {
    var csrfToken = document.querySelector('meta[name="csrf-token"]');
    options = options || {};
    options.headers = options.headers || {};

    // Add CSRF token to headers (unless it's FormData, which can't have custom headers easily)
    if (!(options.body instanceof FormData)) {
      if (typeof options.headers === 'object' && !Array.isArray(options.headers)) {
        options.headers['X-CSRF-Token'] = csrfToken ? csrfToken.getAttribute('content') : '';
        // Auto-set Content-Type for JSON bodies
        if (typeof options.body === 'string' && !options.headers['Content-Type']) {
          options.headers['Content-Type'] = 'application/json';
        }
      }
    } else {
      // For FormData, we need to set headers differently
      var newHeaders = new Headers(options.headers);
      newHeaders.set('X-CSRF-Token', csrfToken ? csrfToken.getAttribute('content') : '');
      options.headers = newHeaders;
    }

    return fetch(url, options).then(function(res) {
      if (res.status === 401) {
        window.location.href = '/login';
        throw new Error('Unauthorized');
      }
      if (res.status === 403) {
        handleUpgradeError(res);
      }
      return res;
    });
  }

  /* ════════════════════════════════
     IMAGE UPLOAD / DELETE
     ════════════════════════════════ */
  window.uploadImage = function(type, input) {
    var file = input.files && input.files[0];
    if (!file) return;

    // Validate file size (max 5MB)
    if (file.size > 5 * 1024 * 1024) {
      showToast('Imaginea nu poate depăși 5MB', 'error');
      input.value = '';
      return;
    }

    var formData = new FormData();
    formData.append(type, file);

    var previewBox = document.getElementById(type + '-preview');
    previewBox.style.opacity = '0.5';

    apiFetch('/api/web/portal/' + businessId + '/' + type, {
      method: 'POST',
      body: formData
    })
    .then(function(res) { return res.json(); })
    .then(function(data) {
      previewBox.style.opacity = '1';
      if (data.url) {
        // Update preview image
        var existingImg = document.getElementById(type + '-img');
        var placeholder = document.getElementById(type + '-placeholder');

        if (existingImg) {
          existingImg.src = data.url;
        } else {
          // Create new img element
          var img = document.createElement('img');
          img.src = data.url;
          img.alt = type === 'logo' ? 'Logo' : 'Cover';
          img.id = type + '-img';
          previewBox.innerHTML = '';
          previewBox.appendChild(img);
        }

        // Show delete button if hidden
        var btnContainer = previewBox.parentNode.querySelector('div[style*="display: flex"]');
        if (btnContainer && !btnContainer.querySelector('.danger')) {
          var delBtn = document.createElement('button');
          delBtn.type = 'button';
          delBtn.className = 'btn-sm danger';
          delBtn.onclick = function() { deleteImage(type); };
          delBtn.innerHTML = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg> Șterge';
          btnContainer.appendChild(delBtn);
        }

        showToast(type === 'logo' ? 'Logo actualizat' : 'Copertă actualizată', 'success');
      } else {
        showToast(data.message || 'Eroare la încărcare', 'error');
      }
    })
    .catch(function() {
      previewBox.style.opacity = '1';
      showToast('Eroare la încărcarea imaginii', 'error');
    });

    input.value = '';
  };

  window.deleteImage = function(type) {
    if (!confirm('Sigur vrei să ștergi această imagine?')) return;

    var previewBox = document.getElementById(type + '-preview');
    previewBox.style.opacity = '0.5';

    apiFetch('/api/web/portal/' + businessId + '/' + type, {
      method: 'DELETE'
    })
    .then(function(res) { return res.json(); })
    .then(function(data) {
      previewBox.style.opacity = '1';
      if (data.success) {
        // Replace with placeholder
        var placeholderText = type === 'logo' ? 'Fără logo' : 'Fără copertă';
        previewBox.innerHTML = '<div class="img-preview-placeholder" id="' + type + '-placeholder">' +
          '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>' +
          placeholderText + '</div>';

        // Remove delete button
        var btnContainer = previewBox.parentNode.querySelector('div[style*="display: flex"]');
        if (btnContainer) {
          var delBtn = btnContainer.querySelector('.danger');
          if (delBtn) delBtn.remove();
        }

        showToast('Imaginea a fost ștearsă', 'success');
      } else {
        showToast(data.message || 'Eroare la ștergere', 'error');
      }
    })
    .catch(function() {
      previewBox.style.opacity = '1';
      showToast('Eroare la ștergerea imaginii', 'error');
    });
  };

  /* ════════════════════════════════
     GALLERY UPLOAD / DELETE
     ════════════════════════════════ */
  window.uploadGalleryImages = function(input) {
    var files = input.files;
    if (!files || !files.length) return;

    var grid = document.getElementById('gallery-grid');
    var currentCount = grid.querySelectorAll('.gallery-upload-item').length;

    // Check total limit (tier-based; null = unlimited for Premium)
    var galleryLimit = <%= tier && tier.plan && tier.plan.max_gallery_images != null ? tier.plan.max_gallery_images : 'null' %>;
    if (galleryLimit !== null && currentCount + files.length > galleryLimit) {
      showToast('Maximum ' + galleryLimit + ' imagini. Poți adăuga încă ' + (galleryLimit - currentCount) + '.', 'error');
      input.value = '';
      return;
    }

    var addBtn = document.getElementById('gallery-add-btn');

    Array.from(files).forEach(function(file) {
      // Validate size
      if (file.size > 5 * 1024 * 1024) {
        showToast('Fișierul "' + file.name + '" depășește 5MB', 'error');
        return;
      }

      var formData = new FormData();
      formData.append('image', file);

      // Create temporary loading placeholder
      var placeholder = document.createElement('div');
      placeholder.className = 'gallery-upload-item';
      placeholder.style.opacity = '0.5';
      placeholder.innerHTML = '<div style="display:flex;align-items:center;justify-content:center;width:100%;height:100%;color:var(--text-secondary);font-size:0.75rem;">Se încarcă...</div>';
      if (addBtn) grid.insertBefore(placeholder, addBtn);
      else grid.appendChild(placeholder);

      apiFetch('/api/web/portal/' + businessId + '/gallery', {
        method: 'POST',
        body: formData
      })
      .then(function(res) { return res.json(); })
      .then(function(data) {
        if (data.success && data.image) {
          placeholder.style.opacity = '1';
          placeholder.setAttribute('data-image-id', data.image.id);
          var img = document.createElement('img');
          img.src = data.image.url;
          img.alt = 'Galerie';
          img.width = 120;
          img.height = 80;
          img.loading = 'lazy';
          var btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'gallery-delete-btn';
          btn.title = 'Șterge imaginea';
          btn.setAttribute('aria-label', 'Șterge imaginea');
          btn.innerHTML = '&times;';
          btn.onclick = function() { deleteGalleryImage(data.image.id, this); };
          placeholder.innerHTML = '';
          placeholder.appendChild(img);
          placeholder.appendChild(btn);

          currentCount++;
          // Hide add button if at limit
          var galleryLimit = _serverTier && _serverTier.plan ? _serverTier.plan.maxGalleryImages : 8;
          if (galleryLimit !== null && currentCount >= galleryLimit && addBtn) {
            addBtn.style.display = 'none';
          }

          showToast('Imagine adăugată cu succes', 'success');
        } else {
          placeholder.remove();
          showToast(data.message || 'Eroare la încărcare', 'error');
        }
      })
      .catch(function() {
        placeholder.remove();
        showToast('Eroare la încărcarea imaginii', 'error');
      });
    });

    input.value = '';
  };

  window.deleteGalleryImage = function(imageId, btn) {
    if (!confirm('Sigur vrei să ștergi această imagine din galerie?')) return;

    var item = btn.closest('.gallery-upload-item');
    if (item) item.style.opacity = '0.5';

    apiFetch('/api/web/portal/' + businessId + '/gallery/' + imageId, {
      method: 'DELETE'
    })
    .then(function(res) { return res.json(); })
    .then(function(data) {
      if (data.success) {
        if (item) item.remove();

        // Show add button if was hidden
        var addBtn = document.getElementById('gallery-add-btn');
        if (addBtn) addBtn.style.display = '';

        showToast('Imaginea a fost ștearsă din galerie', 'success');
      } else {
        if (item) item.style.opacity = '1';
        showToast(data.message || 'Eroare la ștergere', 'error');
      }
    })
    .catch(function() {
      if (item) item.style.opacity = '1';
      showToast('Eroare la ștergerea imaginii', 'error');
    });
  };

  /* ════════════════════════════════
     LOCATION MANAGEMENT
     ════════════════════════════════ */

  window.loc_showAddForm = function() {
    document.getElementById('loc-add-form').style.display = '';
  };

  window.loc_hideAddForm = function() {
    var form = document.getElementById('loc-add-form');
    form.style.display = 'none';
    // Reset fields
    document.getElementById('loc-add-address').value = '';
    document.getElementById('loc-add-city').value = '';
    document.getElementById('loc-add-phone').value = '';
    document.getElementById('loc-add-maps-url').value = '';
    document.getElementById('loc-add-lat').value = '';
    document.getElementById('loc-add-lng').value = '';
  };

  window.loc_detectCoords = function(locIdOrAdd) {
    var mapsInput, latInput, lngInput;
    if (locIdOrAdd === 'add') {
      mapsInput = document.getElementById('loc-add-maps-url');
      latInput = document.getElementById('loc-add-lat');
      lngInput = document.getElementById('loc-add-lng');
    } else {
      var card = document.getElementById('loc-card-' + locIdOrAdd);
      mapsInput = card.querySelector('.loc-maps-url');
      latInput = card.querySelector('.loc-lat');
      lngInput = card.querySelector('.loc-lng');
    }

    var url = mapsInput.value.trim();
    if (!url) {
      showToast('Introdu un link Google Maps', 'error');
      return;
    }

    showToast('Se detectează coordonatele...', 'info');

    apiFetch('/api/web/parse-maps-link', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ url: url })
    })
    .then(function(res) { return res.json(); })
    .then(function(data) {
      if (data.error) {
        showToast(data.error, 'error');
        return;
      }
      latInput.value = data.lat;
      lngInput.value = data.lng;
      if (data.mapsUrl) mapsInput.value = data.mapsUrl;
      showToast('Coordonate detectate!', 'success');
    })
    .catch(function() {
      showToast('Eroare la detectarea coordonatelor', 'error');
    });
  };

  window.loc_create = function() {
    var address = document.getElementById('loc-add-address').value.trim();
    var cityId = document.getElementById('loc-add-city').value;
    var phone = document.getElementById('loc-add-phone').value.trim();
    var mapsUrl = document.getElementById('loc-add-maps-url').value.trim();
    var lat = document.getElementById('loc-add-lat').value.trim();
    var lng = document.getElementById('loc-add-lng').value.trim();

    if (!address || !cityId) {
      showToast('Adresa și orașul sunt obligatorii', 'error');
      return;
    }

    apiFetch('/api/web/portal/' + businessId + '/locations', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ address: address, city_id: cityId, phone: phone, maps_url: mapsUrl, lat: lat, lng: lng })
    })
    .then(function(res) { return res.json(); })
    .then(function(data) {
      if (data.success) {
        showToast(data.message || 'Locație adăugată!', 'success');
        // Reload page to refresh location list and counters
        setTimeout(function() { window.location.reload(); }, 500);
      } else {
        showToast(data.message || 'Eroare la adăugare', 'error');
      }
    })
    .catch(function() {
      showToast('Eroare la adăugarea locației', 'error');
    });
  };

  window.loc_update = function(locId) {
    var card = document.getElementById('loc-card-' + locId);
    var address = card.querySelector('.loc-address').value.trim();
    var cityId = card.querySelector('.loc-city').value;
    var phone = card.querySelector('.loc-phone').value.trim();
    var mapsUrl = card.querySelector('.loc-maps-url').value.trim();
    var lat = card.querySelector('.loc-lat').value.trim();
    var lng = card.querySelector('.loc-lng').value.trim();

    if (!address || !cityId) {
      showToast('Adresa și orașul sunt obligatorii', 'error');
      return;
    }

    apiFetch('/api/web/portal/' + businessId + '/locations/' + locId, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ address: address, city_id: cityId, phone: phone, maps_url: mapsUrl, lat: lat, lng: lng })
    })
    .then(function(res) { return res.json(); })
    .then(function(data) {
      if (data.success) {
        showToast(data.message || 'Locație actualizată!', 'success');
      } else {
        showToast(data.message || 'Eroare la actualizare', 'error');
      }
    })
    .catch(function() {
      showToast('Eroare la actualizarea locației', 'error');
    });
  };

  window.loc_delete = function(locId) {
    if (!confirm('Sigur vrei să ștergi această locație? Ofertele asociate vor fi actualizate.')) return;

    var card = document.getElementById('loc-card-' + locId);
    if (card) card.style.opacity = '0.5';

    apiFetch('/api/web/portal/' + businessId + '/locations/' + locId, {
      method: 'DELETE'
    })
    .then(function(res) { return res.json(); })
    .then(function(data) {
      if (data.success) {
        if (card) card.remove();
        showToast(data.message || 'Locație ștearsă!', data.affectedOffers > 0 ? 'info' : 'success');
        // If no more locations, show empty state
        var list = document.getElementById('loc-list');
        if (list && !list.querySelector('.loc-card')) {
          list.innerHTML = '<div id="loc-empty" style="text-align: center; padding: 24px; color: var(--text-secondary); font-size: 0.875rem;">' +
            '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin-bottom: 8px; opacity: 0.5;"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>' +
            '<p>Nicio locație adăugată.</p></div>';
        }
      } else {
        if (card) card.style.opacity = '1';
        showToast(data.message || 'Eroare la ștergere', 'error');
      }
    })
    .catch(function() {
      if (card) card.style.opacity = '1';
      showToast('Eroare la ștergerea locației', 'error');
    });
  };

  /* ════════════════════════════════
     OPENING HOURS — per-location
     ════════════════════════════════ */
  var HRS_DAY_NAMES = ['Luni', 'Marți', 'Miercuri', 'Joi', 'Vineri', 'Sâmbătă', 'Duminică'];
  var _hrsLoaded = {};

  // Build <option> tags for 24h time select (30-min steps)
  function hrs_timeOpts(sel, isClose) {
    var opts = '';
    var matched = false;
    for (var h = 0; h < 24; h++) {
      for (var m = 0; m < 60; m += 30) {
        var hh = (h < 10 ? '0' : '') + h;
        var mm = (m < 10 ? '0' : '') + m;
        var val = hh + ':' + mm;
        // Skip 00:00 in the normal loop for close selects (added at end as midnight)
        if (isClose && val === '00:00') continue;
        if (val === sel) matched = true;
        opts += '<option value="' + val + '"' + (val === sel ? ' selected' : '') + '>' + val + '</option>';
      }
    }
    // Close select: add 00:00 at end as "midnight" option
    if (isClose) {
      var midSel = (sel === '00:00');
      if (midSel) matched = true;
      opts += '<option value="00:00"' + (midSel ? ' selected' : '') + '>00:00 (miezul nopții)</option>';
    }
    // If saved value doesn't match a 30-min slot, add it as first option
    if (!matched && sel) {
      opts = '<option value="' + sel + '" selected>' + sel + '</option>' + opts;
    }
    return opts;
  }

  window.hrs_toggle = function(locId) {
    var panel = document.getElementById('hrs-panel-' + locId);
    if (!panel) return;
    if (panel.style.display === 'none') {
      panel.style.display = 'block';
      if (!_hrsLoaded[locId]) hrs_load(locId); // fetch only on first expand
    } else {
      panel.style.display = 'none';
    }
  };

  function hrs_load(locId) {
    var grid = document.getElementById('hrs-grid-' + locId);
    if (!grid) return;
    grid.innerHTML = '<p style="font-size:0.8125rem;color:var(--text-tertiary);">Se încarcă...</p>';

    apiFetch('/api/web/portal/' + businessId + '/locations/' + locId + '/hours')
    .then(function(r) { return r.json(); })
    .then(function(data) {
      var hours = data.hours || [];
      var html = '';
      for (var i = 0; i < 7; i++) {
        var h = hours.find(function(x) { return parseInt(x.day_of_week) === i; }) || { day_of_week: i, open_time: '09:00', close_time: '18:00', is_closed: false };
        var closed = !!h.is_closed;
        html += '<div class="hrs-day-row" data-day="' + i + '" style="display: grid; grid-template-columns: 90px 1fr 80px; gap: 8px; align-items: center;">';
        html += '<span style="font-size:0.8125rem;color:var(--text-primary);font-weight:500;">' + HRS_DAY_NAMES[i] + '</span>';
        // Time inputs wrapper — hidden when closed
        html += '<span class="hrs-times" style="display:' + (closed ? 'none' : 'grid') + '; grid-template-columns: 1fr 12px 1fr; gap: 8px; align-items: center;">';
        html += '<select class="form-select hrs-open" data-day="' + i + '" style="font-size:0.8125rem;padding:6px 8px;">' + hrs_timeOpts(h.open_time || '09:00', false) + '</select>';
        html += '<span style="color:var(--text-tertiary);text-align:center;">–</span>';
        html += '<select class="form-select hrs-close" data-day="' + i + '" style="font-size:0.8125rem;padding:6px 8px;">' + hrs_timeOpts(h.close_time || '18:00', true) + '</select>';
        html += '</span>';
        // "Închis" label — visible when closed
        html += '<span class="hrs-closed-label" style="display:' + (closed ? '' : 'none') + '; font-size:0.8125rem; color:var(--text-tertiary); font-style:italic;">Închis</span>';
        // Checkbox
        html += '<label style="display:flex;align-items:center;gap:4px;font-size:0.75rem;color:var(--text-secondary);cursor:pointer;justify-self:end;">';
        html += '<input type="checkbox" class="hrs-closed" data-day="' + i + '" ' + (closed ? 'checked' : '') + ' onchange="hrs_toggleClosed(this,' + locId + ',' + i + ')"> Închis</label>';
        html += '</div>';
      }
      grid.innerHTML = html;
      _hrsLoaded[locId] = true;
      hrs_updateStatus(locId, hours);
    })
    .catch(function() {
      grid.innerHTML = '<p style="font-size:0.8125rem;color:#ef4444;">Eroare la încărcarea programului</p>';
    });
  }

  window.hrs_toggleClosed = function(checkbox, locId, day) {
    var row = checkbox.closest('.hrs-day-row');
    if (!row) return;
    var times = row.querySelector('.hrs-times');
    var label = row.querySelector('.hrs-closed-label');
    if (times) times.style.display = checkbox.checked ? 'none' : 'grid';
    if (label) label.style.display = checkbox.checked ? '' : 'none';
    // Update status badge from current DOM state
    hrs_updateStatusFromDOM(locId);
  };

  // Read current hours state from DOM inputs (no server call)
  function hrs_updateStatusFromDOM(locId) {
    var panel = document.getElementById('hrs-panel-' + locId);
    if (!panel) return;
    var hours = [];
    for (var d = 0; d < 7; d++) {
      var closed = panel.querySelector('.hrs-closed[data-day="' + d + '"]');
      var openI = panel.querySelector('.hrs-open[data-day="' + d + '"]');
      var closeI = panel.querySelector('.hrs-close[data-day="' + d + '"]');
      hours.push({
        day_of_week: d,
        is_closed: closed ? closed.checked : false,
        open_time: openI ? openI.value : null,
        close_time: closeI ? closeI.value : null,
      });
    }
    hrs_updateStatus(locId, hours);
  }

  window.hrs_save = function(locId) {
    var panel = document.getElementById('hrs-panel-' + locId);
    if (!panel) return;
    var hours = [];
    for (var d = 0; d < 7; d++) {
      var isClosed = panel.querySelector('.hrs-closed[data-day="' + d + '"]');
      var openInput = panel.querySelector('.hrs-open[data-day="' + d + '"]');
      var closeInput = panel.querySelector('.hrs-close[data-day="' + d + '"]');
      hours.push({
        day_of_week: d,
        open_time: isClosed && isClosed.checked ? null : (openInput ? openInput.value : null),
        close_time: isClosed && isClosed.checked ? null : (closeInput ? closeInput.value : null),
        is_closed: isClosed ? isClosed.checked : false,
      });
    }

    apiFetch('/api/web/portal/' + businessId + '/locations/' + locId + '/hours', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ hours: hours }),
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
      if (data.success) {
        showToast(data.message || 'Program salvat!', 'success');
        hrs_updateStatus(locId, hours);
      } else {
        showToast(data.message || 'Eroare', 'error');
      }
    })
    .catch(function() { showToast('Eroare la salvarea programului', 'error'); });
  };

  window.hrs_copyAll = function(locId) {
    if (!confirm('Copiezi programul acestei locații la toate celelalte locații?')) return;
    apiFetch('/api/web/portal/' + businessId + '/locations/' + locId + '/hours/copy-all', { method: 'POST' })
    .then(function(r) { return r.json(); })
    .then(function(data) {
      if (data.success) showToast(data.message, 'success');
      else showToast(data.message || 'Eroare', 'error');
    })
    .catch(function() { showToast('Eroare la copiere', 'error'); });
  };

  function hrs_updateStatus(locId, hours) {
    var statusEl = document.getElementById('hrs-status-' + locId);
    if (!statusEl || !hours || hours.length === 0) return;
    var now = new Date();
    var jsDay = now.getDay(); // 0=Sun
    var todayIdx = (jsDay + 6) % 7; // 0=Mon
    var today = hours.find(function(h) { return parseInt(h.day_of_week) === todayIdx; });
    if (!today || today.is_closed) {
      statusEl.textContent = 'Închis acum';
      statusEl.style.background = 'rgba(239,68,68,0.1)';
      statusEl.style.color = '#ef4444';
      return;
    }
    if (today.open_time && today.close_time) {
      var hm = now.getHours() * 60 + now.getMinutes();
      var op = today.open_time.split(':');
      var cl = today.close_time.split(':');
      var openMin = parseInt(op[0]) * 60 + parseInt(op[1]);
      var closeMin = parseInt(cl[0]) * 60 + parseInt(cl[1]);
      if (closeMin === 0) closeMin = 1440; // 00:00 = midnight = end of day
      if (hm >= openMin && hm < closeMin) {
        statusEl.textContent = 'Deschis acum';
        statusEl.style.background = 'rgba(34,197,94,0.1)';
        statusEl.style.color = '#22c55e';
      } else {
        statusEl.textContent = 'Închis acum';
        statusEl.style.background = 'rgba(239,68,68,0.1)';
        statusEl.style.color = '#ef4444';
      }
    }
  }

  /* ════════════════════════════════
     CATALOG MANAGEMENT
     ════════════════════════════════ */
  var _catalogLoaded = false;
  var _catalogCategories = [];
  var _catalogItems = [];
  var _csvPreview = [];

  // Type display labels
  var TYPE_LABELS = { service: 'Serviciu', product: 'Produs', menu_item: 'Meniu' };

  function catalog_load() {
    if (_catalogLoaded) return;
    _catalogLoaded = true;
    var container = document.getElementById('catalog-container');
    container.innerHTML = '<div style="text-align:center;padding:30px;"><div class="spinner"></div></div>';

    Promise.all([
      apiFetch('/api/web/portal/' + businessId + '/catalog/categories').then(function(r) { return r.json(); }),
      apiFetch('/api/web/portal/' + businessId + '/catalog/items').then(function(r) { return r.json(); })
    ]).then(function(results) {
      _catalogCategories = results[0].categories || [];
      _catalogItems = results[1].items || [];
      catalog_render();
    }).catch(function() {
      container.innerHTML = '<p style="text-align:center;color:var(--text-secondary);padding:30px;">Eroare la încărcarea catalogului. Reîncearcă.</p>';
    });
  }

  function catalog_render() {
    var container = document.getElementById('catalog-container');
    if (_catalogCategories.length === 0 && _catalogItems.length === 0) {
      container.innerHTML = '<div class="catalog-empty">' +
        '<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>' +
        '<p style="margin:0 0 4px;font-weight:600;">Catalogul este gol</p>' +
        '<p style="margin:0;font-size:13px;">Adaugă o categorie și apoi articole, sau importă din CSV.</p></div>';
      return;
    }

    var html = '';
    // Group items by category
    var itemsByCat = {};
    var uncategorized = [];
    _catalogItems.forEach(function(item) {
      if (item.category_id) {
        if (!itemsByCat[item.category_id]) itemsByCat[item.category_id] = [];
        itemsByCat[item.category_id].push(item);
      } else {
        uncategorized.push(item);
      }
    });

    _catalogCategories.forEach(function(cat) {
      var catItems = itemsByCat[cat.id] || [];
      html += catalog_renderCategoryCard(cat, catItems);
    });

    if (uncategorized.length > 0) {
      html += catalog_renderCategoryCard({ id: null, name: 'Fără categorie' }, uncategorized);
    }

    html += '<div style="margin-top: 12px;"><button class="btn btn-secondary" onclick="catalog_openItemModal(null)">+ Articol nou</button></div>';
    container.innerHTML = html;
  }

  function catalog_renderCategoryCard(cat, items) {
    var isReal = cat.id !== null;
    var html = '<div class="catalog-cat-card">';
    html += '<div class="catalog-cat-header" onclick="this.parentElement.querySelector(\'.catalog-items-list\').style.display = this.parentElement.querySelector(\'.catalog-items-list\').style.display === \'none\' ? \'\' : \'none\'">';
    html += '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>';
    html += '<span class="catalog-cat-name">' + escapeHtml(cat.name) + '</span>';
    html += '<span class="catalog-cat-count">' + items.length + ' articol' + (items.length !== 1 ? 'e' : '') + '</span>';
    if (isReal) {
      html += '<span class="catalog-cat-actions" onclick="event.stopPropagation()">';
      html += '<button title="Redenumește" onclick="catalog_renameCategory(' + cat.id + ',\'' + escapeHtml(cat.name).replace(/'/g, "\\'") + '\')"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 3a2.85 2.85 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg></button>';
      html += '<button class="catalog-del" title="Șterge" onclick="catalog_deleteCategory(' + cat.id + ')"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg></button>';
      html += '</span>';
    }
    html += '</div>';
    html += '<div class="catalog-items-list">';
    items.forEach(function(item) {
      html += '<div class="catalog-item-row">';
      html += '<span class="catalog-item-type-badge ' + item.type + '">' + (TYPE_LABELS[item.type] || item.type) + '</span>';
      html += '<span class="catalog-item-name">' + escapeHtml(item.name) + '</span>';
      if (item.duration_minutes) html += '<span class="catalog-item-dur">' + item.duration_minutes + ' min</span>';
      html += '<span class="catalog-item-price">' + (item.price_display || 'La cerere') + '</span>';
      html += '<span class="catalog-item-actions">';
      html += '<button title="Editează" onclick="catalog_openItemModal(' + item.id + ')"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 3a2.85 2.85 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg></button>';
      html += '<button class="catalog-del" title="Șterge" onclick="catalog_deleteItem(' + item.id + ')"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg></button>';
      html += '</span>';
      html += '</div>';
    });
    if (isReal) {
      html += '<div style="padding: 6px 12px;"><button class="btn btn-secondary" style="font-size: 12px; padding: 4px 12px;" onclick="catalog_openItemModal(null, ' + cat.id + ')">+ Articol</button></div>';
    }
    html += '</div></div>';
    return html;
  }

  // Escape HTML helper
  function escapeHtml(str) {
    var div = document.createElement('div');
    div.appendChild(document.createTextNode(str || ''));
    return div.innerHTML;
  }

  window.catalog_addCategory = function() {
    var name = prompt('Numele categoriei noi:');
    if (!name || !name.trim()) return;
    apiFetch('/api/web/portal/' + businessId + '/catalog/categories', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name: name.trim() })
    }).then(function(r) { return r.json(); }).then(function(data) {
      if (data.success) {
        _catalogCategories.push(data.category);
        catalog_render();
      } else {
        alert(data.message || 'Eroare');
      }
    });
  };

  window.catalog_renameCategory = function(catId, currentName) {
    var name = prompt('Noul nume:', currentName);
    if (!name || !name.trim() || name.trim() === currentName) return;
    apiFetch('/api/web/portal/' + businessId + '/catalog/categories/' + catId, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name: name.trim() })
    }).then(function(r) { return r.json(); }).then(function(data) {
      if (data.success) {
        var cat = _catalogCategories.find(function(c) { return c.id === catId; });
        if (cat) cat.name = name.trim();
        catalog_render();
      }
    });
  };

  window.catalog_deleteCategory = function(catId) {
    if (!confirm('Sigur dorești să ștergi această categorie? Articolele rămân fără categorie.')) return;
    apiFetch('/api/web/portal/' + businessId + '/catalog/categories/' + catId, { method: 'DELETE' })
    .then(function(r) { return r.json(); }).then(function(data) {
      if (data.success) {
        _catalogCategories = _catalogCategories.filter(function(c) { return c.id !== catId; });
        _catalogItems.forEach(function(item) { if (item.category_id === catId) item.category_id = null; });
        catalog_render();
      }
    });
  };

  window.catalog_openItemModal = function(itemId, presetCatId) {
    var modal = document.getElementById('catalog-item-modal');
    var title = document.getElementById('catalog-item-modal-title');
    var catSelect = document.getElementById('catalog-item-category');

    // Populate category select
    catSelect.innerHTML = '<option value="">— Fără categorie —</option>';
    _catalogCategories.forEach(function(c) {
      catSelect.innerHTML += '<option value="' + c.id + '">' + escapeHtml(c.name) + '</option>';
    });

    if (itemId) {
      var item = _catalogItems.find(function(i) { return i.id === itemId; });
      if (!item) return;
      title.textContent = 'Editează articol';
      document.getElementById('catalog-item-id').value = itemId;
      document.getElementById('catalog-item-name').value = item.name;
      document.getElementById('catalog-item-type').value = item.type;
      catSelect.value = item.category_id || '';
      document.getElementById('catalog-item-price').value = item.price != null ? (item.price / 100).toFixed(2) : '';
      document.getElementById('catalog-item-duration').value = item.duration_minutes || '';
      document.getElementById('catalog-item-price-label').value = item.price_label || '';
      document.getElementById('catalog-item-desc').value = item.description || '';
    } else {
      title.textContent = 'Articol nou';
      document.getElementById('catalog-item-id').value = '';
      document.getElementById('catalog-item-name').value = '';
      document.getElementById('catalog-item-type').value = 'service';
      catSelect.value = presetCatId || '';
      document.getElementById('catalog-item-price').value = '';
      document.getElementById('catalog-item-duration').value = '';
      document.getElementById('catalog-item-price-label').value = '';
      document.getElementById('catalog-item-desc').value = '';
    }
    modal.style.display = 'flex';
  };

  window.catalog_closeItemModal = function() {
    document.getElementById('catalog-item-modal').style.display = 'none';
  };

  window.catalog_saveItem = function() {
    var itemId = document.getElementById('catalog-item-id').value;
    var payload = {
      name: document.getElementById('catalog-item-name').value,
      type: document.getElementById('catalog-item-type').value,
      category_id: document.getElementById('catalog-item-category').value || null,
      price: document.getElementById('catalog-item-price').value || null,
      duration_minutes: document.getElementById('catalog-item-duration').value || null,
      price_label: document.getElementById('catalog-item-price-label').value || null,
      description: document.getElementById('catalog-item-desc').value || null,
    };

    var url = '/api/web/portal/' + businessId + '/catalog/items' + (itemId ? '/' + itemId : '');
    var method = itemId ? 'PUT' : 'POST';

    apiFetch(url, {
      method: method,
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    }).then(function(r) { return r.json(); }).then(function(data) {
      if (data.success) {
        catalog_closeItemModal();
        // Refresh items
        _catalogLoaded = false;
        catalog_load();
      } else {
        alert(data.message || 'Eroare');
      }
    });
  };

  window.catalog_deleteItem = function(itemId) {
    if (!confirm('Sigur dorești să ștergi acest articol?')) return;
    apiFetch('/api/web/portal/' + businessId + '/catalog/items/' + itemId, { method: 'DELETE' })
    .then(function(r) { return r.json(); }).then(function(data) {
      if (data.success) {
        _catalogItems = _catalogItems.filter(function(i) { return i.id !== itemId; });
        catalog_render();
      }
    });
  };

  // CSV Import
  window.catalog_showCsvModal = function() {
    document.getElementById('catalog-csv-modal').style.display = 'flex';
    document.getElementById('csv-step-upload').style.display = '';
    document.getElementById('csv-step-preview').style.display = 'none';
  };
  window.catalog_closeCsvModal = function() {
    document.getElementById('catalog-csv-modal').style.display = 'none';
  };

  window.catalog_uploadCsv = function(file) {
    if (!file) return;
    var formData = new FormData();
    formData.append('csv', file);
    apiFetch('/api/web/portal/' + businessId + '/catalog/import-csv', {
      method: 'POST',
      body: formData
    }).then(function(r) { return r.json(); }).then(function(data) {
      if (!data.success) { alert(data.message || 'Eroare la procesare'); return; }
      _csvPreview = data.preview || [];

      // Show errors
      var errDiv = document.getElementById('csv-errors');
      if (data.errors && data.errors.length > 0) {
        errDiv.style.display = '';
        errDiv.innerHTML = data.errors.join('<br>');
      } else {
        errDiv.style.display = 'none';
      }

      // Build preview table
      var tableHtml = '<table style="width:100%;font-size:13px;border-collapse:collapse;">' +
        '<thead><tr style="border-bottom:1px solid var(--border);"><th style="text-align:left;padding:6px;">Nume</th><th>Tip</th><th>Categorie</th><th style="text-align:right;">Preț</th></tr></thead><tbody>';
      _csvPreview.forEach(function(item) {
        tableHtml += '<tr style="border-bottom:1px solid rgba(255,255,255,0.04);">';
        tableHtml += '<td style="padding:6px;">' + escapeHtml(item.name) + '</td>';
        tableHtml += '<td style="padding:6px;text-align:center;">' + (TYPE_LABELS[item.type] || item.type) + '</td>';
        tableHtml += '<td style="padding:6px;">' + escapeHtml(item.category || '—') + '</td>';
        tableHtml += '<td style="padding:6px;text-align:right;">' + (item.price != null ? (item.price / 100).toFixed(2) + ' RON' : '—') + '</td>';
        tableHtml += '</tr>';
      });
      tableHtml += '</tbody></table>';
      document.getElementById('csv-preview-table').innerHTML = tableHtml;

      document.getElementById('csv-step-upload').style.display = 'none';
      document.getElementById('csv-step-preview').style.display = '';
    }).catch(function(err) {
      alert('Eroare la upload: ' + (err.message || 'necunoscută'));
    });
  };

  window.catalog_csvBack = function() {
    document.getElementById('csv-step-upload').style.display = '';
    document.getElementById('csv-step-preview').style.display = 'none';
    document.getElementById('csv-file-input').value = '';
  };

  window.catalog_csvConfirm = function() {
    if (_csvPreview.length === 0) return;
    var btn = document.getElementById('csv-confirm-btn');
    btn.disabled = true;
    btn.textContent = 'Se importă...';

    apiFetch('/api/web/portal/' + businessId + '/catalog/import-csv/confirm', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ items: _csvPreview })
    }).then(function(r) { return r.json(); }).then(function(data) {
      btn.disabled = false;
      btn.textContent = 'Importă articolele';
      if (data.success) {
        catalog_closeCsvModal();
        _catalogLoaded = false;
        catalog_load();
        alert(data.message || 'Import reușit!');
      } else {
        alert(data.message || 'Eroare la import');
      }
    }).catch(function() {
      btn.disabled = false;
      btn.textContent = 'Importă articolele';
      alert('Eroare la import');
    });
  };

  // Drag-n-drop on CSV zone
  (function() {
    var zone = document.getElementById('csv-drop-zone');
    if (!zone) return;
    zone.addEventListener('dragover', function(e) { e.preventDefault(); zone.classList.add('dragover'); });
    zone.addEventListener('dragleave', function() { zone.classList.remove('dragover'); });
    zone.addEventListener('drop', function(e) {
      e.preventDefault();
      zone.classList.remove('dragover');
      if (e.dataTransfer.files.length > 0) catalog_uploadCsv(e.dataTransfer.files[0]);
    });
  })();

  /* ════════════════════════════════
     CONCIERGE ONBOARDING MODAL
     ════════════════════════════════ */
  var _conciergeChecked = false;

  window.concierge_open = function() {
    document.getElementById('concierge-modal').style.display = '';
    // Check for existing active request
    if (!_conciergeChecked) {
      apiFetch('/api/web/portal/' + businessId + '/onboarding/request').then(function(r) { return r.json(); })
        .then(function(data) {
          _conciergeChecked = true;
          if (data.request) {
            var typeLabels = { catalog: 'Catalog', hours: 'Program de lucru', full_setup: 'Setup complet' };
            var statusLabels = { pending: 'În așteptare', in_progress: 'În lucru' };
            document.getElementById('concierge-active-detail').textContent =
              (typeLabels[data.request.request_type] || data.request.request_type) +
              ' — ' + (statusLabels[data.request.status] || data.request.status) +
              ' (trimisă ' + new Date(data.request.created_at).toLocaleDateString('ro-RO') + ')';
            document.getElementById('concierge-active').style.display = '';
            document.getElementById('concierge-form').style.display = 'none';
          }
        }).catch(function() {});
    }
  };

  window.concierge_close = function() {
    document.getElementById('concierge-modal').style.display = 'none';
  };

  window.concierge_submit = function() {
    var type = document.getElementById('concierge-type').value;
    var message = document.getElementById('concierge-message').value.trim();
    var filesInput = document.getElementById('concierge-files');
    var files = filesInput.files;

    if (files.length > 5) {
      alert('Maxim 5 fișiere!');
      return;
    }

    var btn = document.getElementById('concierge-submit-btn');
    btn.disabled = true;
    btn.textContent = 'Se trimite...';

    var fd = new FormData();
    fd.append('request_type', type);
    if (message) fd.append('message', message);
    for (var i = 0; i < files.length; i++) {
      fd.append('attachments', files[i]);
    }

    apiFetch('/api/web/portal/' + businessId + '/onboarding/request', {
      method: 'POST',
      body: fd
    }).then(function(r) { return r.json(); }).then(function(data) {
      btn.disabled = false;
      btn.textContent = 'Trimite cererea';
      if (data.success) {
        alert('Cererea a fost trimisă! Vom reveni în maxim 48h.');
        _conciergeChecked = false;
        concierge_close();
      } else {
        alert(data.error || 'Eroare la trimitere');
      }
    }).catch(function(err) {
      btn.disabled = false;
      btn.textContent = 'Trimite cererea';
      alert('Eroare: ' + (err.message || 'necunoscută'));
    });
  };

  /* ════════════════════════════════
     SUBSCRIPTION MANAGEMENT
     ════════════════════════════════ */
  var _subscriptionLoaded = false;

  function loadSubscription() {
    apiFetch('/api/web/portal/' + businessId + '/subscription')
    .then(function(res) { return res.json(); })
    .then(function(data) {
      renderSubscriptionSection(data);
      applyTierGating(data);
    })
    .catch(function(err) {
      console.error('Load subscription error:', err);
      var c = document.getElementById('subscription-content');
      if (c) c.innerHTML = '<div class="glass-card" style="text-align: center; padding: 40px;"><p style="color: var(--text-tertiary);">Eroare la incarcarea informatiilor despre abonament.</p></div>';
    });
  }

  /**
   * Wraps a section in an upgrade overlay if the feature is not available
   */
  function gateSection(sectionId, hasAccess, featureName, requiredTier) {
    var section = document.getElementById(sectionId);
    if (!section) return;

    if (hasAccess) {
      var existing = section.querySelector('.tier-gate-overlay');
      if (existing) existing.remove();
      section.style.position = '';
      section.style.overflow = '';
      return;
    }

    section.style.position = 'relative';
    section.style.overflow = 'hidden';

    var overlay = document.createElement('div');
    overlay.className = 'tier-gate-overlay';
    overlay.innerHTML = '<div class="tier-gate-content">' +
      '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="' + (requiredTier === 'Premium' ? '#a78bfa' : '#fb923c') + '" stroke-width="1.5"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>' +
      '<p style="font-size: 0.9375rem; font-weight: 600; color: var(--text-primary); margin: 8px 0 4px;">' + featureName + '</p>' +
      '<p style="font-size: 0.8125rem; color: var(--text-tertiary); margin: 0 0 16px;">Disponibil cu planul ' + requiredTier + '+</p>' +
      '<a href="/pentru-business#preturi" style="display: inline-flex; align-items: center; gap: 6px; padding: 10px 24px; background: ' + (requiredTier === 'Premium' ? 'linear-gradient(135deg, #a78bfa, #8b5cf6)' : 'linear-gradient(135deg, #f97316, #fb923c)') + '; color: ' + (requiredTier === 'Premium' ? '#fff' : '#06060a') + '; border-radius: var(--radius-full); font-size: 0.875rem; font-weight: 600; text-decoration: none;">Upgrade &rarr;</a>' +
    '</div>';

    section.appendChild(overlay);
  }

  function applyTierGating(subscription) {
    var plan = subscription ? subscription.plan : {};

    // Images (logo + cover) — Standard+
    gateSection('images-upload-section', plan.canUploadLogo, 'Upload Imagini', 'Standard');

    // Gallery — limit enforced on backend, just show limit text
    var gallerySection = document.getElementById('gallery-section');
    if (gallerySection) {
      var maxImages = plan.maxGalleryImages;
      var limitP = gallerySection.querySelector('.section-title');
      if (limitP) {
        var galleryText = (maxImages === null || maxImages === undefined) ? 'nelimitat' : 'max ' + maxImages;
        limitP.innerHTML = 'Galerie foto <span style="font-size: 0.8rem; font-weight: 400; color: var(--text-tertiary);">(' + galleryText + ')</span>';
      }
    }

    // Booking — Standard+
    gateSection('booking-section', plan.hasBooking, 'Rezervari', 'Standard');

    // Analytics charts — Standard+
    gateSection('analytics-charts-section', plan.hasAnalyticsCharts, 'Grafice statistici', 'Standard');

    // Concierge onboarding — Standard+ (multiple elements via class)
    document.querySelectorAll('.concierge-section').forEach(function(el) {
      el.id = 'concierge-gate-' + Math.random().toString(36).slice(2, 6);
      gateSection(el.id, plan.hasConcierge, 'Concierge Onboarding', 'Standard');
    });
  }

  // Helper: escape HTML to prevent XSS in dynamic content
  function escapeHtml(text) {
    var el = document.createElement('span');
    el.textContent = text;
    return el.innerHTML;
  }

  function renderSubscriptionSection(subscription) {
    var container = document.getElementById('subscription-content');
    if (!container) return;

    var tier = subscription ? subscription.tier : 'free';
    var plan = subscription ? subscription.plan : { name: 'Gratuit', slug: 'free' };
    var isTrial = subscription ? subscription.isTrial : false;
    var trialEnd = subscription ? subscription.trialEnd : null;
    var periodEnd = subscription ? subscription.periodEnd : null;
    var cancelAtEnd = subscription ? subscription.cancelAtPeriodEnd : false;

    // Calculate trial days remaining
    var trialDaysLeft = 0;
    if (isTrial && trialEnd) {
      var diff = new Date(trialEnd) - new Date();
      trialDaysLeft = Math.max(0, Math.ceil(diff / (1000 * 60 * 60 * 24)));
    }

    // Tier color
    var tierColor = tier === 'premium' ? '#a78bfa' : (tier === 'standard' ? '#fb923c' : '#71717a');

    var html = '';

    // Current Plan Card
    html += '<div class="glass-card" style="border-color: ' + tierColor + '20;">';

    // Trial banner
    if (isTrial && trialDaysLeft > 0) {
      html += '<div style="background: rgba(251, 146, 60, 0.08); border: 1px solid rgba(251, 146, 60, 0.2); border-radius: var(--radius-md); padding: 12px 16px; margin-bottom: 20px; display: flex; align-items: center; gap: 10px;">';
      html += '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fb923c" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>';
      html += '<span style="color: #fb923c; font-size: 0.875rem; font-weight: 500;">Trial Standard: ' + trialDaysLeft + ' zile ramase</span>';
      html += '</div>';
    }

    // Expired trial banner
    if (isTrial && trialDaysLeft <= 0) {
      html += '<div style="background: rgba(239, 68, 68, 0.08); border: 1px solid rgba(239, 68, 68, 0.2); border-radius: var(--radius-md); padding: 12px 16px; margin-bottom: 20px; display: flex; align-items: center; gap: 10px;">';
      html += '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>';
      html += '<span style="color: #ef4444; font-size: 0.875rem; font-weight: 500;">Trial expirat &mdash; Upgrade acum pentru a pastra beneficiile</span>';
      html += '</div>';
    }

    // Plan header
    html += '<div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; flex-wrap: wrap; gap: 12px;">';
    html += '<div>';
    html += '<h3 style="font-size: 1.25rem; font-weight: 600; color: var(--text-primary); margin: 0;">Planul tau: <span style="color: ' + tierColor + ';">' + escapeHtml(plan.name) + '</span></h3>';
    if (cancelAtEnd && periodEnd) {
      html += '<p style="color: #ef4444; font-size: 0.8125rem; margin: 4px 0 0;">Se anuleaza la ' + new Date(periodEnd).toLocaleDateString('ro-RO') + '</p>';
    }
    html += '</div>';
    html += '<a href="/pentru-business#preturi" style="color: var(--accent); font-size: 0.875rem; text-decoration: none; font-weight: 500;">Vezi toate planurile &rarr;</a>';
    html += '</div>';

    // Plan features summary (compact)
    html += '<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 24px;">';
    var features = [
      { label: 'Oferte active', value: plan.maxActiveOffers === null ? 'Nelimitate' : plan.maxActiveOffers },
      { label: 'Imagini galerie', value: plan.maxGalleryImages === null ? 'Nelimitate' : plan.maxGalleryImages },
      { label: 'Locatii', value: plan.maxLocations === null ? 'Nelimitate' : plan.maxLocations },
      { label: 'Statistici', value: (plan.analyticsDays || 30) + ' zile' },
    ];
    features.forEach(function(f) {
      html += '<div style="background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-md); padding: 10px 14px;">';
      html += '<p style="font-size: 0.75rem; color: var(--text-tertiary); margin: 0 0 2px;">' + f.label + '</p>';
      html += '<p style="font-size: 0.9rem; font-weight: 600; color: var(--text-primary); margin: 0;">' + f.value + '</p>';
      html += '</div>';
    });
    html += '</div>';

    // Action buttons
    html += '<div style="display: flex; gap: 12px; flex-wrap: wrap;">';

    if (tier === 'free') {
      html += '<a href="/pentru-business#preturi" style="flex: 1; display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 12px 24px; background: linear-gradient(135deg, #f97316, #fb923c); color: #06060a; border-radius: var(--radius-full); font-size: 0.9rem; font-weight: 600; text-decoration: none; transition: opacity 0.2s;">Alege Standard</a>';
      html += '<a href="/pentru-business#preturi" style="flex: 1; display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 12px 24px; background: linear-gradient(135deg, #a78bfa, #8b5cf6); color: #fff; border-radius: var(--radius-full); font-size: 0.9rem; font-weight: 600; text-decoration: none; transition: opacity 0.2s;">Alege Premium</a>';
    } else if (tier === 'standard') {
      html += '<a href="/pentru-business#preturi" style="flex: 1; display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 12px 24px; background: linear-gradient(135deg, #a78bfa, #8b5cf6); color: #fff; border-radius: var(--radius-full); font-size: 0.9rem; font-weight: 600; text-decoration: none; transition: opacity 0.2s;">Upgrade la Premium</a>';
      if (!cancelAtEnd && !isTrial) {
        html += '<button onclick="handleCancelSubscription()" style="padding: 12px 24px; background: transparent; border: 1px solid var(--border); color: var(--text-tertiary); border-radius: var(--radius-full); font-size: 0.875rem; cursor: pointer; transition: all 0.2s;">Anuleaza abonament</button>';
      }
    } else if (tier === 'premium') {
      html += '<div style="background: rgba(167, 139, 250, 0.06); border: 1px solid rgba(167, 139, 250, 0.12); border-radius: var(--radius-md); padding: 14px 16px; flex: 1; text-align: center;">';
      html += '<p style="color: #a78bfa; font-size: 0.875rem; margin: 0;">Ai planul maxim! Bucura-te de toate beneficiile.</p>';
      html += '</div>';
      if (!cancelAtEnd) {
        html += '<button onclick="handleCancelSubscription()" style="padding: 12px 24px; background: transparent; border: 1px solid var(--border); color: var(--text-tertiary); border-radius: var(--radius-full); font-size: 0.875rem; cursor: pointer; transition: all 0.2s;">Anuleaza</button>';
      }
    }

    html += '</div>';
    html += '</div>';  // end glass-card

    container.innerHTML = html;
  }

  // Cancel subscription handler
  window.handleCancelSubscription = function() {
    if (!confirm('Esti sigur ca vrei sa anulezi abonamentul? Vei pastra beneficiile pana la sfarsitul perioadei platite.')) return;

    apiFetch('/api/web/portal/' + businessId + '/subscription/cancel', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
      if (data.success) {
        showToast('Abonamentul a fost anulat', 'success');
        loadSubscription();  // Refresh the section
      } else {
        showToast(data.message || 'Eroare', 'error');
      }
    })
    .catch(function(err) {
      console.error('Cancel error:', err);
      showToast('Eroare la anulare', 'error');
    });
  };

  /* ════════════════════════════════
     TAB SWITCHING
     ════════════════════════════════ */
  window.switchTab = function(tabName) {
    var panels = document.querySelectorAll('.tab-panel');
    var tabs = document.querySelectorAll('.portal-tab');
    panels.forEach(function(p) { p.classList.remove('active'); });
    tabs.forEach(function(t) { t.classList.remove('active'); });

    var panel = document.getElementById('tab-' + tabName);
    if (panel) panel.classList.add('active');

    // Find matching tab button
    var labels = { info: 'Info', oferte: 'Oferte', catalog: 'Catalog', recenzii: 'Recenzii', statistici: 'Statistici', support: 'Suport', subscription: 'Abonament' };
    tabs.forEach(function(t) {
      if (t.textContent.trim().indexOf(labels[tabName]) === 0) {
        t.classList.add('active');
      }
    });

    // Load charts on first stats tab visit
    if (tabName === 'statistici' && !window._chartsLoaded) {
      window._chartsLoaded = true;
      loadCharts(currentPeriod);
    }

    // Load competitive insights and push history on stats tab
    if (tabName === 'statistici') {
      if (typeof loadCompetitiveInsights === 'function') loadCompetitiveInsights();
      if (typeof loadPushHistory === 'function') loadPushHistory();
    }

    // Load catalog on first visit
    if (tabName === 'catalog') {
      catalog_load();
    }

    // Load subscription on first visit
    if (tabName === 'subscription' && !_subscriptionLoaded) {
      _subscriptionLoaded = true;
      loadSubscription();
    }

    // Update URL hash
    history.replaceState(null, '', '#' + tabName);
  };

  // Restore tab from hash on load
  (function() {
    var hash = window.location.hash.replace('#', '');
    if (['info', 'oferte', 'recenzii', 'statistici', 'support', 'subscription'].indexOf(hash) !== -1) {
      switchTab(hash);
    }
  })();

  // Apply tier gating immediately using server-side data
  applyTierGating(_serverTier);

  // Show toast if redirected from offer form
  (function() {
    var q = window.location.search;
    var msg = null;
    var type = 'success';
    if (q.indexOf('offer_pending=1') !== -1) {
      msg = 'Oferta ta a fost creată și este în curs de verificare. Va fi activată după aprobarea unui admin.';
      type = 'info';
    } else if (q.indexOf('offer_created=1') !== -1) {
      msg = 'Oferta a fost creată cu succes!';
    } else if (q.indexOf('offer_updated=1') !== -1) {
      msg = 'Oferta a fost actualizată!';
    } else if (q.indexOf('offer_deleted=1') !== -1) {
      msg = 'Oferta a fost ștearsă.';
      type = 'info';
    }
    if (msg) {
      showToast(msg, type);
      history.replaceState(null, '', window.location.pathname + window.location.hash);
    }
  })();

  /* ════════════════════════════════
     TAB 1: BUSINESS INFO FORM
     ════════════════════════════════ */
  window.selectBookingType = function(type) {
    document.getElementById('booking-type-input').value = type;
    var options = document.querySelectorAll('.booking-option');
    options.forEach(function(o) { o.classList.remove('active'); });
    // Activate clicked
    options.forEach(function(o) {
      var text = o.textContent.trim().toLowerCase();
      var map = { 'niciunul': 'none', 'telefon': 'phone', 'whatsapp': 'whatsapp', 'link': 'url' };
      if (map[text] === type) o.classList.add('active');
    });
    // Show/hide conditional fields
    var fields = ['phone', 'whatsapp', 'url'];
    fields.forEach(function(f) {
      var el = document.getElementById('booking-field-' + f);
      if (el) el.style.display = (f === type) ? '' : 'none';
    });
  };

  window.saveBusinessInfo = function(e) {
    e.preventDefault();
    var form = document.getElementById('business-info-form');
    var btn = document.getElementById('save-info-btn');
    var fd = new FormData(form);
    var data = {};
    fd.forEach(function(val, key) { data[key] = val; });

    btn.disabled = true;
    btn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="animation:spin 1s linear infinite"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg> Se salvează...';

    apiFetch('/api/web/portal/' + businessId, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    })
    .then(function(res) { return res.json().then(function(j) { return { ok: res.ok, data: j }; }); })
    .then(function(result) {
      if (result.ok) {
        showToast('Informațiile au fost salvate cu succes!', 'success');
      } else {
        showToast(result.data.message || 'Eroare la salvare', 'error');
      }
    })
    .catch(function(err) {
      if (err.message !== 'Unauthorized') showToast('Eroare de rețea', 'error');
    })
    .finally(function() {
      btn.disabled = false;
      btn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg> Salvează modificările';
    });

    return false;
  };

  /* ════════════════════════════════
     TAB 2: OFFERS TOGGLE
     ════════════════════════════════ */
  window.toggleOffer = function(offerId, btn) {
    var isOn = btn.classList.contains('on');
    apiFetch('/api/web/portal/' + businessId + '/offers/' + offerId + '/toggle', {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' }
    })
    .then(function(res) { return res.json().then(function(j) { return { ok: res.ok, data: j }; }); })
    .then(function(result) {
      if (result.ok) {
        if (isOn) {
          btn.classList.remove('on');
          btn.classList.add('off');
          btn.title = 'Inactivă';
        } else {
          btn.classList.remove('off');
          btn.classList.add('on');
          btn.title = 'Activă';
        }
        showToast(isOn ? 'Oferta a fost dezactivată' : 'Oferta a fost activată', 'success');
      } else {
        showToast(result.data.message || 'Eroare', 'error');
      }
    })
    .catch(function(err) {
      if (err.message !== 'Unauthorized') showToast('Eroare de rețea', 'error');
    });
  };

  /* ════════════════════════════════
     TAB 3: REVIEWS
     ════════════════════════════════ */
  window.updateCharCount = function(reviewId) {
    var textarea = document.getElementById('response-text-' + reviewId);
    var counter = document.getElementById('char-count-' + reviewId);
    if (textarea && counter) {
      counter.textContent = textarea.value.length + ' / 500';
    }
  };

  window.showResponseForm = function(reviewId, isEdit) {
    var form = document.getElementById('response-form-' + reviewId);
    var respondBtn = document.getElementById('respond-btn-' + reviewId);
    if (form) {
      form.style.display = '';
      var btnText = document.getElementById('response-btn-text-' + reviewId);
      if (btnText) btnText.textContent = isEdit ? 'Actualizează' : 'Trimite';
      form.dataset.mode = isEdit ? 'edit' : 'create';
      updateCharCount(reviewId);
    }
    if (respondBtn) respondBtn.style.display = 'none';
  };

  window.cancelResponse = function(reviewId) {
    var form = document.getElementById('response-form-' + reviewId);
    var respondBtn = document.getElementById('respond-btn-' + reviewId);
    if (form) form.style.display = 'none';
    if (respondBtn) respondBtn.style.display = '';
  };

  window.editResponse = function(reviewId) {
    var responseEl = document.getElementById('response-' + reviewId);
    if (responseEl) responseEl.style.display = 'none';
    showResponseForm(reviewId, true);
  };

  window.submitResponse = function(reviewId) {
    var textarea = document.getElementById('response-text-' + reviewId);
    var text = textarea ? textarea.value.trim() : '';
    if (!text) { showToast('Scrie un răspuns', 'error'); return; }
    if (text.length > 500) { showToast('Răspunsul nu poate depăși 500 de caractere', 'error'); return; }

    var form = document.getElementById('response-form-' + reviewId);
    var isEdit = form && form.dataset.mode === 'edit';
    var method = isEdit ? 'PUT' : 'POST';

    apiFetch('/api/web/portal/' + businessId + '/reviews/' + reviewId + '/respond', {
      method: method,
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ text: text })
    })
    .then(function(res) { return res.json().then(function(j) { return { ok: res.ok, data: j }; }); })
    .then(function(result) {
      if (result.ok) {
        showToast(isEdit ? 'Răspunsul a fost actualizat' : 'Răspunsul a fost trimis', 'success');
        // Reload to show updated response
        setTimeout(function() { window.location.reload(); }, 800);
      } else {
        showToast(result.data.message || 'Eroare', 'error');
      }
    })
    .catch(function(err) {
      if (err.message !== 'Unauthorized') showToast('Eroare de rețea', 'error');
    });
  };

  window.deleteResponse = function(reviewId) {
    if (!confirm('Ești sigur că vrei să ștergi acest răspuns?')) return;

    apiFetch('/api/web/portal/' + businessId + '/reviews/' + reviewId + '/respond', {
      method: 'DELETE',
      headers: { 'Content-Type': 'application/json' }
    })
    .then(function(res) { return res.json().then(function(j) { return { ok: res.ok, data: j }; }); })
    .then(function(result) {
      if (result.ok) {
        showToast('Răspunsul a fost șters', 'success');
        setTimeout(function() { window.location.reload(); }, 800);
      } else {
        showToast(result.data.message || 'Eroare', 'error');
      }
    })
    .catch(function(err) {
      if (err.message !== 'Unauthorized') showToast('Eroare de rețea', 'error');
    });
  };

  /* ════════════════════════════════
     TAB 4: STATISTICS & CHARTS
     ════════════════════════════════ */
  var isWeekly = false;
  var rawChartData = { views: [], subscribers: [], clicks: [] };

  window.changePeriod = function(days, btn) {
    currentPeriod = days;
    var buttons = document.querySelectorAll('.period-btn');
    buttons.forEach(function(b) { b.classList.remove('active'); });
    if (btn) btn.classList.add('active');
    loadCharts(days);
  };

  window.toggleGrouping = function(btn) {
    isWeekly = !isWeekly;
    if (isWeekly) {
      btn.classList.add('active');
      btn.textContent = 'Zilnic';
    } else {
      btn.classList.remove('active');
      btn.textContent = 'Săptămânal';
    }
    rerenderCharts();
  };

  function groupByWeek(dataArr, valueKey) {
    if (!dataArr || dataArr.length === 0) return [];
    var weeks = [];
    var weekSum = 0;
    var weekStart = dataArr[0].date || '';
    var weekEnd = '';
    var count = 0;

    dataArr.forEach(function(item, i) {
      weekSum += item[valueKey] || 0;
      weekEnd = item.date || '';
      count++;

      if (count === 7 || i === dataArr.length - 1) {
        var startParts = weekStart.split('-');
        var endParts = weekEnd.split('-');
        var label = startParts[2] + '/' + startParts[1] + '-' + endParts[2] + '/' + endParts[1];
        var entry = { date: label };
        entry[valueKey] = weekSum;
        weeks.push(entry);
        weekSum = 0;
        weekStart = (i + 1 < dataArr.length) ? (dataArr[i + 1].date || '') : '';
        count = 0;
      }
    });
    return weeks;
  }

  /* ── Chart.js instances ── */
  var chartInstances = {};

  function renderChart(canvasId, dataArr, label, valueKey) {
    // Destroy existing chart instance
    if (chartInstances[canvasId]) {
      chartInstances[canvasId].destroy();
      chartInstances[canvasId] = null;
    }

    var canvas = document.getElementById(canvasId);
    if (!canvas) return;

    if (!dataArr || dataArr.length === 0) {
      var parent = canvas.parentNode;
      parent.innerHTML = '<div class="chart-loading">Nu sunt date disponibile</div>';
      return;
    }

    // Build labels and values
    var labels = [];
    var values = [];
    dataArr.forEach(function(item) {
      var dateLabel = item.date || item.label || '';
      // Format short date: "2025-02-14" → "14/02"
      if (dateLabel && dateLabel.indexOf('-') !== -1 && dateLabel.length === 10) {
        var parts = dateLabel.split('-');
        dateLabel = parts[2] + '/' + parts[1];
      }
      labels.push(dateLabel);
      values.push((valueKey && item[valueKey] !== undefined) ? item[valueKey] : (item.count || item.value || 0));
    });

    var ctx = canvas.getContext('2d');
    chartInstances[canvasId] = new Chart(ctx, {
      type: 'bar',
      data: {
        labels: labels,
        datasets: [{
          label: label,
          data: values,
          backgroundColor: 'rgba(251, 146, 60, 0.7)',
          borderColor: '#fb923c',
          borderWidth: 1,
          borderRadius: 4,
          borderSkipped: 'bottom',
          maxBarThickness: 40,
          barPercentage: 0.8,
          categoryPercentage: 0.7,
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        layout: { padding: { right: 4, bottom: 4 } },
        plugins: {
          legend: { display: false },
          tooltip: {
            backgroundColor: '#27272a',
            titleColor: '#f4f4f5',
            bodyColor: '#f4f4f5',
            borderColor: 'rgba(255,255,255,0.1)',
            borderWidth: 1,
            cornerRadius: 6,
            padding: 8,
            displayColors: false,
            callbacks: {
              title: function(items) { return items[0].label || ''; },
              label: function(item) { return item.raw + ' ' + label; }
            }
          }
        },
        scales: {
          x: {
            grid: { display: false },
            ticks: {
              color: '#71717a',
              font: { size: 10 },
              maxRotation: 45,
              minRotation: 0,
              maxTicksLimit: 8,
              autoSkip: true,
            },
            border: { display: false }
          },
          y: {
            beginAtZero: true,
            grid: { color: 'rgba(255,255,255,0.04)' },
            ticks: {
              color: '#71717a',
              font: { size: 10 },
              precision: 0,
            },
            border: { display: false }
          }
        },
        animation: {
          duration: 400,
          easing: 'easeOutQuart'
        }
      }
    });
  }

  function rerenderCharts() {
    var vData = isWeekly ? groupByWeek(rawChartData.views, 'views') : rawChartData.views;
    var sData = isWeekly ? groupByWeek(rawChartData.subscribers, 'new_subscribers') : rawChartData.subscribers;
    var cData = isWeekly ? groupByWeek(rawChartData.clicks, 'clicks') : rawChartData.clicks;

    renderChart('views-chart', vData, 'vizualizări', 'views');
    renderChart('subscribers-chart', sData, 'abonați', 'new_subscribers');
    renderChart('clicks-chart', cData, 'click-uri', 'clicks');
  }

  function loadViewsChart(days) {
    var url;
    if (currentViewsMode === 'business') {
      url = '/api/web/portal/' + businessId + '/analytics/views?days=' + days;
    } else {
      var offerId = currentViewsMode.replace('offer-', '');
      url = '/api/web/portal/' + businessId + '/analytics/offer-views?days=' + days + '&offer_id=' + offerId;
    }
    apiFetch(url)
      .then(function(res) { return res.json(); })
      .then(function(data) {
        rawChartData.views = data.data || data || [];
        var displayData = isWeekly ? groupByWeek(rawChartData.views, 'views') : rawChartData.views;
        renderChart('views-chart', displayData, 'vizualizări', 'views');
      })
      .catch(function(err) { console.error('[Charts] Views error:', err); });
  }

  function loadSubscribersChart(days) {
    apiFetch('/api/web/portal/' + businessId + '/analytics/subscribers?days=' + days)
      .then(function(res) { return res.json(); })
      .then(function(data) {
        rawChartData.subscribers = data.data || data || [];
        var displayData = isWeekly ? groupByWeek(rawChartData.subscribers, 'new_subscribers') : rawChartData.subscribers;
        renderChart('subscribers-chart', displayData, 'abonați', 'new_subscribers');
      })
      .catch(function(err) { console.error('[Charts] Subscribers error:', err); });
  }

  function loadClicksChart(days) {
    apiFetch('/api/web/portal/' + businessId + '/analytics/clicks?days=' + days + '&action_type=' + currentClicksAction)
      .then(function(res) { return res.json(); })
      .then(function(data) {
        rawChartData.clicks = data.data || data || [];
        var displayData = isWeekly ? groupByWeek(rawChartData.clicks, 'clicks') : rawChartData.clicks;
        renderChart('clicks-chart', displayData, 'click-uri', 'clicks');
      })
      .catch(function(err) { console.error('[Charts] Clicks error:', err); });
  }

  function loadCharts(days) {
    currentPeriod = days;
    // W4: Skip API calls if analytics charts are not available (gated on backend too)
    if (_serverTier && _serverTier.plan && !_serverTier.plan.hasAnalyticsCharts) return;
    loadViewsChart(days);
    loadSubscribersChart(days);
    loadClicksChart(days);
  }

  window.onViewsDropdownChange = function(sel) {
    currentViewsMode = sel.value;
    loadViewsChart(currentPeriod);
  };

  window.onClicksDropdownChange = function(sel) {
    currentClicksAction = sel.value;
    loadClicksChart(currentPeriod);
  };

  /* ════════════════════════════════
     COMPETITOR BLOCKING (Plan 10)
     ════════════════════════════════ */
  window.toggleCompetitorBlocking = async function(btn) {
    var isOn = btn.classList.contains('on');
    var newValue = !isOn;

    try {
      var res = await apiFetch('/my-businesses/' + businessId + '/competitor-blocking', {
        method: 'PUT',
        body: JSON.stringify({ enabled: newValue }),
      });

      if (res.ok) {
        btn.classList.toggle('on');
        btn.classList.toggle('off');
        showToast(newValue ? 'Blocare competitori activata' : 'Blocare competitori dezactivata', 'success');
      } else {
        var data = await res.json();
        showToast(data.error || 'Eroare', 'error');
      }
    } catch (e) {
      showToast('Eroare de retea', 'error');
    }
  };

  /* ════════════════════════════════
     CSV EXPORT (Plan 05)
     ════════════════════════════════ */
  window.toggleExportDropdown = function(e) {
    e.stopPropagation();
    var dd = document.getElementById('export-dropdown');
    if (!dd) return;
    var isVisible = dd.style.display !== 'none';
    dd.style.display = isVisible ? 'none' : 'block';

    if (!isVisible) {
      function closeExport(ev) {
        if (!dd.contains(ev.target)) {
          dd.style.display = 'none';
          document.removeEventListener('click', closeExport);
        }
      }
      setTimeout(function() {
        document.addEventListener('click', closeExport);
      }, 0);
    }
  };

  window.exportCSV = function(type) {
    document.getElementById('export-dropdown').style.display = 'none';
    var url = '/api/web/portal/' + businessId + '/analytics/export?type=' + type + '&days=' + currentPeriod;

    if (type === 'clicks' && currentClicksAction) {
      url += '&action_type=' + currentClicksAction;
    }

    apiFetch(url)
      .then(function(res) {
        if (!res.ok) {
          return res.json().then(function(data) {
            if (data.error === 'upgrade_required') {
              showToast('Exportul CSV necesita planul Premium', 'error');
            } else {
              showToast('Eroare la export', 'error');
            }
            throw new Error('export_failed');
          });
        }
        return res.blob();
      })
      .then(function(blob) {
        var a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        var today = new Date().toISOString().split('T')[0];
        a.download = 'analytics-' + type + '-' + today + '.csv';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(a.href);
        showToast('Export CSV descarcat!', 'success');
      })
      .catch(function(err) {
        if (err.message !== 'export_failed') {
          console.error('[Export] Error:', err);
          showToast('Eroare la export', 'error');
        }
      });
  };

  /* ════════════════════════════════
     COMPETITIVE INSIGHTS (Plan 06)
     ════════════════════════════════ */
  var competitiveLoaded = false;

  function loadCompetitiveInsights() {
    if (competitiveLoaded) return;
    competitiveLoaded = true;

    var container = document.getElementById('competitive-content');
    if (!container) return;

    apiFetch('/api/web/portal/' + businessId + '/analytics/competitive')
      .then(function(res) { return res.json(); })
      .then(function(data) {
        if (!data.available) {
          container.innerHTML = '<div class="comp-no-data">' +
            '<svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin-bottom: 8px; opacity: 0.4;">' +
            '<circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>' +
            '<div>' + escapeHtml(data.reason || 'Date insuficiente') + '</div>' +
            '</div>';
          return;
        }

        var html = '<div class="comp-legend">' +
          '<span><span class="comp-legend-dot" style="background:#fb923c;"></span>Tu</span>' +
          '<span><span class="comp-legend-dot" style="background:#3b82f6;"></span>Media categoriei (' + escapeHtml('' + data.peersCount) + ' business-uri)</span>' +
          '</div>';

        data.insights.forEach(function(ins) {
          var rowMax = Math.max(ins.yours, ins.categoryAvg, 1);
          var yoursPct = (ins.yours / rowMax) * 100;
          var avgPct = (ins.categoryAvg / rowMax) * 100;

          var diffClass = ins.diff > 0 ? 'positive' : (ins.diff < 0 ? 'negative' : 'neutral');
          var diffText = ins.diff > 0 ? '+' + ins.diff + '%' : (ins.diff < 0 ? ins.diff + '%' : '0%');

          html += '<div class="comp-row">' +
            '<div class="comp-metric">' + escapeHtml(ins.metric) + '</div>' +
            '<div class="comp-bars">' +
              '<div class="comp-bar-wrap">' +
                '<div class="comp-bar-label">Tu</div>' +
                '<div class="comp-bar-track"><div class="comp-bar-fill yours" style="width:' + yoursPct + '%"></div></div>' +
                '<div class="comp-bar-value">' + escapeHtml('' + ins.yours) + '</div>' +
              '</div>' +
              '<div class="comp-bar-wrap">' +
                '<div class="comp-bar-label">Media</div>' +
                '<div class="comp-bar-track"><div class="comp-bar-fill avg" style="width:' + avgPct + '%"></div></div>' +
                '<div class="comp-bar-value">' + escapeHtml('' + ins.categoryAvg) + '</div>' +
              '</div>' +
            '</div>' +
            '<div class="comp-diff ' + diffClass + '">' + diffText + '</div>' +
          '</div>';
        });

        container.innerHTML = html;
      })
      .catch(function(err) {
        console.error('[Competitive] Error:', err);
        container.innerHTML = '<div class="comp-no-data">Eroare la incarcarea datelor.</div>';
      });
  }

  /* ════════════════════════════════
     CUSTOM PUSH NOTIFICATIONS (Plan 07)
     ════════════════════════════════ */
  var pushHistoryLoaded = false;

  // Character counter
  (function() {
    var textarea = document.getElementById('push-message');
    var counter = document.getElementById('push-char-count');
    if (textarea && counter) {
      textarea.addEventListener('input', function() {
        counter.textContent = textarea.value.length;
      });
    }
  })();

  window.sendCustomPush = function(e) {
    e.preventDefault();
    var titleEl = document.getElementById('push-title');
    var messageEl = document.getElementById('push-message');
    var btn = document.getElementById('push-send-btn');

    var title = titleEl.value.trim();
    var message = messageEl.value.trim();

    if (!title || !message) {
      showToast('Completeaza titlul si mesajul', 'error');
      return false;
    }

    if (!confirm('Esti sigur ca vrei sa trimiti aceasta notificare catre toti abonatii?')) {
      return false;
    }

    btn.disabled = true;
    btn.textContent = 'Se trimite...';

    apiFetch('/api/web/portal/' + businessId + '/notifications/send', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ title: title, message: message }),
    })
      .then(function(res) { return res.json().then(function(data) { return { ok: res.ok, status: res.status, data: data }; }); })
      .then(function(result) {
        btn.disabled = false;
        btn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:4px;"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>Trimite notificarea';

        if (!result.ok) {
          if (result.status === 429) {
            showToast(result.data.message || 'Limita de notificari atinsa', 'error');
          } else if (result.status === 403) {
            showToast('Aceasta functie necesita planul Premium', 'error');
          } else {
            showToast(result.data.message || 'Eroare la trimitere', 'error');
          }
          return;
        }

        showToast('Notificare trimisa! (' + result.data.sent + ' destinatari)', 'success');
        titleEl.value = '';
        messageEl.value = '';
        document.getElementById('push-char-count').textContent = '0';

        var remainingEl = document.getElementById('push-remaining');
        if (remainingEl) {
          remainingEl.textContent = result.data.remaining + ' notificari ramase saptamana aceasta';
        }

        pushHistoryLoaded = false;
        loadPushHistory();
      })
      .catch(function(err) {
        btn.disabled = false;
        btn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:4px;"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>Trimite notificarea';
        if (err.message !== 'Unauthorized') {
          showToast('Eroare la trimitere', 'error');
        }
      });

    return false;
  };

  function loadPushHistory() {
    if (pushHistoryLoaded) return;
    pushHistoryLoaded = true;

    var container = document.getElementById('push-history');
    if (!container) return;

    apiFetch('/api/web/portal/' + businessId + '/notifications/history')
      .then(function(res) { return res.json(); })
      .then(function(data) {
        var remainingEl = document.getElementById('push-remaining');
        if (remainingEl && data.rateLimit) {
          remainingEl.textContent = data.rateLimit.remaining + ' notificari ramase saptamana aceasta';
        }

        if (!data.history || data.history.length === 0) {
          container.innerHTML = '<div style="text-align: center; padding: 16px; color: var(--text-tertiary); font-size: 13px;">Nicio notificare trimisa inca.</div>';
          return;
        }

        var html = '';
        data.history.forEach(function(item) {
          var d = new Date(item.createdAt);
          var dateStr = d.toLocaleDateString('ro-RO', { day: 'numeric', month: 'short', year: 'numeric' });
          var timeStr = d.toLocaleTimeString('ro-RO', { hour: '2-digit', minute: '2-digit' });

          html += '<div class="push-history-item">' +
            '<div class="push-history-header">' +
              '<div class="push-history-title">' + escapeHtml(item.title) + '</div>' +
              '<div class="push-history-date">' + dateStr + ' ' + timeStr + '</div>' +
            '</div>' +
            '<div class="push-history-message">' + escapeHtml(item.message) + '</div>' +
            '<div class="push-history-stats">' +
              '<span class="success">' + item.successCount + ' trimise</span>' +
              (item.failureCount > 0 ? ' &middot; <span class="failure">' + item.failureCount + ' esuate</span>' : '') +
              ' &middot; ' + item.recipientsCount + ' destinatari' +
            '</div>' +
          '</div>';
        });

        container.innerHTML = html;
      })
      .catch(function(err) {
        console.error('[Push] History error:', err);
        container.innerHTML = '<div style="text-align: center; padding: 16px; color: var(--text-tertiary);">Eroare la incarcarea istoricului.</div>';
      });
  }

  /* ════════════════════════════════
     DEAL OF DAY NOMINATION (Plan 08)
     ════════════════════════════════ */
  window.nominateOffer = function(offerId, btn) {
    if (btn.classList.contains('nominated') || btn.disabled) return;

    btn.disabled = true;
    btn.textContent = 'Se trimite...';

    apiFetch('/my-businesses/' + businessId + '/nominations', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ offerId: offerId }),
    })
      .then(function(res) { return res.json().then(function(data) { return { ok: res.ok, status: res.status, data: data }; }); })
      .then(function(result) {
        if (!result.ok) {
          if (result.data.error === 'rate_limited') {
            showToast(result.data.message, 'error');
          } else {
            showToast(result.data.error || result.data.message || 'Eroare la nominalizare', 'error');
          }
          btn.disabled = false;
          btn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg> Nominalizare';
          return;
        }

        btn.classList.add('nominated');
        btn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg> Nominalizat';
        showToast('Oferta a fost nominalizata pentru Oferta Zilei!', 'success');

        // Disable all other nominate buttons (rate limit)
        document.querySelectorAll('.nominate-btn:not(.nominated)').forEach(function(b) {
          b.disabled = true;
        });
      })
      .catch(function(e) {
        btn.disabled = false;
        btn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg> Nominalizare';
        showToast('Eroare de retea', 'error');
      });
  };

  // On page load: mark already-nominated offers and disable if rate-limited
  (function initNominations() {
    var nominations = <%- JSON.stringify(nominations || []).replace(/<\//g, '<\\/') %>;
    var canNominate = <%= canNominate ? 'true' : 'false' %>;

    nominations.forEach(function(nom) {
      var btn = document.getElementById('nom-btn-' + nom.offer_id);
      if (btn) {
        if (nom.status === 'pending') {
          btn.classList.add('nominated');
          btn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg> Nominalizat';
        } else if (nom.status === 'selected') {
          btn.classList.add('nominated');
          var dateStr = nom.selected_for_date ? new Date(nom.selected_for_date).toLocaleDateString('ro-RO', { day: 'numeric', month: 'short' }) : '';
          btn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg> Oferta Zilei ' + dateStr;
        }
      }
    });

    if (!canNominate) {
      document.querySelectorAll('.nominate-btn:not(.nominated)').forEach(function(b) {
        b.disabled = true;
      });
    }
  })();

  /* ── Spin animation for loading button ── */
  var styleEl = document.createElement('style');
  styleEl.textContent = '@keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }';
  document.head.appendChild(styleEl);

})();
</script>