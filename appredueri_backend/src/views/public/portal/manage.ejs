<%- include('../partials/head', { pageTitle: business.name + ' — Portal', activePage: 'portal' }) %>
<%- include('../partials/navbar', { activePage: 'portal', webUser: webUser }) %>

<style>
  :root {
    --bg-primary: #06060a;
    --bg-secondary: #0c0c12;
    --bg-card: rgba(255,255,255,0.04);
    --accent: #fb923c;
    --accent-hover: #f97316;
    --accent-glow: rgba(251,146,60,0.15);
    --text-primary: #f4f4f5;
    --text-secondary: #a1a1aa;
    --text-tertiary: #71717a;
    --border: rgba(255,255,255,0.08);
    --border-hover: rgba(255,255,255,0.14);
    --radius-lg: 16px;
    --radius-md: 10px;
    --radius-full: 9999px;
    --success: #22c55e;
    --danger: #ef4444;
    --warning: #eab308;
  }

  /* ── Layout ── */
  .portal-page { padding: 120px 0 60px; min-height: 100vh; }
  .portal-container { max-width: 960px; margin: 0 auto; padding: 0 20px; }

  /* ── Header ── */
  .portal-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 28px; gap: 16px; flex-wrap: wrap; }
  .portal-header-left { display: flex; align-items: center; gap: 14px; min-width: 0; }
  .portal-back {
    display: inline-flex; align-items: center; gap: 6px;
    color: var(--text-secondary); text-decoration: none; font-size: 0.875rem;
    transition: color 0.2s;
    white-space: nowrap;
  }
  .portal-back:hover { color: var(--accent); }
  .portal-biz-name { font-size: 1.5rem; font-weight: 700; color: var(--text-primary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .portal-view-btn {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 8px 18px; border-radius: var(--radius-full);
    background: var(--bg-card); border: 1px solid var(--border);
    color: var(--text-secondary); font-size: 0.8125rem; text-decoration: none;
    transition: all 0.2s; white-space: nowrap;
  }
  .portal-view-btn:hover { border-color: var(--accent); color: var(--accent); }

  /* ── Tabs ── */
  .portal-tabs {
    display: flex; gap: 0; border-bottom: 1px solid var(--border);
    margin-bottom: 32px; overflow-x: auto;
    -ms-overflow-style: none; scrollbar-width: none;
  }
  .portal-tabs::-webkit-scrollbar { display: none; }
  .portal-tab {
    padding: 12px 22px; font-size: 0.9rem; font-weight: 500;
    color: var(--text-tertiary); cursor: pointer;
    border-bottom: 2px solid transparent;
    transition: all 0.2s; white-space: nowrap;
    background: none; border-top: none; border-left: none; border-right: none;
    font-family: inherit;
  }
  .portal-tab:hover { color: var(--text-secondary); }
  .portal-tab.active { color: var(--accent); border-bottom-color: var(--accent); }
  .portal-tab-badge {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 20px; height: 20px; padding: 0 6px;
    background: var(--accent-glow); color: var(--accent);
    border-radius: var(--radius-full); font-size: 0.75rem; font-weight: 600;
    margin-left: 6px;
  }

  /* ── Tab Panels ── */
  .tab-panel { display: none; }
  .tab-panel.active { display: block; }

  /* ── Glass Card ── */
  .glass-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 24px;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition: border-color 0.2s;
  }
  .glass-card:hover { border-color: var(--border-hover); }
  .glass-card + .glass-card { margin-top: 16px; }

  /* ── Form Fields ── */
  .form-group { margin-bottom: 20px; }
  .form-label {
    display: block; margin-bottom: 6px;
    font-size: 0.8125rem; font-weight: 500;
    color: var(--text-secondary);
  }
  .form-input, .form-select, .form-textarea {
    width: 100%; padding: 10px 14px;
    background: rgba(255,255,255,0.04);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    color: var(--text-primary); font-size: 0.9rem;
    font-family: inherit;
    transition: border-color 0.2s;
    outline: none;
    box-sizing: border-box;
  }
  .form-input:focus, .form-select:focus, .form-textarea:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-glow);
  }
  .form-select { appearance: none; background-image: url("data:image/svg+xml,%3Csvg width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='%2371717a' stroke-width='2'%3E%3Cpolyline points='6 9 12 15 18 9'/%3E%3C/svg%3E"); background-repeat: no-repeat; background-position: right 12px center; padding-right: 36px; }
  .form-select option { background: #18181b; color: var(--text-primary); }
  .form-textarea { resize: vertical; min-height: 80px; }

  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  @media (max-width: 600px) { .form-row { grid-template-columns: 1fr; } }

  /* ── Section Title ── */
  .section-title {
    font-size: 1rem; font-weight: 600; color: var(--text-primary);
    margin-bottom: 16px; padding-bottom: 10px;
    border-bottom: 1px solid var(--border);
  }

  /* ── Booking Type Grid ── */
  .booking-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-bottom: 16px; }
  @media (max-width: 500px) { .booking-grid { grid-template-columns: repeat(2, 1fr); } }
  .booking-option {
    display: flex; flex-direction: column; align-items: center; gap: 6px;
    padding: 14px 8px; border-radius: var(--radius-md);
    background: rgba(255,255,255,0.03); border: 1px solid var(--border);
    cursor: pointer; transition: all 0.2s;
    font-size: 0.8125rem; color: var(--text-secondary);
    text-align: center;
  }
  .booking-option:hover { border-color: var(--border-hover); }
  .booking-option.active { border-color: var(--accent); background: var(--accent-glow); color: var(--accent); }
  .booking-option svg { flex-shrink: 0; }

  .booking-fields { margin-top: 12px; }
  .booking-field { display: none; }
  .booking-field.visible { display: block; }

  /* ── Image Preview ── */
  .img-preview-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 20px; }
  @media (max-width: 500px) { .img-preview-row { grid-template-columns: 1fr; } }
  .img-preview-box {
    border-radius: var(--radius-md); overflow: hidden;
    border: 1px solid var(--border); background: rgba(255,255,255,0.02);
    aspect-ratio: 16 / 10; display: flex; align-items: center; justify-content: center;
    position: relative;
  }
  .img-preview-box img { width: 100%; height: 100%; object-fit: cover; }
  .img-preview-placeholder {
    display: flex; flex-direction: column; align-items: center; gap: 8px;
    color: var(--text-tertiary); font-size: 0.8125rem;
  }
  .img-preview-label {
    font-size: 0.75rem; color: var(--text-tertiary); text-align: center; margin-top: 6px;
  }

  /* ── Buttons ── */
  .btn-accent {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    padding: 10px 24px; border-radius: var(--radius-full);
    background: var(--accent); color: #09090b;
    font-weight: 600; font-size: 0.875rem;
    border: none; cursor: pointer;
    transition: all 0.2s; font-family: inherit;
  }
  .btn-accent:hover { background: var(--accent-hover); transform: translateY(-1px); }
  .btn-accent:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }

  .btn-secondary-portal {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    padding: 8px 18px; border-radius: var(--radius-full);
    background: var(--bg-card); border: 1px solid var(--border);
    color: var(--text-secondary); font-size: 0.8125rem;
    cursor: pointer; transition: all 0.2s; font-family: inherit;
    text-decoration: none;
  }
  .btn-secondary-portal:hover { border-color: var(--accent); color: var(--accent); }

  .btn-sm {
    padding: 6px 14px; font-size: 0.75rem; border-radius: var(--radius-full);
    border: 1px solid var(--border); background: transparent;
    color: var(--text-secondary); cursor: pointer; transition: all 0.2s;
    font-family: inherit; display: inline-flex; align-items: center; gap: 4px;
  }
  .btn-sm:hover { border-color: var(--accent); color: var(--accent); }
  .btn-sm.danger:hover { border-color: var(--danger); color: var(--danger); }

  /* ── Offers Tab ── */
  .offers-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; flex-wrap: wrap; gap: 12px; }
  .offers-count { font-size: 0.875rem; color: var(--text-secondary); }

  .offer-card {
    display: flex; align-items: center; gap: 16px;
    padding: 16px; border-radius: var(--radius-md);
    background: var(--bg-card); border: 1px solid var(--border);
    transition: border-color 0.2s;
  }
  .offer-card:hover { border-color: var(--border-hover); }
  .offer-card + .offer-card { margin-top: 10px; }

  .offer-thumb {
    width: 56px; height: 56px; border-radius: var(--radius-md);
    background: rgba(255,255,255,0.06); overflow: hidden;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .offer-thumb img { width: 100%; height: 100%; object-fit: cover; }
  .offer-thumb-icon { color: var(--accent); }

  .offer-info { flex: 1; min-width: 0; }
  .offer-title { font-size: 0.9rem; font-weight: 600; color: var(--text-primary); margin-bottom: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .offer-meta { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .offer-discount {
    display: inline-flex; padding: 2px 10px; border-radius: var(--radius-full);
    background: var(--accent-glow); color: var(--accent);
    font-size: 0.75rem; font-weight: 700;
  }
  .offer-dates { font-size: 0.75rem; color: var(--text-tertiary); }

  .offer-actions { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }

  .toggle-btn {
    width: 44px; height: 24px; border-radius: 12px;
    border: none; cursor: pointer; position: relative;
    transition: background 0.2s;
    padding: 0;
  }
  .toggle-btn.on { background: var(--success); }
  .toggle-btn.off { background: var(--text-tertiary); }
  .toggle-btn::after {
    content: ''; position: absolute; top: 3px;
    width: 18px; height: 18px; border-radius: 50%;
    background: white; transition: left 0.2s;
  }
  .toggle-btn.on::after { left: 23px; }
  .toggle-btn.off::after { left: 3px; }

  .offer-edit-link { color: var(--text-tertiary); transition: color 0.2s; }
  .offer-edit-link:hover { color: var(--accent); }

  /* ── Empty State ── */
  .empty-state {
    text-align: center; padding: 48px 20px; color: var(--text-tertiary);
  }
  .empty-state svg { margin-bottom: 16px; opacity: 0.4; }
  .empty-state p { font-size: 0.9rem; margin-bottom: 20px; }

  /* ── Reviews Tab ── */
  .review-card {
    padding: 20px; border-radius: var(--radius-md);
    background: var(--bg-card); border: 1px solid var(--border);
  }
  .review-card + .review-card { margin-top: 12px; }

  .review-header { display: flex; align-items: center; gap: 12px; margin-bottom: 10px; }
  .review-avatar {
    width: 36px; height: 36px; border-radius: 50%;
    background: var(--accent-glow); color: var(--accent);
    display: flex; align-items: center; justify-content: center;
    font-weight: 700; font-size: 0.875rem; flex-shrink: 0;
  }
  .review-user-info { flex: 1; min-width: 0; }
  .review-user-name { font-size: 0.875rem; font-weight: 600; color: var(--text-primary); }
  .review-date { font-size: 0.75rem; color: var(--text-tertiary); }

  .review-stars { display: flex; gap: 2px; margin-bottom: 8px; }
  .review-comment { font-size: 0.875rem; color: var(--text-secondary); line-height: 1.5; margin-bottom: 12px; }

  .review-response {
    padding: 14px; border-radius: var(--radius-md);
    background: rgba(251,146,60,0.05); border-left: 3px solid var(--accent);
    margin-top: 10px;
  }
  .review-response-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px; }
  .review-response-label { font-size: 0.75rem; font-weight: 600; color: var(--accent); }
  .review-response-actions { display: flex; gap: 6px; }
  .review-response-text { font-size: 0.8125rem; color: var(--text-secondary); line-height: 1.5; }
  .review-response-date { font-size: 0.7rem; color: var(--text-tertiary); margin-top: 6px; }

  .response-form { margin-top: 12px; }
  .response-form textarea {
    width: 100%; padding: 10px; border-radius: var(--radius-md);
    background: rgba(255,255,255,0.04); border: 1px solid var(--border);
    color: var(--text-primary); font-size: 0.8125rem; font-family: inherit;
    resize: vertical; min-height: 70px; outline: none; box-sizing: border-box;
  }
  .response-form textarea:focus { border-color: var(--accent); }
  .response-form-actions { display: flex; gap: 8px; margin-top: 8px; justify-content: flex-end; }
  .response-char-count { font-size: 0.7rem; color: var(--text-tertiary); text-align: right; margin-top: 4px; }

  /* ── Stats Tab ── */
  .stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 24px; align-items: stretch; }
  @media (max-width: 480px) { .stats-grid { grid-template-columns: repeat(2, 1fr); } }

  .stat-card {
    padding: 18px; border-radius: var(--radius-md);
    background: var(--bg-card); border: 1px solid var(--border);
    text-align: center; display: flex; flex-direction: column; justify-content: center; min-height: 100px;
  }
  .stat-value { font-size: 1.75rem; font-weight: 700; color: var(--text-primary); line-height: 1.2; }
  .stat-label { font-size: 0.75rem; color: var(--text-tertiary); margin-top: 4px; }
  .stat-subtext { font-size: 0.7rem; color: var(--text-tertiary); margin-top: 4px; opacity: 0.7; }

  /* ── Score Card ── */
  .score-card { display: flex; gap: 28px; align-items: flex-start; flex-wrap: wrap; }
  .score-circle-wrap { display: flex; flex-direction: column; align-items: center; gap: 8px; flex-shrink: 0; }
  .score-circle {
    position: relative; width: 120px; height: 120px;
  }
  .score-circle svg { width: 120px; height: 120px; transform: rotate(-90deg); }
  .score-circle-bg { fill: none; stroke: rgba(255,255,255,0.06); stroke-width: 10; }
  .score-circle-fill { fill: none; stroke-width: 10; stroke-linecap: round; transition: stroke-dashoffset 0.6s ease; }
  .score-circle-text {
    position: absolute; inset: 0; display: flex; flex-direction: column;
    align-items: center; justify-content: center;
  }
  .score-number { font-size: 1.75rem; font-weight: 800; color: var(--text-primary); line-height: 1; }
  .score-max { font-size: 0.7rem; color: var(--text-tertiary); }
  .score-label-text { font-size: 0.75rem; color: var(--text-tertiary); text-align: center; }

  .score-breakdown { flex: 1; min-width: 240px; }
  .score-breakdown-item {
    display: flex; align-items: center; gap: 10px;
    padding: 8px 0; font-size: 0.8125rem;
    border-bottom: 1px solid rgba(255,255,255,0.04);
  }
  .score-breakdown-item:last-child { border-bottom: none; }
  .score-icon-ok { color: var(--success); flex-shrink: 0; }
  .score-icon-miss { color: var(--text-tertiary); flex-shrink: 0; }
  .score-criterion { flex: 1; color: var(--text-secondary); }
  .score-points { font-weight: 600; color: var(--text-primary); white-space: nowrap; }

  .score-tips { margin-top: 16px; }
  .score-tips-title { font-size: 0.8125rem; font-weight: 600; color: var(--accent); margin-bottom: 10px; }
  .score-tip {
    display: flex; gap: 8px; padding: 8px 12px;
    background: var(--accent-glow); border-radius: var(--radius-md);
    font-size: 0.8rem; color: var(--text-secondary); line-height: 1.4;
    margin-bottom: 6px;
  }
  .score-tip svg { flex-shrink: 0; margin-top: 2px; color: var(--accent); }

  /* ── Rating Distribution ── */
  .rating-dist { margin-top: 24px; }
  .rating-dist-title { font-size: 0.9rem; font-weight: 600; color: var(--text-primary); margin-bottom: 14px; }
  .rating-dist-row { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
  .rating-dist-label { font-size: 0.8rem; color: var(--text-secondary); width: 50px; display: flex; align-items: center; gap: 4px; }
  .rating-dist-bar-bg {
    flex: 1; height: 8px; background: rgba(255,255,255,0.06);
    border-radius: 4px; overflow: hidden;
  }
  .rating-dist-bar-fill {
    height: 100%; border-radius: 4px; background: var(--accent);
    transition: width 0.4s ease;
  }
  .rating-dist-count { font-size: 0.75rem; color: var(--text-tertiary); width: 30px; text-align: right; }

  /* ── Period Selector ── */
  .period-selector { display: flex; gap: 6px; margin-bottom: 20px; }
  .period-btn {
    padding: 6px 16px; border-radius: var(--radius-full);
    border: 1px solid var(--border); background: transparent;
    color: var(--text-secondary); font-size: 0.8rem;
    cursor: pointer; transition: all 0.2s; font-family: inherit;
  }
  .period-btn:hover { border-color: var(--border-hover); }
  .period-btn.active { background: var(--accent); color: #09090b; border-color: var(--accent); font-weight: 600; }

  /* ── Bar Charts (Chart.js) ── */
  .chart-section { margin-top: 0; }
  .chart-title { font-size: 0.9rem; font-weight: 600; color: var(--text-primary); margin-bottom: 10px; }
  .chart-container { position: relative; height: 180px; }
  .charts-row { display: flex; flex-direction: column; gap: 28px; }

  /* ── Chart Dropdowns ── */
  .chart-dropdown {
    background: var(--bg-card, #1a1a2e);
    color: var(--text-primary, #e0e0e0);
    border: 1px solid var(--border, #2d2d4a);
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 0.875rem;
    font-family: inherit;
    cursor: pointer;
    width: 100%;
    max-width: 320px;
    margin-bottom: 10px;
    appearance: none;
    background-image: url("data:image/svg+xml,%3Csvg width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='%2371717a' stroke-width='2'%3E%3Cpolyline points='6 9 12 15 18 9'/%3E%3C/svg%3E");
    background-repeat: no-repeat;
    background-position: right 10px center;
    padding-right: 30px;
  }
  .chart-dropdown:focus {
    border-color: var(--accent, #fb923c);
    outline: none;
  }
  .chart-dropdown option {
    background: #18181b;
    color: var(--text-primary, #e0e0e0);
  }

  /* ── Trend Arrows ── */
  .stat-trend {
    display: inline-flex; align-items: center; gap: 3px;
    font-size: 0.7rem; font-weight: 600; margin-top: 4px;
  }
  .stat-trend.up { color: var(--success); }
  .stat-trend.down { color: var(--danger); }
  .stat-trend.neutral { color: var(--text-tertiary); }

  /* ── Period Separator & Grouping ── */
  .period-separator {
    width: 1px; height: 20px; background: var(--border); flex-shrink: 0; align-self: center;
  }
  .period-btn.grouping-btn { font-style: italic; }
  .period-btn.grouping-btn.active {
    background: rgba(251,146,60,0.12); color: var(--accent); border-color: var(--accent); font-weight: 500;
  }

  .chart-loading {
    display: flex; align-items: center; justify-content: center;
    height: 160px; color: var(--text-tertiary); font-size: 0.8125rem;
  }

  /* ── Toast ── */
  .pm-toast {
    position: fixed; bottom: 24px; right: 24px; z-index: 9999;
    padding: 12px 20px; border-radius: var(--radius-md);
    font-size: 0.875rem; font-weight: 500;
    animation: pmToastIn 0.3s ease, pmToastOut 0.3s ease 2.7s forwards;
    max-width: 340px;
  }
  .pm-toast.success { background: var(--success); color: #fff; }
  .pm-toast.error { background: var(--danger); color: #fff; }
  @keyframes pmToastIn { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes pmToastOut { from { opacity: 1; } to { opacity: 0; transform: translateY(12px); } }

  /* ── Responsive ── */
  @media (max-width: 600px) {
    .portal-biz-name { font-size: 1.2rem; }
    .glass-card { padding: 18px; }
    .score-card { flex-direction: column; align-items: center; }
    .offer-card { flex-direction: column; align-items: flex-start; }
    .offer-actions { width: 100%; justify-content: flex-end; margin-top: 8px; }
  }
</style>

<!-- ═══════════════════════════════════════════════════════
     PAGE CONTENT
     ═══════════════════════════════════════════════════════ -->
<div class="portal-page">
  <div class="portal-container">

    <!-- Header -->
    <div class="portal-header">
      <div class="portal-header-left">
        <a href="/portal" class="portal-back">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
          Înapoi
        </a>
        <h1 class="portal-biz-name"><%= business.name %></h1>
      </div>
      <a href="/business/<%= business.id %>" class="portal-view-btn" target="_blank">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        Vizualizează
      </a>
    </div>

    <!-- Tab Navigation -->
    <div class="portal-tabs">
      <button class="portal-tab active" onclick="switchTab('info')">Info</button>
      <button class="portal-tab" onclick="switchTab('oferte')">
        Oferte<span class="portal-tab-badge"><%= offers.length %></span>
      </button>
      <button class="portal-tab" onclick="switchTab('recenzii')">
        Recenzii<span class="portal-tab-badge"><%= reviewCount %></span>
      </button>
      <button class="portal-tab" onclick="switchTab('statistici')">Statistici</button>
    </div>

    <!-- ═══════════════════════════════════════
         TAB 1: INFO
         ═══════════════════════════════════════ -->
    <div class="tab-panel active" id="tab-info">
      <form id="business-info-form" onsubmit="return saveBusinessInfo(event)">
        <div class="glass-card">
          <h3 class="section-title">Informații generale</h3>

          <div class="form-group">
            <label class="form-label">Nume</label>
            <input type="text" name="name" class="form-input" value="<%= business.name %>" required>
          </div>

          <div class="form-group">
            <label class="form-label">Adresă</label>
            <input type="text" name="address" class="form-input" value="<%= business.address || '' %>">
          </div>

          <div class="form-row">
            <div class="form-group">
              <label class="form-label">Telefon</label>
              <input type="text" name="phone" class="form-input" value="<%= business.phone || '' %>">
            </div>
            <div class="form-group">
              <label class="form-label">Website</label>
              <input type="text" name="website" class="form-input" value="<%= business.website || '' %>" placeholder="https://">
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label class="form-label">Oraș</label>
              <select name="city_id" class="form-select">
                <option value="">— Selectează —</option>
                <% cities.forEach(function(c) { %>
                  <option value="<%= c.id %>" <%= business.city_id == c.id ? 'selected' : '' %>><%= c.name %></option>
                <% }); %>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label">Categorie</label>
              <select name="category_id" class="form-select">
                <option value="">— Selectează —</option>
                <% categories.forEach(function(cat) { %>
                  <option value="<%= cat.id %>" <%= business.category_id == cat.id ? 'selected' : '' %>><%= cat.name %></option>
                <% }); %>
              </select>
            </div>
          </div>
        </div>

        <!-- Booking Section -->
        <div class="glass-card" style="margin-top: 16px;">
          <h3 class="section-title">Rezervări</h3>

          <label class="form-label">Tip rezervare</label>
          <div class="booking-grid">
            <div class="booking-option <%= business.booking_type === 'none' || !business.booking_type ? 'active' : '' %>" onclick="selectBookingType('none')">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
              Niciunul
            </div>
            <div class="booking-option <%= business.booking_type === 'phone' ? 'active' : '' %>" onclick="selectBookingType('phone')">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              Telefon
            </div>
            <div class="booking-option <%= business.booking_type === 'whatsapp' ? 'active' : '' %>" onclick="selectBookingType('whatsapp')">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
              WhatsApp
            </div>
            <div class="booking-option <%= business.booking_type === 'url' ? 'active' : '' %>" onclick="selectBookingType('url')">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
              Link
            </div>
          </div>
          <input type="hidden" name="booking_type" id="booking-type-input" value="<%= business.booking_type || 'none' %>">

          <div class="booking-fields">
            <div class="booking-field" id="booking-field-phone" style="<%= business.booking_type === 'phone' ? '' : 'display:none' %>">
              <div class="form-group">
                <label class="form-label">Telefon rezervări</label>
                <input type="text" name="booking_phone" class="form-input" value="<%= business.booking_phone || '' %>" placeholder="+40 7XX XXX XXX">
              </div>
            </div>
            <div class="booking-field" id="booking-field-whatsapp" style="<%= business.booking_type === 'whatsapp' ? '' : 'display:none' %>">
              <div class="form-group">
                <label class="form-label">Număr WhatsApp</label>
                <input type="text" name="booking_whatsapp" class="form-input" value="<%= business.booking_whatsapp || '' %>" placeholder="+40 7XX XXX XXX">
              </div>
            </div>
            <div class="booking-field" id="booking-field-url" style="<%= business.booking_type === 'url' ? '' : 'display:none' %>">
              <div class="form-group">
                <label class="form-label">Link rezervare</label>
                <input type="text" name="booking_url" class="form-input" value="<%= business.booking_url || '' %>" placeholder="https://">
              </div>
            </div>
          </div>

          <div class="form-group" style="margin-top: 12px;">
            <label class="form-label">Instrucțiuni rezervare</label>
            <textarea name="booking_instructions" class="form-textarea" placeholder="Ex: Rezervările se fac cu minim 2 ore înainte..."><%= business.booking_instructions || '' %></textarea>
          </div>
        </div>

        <!-- Image Uploads -->
        <div class="glass-card" style="margin-top: 16px;">
          <h3 class="section-title">Imagini</h3>
          <div class="img-preview-row">
            <div>
              <div class="img-preview-box" id="logo-preview">
                <% if (business.logo_url) { %>
                  <img src="<%= business.logo_url %>" alt="Logo" id="logo-img" width="100" height="100">
                <% } else { %>
                  <div class="img-preview-placeholder" id="logo-placeholder">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
                    Fără logo
                  </div>
                <% } %>
              </div>
              <p class="img-preview-label">Logo</p>
              <div style="display: flex; gap: 8px; margin-top: 6px; justify-content: center;">
                <label class="btn-sm" style="cursor: pointer;">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                  Încarcă
                  <input type="file" accept="image/*" style="display:none;" onchange="uploadImage('logo', this)">
                </label>
                <% if (business.logo_url) { %>
                  <button type="button" class="btn-sm danger" onclick="deleteImage('logo')">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                    Șterge
                  </button>
                <% } %>
              </div>
            </div>
            <div>
              <div class="img-preview-box" id="cover-preview">
                <% if (business.cover_image_url) { %>
                  <img src="<%= business.cover_image_url %>" alt="Cover" id="cover-img" width="400" height="200">
                <% } else { %>
                  <div class="img-preview-placeholder" id="cover-placeholder">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
                    Fără copertă
                  </div>
                <% } %>
              </div>
              <p class="img-preview-label">Imagine copertă</p>
              <div style="display: flex; gap: 8px; margin-top: 6px; justify-content: center;">
                <label class="btn-sm" style="cursor: pointer;">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                  Încarcă
                  <input type="file" accept="image/*" style="display:none;" onchange="uploadImage('cover', this)">
                </label>
                <% if (business.cover_image_url) { %>
                  <button type="button" class="btn-sm danger" onclick="deleteImage('cover')">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                    Șterge
                  </button>
                <% } %>
              </div>
            </div>
          </div>
        </div>

        <div style="margin-top: 24px; text-align: right;">
          <button type="submit" class="btn-accent" id="save-info-btn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
            Salvează modificările
          </button>
        </div>
      </form>

      <!-- Gallery Upload Section -->
      <div class="glass-card" style="margin-top: 16px;">
        <h3 class="section-title">Galerie foto</h3>
        <p style="color: var(--text-secondary); font-size: 0.85rem; margin-bottom: 12px;">
          Maximum 8 imagini. Recomandat: format landscape, minim 1200x800px.
        </p>
        <div class="gallery-upload-grid" id="gallery-grid">
          <% if (business.images && business.images.length > 0) { %>
            <% business.images.forEach((img) => { %>
              <div class="gallery-upload-item" data-image-id="<%= img.id %>">
                <img src="<%= img.url %>" alt="Galerie" width="120" height="80" loading="lazy">
                <button type="button" class="gallery-delete-btn" onclick="deleteGalleryImage(<%= img.id %>, this)" title="Șterge imaginea" aria-label="Șterge imaginea">&times;</button>
              </div>
            <% }); %>
          <% } %>
          <% if (!business.images || business.images.length < 8) { %>
            <label class="gallery-upload-add" id="gallery-add-btn">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              <span>Adaugă</span>
              <input type="file" accept="image/*" multiple style="display:none;" onchange="uploadGalleryImages(this)">
            </label>
          <% } %>
        </div>
      </div>

      <style>
        .gallery-upload-grid {
          display: grid;
          grid-template-columns: repeat(4, 1fr);
          gap: 12px;
        }
        .gallery-upload-item {
          position: relative;
          aspect-ratio: 4 / 3;
          border-radius: var(--radius-md);
          overflow: hidden;
          border: 1px solid var(--border);
          background: var(--bg-surface);
        }
        .gallery-upload-item img {
          width: 100%;
          height: 100%;
          object-fit: cover;
        }
        .gallery-delete-btn {
          position: absolute;
          top: 6px;
          right: 6px;
          width: 24px;
          height: 24px;
          border-radius: 50%;
          background: rgba(239, 68, 68, 0.9);
          border: none;
          color: #fff;
          font-size: 1rem;
          cursor: pointer;
          display: flex;
          align-items: center;
          justify-content: center;
          opacity: 0;
          transition: opacity 0.2s;
          line-height: 1;
        }
        .gallery-upload-item:hover .gallery-delete-btn {
          opacity: 1;
        }
        .gallery-upload-add {
          aspect-ratio: 4 / 3;
          border-radius: var(--radius-md);
          border: 2px dashed var(--border);
          display: flex;
          flex-direction: column;
          align-items: center;
          justify-content: center;
          gap: 6px;
          color: var(--text-secondary);
          cursor: pointer;
          transition: border-color 0.2s, color 0.2s;
          font-size: 0.8rem;
        }
        .gallery-upload-add:hover {
          border-color: var(--accent);
          color: var(--accent);
        }
        @media (max-width: 600px) {
          .gallery-upload-grid {
            grid-template-columns: repeat(3, 1fr);
          }
        }
        @media (max-width: 400px) {
          .gallery-upload-grid {
            grid-template-columns: repeat(2, 1fr);
          }
        }
      </style>
    </div>

    <!-- ═══════════════════════════════════════
         TAB 2: OFERTE
         ═══════════════════════════════════════ -->
    <div class="tab-panel" id="tab-oferte">
      <div class="offers-header">
        <span class="offers-count"><%= offers.length %> ofert<%= offers.length === 1 ? 'ă' : 'e' %></span>
        <a href="/portal/<%= business.id %>/oferta-noua" class="btn-accent">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Adaugă ofertă
        </a>
      </div>

      <% if (offers.length === 0) { %>
        <div class="empty-state">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
          <p>Nu ai nicio ofertă încă.<br>Adaugă prima ta ofertă pentru a atrage clienți!</p>
          <a href="/portal/<%= business.id %>/oferta-noua" class="btn-accent">Adaugă ofertă</a>
        </div>
      <% } else { %>
        <% offers.forEach(function(offer) { %>
          <div class="offer-card" id="offer-<%= offer.id %>">
            <div class="offer-thumb">
              <% if (offer.logo_url) { %>
                <img src="<%= offer.logo_url %>" alt="<%= offer.title %>" width="80" height="80" loading="lazy">
              <% } else { %>
                <svg class="offer-thumb-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
              <% } %>
            </div>
            <div class="offer-info">
              <div class="offer-title"><%= offer.title %></div>
              <div class="offer-meta">
                <span class="offer-discount">
                  <% if (offer.discount_type === 'percentage') { %>
                    -<%= offer.discount_value %>%
                  <% } else { %>
                    -<%= offer.discount_value %> lei
                  <% } %>
                </span>
                <span class="offer-dates">
                  <%= new Date(offer.start_date).toLocaleDateString('ro-RO', { day: 'numeric', month: 'short' }) %>
                  —
                  <%= new Date(offer.end_date).toLocaleDateString('ro-RO', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                </span>
              </div>
            </div>
            <div class="offer-actions">
              <button class="toggle-btn <%= offer.is_active ? 'on' : 'off' %>"
                      onclick="toggleOffer(<%= offer.id %>, this)"
                      title="<%= offer.is_active ? 'Activă' : 'Inactivă' %>"></button>
              <a href="/portal/<%= business.id %>/oferta/<%= offer.id %>" class="offer-edit-link" title="Editează">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
              </a>
            </div>
          </div>
        <% }); %>
      <% } %>
    </div>

    <!-- ═══════════════════════════════════════
         TAB 3: RECENZII
         ═══════════════════════════════════════ -->
    <div class="tab-panel" id="tab-recenzii">
      <% if (reviews.length === 0) { %>
        <div class="empty-state">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          <p>Nu ai nicio recenzie încă.<br>Recenziile vor apărea pe măsură ce clienții vizitează pagina ta.</p>
        </div>
      <% } else { %>
        <% reviews.forEach(function(review) { %>
          <div class="review-card" id="review-<%= review.id %>">
            <div class="review-header">
              <div class="review-avatar">
                <%= review.first_name ? review.first_name.charAt(0).toUpperCase() : '?' %>
              </div>
              <div class="review-user-info">
                <div class="review-user-name"><%= review.first_name || '' %> <%= review.last_name || '' %></div>
                <div class="review-date"><%= new Date(review.created_at).toLocaleDateString('ro-RO', { day: 'numeric', month: 'long', year: 'numeric' }) %></div>
              </div>
            </div>

            <div class="review-stars">
              <% for (var s = 1; s <= 5; s++) { %>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="<%= s <= review.rating ? '#fb923c' : 'none' %>" stroke="<%= s <= review.rating ? '#fb923c' : '#52525b' %>" stroke-width="1.5"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <% } %>
            </div>

            <% if (review.comment) { %>
              <div class="review-comment"><%= review.comment %></div>
            <% } %>

            <!-- Response Section -->
            <% if (review.response_id) { %>
              <div class="review-response" id="response-<%= review.id %>">
                <div class="review-response-header">
                  <span class="review-response-label">Răspunsul tău</span>
                  <div class="review-response-actions">
                    <button class="btn-sm" onclick="editResponse(<%= review.id %>, this)">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                      Editează
                    </button>
                    <button class="btn-sm danger" onclick="deleteResponse(<%= review.id %>)">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                      Șterge
                    </button>
                  </div>
                </div>
                <div class="review-response-text"><%= review.response_text %></div>
                <div class="review-response-date"><%= new Date(review.response_date).toLocaleDateString('ro-RO', { day: 'numeric', month: 'long', year: 'numeric' }) %></div>
              </div>
            <% } %>

            <!-- Response Form (hidden by default) -->
            <div class="response-form" id="response-form-<%= review.id %>" style="display: none;">
              <textarea id="response-text-<%= review.id %>"
                        maxlength="500"
                        placeholder="Scrie un răspuns..."
                        oninput="updateCharCount(<%= review.id %>)"><%= review.response_id ? review.response_text : '' %></textarea>
              <div class="response-char-count" id="char-count-<%= review.id %>">0 / 500</div>
              <div class="response-form-actions">
                <button class="btn-sm" onclick="cancelResponse(<%= review.id %>)">Anulează</button>
                <button class="btn-accent" style="padding: 6px 16px; font-size: 0.8rem;" onclick="submitResponse(<%= review.id %>)">
                  <span id="response-btn-text-<%= review.id %>">Trimite</span>
                </button>
              </div>
            </div>

            <% if (!review.response_id) { %>
              <button class="btn-sm" style="margin-top: 10px;" id="respond-btn-<%= review.id %>" onclick="showResponseForm(<%= review.id %>, false)">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                Răspunde
              </button>
            <% } %>
          </div>
        <% }); %>
      <% } %>
    </div>

    <!-- ═══════════════════════════════════════
         TAB 4: STATISTICI
         ═══════════════════════════════════════ -->
    <div class="tab-panel" id="tab-statistici">

      <!-- Performance Score -->
      <div class="glass-card">
        <h3 class="section-title">Scor Performanță</h3>
        <div class="score-card">
          <div class="score-circle-wrap">
            <%
              var scoreVal = score.score || 0;
              var scoreMax = score.max_score || 100;
              var scorePercent = scoreMax > 0 ? (scoreVal / scoreMax) * 100 : 0;
              var scoreColor = scorePercent >= 70 ? '#22c55e' : (scorePercent >= 40 ? '#eab308' : '#ef4444');
              var circumference = 2 * Math.PI * 50;
              var dashOffset = circumference - (scorePercent / 100) * circumference;
            %>
            <div class="score-circle">
              <svg viewBox="0 0 120 120">
                <circle class="score-circle-bg" cx="60" cy="60" r="50"/>
                <circle class="score-circle-fill" cx="60" cy="60" r="50"
                        stroke="<%= scoreColor %>"
                        stroke-dasharray="<%= circumference %>"
                        stroke-dashoffset="<%= dashOffset %>"/>
              </svg>
              <div class="score-circle-text">
                <span class="score-number" style="color: <%= scoreColor %>"><%= scoreVal %></span>
                <span class="score-max">/ <%= scoreMax %></span>
              </div>
            </div>
            <span class="score-label-text">
              <% if (scorePercent >= 70) { %>Excelent
              <% } else if (scorePercent >= 40) { %>Bine
              <% } else { %>Necesită îmbunătățiri<% } %>
            </span>
          </div>

          <div class="score-breakdown">
            <% if (score.breakdown && score.breakdown.length) { score.breakdown.forEach(function(item) { %>
              <div class="score-breakdown-item">
                <% if (item.completed) { %>
                  <svg class="score-icon-ok" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                <% } else { %>
                  <svg class="score-icon-miss" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                <% } %>
                <span class="score-criterion"><%= item.criterion %></span>
                <span class="score-points"><%= item.earned %>/<%= item.points %></span>
              </div>
            <% }); } %>

            <%
              var tips = [];
              if (score.breakdown && score.breakdown.length) {
                score.breakdown.forEach(function(item) {
                  if (!item.completed && item.tip) tips.push(item.tip);
                });
              }
            %>
            <% if (tips.length > 0) { %>
              <div class="score-tips">
                <div class="score-tips-title">Sfaturi pentru îmbunătățire</div>
                <% tips.forEach(function(tip) { %>
                  <div class="score-tip">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                    <span><%= tip %></span>
                  </div>
                <% }); %>
              </div>
            <% } %>
          </div>
        </div>
      </div>

      <!-- Stats Cards -->
      <%
        var viewsTrend = 0;
        if (analytics.views && analytics.views.prev_7d > 0) {
          viewsTrend = Math.round(((analytics.views.last_7d - analytics.views.prev_7d) / analytics.views.prev_7d) * 100);
        } else if (analytics.views && analytics.views.last_7d > 0) {
          viewsTrend = 100;
        }
      %>
      <div class="stats-grid" style="margin-top: 20px;">
        <div class="stat-card">
          <div class="stat-value"><%= analytics.views ? analytics.views.last_30d : 0 %></div>
          <div class="stat-label">Vizualizări (30 zile)</div>
          <% if (analytics.views && (analytics.views.last_7d > 0 || analytics.views.prev_7d > 0)) { %>
            <div class="stat-trend <%= viewsTrend > 0 ? 'up' : (viewsTrend < 0 ? 'down' : 'neutral') %>">
              <% if (viewsTrend > 0) { %>
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="18 15 12 9 6 15"/></svg>
                +<%= viewsTrend %>%
              <% } else if (viewsTrend < 0) { %>
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="6 9 12 15 18 9"/></svg>
                <%= viewsTrend %>%
              <% } else { %>
                &mdash; 0%
              <% } %>
              <span style="color: var(--text-tertiary); font-weight: 400; margin-left: 2px;">vs săpt. trec.</span>
            </div>
          <% } %>
        </div>
        <div class="stat-card">
          <div class="stat-value"><%= analytics.subscribers || 0 %></div>
          <div class="stat-label">Abonați</div>
        </div>
        <div class="stat-card">
          <div class="stat-value"><%= analytics.reviews ? (Number(analytics.reviews.avg_rating) || 0).toFixed(1) : '0.0' %></div>
          <div class="stat-label">Rating mediu</div>
        </div>
        <div class="stat-card">
          <div class="stat-value"><%= analytics.offers ? analytics.offers.active : 0 %></div>
          <div class="stat-label">Oferte active</div>
        </div>
        <div class="stat-card">
          <div class="stat-value"><%= analytics.offerRequests ? analytics.offerRequests.total : 0 %></div>
          <div class="stat-label">Cereri de ofertă</div>
          <% if (analytics.offerRequests && analytics.offerRequests.uniqueRequesters > 0) { %>
            <div class="stat-subtext"><%= analytics.offerRequests.uniqueRequesters %> utilizator<%= analytics.offerRequests.uniqueRequesters === 1 ? '' : 'i' %> unic<%= analytics.offerRequests.uniqueRequesters === 1 ? '' : 'i' %></div>
          <% } %>
        </div>
        <div class="stat-card">
          <div class="stat-value"><%= analytics.codeReveals ? analytics.codeReveals.last30d : 0 %></div>
          <div class="stat-label">Coduri folosite</div>
        </div>
        <%
          var actionCards = {
            phone: { label: 'Apeluri', icon: '📞' },
            whatsapp: { label: 'WhatsApp', icon: '💬' },
            website: { label: 'Vizite site', icon: '🌐' },
            navigate: { label: 'Direcții', icon: '📍' },
            booking_url: { label: 'Rezervări link', icon: '🔗' },
            share: { label: 'Distribuiri', icon: '📤' },
            copy_code: { label: 'Coduri copiate', icon: '📋' },
            follow: { label: 'Urmăriri noi', icon: '❤️' },
            favorite: { label: 'Favorite', icon: '⭐' }
          };
          var clickCards = [];
          if (analytics.clicks && analytics.clicks.breakdown) {
            analytics.clicks.breakdown.forEach(function(c) {
              if (c.last30d > 0 && actionCards[c.action]) {
                clickCards.push({ value: c.last30d, label: actionCards[c.action].label, icon: actionCards[c.action].icon });
              }
            });
          }
        %>
        <% clickCards.forEach(function(card) { %>
          <div class="stat-card">
            <div class="stat-value"><%= card.value %></div>
            <div class="stat-label"><%= card.icon %> <%= card.label %></div>
          </div>
        <% }); %>
      </div>

      <!-- Rating Distribution -->
      <div class="glass-card">
        <div class="rating-dist-title">Distribuție recenzii</div>
        <%
          var distribution = (analytics.reviews && analytics.reviews.distribution) ? analytics.reviews.distribution : [];
          var maxCount = 0;
          distribution.forEach(function(d) { if (d.count > maxCount) maxCount = d.count; });
        %>
        <% for (var star = 5; star >= 1; star--) {
          var found = distribution.find(function(d) { return d.rating == star; });
          var count = found ? found.count : 0;
          var pct = maxCount > 0 ? (count / maxCount) * 100 : 0;
        %>
          <div class="rating-dist-row">
            <div class="rating-dist-label">
              <%= star %>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="#fb923c" stroke="#fb923c" stroke-width="1.5"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            </div>
            <div class="rating-dist-bar-bg">
              <div class="rating-dist-bar-fill" style="width: <%= pct %>%"></div>
            </div>
            <div class="rating-dist-count"><%= count %></div>
          </div>
        <% } %>
      </div>


      <!-- Charts -->
      <div class="glass-card" style="margin-top: 16px;">
        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-bottom: 20px;">
          <h3 class="section-title" style="border: none; margin: 0; padding: 0;">Grafice</h3>
          <div class="period-selector">
            <button class="period-btn grouping-btn" id="grouping-toggle" onclick="toggleGrouping(this)">Săptămânal</button>
            <span class="period-separator"></span>
            <button class="period-btn" onclick="changePeriod(7, this)">7 zile</button>
            <button class="period-btn active" onclick="changePeriod(30, this)">30 zile</button>
            <button class="period-btn" onclick="changePeriod(90, this)">90 zile</button>
          </div>
        </div>

        <div class="charts-row">
          <div class="chart-section">
            <select id="views-selector" class="chart-dropdown" onchange="onViewsDropdownChange(this)">
              <option value="business">Vizualizări Pagină Business</option>
              <% offers.forEach(function(o) { %>
                <option value="offer-<%= o.id %>"><%= o.title.length > 40 ? o.title.substring(0, 40) + '...' : o.title %></option>
              <% }); %>
            </select>
            <div class="chart-container">
              <canvas id="views-chart"></canvas>
            </div>
          </div>
          <div class="chart-section">
            <div class="chart-title">Abonați noi</div>
            <div class="chart-container">
              <canvas id="subscribers-chart"></canvas>
            </div>
          </div>
          <div class="chart-section">
            <select id="clicks-selector" class="chart-dropdown" onchange="onClicksDropdownChange(this)">
              <option value="phone">Apeluri</option>
              <option value="whatsapp">WhatsApp</option>
              <option value="navigate">Direcții</option>
              <option value="booking_url">Rezervări Link</option>
            </select>
            <div class="chart-container">
              <canvas id="clicks-chart"></canvas>
            </div>
          </div>
        </div>
      </div>

    </div><!-- /tab-statistici -->

  </div><!-- /portal-container -->
</div><!-- /portal-page -->

<%- include('../partials/footer') %>

<script>
(function() {
  var businessId = '<%= business.id %>';
  var currentPeriod = 30;
  var currentViewsMode = 'business';
  var currentClicksAction = 'phone';

  /* ── Toast ── */
  function showToast(message, type) {
    var existing = document.querySelector('.pm-toast');
    if (existing) existing.remove();
    var t = document.createElement('div');
    t.className = 'pm-toast ' + (type || 'success');
    t.textContent = message;
    document.body.appendChild(t);
    setTimeout(function() { if (t.parentNode) t.remove(); }, 3000);
  }

  /* ── Auth-aware fetch with CSRF ── */
  function apiFetch(url, options) {
    var csrfToken = document.querySelector('meta[name="csrf-token"]');
    options = options || {};
    options.headers = options.headers || {};

    // Add CSRF token to headers (unless it's FormData, which can't have custom headers easily)
    if (!(options.body instanceof FormData)) {
      if (typeof options.headers === 'object' && !Array.isArray(options.headers)) {
        options.headers['X-CSRF-Token'] = csrfToken ? csrfToken.getAttribute('content') : '';
      }
    } else {
      // For FormData, we need to set headers differently
      var newHeaders = new Headers(options.headers);
      newHeaders.set('X-CSRF-Token', csrfToken ? csrfToken.getAttribute('content') : '');
      options.headers = newHeaders;
    }

    return fetch(url, options).then(function(res) {
      if (res.status === 401) {
        window.location.href = '/login';
        throw new Error('Unauthorized');
      }
      return res;
    });
  }

  /* ════════════════════════════════
     IMAGE UPLOAD / DELETE
     ════════════════════════════════ */
  window.uploadImage = function(type, input) {
    var file = input.files && input.files[0];
    if (!file) return;

    // Validate file size (max 5MB)
    if (file.size > 5 * 1024 * 1024) {
      showToast('Imaginea nu poate depăși 5MB', 'error');
      input.value = '';
      return;
    }

    var formData = new FormData();
    formData.append(type, file);

    var previewBox = document.getElementById(type + '-preview');
    previewBox.style.opacity = '0.5';

    apiFetch('/api/web/portal/' + businessId + '/' + type, {
      method: 'POST',
      body: formData
    })
    .then(function(res) { return res.json(); })
    .then(function(data) {
      previewBox.style.opacity = '1';
      if (data.url) {
        // Update preview image
        var existingImg = document.getElementById(type + '-img');
        var placeholder = document.getElementById(type + '-placeholder');

        if (existingImg) {
          existingImg.src = data.url;
        } else {
          // Create new img element
          var img = document.createElement('img');
          img.src = data.url;
          img.alt = type === 'logo' ? 'Logo' : 'Cover';
          img.id = type + '-img';
          previewBox.innerHTML = '';
          previewBox.appendChild(img);
        }

        // Show delete button if hidden
        var btnContainer = previewBox.parentNode.querySelector('div[style*="display: flex"]');
        if (btnContainer && !btnContainer.querySelector('.danger')) {
          var delBtn = document.createElement('button');
          delBtn.type = 'button';
          delBtn.className = 'btn-sm danger';
          delBtn.onclick = function() { deleteImage(type); };
          delBtn.innerHTML = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg> Șterge';
          btnContainer.appendChild(delBtn);
        }

        showToast(type === 'logo' ? 'Logo actualizat' : 'Copertă actualizată', 'success');
      } else {
        showToast(data.message || 'Eroare la încărcare', 'error');
      }
    })
    .catch(function() {
      previewBox.style.opacity = '1';
      showToast('Eroare la încărcarea imaginii', 'error');
    });

    input.value = '';
  };

  window.deleteImage = function(type) {
    if (!confirm('Sigur vrei să ștergi această imagine?')) return;

    var previewBox = document.getElementById(type + '-preview');
    previewBox.style.opacity = '0.5';

    apiFetch('/api/web/portal/' + businessId + '/' + type, {
      method: 'DELETE'
    })
    .then(function(res) { return res.json(); })
    .then(function(data) {
      previewBox.style.opacity = '1';
      if (data.success) {
        // Replace with placeholder
        var placeholderText = type === 'logo' ? 'Fără logo' : 'Fără copertă';
        previewBox.innerHTML = '<div class="img-preview-placeholder" id="' + type + '-placeholder">' +
          '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>' +
          placeholderText + '</div>';

        // Remove delete button
        var btnContainer = previewBox.parentNode.querySelector('div[style*="display: flex"]');
        if (btnContainer) {
          var delBtn = btnContainer.querySelector('.danger');
          if (delBtn) delBtn.remove();
        }

        showToast('Imaginea a fost ștearsă', 'success');
      } else {
        showToast(data.message || 'Eroare la ștergere', 'error');
      }
    })
    .catch(function() {
      previewBox.style.opacity = '1';
      showToast('Eroare la ștergerea imaginii', 'error');
    });
  };

  /* ════════════════════════════════
     GALLERY UPLOAD / DELETE
     ════════════════════════════════ */
  window.uploadGalleryImages = function(input) {
    var files = input.files;
    if (!files || !files.length) return;

    var grid = document.getElementById('gallery-grid');
    var currentCount = grid.querySelectorAll('.gallery-upload-item').length;

    // Check total limit
    if (currentCount + files.length > 8) {
      showToast('Maximum 8 imagini. Poți adăuga încă ' + (8 - currentCount) + '.', 'error');
      input.value = '';
      return;
    }

    var addBtn = document.getElementById('gallery-add-btn');

    Array.from(files).forEach(function(file) {
      // Validate size
      if (file.size > 5 * 1024 * 1024) {
        showToast('Fișierul "' + file.name + '" depășește 5MB', 'error');
        return;
      }

      var formData = new FormData();
      formData.append('image', file);

      // Create temporary loading placeholder
      var placeholder = document.createElement('div');
      placeholder.className = 'gallery-upload-item';
      placeholder.style.opacity = '0.5';
      placeholder.innerHTML = '<div style="display:flex;align-items:center;justify-content:center;width:100%;height:100%;color:var(--text-secondary);font-size:0.75rem;">Se încarcă...</div>';
      if (addBtn) grid.insertBefore(placeholder, addBtn);
      else grid.appendChild(placeholder);

      apiFetch('/api/web/portal/' + businessId + '/gallery', {
        method: 'POST',
        body: formData
      })
      .then(function(res) { return res.json(); })
      .then(function(data) {
        if (data.success && data.image) {
          placeholder.style.opacity = '1';
          placeholder.setAttribute('data-image-id', data.image.id);
          placeholder.innerHTML = '<img src="' + data.image.url + '" alt="Galerie" width="120" height="80" loading="lazy">' +
            '<button type="button" class="gallery-delete-btn" onclick="deleteGalleryImage(' + data.image.id + ', this)" title="Șterge imaginea" aria-label="Șterge imaginea">&times;</button>';

          currentCount++;
          // Hide add button if at limit
          if (currentCount >= 8 && addBtn) {
            addBtn.style.display = 'none';
          }

          showToast('Imagine adăugată cu succes', 'success');
        } else {
          placeholder.remove();
          showToast(data.message || 'Eroare la încărcare', 'error');
        }
      })
      .catch(function() {
        placeholder.remove();
        showToast('Eroare la încărcarea imaginii', 'error');
      });
    });

    input.value = '';
  };

  window.deleteGalleryImage = function(imageId, btn) {
    if (!confirm('Sigur vrei să ștergi această imagine din galerie?')) return;

    var item = btn.closest('.gallery-upload-item');
    if (item) item.style.opacity = '0.5';

    apiFetch('/api/web/portal/' + businessId + '/gallery/' + imageId, {
      method: 'DELETE'
    })
    .then(function(res) { return res.json(); })
    .then(function(data) {
      if (data.success) {
        if (item) item.remove();

        // Show add button if was hidden
        var addBtn = document.getElementById('gallery-add-btn');
        if (addBtn) addBtn.style.display = '';

        showToast('Imaginea a fost ștearsă din galerie', 'success');
      } else {
        if (item) item.style.opacity = '1';
        showToast(data.message || 'Eroare la ștergere', 'error');
      }
    })
    .catch(function() {
      if (item) item.style.opacity = '1';
      showToast('Eroare la ștergerea imaginii', 'error');
    });
  };

  /* ════════════════════════════════
     TAB SWITCHING
     ════════════════════════════════ */
  window.switchTab = function(tabName) {
    var panels = document.querySelectorAll('.tab-panel');
    var tabs = document.querySelectorAll('.portal-tab');
    panels.forEach(function(p) { p.classList.remove('active'); });
    tabs.forEach(function(t) { t.classList.remove('active'); });

    var panel = document.getElementById('tab-' + tabName);
    if (panel) panel.classList.add('active');

    // Find matching tab button
    var labels = { info: 'Info', oferte: 'Oferte', recenzii: 'Recenzii', statistici: 'Statistici' };
    tabs.forEach(function(t) {
      if (t.textContent.trim().indexOf(labels[tabName]) === 0) {
        t.classList.add('active');
      }
    });

    // Load charts on first stats tab visit
    if (tabName === 'statistici' && !window._chartsLoaded) {
      window._chartsLoaded = true;
      loadCharts(currentPeriod);
    }

    // Update URL hash
    history.replaceState(null, '', '#' + tabName);
  };

  // Restore tab from hash on load
  (function() {
    var hash = window.location.hash.replace('#', '');
    if (['info', 'oferte', 'recenzii', 'statistici'].indexOf(hash) !== -1) {
      switchTab(hash);
    }
  })();

  /* ════════════════════════════════
     TAB 1: BUSINESS INFO FORM
     ════════════════════════════════ */
  window.selectBookingType = function(type) {
    document.getElementById('booking-type-input').value = type;
    var options = document.querySelectorAll('.booking-option');
    options.forEach(function(o) { o.classList.remove('active'); });
    // Activate clicked
    options.forEach(function(o) {
      var text = o.textContent.trim().toLowerCase();
      var map = { 'niciunul': 'none', 'telefon': 'phone', 'whatsapp': 'whatsapp', 'link': 'url' };
      if (map[text] === type) o.classList.add('active');
    });
    // Show/hide conditional fields
    var fields = ['phone', 'whatsapp', 'url'];
    fields.forEach(function(f) {
      var el = document.getElementById('booking-field-' + f);
      if (el) el.style.display = (f === type) ? '' : 'none';
    });
  };

  window.saveBusinessInfo = function(e) {
    e.preventDefault();
    var form = document.getElementById('business-info-form');
    var btn = document.getElementById('save-info-btn');
    var fd = new FormData(form);
    var data = {};
    fd.forEach(function(val, key) { data[key] = val; });

    btn.disabled = true;
    btn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="animation:spin 1s linear infinite"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg> Se salvează...';

    apiFetch('/api/web/portal/' + businessId, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    })
    .then(function(res) { return res.json().then(function(j) { return { ok: res.ok, data: j }; }); })
    .then(function(result) {
      if (result.ok) {
        showToast('Informațiile au fost salvate cu succes!', 'success');
      } else {
        showToast(result.data.message || 'Eroare la salvare', 'error');
      }
    })
    .catch(function(err) {
      if (err.message !== 'Unauthorized') showToast('Eroare de rețea', 'error');
    })
    .finally(function() {
      btn.disabled = false;
      btn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg> Salvează modificările';
    });

    return false;
  };

  /* ════════════════════════════════
     TAB 2: OFFERS TOGGLE
     ════════════════════════════════ */
  window.toggleOffer = function(offerId, btn) {
    var isOn = btn.classList.contains('on');
    apiFetch('/api/web/portal/' + businessId + '/offers/' + offerId + '/toggle', {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' }
    })
    .then(function(res) { return res.json().then(function(j) { return { ok: res.ok, data: j }; }); })
    .then(function(result) {
      if (result.ok) {
        if (isOn) {
          btn.classList.remove('on');
          btn.classList.add('off');
          btn.title = 'Inactivă';
        } else {
          btn.classList.remove('off');
          btn.classList.add('on');
          btn.title = 'Activă';
        }
        showToast(isOn ? 'Oferta a fost dezactivată' : 'Oferta a fost activată', 'success');
      } else {
        showToast(result.data.message || 'Eroare', 'error');
      }
    })
    .catch(function(err) {
      if (err.message !== 'Unauthorized') showToast('Eroare de rețea', 'error');
    });
  };

  /* ════════════════════════════════
     TAB 3: REVIEWS
     ════════════════════════════════ */
  window.updateCharCount = function(reviewId) {
    var textarea = document.getElementById('response-text-' + reviewId);
    var counter = document.getElementById('char-count-' + reviewId);
    if (textarea && counter) {
      counter.textContent = textarea.value.length + ' / 500';
    }
  };

  window.showResponseForm = function(reviewId, isEdit) {
    var form = document.getElementById('response-form-' + reviewId);
    var respondBtn = document.getElementById('respond-btn-' + reviewId);
    if (form) {
      form.style.display = '';
      var btnText = document.getElementById('response-btn-text-' + reviewId);
      if (btnText) btnText.textContent = isEdit ? 'Actualizează' : 'Trimite';
      form.dataset.mode = isEdit ? 'edit' : 'create';
      updateCharCount(reviewId);
    }
    if (respondBtn) respondBtn.style.display = 'none';
  };

  window.cancelResponse = function(reviewId) {
    var form = document.getElementById('response-form-' + reviewId);
    var respondBtn = document.getElementById('respond-btn-' + reviewId);
    if (form) form.style.display = 'none';
    if (respondBtn) respondBtn.style.display = '';
  };

  window.editResponse = function(reviewId) {
    var responseEl = document.getElementById('response-' + reviewId);
    if (responseEl) responseEl.style.display = 'none';
    showResponseForm(reviewId, true);
  };

  window.submitResponse = function(reviewId) {
    var textarea = document.getElementById('response-text-' + reviewId);
    var text = textarea ? textarea.value.trim() : '';
    if (!text) { showToast('Scrie un răspuns', 'error'); return; }
    if (text.length > 500) { showToast('Răspunsul nu poate depăși 500 de caractere', 'error'); return; }

    var form = document.getElementById('response-form-' + reviewId);
    var isEdit = form && form.dataset.mode === 'edit';
    var method = isEdit ? 'PUT' : 'POST';

    apiFetch('/api/web/portal/' + businessId + '/reviews/' + reviewId + '/respond', {
      method: method,
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ text: text })
    })
    .then(function(res) { return res.json().then(function(j) { return { ok: res.ok, data: j }; }); })
    .then(function(result) {
      if (result.ok) {
        showToast(isEdit ? 'Răspunsul a fost actualizat' : 'Răspunsul a fost trimis', 'success');
        // Reload to show updated response
        setTimeout(function() { window.location.reload(); }, 800);
      } else {
        showToast(result.data.message || 'Eroare', 'error');
      }
    })
    .catch(function(err) {
      if (err.message !== 'Unauthorized') showToast('Eroare de rețea', 'error');
    });
  };

  window.deleteResponse = function(reviewId) {
    if (!confirm('Ești sigur că vrei să ștergi acest răspuns?')) return;

    apiFetch('/api/web/portal/' + businessId + '/reviews/' + reviewId + '/respond', {
      method: 'DELETE',
      headers: { 'Content-Type': 'application/json' }
    })
    .then(function(res) { return res.json().then(function(j) { return { ok: res.ok, data: j }; }); })
    .then(function(result) {
      if (result.ok) {
        showToast('Răspunsul a fost șters', 'success');
        setTimeout(function() { window.location.reload(); }, 800);
      } else {
        showToast(result.data.message || 'Eroare', 'error');
      }
    })
    .catch(function(err) {
      if (err.message !== 'Unauthorized') showToast('Eroare de rețea', 'error');
    });
  };

  /* ════════════════════════════════
     TAB 4: STATISTICS & CHARTS
     ════════════════════════════════ */
  var isWeekly = false;
  var rawChartData = { views: [], subscribers: [], clicks: [] };

  window.changePeriod = function(days, btn) {
    currentPeriod = days;
    var buttons = document.querySelectorAll('.period-btn');
    buttons.forEach(function(b) { b.classList.remove('active'); });
    if (btn) btn.classList.add('active');
    loadCharts(days);
  };

  window.toggleGrouping = function(btn) {
    isWeekly = !isWeekly;
    if (isWeekly) {
      btn.classList.add('active');
      btn.textContent = 'Zilnic';
    } else {
      btn.classList.remove('active');
      btn.textContent = 'Săptămânal';
    }
    rerenderCharts();
  };

  function groupByWeek(dataArr, valueKey) {
    if (!dataArr || dataArr.length === 0) return [];
    var weeks = [];
    var weekSum = 0;
    var weekStart = dataArr[0].date || '';
    var weekEnd = '';
    var count = 0;

    dataArr.forEach(function(item, i) {
      weekSum += item[valueKey] || 0;
      weekEnd = item.date || '';
      count++;

      if (count === 7 || i === dataArr.length - 1) {
        var startParts = weekStart.split('-');
        var endParts = weekEnd.split('-');
        var label = startParts[2] + '/' + startParts[1] + '-' + endParts[2] + '/' + endParts[1];
        var entry = { date: label };
        entry[valueKey] = weekSum;
        weeks.push(entry);
        weekSum = 0;
        weekStart = (i + 1 < dataArr.length) ? (dataArr[i + 1].date || '') : '';
        count = 0;
      }
    });
    return weeks;
  }

  /* ── Chart.js instances ── */
  var chartInstances = {};

  function renderChart(canvasId, dataArr, label, valueKey) {
    // Destroy existing chart instance
    if (chartInstances[canvasId]) {
      chartInstances[canvasId].destroy();
      chartInstances[canvasId] = null;
    }

    var canvas = document.getElementById(canvasId);
    if (!canvas) return;

    if (!dataArr || dataArr.length === 0) {
      var parent = canvas.parentNode;
      parent.innerHTML = '<div class="chart-loading">Nu sunt date disponibile</div>';
      return;
    }

    // Build labels and values
    var labels = [];
    var values = [];
    dataArr.forEach(function(item) {
      var dateLabel = item.date || item.label || '';
      // Format short date: "2025-02-14" → "14/02"
      if (dateLabel && dateLabel.indexOf('-') !== -1 && dateLabel.length === 10) {
        var parts = dateLabel.split('-');
        dateLabel = parts[2] + '/' + parts[1];
      }
      labels.push(dateLabel);
      values.push((valueKey && item[valueKey] !== undefined) ? item[valueKey] : (item.count || item.value || 0));
    });

    var ctx = canvas.getContext('2d');
    chartInstances[canvasId] = new Chart(ctx, {
      type: 'bar',
      data: {
        labels: labels,
        datasets: [{
          label: label,
          data: values,
          backgroundColor: 'rgba(251, 146, 60, 0.7)',
          borderColor: '#fb923c',
          borderWidth: 1,
          borderRadius: 4,
          borderSkipped: 'bottom',
          maxBarThickness: 40,
          barPercentage: 0.8,
          categoryPercentage: 0.7,
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        layout: { padding: { right: 4, bottom: 4 } },
        plugins: {
          legend: { display: false },
          tooltip: {
            backgroundColor: '#27272a',
            titleColor: '#f4f4f5',
            bodyColor: '#f4f4f5',
            borderColor: 'rgba(255,255,255,0.1)',
            borderWidth: 1,
            cornerRadius: 6,
            padding: 8,
            displayColors: false,
            callbacks: {
              title: function(items) { return items[0].label || ''; },
              label: function(item) { return item.raw + ' ' + label; }
            }
          }
        },
        scales: {
          x: {
            grid: { display: false },
            ticks: {
              color: '#71717a',
              font: { size: 10 },
              maxRotation: 45,
              minRotation: 0,
              maxTicksLimit: 8,
              autoSkip: true,
            },
            border: { display: false }
          },
          y: {
            beginAtZero: true,
            grid: { color: 'rgba(255,255,255,0.04)' },
            ticks: {
              color: '#71717a',
              font: { size: 10 },
              precision: 0,
            },
            border: { display: false }
          }
        },
        animation: {
          duration: 400,
          easing: 'easeOutQuart'
        }
      }
    });
  }

  function rerenderCharts() {
    var vData = isWeekly ? groupByWeek(rawChartData.views, 'views') : rawChartData.views;
    var sData = isWeekly ? groupByWeek(rawChartData.subscribers, 'new_subscribers') : rawChartData.subscribers;
    var cData = isWeekly ? groupByWeek(rawChartData.clicks, 'clicks') : rawChartData.clicks;

    renderChart('views-chart', vData, 'vizualizări', 'views');
    renderChart('subscribers-chart', sData, 'abonați', 'new_subscribers');
    renderChart('clicks-chart', cData, 'click-uri', 'clicks');
  }

  function loadViewsChart(days) {
    var url;
    if (currentViewsMode === 'business') {
      url = '/api/web/portal/' + businessId + '/analytics/views?days=' + days;
    } else {
      var offerId = currentViewsMode.replace('offer-', '');
      url = '/api/web/portal/' + businessId + '/analytics/offer-views?days=' + days + '&offer_id=' + offerId;
    }
    apiFetch(url)
      .then(function(res) { return res.json(); })
      .then(function(data) {
        rawChartData.views = data.data || data || [];
        var displayData = isWeekly ? groupByWeek(rawChartData.views, 'views') : rawChartData.views;
        renderChart('views-chart', displayData, 'vizualizări', 'views');
      })
      .catch(function(err) { console.error('[Charts] Views error:', err); });
  }

  function loadSubscribersChart(days) {
    apiFetch('/api/web/portal/' + businessId + '/analytics/subscribers?days=' + days)
      .then(function(res) { return res.json(); })
      .then(function(data) {
        rawChartData.subscribers = data.data || data || [];
        var displayData = isWeekly ? groupByWeek(rawChartData.subscribers, 'new_subscribers') : rawChartData.subscribers;
        renderChart('subscribers-chart', displayData, 'abonați', 'new_subscribers');
      })
      .catch(function(err) { console.error('[Charts] Subscribers error:', err); });
  }

  function loadClicksChart(days) {
    apiFetch('/api/web/portal/' + businessId + '/analytics/clicks?days=' + days + '&action_type=' + currentClicksAction)
      .then(function(res) { return res.json(); })
      .then(function(data) {
        rawChartData.clicks = data.data || data || [];
        var displayData = isWeekly ? groupByWeek(rawChartData.clicks, 'clicks') : rawChartData.clicks;
        renderChart('clicks-chart', displayData, 'click-uri', 'clicks');
      })
      .catch(function(err) { console.error('[Charts] Clicks error:', err); });
  }

  function loadCharts(days) {
    currentPeriod = days;
    loadViewsChart(days);
    loadSubscribersChart(days);
    loadClicksChart(days);
  }

  window.onViewsDropdownChange = function(sel) {
    currentViewsMode = sel.value;
    loadViewsChart(currentPeriod);
  };

  window.onClicksDropdownChange = function(sel) {
    currentClicksAction = sel.value;
    loadClicksChart(currentPeriod);
  };

  /* ── Spin animation for loading button ── */
  var styleEl = document.createElement('style');
  styleEl.textContent = '@keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }';
  document.head.appendChild(styleEl);

})();
</script>