      <form id="business-info-form" onsubmit="return saveBusinessInfo(event)">
        <div class="glass-card">
          <h3 class="section-title">Informații generale</h3>

          <div class="form-group">
            <label class="form-label">Nume</label>
            <input type="text" name="name" class="form-input" value="<%= business.name %>" required>
          </div>

          <div class="form-group">
            <label class="form-label">Descriere</label>
            <textarea name="description" class="form-input" rows="4" maxlength="2000" placeholder="Descrie pe scurt business-ul tău, serviciile oferite..."><%= business.description || '' %></textarea>
          </div>

          <div class="form-group">
            <label class="form-label">Adresă</label>
            <input type="text" name="address" class="form-input" value="<%= business.address || '' %>">
          </div>

          <div class="form-row">
            <div class="form-group">
              <label class="form-label">Telefon</label>
              <input type="text" name="phone" class="form-input" value="<%= business.phone || '' %>">
            </div>
            <div class="form-group">
              <label class="form-label">Website</label>
              <input type="text" name="website" class="form-input" value="<%= business.website || '' %>" placeholder="https://">
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label class="form-label">Oraș</label>
              <select name="city_id" class="form-select">
                <option value="">— Selectează —</option>
                <% cities.forEach(function(c) { %>
                  <option value="<%= c.id %>" <%= business.city_id == c.id ? 'selected' : '' %>><%= c.name %></option>
                <% }); %>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label">Categorie</label>
              <select name="category_id" class="form-select">
                <option value="">— Selectează —</option>
                <% categories.forEach(function(cat) { %>
                  <option value="<%= cat.id %>" <%= business.category_id == cat.id ? 'selected' : '' %>><%= cat.name %></option>
                <% }); %>
              </select>
            </div>
          </div>
        </div>

        <!-- Booking Section -->
        <div class="glass-card" id="booking-section" style="margin-top: 16px;">
          <h3 class="section-title">Rezervări</h3>

          <label class="form-label">Tip rezervare</label>
          <div class="booking-grid">
            <div class="booking-option <%= business.booking_type === 'none' || !business.booking_type ? 'active' : '' %>" onclick="selectBookingType('none')">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
              Niciunul
            </div>
            <div class="booking-option <%= business.booking_type === 'phone' ? 'active' : '' %>" onclick="selectBookingType('phone')">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              Telefon
            </div>
            <div class="booking-option <%= business.booking_type === 'whatsapp' ? 'active' : '' %>" onclick="selectBookingType('whatsapp')">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
              WhatsApp
            </div>
            <div class="booking-option <%= business.booking_type === 'url' ? 'active' : '' %>" onclick="selectBookingType('url')">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
              Link
            </div>
          </div>
          <input type="hidden" name="booking_type" id="booking-type-input" value="<%= business.booking_type || 'none' %>">

          <div class="booking-fields">
            <div class="booking-field" id="booking-field-phone" style="<%= business.booking_type === 'phone' ? '' : 'display:none' %>">
              <div class="form-group">
                <label class="form-label">Telefon rezervări</label>
                <input type="text" name="booking_phone" class="form-input" value="<%= business.booking_phone || '' %>" placeholder="+40 7XX XXX XXX">
              </div>
            </div>
            <div class="booking-field" id="booking-field-whatsapp" style="<%= business.booking_type === 'whatsapp' ? '' : 'display:none' %>">
              <div class="form-group">
                <label class="form-label">Număr WhatsApp</label>
                <input type="text" name="booking_whatsapp" class="form-input" value="<%= business.booking_whatsapp || '' %>" placeholder="+40 7XX XXX XXX">
              </div>
            </div>
            <div class="booking-field" id="booking-field-url" style="<%= business.booking_type === 'url' ? '' : 'display:none' %>">
              <div class="form-group">
                <label class="form-label">Link rezervare</label>
                <input type="text" name="booking_url" class="form-input" value="<%= business.booking_url || '' %>" placeholder="https://">
              </div>
            </div>
          </div>

          <div class="form-group" style="margin-top: 12px;">
            <label class="form-label">Instrucțiuni rezervare</label>
            <textarea name="booking_instructions" class="form-textarea" placeholder="Ex: Rezervările se fac cu minim 2 ore înainte..."><%= business.booking_instructions || '' %></textarea>
          </div>
        </div>

        <!-- Image Uploads -->
        <div class="glass-card" id="images-upload-section" style="margin-top: 16px;">
          <h3 class="section-title">Imagini</h3>
          <div class="img-preview-row">
            <div>
              <div class="img-preview-box" id="logo-preview">
                <% if (business.logo_url) { %>
                  <img src="<%= business.logo_url %>" alt="Logo" id="logo-img" width="100" height="100">
                <% } else { %>
                  <div class="img-preview-placeholder" id="logo-placeholder">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
                    Fără logo
                  </div>
                <% } %>
              </div>
              <p class="img-preview-label">Logo</p>
              <div style="display: flex; gap: 8px; margin-top: 6px; justify-content: center;">
                <label class="btn-sm" style="cursor: pointer;">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                  Încarcă
                  <input type="file" accept="image/*" style="display:none;" onchange="uploadImage('logo', this)">
                </label>
                <% if (business.logo_url) { %>
                  <button type="button" class="btn-sm danger" onclick="deleteImage('logo')">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                    Șterge
                  </button>
                <% } %>
              </div>
            </div>
            <div>
              <div class="img-preview-box" id="cover-preview">
                <% if (business.cover_image_url) { %>
                  <img src="<%= business.cover_image_url %>" alt="Cover" id="cover-img" width="400" height="200">
                <% } else { %>
                  <div class="img-preview-placeholder" id="cover-placeholder">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
                    Fără copertă
                  </div>
                <% } %>
              </div>
              <p class="img-preview-label">Imagine copertă</p>
              <div style="display: flex; gap: 8px; margin-top: 6px; justify-content: center;">
                <label class="btn-sm" style="cursor: pointer;">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                  Încarcă
                  <input type="file" accept="image/*" style="display:none;" onchange="uploadImage('cover', this)">
                </label>
                <% if (business.cover_image_url) { %>
                  <button type="button" class="btn-sm danger" onclick="deleteImage('cover')">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                    Șterge
                  </button>
                <% } %>
              </div>
            </div>
          </div>
        </div>

        <div style="margin-top: 24px; text-align: right;">
          <button type="submit" class="btn-accent" id="save-info-btn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
            Salvează modificările
          </button>
        </div>
      </form>

      <!-- Gallery Upload Section -->
      <div class="glass-card" id="gallery-section" style="margin-top: 16px;">
        <h3 class="section-title">Galerie foto</h3>
        <p style="color: var(--text-secondary); font-size: 0.85rem; margin-bottom: 12px;">
          Maximum <%= tier && tier.plan && tier.plan.max_gallery_images ? tier.plan.max_gallery_images : 8 %> imagini. Recomandat: format landscape, minim 1200x800px.
        </p>
        <div class="gallery-upload-grid" id="gallery-grid">
          <% if (business.images && business.images.length > 0) { %>
            <% business.images.forEach((img) => { %>
              <div class="gallery-upload-item" data-image-id="<%= img.id %>">
                <img src="<%= img.url %>" alt="Galerie" width="120" height="80" loading="lazy">
                <button type="button" class="gallery-delete-btn" onclick="deleteGalleryImage(<%= img.id %>, this)" title="Șterge imaginea" aria-label="Șterge imaginea">&times;</button>
              </div>
            <% }); %>
          <% } %>
          <% const galleryMax = (tier && tier.plan && tier.plan.max_gallery_images) || 8;
             if (!business.images || business.images.length < galleryMax) { %>
            <label class="gallery-upload-add" id="gallery-add-btn">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              <span>Adaugă</span>
              <input type="file" accept="image/*" multiple style="display:none;" onchange="uploadGalleryImages(this)">
            </label>
          <% } %>
        </div>
      </div>

      <!-- ═══════════════════════════════════════
           LOCATIONS SECTION (outside form, like gallery)
           ═══════════════════════════════════════ -->
      <div class="glass-card" id="locations-section" style="margin-top: 16px;">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
          <h3 class="section-title" style="margin-bottom: 0;">Locații</h3>
          <% const maxLocs = (tier && tier.plan && tier.plan.max_locations) || 1;
             const currentLocs = (typeof locations !== 'undefined' && locations) ? locations.length : 0; %>
          <% if (currentLocs < maxLocs) { %>
            <button type="button" class="btn-accent" onclick="loc_showAddForm()" style="font-size: 0.8125rem; padding: 6px 14px;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: -2px;"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              Adaugă locație
            </button>
          <% } else { %>
            <span style="font-size: 0.75rem; color: var(--text-secondary);">
              Limită: <%= currentLocs %>/<%= maxLocs %> locații
              <% if (maxLocs <= 1) { %> — <a href="#tab-subscription" onclick="switchTab('subscription')">Upgrade</a><% } %>
            </span>
          <% } %>
        </div>

        <!-- Add location form (hidden by default) -->
        <div id="loc-add-form" style="display: none; margin-bottom: 16px; padding: 16px; border: 1px solid var(--border-color); border-radius: 12px; background: var(--card-bg);">
          <div style="font-weight: 600; margin-bottom: 12px; color: var(--text-primary);">Locație nouă</div>
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
            <div style="grid-column: 1 / -1;">
              <label style="font-size: 0.8125rem; color: var(--text-secondary); margin-bottom: 4px; display: block;">Adresă *</label>
              <input type="text" id="loc-add-address" class="form-input" placeholder="Str. Exemplu nr. 1" required>
            </div>
            <div>
              <label style="font-size: 0.8125rem; color: var(--text-secondary); margin-bottom: 4px; display: block;">Oraș *</label>
              <select id="loc-add-city" class="form-input">
                <option value="">Selectează</option>
                <% if (typeof cities !== 'undefined' && cities) { cities.forEach(function(c) { %>
                  <option value="<%= c.id %>"><%= c.name %></option>
                <% }); } %>
              </select>
            </div>
            <div>
              <label style="font-size: 0.8125rem; color: var(--text-secondary); margin-bottom: 4px; display: block;">Telefon</label>
              <input type="text" id="loc-add-phone" class="form-input" placeholder="07xx xxx xxx">
            </div>
            <div style="grid-column: 1 / -1;">
              <label style="font-size: 0.8125rem; color: var(--text-secondary); margin-bottom: 4px; display: block;">Link Google Maps</label>
              <div style="display: flex; gap: 8px;">
                <input type="text" id="loc-add-maps-url" class="form-input" placeholder="https://maps.app.goo.gl/..." style="flex: 1;">
                <button type="button" class="btn-secondary" onclick="loc_detectCoords('add')" style="white-space: nowrap; font-size: 0.8125rem;">Detectează</button>
              </div>
            </div>
            <div>
              <label style="font-size: 0.8125rem; color: var(--text-secondary); margin-bottom: 4px; display: block;">Latitudine</label>
              <input type="text" id="loc-add-lat" class="form-input" placeholder="44.4268" readonly style="background: var(--surface-2);">
            </div>
            <div>
              <label style="font-size: 0.8125rem; color: var(--text-secondary); margin-bottom: 4px; display: block;">Longitudine</label>
              <input type="text" id="loc-add-lng" class="form-input" placeholder="26.1025" readonly style="background: var(--surface-2);">
            </div>
          </div>
          <div style="display: flex; gap: 8px; margin-top: 12px; justify-content: flex-end;">
            <button type="button" class="btn-secondary" onclick="loc_hideAddForm()">Anulează</button>
            <button type="button" class="btn-accent" onclick="loc_create()">Salvează</button>
          </div>
        </div>

        <!-- Existing locations list -->
        <div id="loc-list">
          <% if (typeof locations !== 'undefined' && locations && locations.length > 0) { %>
            <% locations.forEach(function(loc) { %>
              <div class="loc-card" id="loc-card-<%= loc.id %>" style="padding: 14px; border: 1px solid var(--border-color); border-radius: 10px; margin-bottom: 10px; background: var(--card-bg);">
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                  <div style="grid-column: 1 / -1;">
                    <label style="font-size: 0.75rem; color: var(--text-secondary); margin-bottom: 2px; display: block;">Adresă</label>
                    <input type="text" class="form-input loc-address" value="<%= loc.address %>" data-loc-id="<%= loc.id %>">
                  </div>
                  <div>
                    <label style="font-size: 0.75rem; color: var(--text-secondary); margin-bottom: 2px; display: block;">Oraș</label>
                    <select class="form-input loc-city" data-loc-id="<%= loc.id %>">
                      <% if (typeof cities !== 'undefined' && cities) { cities.forEach(function(c) { %>
                        <option value="<%= c.id %>" <%= c.id === loc.city_id ? 'selected' : '' %>><%= c.name %></option>
                      <% }); } %>
                    </select>
                  </div>
                  <div>
                    <label style="font-size: 0.75rem; color: var(--text-secondary); margin-bottom: 2px; display: block;">Telefon</label>
                    <input type="text" class="form-input loc-phone" value="<%= loc.phone || '' %>" data-loc-id="<%= loc.id %>">
                  </div>
                  <div style="grid-column: 1 / -1;">
                    <label style="font-size: 0.75rem; color: var(--text-secondary); margin-bottom: 2px; display: block;">Link Google Maps</label>
                    <div style="display: flex; gap: 8px;">
                      <input type="text" class="form-input loc-maps-url" value="<%= loc.maps_url || '' %>" data-loc-id="<%= loc.id %>" style="flex: 1;">
                      <button type="button" class="btn-secondary" onclick="loc_detectCoords('<%= loc.id %>')" style="white-space: nowrap; font-size: 0.8125rem;">Detectează</button>
                    </div>
                  </div>
                  <div>
                    <label style="font-size: 0.75rem; color: var(--text-secondary); margin-bottom: 2px; display: block;">Lat</label>
                    <input type="text" class="form-input loc-lat" value="<%= loc.lat || '' %>" data-loc-id="<%= loc.id %>" readonly style="background: var(--surface-2);">
                  </div>
                  <div>
                    <label style="font-size: 0.75rem; color: var(--text-secondary); margin-bottom: 2px; display: block;">Lng</label>
                    <input type="text" class="form-input loc-lng" value="<%= loc.lng || '' %>" data-loc-id="<%= loc.id %>" readonly style="background: var(--surface-2);">
                  </div>
                </div>
                <div style="display: flex; gap: 8px; margin-top: 10px; justify-content: flex-end; align-items: center;">
                  <button type="button" class="btn-secondary" style="font-size: 0.8125rem;" onclick="hrs_toggle(<%= loc.id %>)">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: -2px;"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    Program
                  </button>
                  <span style="flex: 1;"></span>
                  <button type="button" class="btn-secondary" style="color: #ef4444; font-size: 0.8125rem;" onclick="loc_delete(<%= loc.id %>)">Șterge</button>
                  <button type="button" class="btn-accent" style="font-size: 0.8125rem;" onclick="loc_update(<%= loc.id %>)">Salvează</button>
                </div>

                <!-- Opening Hours Editor (collapsed by default) -->
                <div class="hrs-panel" id="hrs-panel-<%= loc.id %>" style="display: none; margin-top: 12px; padding: 12px; border: 1px solid var(--border-color); border-radius: 8px; background: rgba(255,255,255,0.02);">
                  <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px;">
                    <span style="font-size: 0.8125rem; font-weight: 600; color: var(--text-primary);">Program de lucru</span>
                    <span class="hrs-status" id="hrs-status-<%= loc.id %>" style="font-size: 0.75rem; padding: 2px 8px; border-radius: 10px;"></span>
                  </div>
                  <div id="hrs-grid-<%= loc.id %>" style="display: grid; gap: 6px;"></div>
                  <div style="display: flex; gap: 8px; margin-top: 10px; justify-content: flex-end; flex-wrap: wrap;">
                    <% if (typeof locations !== 'undefined' && locations && locations.length > 1) { %>
                      <button type="button" class="btn-secondary" style="font-size: 0.8125rem;" onclick="hrs_copyAll(<%= loc.id %>)">Copiază la toate</button>
                    <% } %>
                    <button type="button" class="btn-accent" style="font-size: 0.8125rem;" onclick="hrs_save(<%= loc.id %>)">Salvează program</button>
                  </div>
                </div>
              </div>
            <% }); %>
          <% } else { %>
            <div id="loc-empty" style="text-align: center; padding: 24px; color: var(--text-secondary); font-size: 0.875rem;">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin-bottom: 8px; opacity: 0.5;"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              <p>Nicio locație adăugată.</p>
            </div>
          <% } %>
        </div>
      </div>

      <% if (tier && tier.plan && tier.plan.has_competitor_blocking) { %>
      <div class="glass-card" style="margin-top: 24px;">
        <div style="display: flex; align-items: center; justify-content: space-between; gap: 16px;">
          <div>
            <div style="font-weight: 600; color: var(--text-primary); margin-bottom: 4px;">
              Blocheaza ofertele competitorilor
            </div>
            <div style="font-size: 0.8125rem; color: var(--text-secondary);">
              Impiedica afisarea ofertelor altor business-uri din aceeasi categorie pe paginile ofertelor tale.
            </div>
          </div>
          <button class="toggle-btn <%= typeof competitorBlockingEnabled !== 'undefined' && competitorBlockingEnabled !== false ? 'on' : 'off' %>"
                  id="competitor-blocking-toggle"
                  onclick="toggleCompetitorBlocking(this)"
                  title="<%= typeof competitorBlockingEnabled !== 'undefined' && competitorBlockingEnabled !== false ? 'Activ' : 'Inactiv' %>"></button>
        </div>
      </div>
      <% } %>

<!-- Concierge CTA (tier-gated via concierge-section) -->
<div class="concierge-section portal-section" style="margin-top: 20px;">
  <div style="background: linear-gradient(135deg, rgba(251,146,60,0.06), rgba(251,146,60,0.02)); border: 1px solid rgba(251,146,60,0.15); border-radius: 12px; padding: 20px; text-align: center;">
    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 8px;"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
    <h4 style="margin: 0 0 6px; font-size: 15px;">Ai nevoie de ajutor?</h4>
