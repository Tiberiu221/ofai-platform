<!-- ═══════════════════════════════════════════════════════
     TOOLS TAB — Utility tools for business owners
     ═══════════════════════════════════════════════════════ -->

<h2 class="tab-section-title" style="margin-bottom: 8px;">Tool-uri utile</h2>
<p style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 24px;">
  Instrumente gratuite care te ajuta sa-ti pregatesti imaginile si materialele pentru profil.
</p>

<div class="tools-grid">

  <!-- QR Code Generator -->
  <a href="/tools/qr-code?url=https://ofai.ro/b/<%= business.id %>" target="_blank" class="tool-card">
    <div class="tool-card-icon">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <rect x="2" y="2" width="7" height="7" rx="1"/><rect x="15" y="2" width="7" height="7" rx="1"/>
        <rect x="2" y="15" width="7" height="7" rx="1"/>
        <rect x="15" y="15" width="2.5" height="2.5"/><rect x="19.5" y="15" width="2.5" height="2.5"/>
        <rect x="15" y="19.5" width="2.5" height="2.5"/><rect x="19.5" y="19.5" width="2.5" height="2.5"/>
        <rect x="10.5" y="2" width="3" height="3"/><rect x="10.5" y="6.5" width="3" height="2.5"/>
        <rect x="2" y="10.5" width="3" height="3"/><rect x="6.5" y="10.5" width="2.5" height="3"/>
        <rect x="10.5" y="10.5" width="3" height="3" rx="0.5"/>
      </svg>
    </div>
    <div class="tool-card-body">
      <h3 class="tool-card-title">Generator QR Code</h3>
      <p class="tool-card-desc">Genereaza un cod QR cu link-ul paginii tale de business. Perfect pentru vitrine, meniuri, flyere sau materiale promotionale.</p>
    </div>
    <span class="tool-card-action">
      Deschide
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
    </span>
  </a>

  <!-- SVG → PNG / JPEG Converter -->
  <a href="/tools/svg-to-png" target="_blank" class="tool-card">
    <div class="tool-card-icon">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
        <polyline points="14 2 14 8 20 8"/>
        <path d="M10 12l2 2 2-2"/>
        <line x1="12" y1="18" x2="12" y2="14"/>
      </svg>
    </div>
    <div class="tool-card-body">
      <h3 class="tool-card-title">SVG &rarr; PNG / JPEG</h3>
      <p class="tool-card-desc">Converteste fisiere SVG in format PNG sau JPEG cu dimensiuni personalizate. Ideal pentru pregatirea logo-ului sau a altor imagini vectoriale.</p>
    </div>
    <span class="tool-card-action">
      Deschide
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
    </span>
  </a>

</div>
