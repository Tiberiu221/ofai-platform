<%- include('../partials/head', { pageTitle: 'Business Portal', activePage: 'portal' }) %>
<%- include('../partials/navbar', { activePage: 'portal', webUser: webUser }) %>

<!-- ═══════════════════════════════════════════════════════
     PORTAL DASHBOARD — STYLES
     ═══════════════════════════════════════════════════════ -->
<style>
  /* ─── Page Header ─────────────────────────────────────── */
  .portal-header {
    padding: 120px 0 48px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .portal-header-glow {
    position: absolute;
    top: -20%;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 400px;
    background: radial-gradient(ellipse, var(--accent-muted) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  .portal-header .container {
    position: relative;
    z-index: 1;
  }

  .portal-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.15;
    margin-bottom: 12px;
  }

  .portal-subtitle {
    color: var(--text-secondary);
    font-size: 1.0625rem;
    font-weight: 400;
  }

  .portal-subtitle svg {
    display: inline-block;
    vertical-align: -2px;
    margin-right: 6px;
    color: var(--accent);
  }

  /* ─── Business Grid ───────────────────────────────────── */
  .portal-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--container-px);
  }

  @media (max-width: 1024px) {
    .portal-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .portal-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ─── Business Card ───────────────────────────────────── */
  .portal-card {
    display: block;
    position: relative;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: transform 0.4s var(--ease-smooth),
                border-color 0.4s var(--ease-smooth),
                box-shadow 0.4s var(--ease-smooth);
    cursor: pointer;
  }

  .portal-card:hover {
    transform: translateY(-6px);
    border-color: var(--border-hover);
    box-shadow: 0 20px 60px -12px rgba(251, 146, 60, 0.15),
                0 0 0 1px var(--border-hover);
  }

  /* Cover */
  .portal-card-cover {
    position: relative;
    width: 100%;
    height: 160px;
    overflow: hidden;
  }

  .portal-card-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-smooth);
  }

  .portal-card:hover .portal-card-cover img {
    transform: scale(1.05);
  }

  .portal-card-cover-fallback {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, rgba(251, 146, 60, 0.15) 0%, rgba(251, 146, 60, 0.03) 100%);
  }

  .portal-card-cover-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(6, 6, 10, 0.85) 0%, transparent 60%);
  }

  /* Logo */
  .portal-card-logo {
    position: absolute;
    bottom: -28px;
    left: 20px;
    width: 56px;
    height: 56px;
    border-radius: var(--radius-full);
    border: 3px solid var(--bg-primary);
    overflow: hidden;
    background: var(--bg-surface);
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .portal-card-logo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .portal-card-logo-letter {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--accent);
    line-height: 1;
  }

  /* Card Body */
  .portal-card-body {
    padding: 40px 20px 20px;
  }

  .portal-card-name {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 10px;
    line-height: 1.3;
  }

  .portal-card-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 14px;
  }

  .portal-card-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 10px;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-secondary);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    white-space: nowrap;
  }

  .portal-card-badge svg {
    flex-shrink: 0;
    opacity: 0.6;
  }

  /* Offers count */
  .portal-card-offers {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8125rem;
    color: var(--accent);
    font-weight: 600;
  }

  .portal-card-offers .offers-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
    animation: pulse-dot 2s ease-in-out infinite;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  /* Card Arrow */
  .portal-card-arrow {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.06);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.3s var(--ease-smooth),
                transform 0.3s var(--ease-smooth);
    z-index: 2;
  }

  .portal-card-arrow svg {
    color: var(--text-tertiary);
    transition: color 0.3s var(--ease-smooth);
  }

  .portal-card:hover .portal-card-arrow {
    background: var(--accent);
    transform: translate(2px, -2px);
  }

  .portal-card:hover .portal-card-arrow svg {
    color: #09090b;
  }

  /* ─── Empty State ─────────────────────────────────────── */
  .portal-empty {
    text-align: center;
    padding: 80px var(--container-px);
    max-width: 520px;
    margin: 0 auto;
  }

  .portal-empty-icon {
    width: 80px;
    height: 80px;
    border-radius: var(--radius-lg);
    background: var(--accent-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 24px;
  }

  .portal-empty-icon svg {
    color: var(--accent);
  }

  .portal-empty-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 8px;
  }

  .portal-empty-desc {
    color: var(--text-secondary);
    font-size: 0.9375rem;
    line-height: 1.6;
    margin-bottom: 28px;
  }

  .portal-empty-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 28px;
    background: var(--accent);
    color: #09090b;
    font-weight: 600;
    font-size: 0.9375rem;
    border-radius: var(--radius-full);
    transition: background 0.3s var(--ease-smooth),
                transform 0.2s var(--ease-smooth);
  }

  .portal-empty-btn:hover {
    background: var(--accent-hover);
    transform: translateY(-2px);
  }

  /* ─── Section spacing ─────────────────────────────────── */
  .portal-section {
    padding: 0 0 80px;
  }
</style>

<!-- ═══════════════════════════════════════════════════════
     PAGE HEADER
     ═══════════════════════════════════════════════════════ -->
<section class="portal-header">
  <div class="portal-header-glow"></div>
  <div class="container">
    <h1 class="portal-title text-gradient reveal">Business Portal</h1>
    <p class="portal-subtitle reveal reveal-delay-1">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
        <polyline points="9 22 9 12 15 12 15 22"/>
      </svg>
      Gestionează business-urile tale
    </p>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════
     CONTENT
     ═══════════════════════════════════════════════════════ -->
<section class="portal-section">

  <% if (!businesses || businesses.length === 0) { %>

    <!-- ─── Empty State ──────────────────────────────────── -->
    <div class="portal-empty reveal">
      <div class="portal-empty-icon">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
          <polyline points="9 22 9 12 15 12 15 22"/>
        </svg>
      </div>
      <h2 class="portal-empty-title">Nu ai niciun business asociat</h2>
      <p class="portal-empty-desc">
        Adaugă primul tău business pe OFAI și începe să creezi oferte pentru clienții tăi din toată România.
      </p>
      <a href="/pentru-business" class="portal-empty-btn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="12" y1="5" x2="12" y2="19"/>
          <line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
        Adaugă un business
      </a>
    </div>

  <% } else { %>

    <!-- ─── Business Grid ────────────────────────────────── -->
    <div class="portal-grid">
      <% businesses.forEach(function(biz, index) { %>
        <a href="/portal/<%= biz.id %>" class="portal-card reveal reveal-delay-<%= Math.min(index + 1, 5) %>">

          <!-- Arrow -->
          <div class="portal-card-arrow">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="7" y1="17" x2="17" y2="7"/>
              <polyline points="7 7 17 7 17 17"/>
            </svg>
          </div>

          <!-- Cover Image -->
          <div class="portal-card-cover">
            <% if (biz.cover_image_url) { %>
              <img src="<%= biz.cover_image_url %>" alt="<%= biz.name %>">
            <% } else { %>
              <div class="portal-card-cover-fallback"></div>
            <% } %>
            <div class="portal-card-cover-overlay"></div>

            <!-- Logo -->
            <div class="portal-card-logo">
              <% if (biz.logo_url) { %>
                <img src="<%= biz.logo_url %>" alt="<%= biz.name %>">
              <% } else { %>
                <span class="portal-card-logo-letter"><%= biz.name.charAt(0).toUpperCase() %></span>
              <% } %>
            </div>
          </div>

          <!-- Card Body -->
          <div class="portal-card-body">
            <h3 class="portal-card-name"><%= biz.name %></h3>

            <div class="portal-card-badges">
              <% if (biz.category_name) { %>
                <span class="portal-card-badge">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect width="18" height="18" x="3" y="4" rx="2" ry="2"/>
                    <line x1="16" x2="16" y1="2" y2="6"/>
                    <line x1="8" x2="8" y1="2" y2="6"/>
                    <line x1="3" x2="21" y1="10" y2="10"/>
                  </svg>
                  <%= biz.category_name %>
                </span>
              <% } %>
              <% if (biz.city_name) { %>
                <span class="portal-card-badge">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
                    <circle cx="12" cy="10" r="3"/>
                  </svg>
                  <%= biz.city_name %>
                </span>
              <% } %>
            </div>

            <div class="portal-card-offers">
              <span class="offers-dot"></span>
              <%= biz.active_offers || 0 %> ofert<%= biz.active_offers === 1 ? 'ă activă' : 'e active' %>
            </div>
          </div>

        </a>
      <% }); %>
    </div>

  <% } %>

</section>

<%- include('../partials/footer') %>
