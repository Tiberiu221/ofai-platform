                      <span class="offer-meta-item">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                        <span class="ofp-city"></span>
                      </span>
                      <span class="offer-meta-item">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="4" rx="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                        <span class="ofp-cat"></span>
                      </span>
                    </div>
                  </div>
                </div>
              </div>
              <p class="ofp-view-label">Cum apare pe pagina Oferte</p>
            </div>

            <!-- ── Featured / Deal of Day card ── -->
            <div class="ofp-view" id="ofp-view-featured" hidden>
              <div class="ofp-card-frame ofp-frame-featured">
                <div class="offer-card featured" id="ofp-card-featured">
                  <div class="offer-image-wrapper">
                    <div class="offer-image-placeholder">
                      <span class="offer-placeholder-letter ofp-placeholder"></span>
                    </div>
                    <div class="offer-badge ofp-badge" style="display:none;"></div>
                    <div style="position:absolute;top:12px;left:12px;background:var(--accent);color:#000;font-size:0.625rem;font-weight:700;padding:3px 10px;border-radius:4px;text-transform:uppercase;letter-spacing:0.04em;z-index:2;">Oferta Zilei</div>
                  </div>
                  <div class="offer-content">
                    <div class="offer-content-text">
                      <div class="offer-business ofp-biz-name"></div>
                      <div class="offer-title ofp-title">Titlul ofertei apare aici</div>
                      <div class="offer-meta">
                        <span class="offer-meta-item">
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                          <span class="ofp-city"></span>
                        </span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <p class="ofp-view-label">Cum apare ca Oferta Zilei pe pagina principala</p>
            </div>

            <!-- ── Compact card ── -->
            <div class="ofp-view" id="ofp-view-compact" hidden>
              <div class="ofp-card-frame">
                <div class="offer-card offer-card-compact" id="ofp-card-compact">
                  <div class="offer-image-wrapper">
                    <div class="offer-image-placeholder">
                      <span class="offer-placeholder-letter ofp-placeholder"></span>
                    </div>
                    <div class="offer-badge ofp-badge" style="display:none;"></div>
                  </div>
                  <div class="offer-content">
                    <div class="offer-business ofp-biz-name"></div>
                    <div class="offer-title ofp-title">Titlul ofertei apare aici</div>
                    <div class="offer-meta">
                      <span class="offer-meta-item">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                        <span class="ofp-city"></span>
                      </span>
                    </div>
                  </div>
                </div>
              </div>
              <p class="ofp-view-label">Cum apare in sectiunea Oferte similare</p>
            </div>

            <!-- ── Promoted card ── -->
            <div class="ofp-view" id="ofp-view-promoted" hidden>
              <div class="ofp-card-frame">
                <div class="offer-card" id="ofp-card-promoted">
                  <div class="offer-image-wrapper">
                    <div class="offer-image-placeholder">
                      <span class="offer-placeholder-letter ofp-placeholder"></span>
                    </div>
                    <span class="promoted-badge">
                      <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                      Promovat
                    </span>
                    <div class="offer-badge ofp-badge" style="display:none;"></div>
                  </div>
                  <div class="offer-content">
                    <div class="offer-business ofp-biz-name"></div>
                    <div class="offer-title ofp-title">Titlul ofertei apare aici</div>
                    <div class="offer-meta">
                      <span class="offer-meta-item">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                        <span class="ofp-city"></span>
                      </span>
                      <span class="offer-meta-item">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="4" rx="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                        <span class="ofp-cat"></span>
                      </span>
                    </div>
                  </div>
                </div>
              </div>
              <p class="ofp-view-label">Cum apare in sectiunea Oferte Promovate</p>
            </div>

          </div><!-- /.ofp-stage -->
        </div><!-- /.ofp-panel -->
        <!-- ═══ Offer Image Upload (Premium only) ═══ -->
        <div class="ofp-panel" style="margin-top: 16px;">
          <div class="ofp-panel-header">
            <span class="ofp-panel-label">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
              Imagine ofertă
            </span>
            <% if (!(tier && tier.plan && tier.plan.has_custom_offer_image)) { %>
              <span style="font-size: 0.6875rem; color: #a78bfa; background: rgba(167,139,250,0.12); padding: 2px 8px; border-radius: 10px;">Premium</span>
            <% } %>
          </div>
          <div style="padding: 16px;">
            <% if (tier && tier.plan && tier.plan.has_custom_offer_image) { %>
              <!-- Active upload state (Premium) -->
              <div id="ofp-img-area">
                <div id="ofp-img-preview" style="<%= (offer && offer.logo_url) ? '' : 'display:none;' %> margin-bottom: 12px;">
                  <img id="ofp-img-current" src="<%= (offer && offer.logo_url) || '' %>" alt="Imagine ofertă" style="width: 100%; border-radius: 8px; aspect-ratio: 4/3; object-fit: cover;">
                </div>
                <div id="ofp-img-placeholder" style="<%= (offer && offer.logo_url) ? 'display:none;' : '' %> border: 2px dashed var(--border-color); border-radius: 8px; padding: 24px; text-align: center; color: var(--text-secondary);">
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin-bottom: 8px;"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
                  <p style="font-size: 0.8125rem; margin: 0;">Nicio imagine selectată</p>
                </div>
                <div style="display: flex; gap: 8px; margin-top: 10px;">
                  <label class="btn-secondary-portal" style="cursor: pointer; font-size: 0.8125rem; padding: 6px 14px; flex: 1; text-align: center;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: -2px;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                    <span id="ofp-img-btn-text"><%= (offer && offer.logo_url) ? 'Schimbă imaginea' : 'Alege imagine' %></span>
                    <input type="file" id="ofp-img-input" accept="image/jpeg,image/png,image/webp" style="display:none;">
                  </label>
                  <button type="button" id="ofp-img-remove" class="btn-secondary-portal" style="font-size: 0.8125rem; padding: 6px 14px; color: #ef4444; <%= (offer && offer.logo_url) ? '' : 'display:none;' %>">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: -2px;"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                    Șterge
                  </button>
                </div>
                <p class="img-upload-hint" style="margin-top: 8px;">JPEG, PNG sau WebP · Max 10MB · Raport 4:3 recomandat (1200×900px)</p>
              </div>
            <% } else { %>
              <!-- Locked teaser (Free/Standard) -->
              <div style="text-align: center; padding: 20px 12px;">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#a78bfa" stroke-width="1.5" style="margin-bottom: 8px;"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                <p style="font-weight: 600; color: var(--text-primary); margin: 4px 0;">Imagine personalizată ofertă</p>
                <p style="font-size: 0.8125rem; color: var(--text-secondary); margin: 4px 0 12px;">Adaugă o imagine unică pentru fiecare ofertă. Disponibil cu planul Premium.</p>
                <a href="/preturi" class="btn-accent" style="display: inline-block; padding: 8px 20px; font-size: 0.8125rem; text-decoration: none;">Alege Premium</a>
              </div>
            <% } %>
          </div>
        </div>

      </aside>

    </div><!-- /.ofp-layout -->

  </div>
</section>

<%- include('../partials/footer') %>

<script nonce="<%= cspNonce %>">
(function() {
  const businessId = '<%= business.id %>';
  const offerId = '<%= offer ? offer.id : '' %>';
  const isEdit = !!offerId;

  // ─── Offer image upload (Premium only) ─────────────────────
  var _offerImageFile = null;
  var _offerImageRemoved = false;

  var ofpImgInput = document.getElementById('ofp-img-input');
  var ofpImgPreview = document.getElementById('ofp-img-preview');
  var ofpImgCurrent = document.getElementById('ofp-img-current');
  var ofpImgPlaceholder = document.getElementById('ofp-img-placeholder');
  var ofpImgRemoveBtn = document.getElementById('ofp-img-remove');
  var ofpImgBtnText = document.getElementById('ofp-img-btn-text');

  if (ofpImgInput) {
    ofpImgInput.addEventListener('change', function() {
      var file = this.files[0];
      if (!file) return;
      if (file.size > 10 * 1024 * 1024) {
        showMessage('Imaginea nu poate depăși 10MB', 'error');
        this.value = '';
        return;
      }
      _offerImageFile = file;
      _offerImageRemoved = false;
      var reader = new FileReader();
      reader.onload = function(e) {
        ofpImgCurrent.src = e.target.result;
        ofpImgPreview.style.display = '';
        ofpImgPlaceholder.style.display = 'none';
        ofpImgRemoveBtn.style.display = '';
        ofpImgBtnText.textContent = 'Schimbă imaginea';
        // Update all preview cards
        if (typeof window._ofpSetPreviewImage === 'function') {
          document.querySelectorAll('.offer-image-placeholder').forEach(function(container) {
            window._ofpSetPreviewImage(container, e.target.result);
          });
        }
      };
      reader.readAsDataURL(file);
      this.value = '';
    });
  }
  if (ofpImgRemoveBtn) {
    ofpImgRemoveBtn.addEventListener('click', function() {
      _offerImageFile = null;
      _offerImageRemoved = true;
      ofpImgCurrent.src = '';
      ofpImgPreview.style.display = 'none';
      ofpImgPlaceholder.style.display = '';
      ofpImgRemoveBtn.style.display = 'none';
      ofpImgBtnText.textContent = 'Alege imagine';
      // Reset preview cards to business cover/logo fallback
      if (typeof window._ofpSetPreviewImage === 'function') {
        document.querySelectorAll('.offer-image-placeholder').forEach(function(container) {
          window._ofpSetPreviewImage(container, '');
        });
      }
    });
  }

  // ─── Promo codes dynamic list ────────────────────────────────
  var promoCodes = <%- JSON.stringify(typeof promoCodes !== 'undefined' && promoCodes ? promoCodes : []).replace(/</g, '\\u003c') %>;
  var pcListEl = document.getElementById('pc-list');
  var pcAddBtn = document.getElementById('pc-add-btn');

  function escHtml(str) {
    var div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }

  function renderPromoCodes() {
    if (promoCodes.length === 0) {
      pcListEl.innerHTML = '<div class="pc-empty">Niciun cod promoțional adăugat</div>';
      return;
    }
    pcListEl.innerHTML = '';
    promoCodes.forEach(function(pc, idx) {
      var row = document.createElement('div');
      row.className = 'pc-row';
      row.dataset.idx = idx;
      row.innerHTML =
        '<input type="text" value="' + escHtml(pc.code || '') + '" ' +
          'placeholder="Ex: REDUCERE20" maxlength="100" data-field="code" data-idx="' + idx + '">' +
        '<label class="pc-toggle">' +
          '<input type="checkbox" ' + (pc.is_active !== false ? 'checked' : '') + ' data-field="toggle" data-idx="' + idx + '">' +
          '<span class="pc-toggle-slider"></span>' +
        '</label>' +
        '<span class="pc-status ' + (pc.is_active !== false ? 'active' : 'inactive') + '">' +
          (pc.is_active !== false ? 'Activ' : 'Inactiv') +
        '</span>' +
        '<button type="button" class="pc-remove" data-field="remove" data-idx="' + idx + '" title="Elimină codul" aria-label="Elimină codul">&times;</button>';
      pcListEl.appendChild(row);
    });
  }

  // Event delegation
  pcListEl.addEventListener('input', function(e) {
    var idx = parseInt(e.target.dataset.idx);
    if (e.target.dataset.field === 'code' && !isNaN(idx)) {
      promoCodes[idx].code = e.target.value;
    }
  });

  pcListEl.addEventListener('change', function(e) {
    var idx = parseInt(e.target.dataset.idx);
    if (e.target.dataset.field === 'toggle' && !isNaN(idx)) {
      promoCodes[idx].is_active = e.target.checked;
      var status = e.target.closest('.pc-row').querySelector('.pc-status');
      if (status) {
        status.textContent = e.target.checked ? 'Activ' : 'Inactiv';
        status.className = 'pc-status ' + (e.target.checked ? 'active' : 'inactive');
      }
    }
  });

  pcListEl.addEventListener('click', function(e) {
    var btn = e.target.closest('[data-field="remove"]');
    if (btn) {
      var idx = parseInt(btn.dataset.idx);
      if (!isNaN(idx)) {
        promoCodes.splice(idx, 1);
        renderPromoCodes();
      }
    }
  });

  pcAddBtn.addEventListener('click', function() {
    promoCodes.push({ code: '', is_active: true });
    renderPromoCodes();
    // Focus the new input
    var inputs = pcListEl.querySelectorAll('input[type="text"]');
    if (inputs.length) inputs[inputs.length - 1].focus();
  });

  renderPromoCodes();

  // ─── Discount type toggle ──────────────────────────────────
  const discountTypeSelect = document.getElementById('of-discount-type');
  const discountValueInput = document.getElementById('of-discount-value');

  discountTypeSelect.addEventListener('change', function() {
    if (this.value === 'special') {
      discountValueInput.type = 'text';
      discountValueInput.placeholder = 'Ex: 1+1 gratis';
      discountValueInput.removeAttribute('min');
      discountValueInput.removeAttribute('step');
    } else {
      discountValueInput.type = 'number';
      discountValueInput.placeholder = this.value === 'percentage' ? 'Ex: 20' : 'Ex: 50';
      discountValueInput.min = '0';
      discountValueInput.step = 'any';
    }
  });

  // ─── Booking type toggle ───────────────────────────────────
  const bookingBtns = document.querySelectorAll('.of-booking-btn');
  const bookingTypeInput = document.getElementById('of-booking-type');
  const bookingFieldsMap = {
    phone: document.getElementById('of-booking-phone'),
    whatsapp: document.getElementById('of-booking-whatsapp'),
    url: document.getElementById('of-booking-url')
  };
  const instructionsField = document.getElementById('of-booking-instructions');

  function setBookingType(type) {
    bookingTypeInput.value = type;

    bookingBtns.forEach(function(btn) {
      btn.classList.toggle('active', btn.dataset.booking === type);
    });

    // Hide all conditional fields
    Object.values(bookingFieldsMap).forEach(function(el) {
      el.style.display = 'none';
    });

    // Show the relevant field
    if (bookingFieldsMap[type]) {
      bookingFieldsMap[type].style.display = 'block';
    }

    // Show instructions for types that are not none or inherit
    if (type !== 'none' && type !== 'inherit') {
      instructionsField.style.display = 'block';
    } else {
      instructionsField.style.display = 'none';
    }
  }

  bookingBtns.forEach(function(btn) {
    btn.addEventListener('click', function() {
      setBookingType(this.dataset.booking);
    });
  });

  // ─── Redemption method toggle ────────────────────────────────
  var redemptionSelect = document.getElementById('of-redemption-select');
  var redemptionHidden = document.getElementById('of-redemption-method');
  var redemptionCustomWrap = document.getElementById('of-redemption-custom-wrap');
  var redemptionCustomInput = document.getElementById('of-redemption-custom');

  var REDEMPTION_KEYS = ['auto','call','whatsapp','online','booking','appointment','order','checkout','show_page','custom'];

  function updateRedemptionMethod() {
    var val = redemptionSelect.value;
    if (val === 'custom') {
      redemptionCustomWrap.style.display = 'block';
      redemptionHidden.value = redemptionCustomInput.value.trim() || 'custom';
    } else {
      redemptionCustomWrap.style.display = 'none';
      redemptionHidden.value = val;
    }
  }

  redemptionSelect.addEventListener('change', updateRedemptionMethod);
  if (redemptionCustomInput) {
    redemptionCustomInput.addEventListener('input', function() {
      if (redemptionSelect.value === 'custom') {
        redemptionHidden.value = this.value.trim() || 'custom';
      }
    });
  }

  // Initialize from existing value (edit mode)
  (function() {
    var saved = redemptionHidden.value || 'auto';
    if (REDEMPTION_KEYS.indexOf(saved) !== -1 && saved !== 'custom') {
      redemptionSelect.value = saved;
    } else if (saved !== 'auto') {
      // Custom text — set select to "custom" and fill textarea
      redemptionSelect.value = 'custom';
      redemptionCustomInput.value = saved;
      redemptionCustomWrap.style.display = 'block';
    }
  })();

  // ─── Message display ───────────────────────────────────────
  var msgEl = document.getElementById('of-message');

  function showMessage(text, type) {
    msgEl.textContent = text;
    msgEl.className = 'of-message of-message-' + type;
    msgEl.style.display = 'block';
    if (window.lenis) { window.lenis.scrollTo(msgEl, { offset: -(window.innerHeight / 2) + (msgEl.offsetHeight / 2) }); }
    else { msgEl.scrollIntoView({ behavior: 'smooth', block: 'center' }); }
  }

  function hideMessage() {
    msgEl.style.display = 'none';
  }

  // ─── Form submission ───────────────────────────────────────
  var form = document.getElementById('offer-form');
  var submitBtn = document.getElementById('of-submit-btn');

  form.addEventListener('submit', async function(e) {
    e.preventDefault();
    hideMessage();

    var title = document.getElementById('of-title').value.trim();
    if (!title) {
      showMessage('Titlul ofertei este obligatoriu.', 'error');
      return;
    }

    submitBtn.disabled = true;
    submitBtn.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="animation: spin 1s linear infinite;"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg> Se salvează...';

    var payload = {
      title: title,
      description: document.getElementById('of-description').value.trim(),
      discount_type: discountTypeSelect.value,
      discount_value: discountValueInput.value.trim(),
      conditions: document.getElementById('of-conditions').value.trim(),
      start_date: document.getElementById('of-start-date').value || null,
      end_date: document.getElementById('of-end-date').value || null,
      is_active: document.getElementById('of-is-active').checked,
      booking_type: bookingTypeInput.value,
      booking_phone: document.getElementById('of-booking-phone-input').value.trim(),
      booking_whatsapp: document.getElementById('of-booking-whatsapp-input').value.trim(),
      booking_url: document.getElementById('of-booking-url-input').value.trim(),
      booking_instructions: document.getElementById('of-booking-instructions-input').value.trim(),
      promo_codes: promoCodes.filter(function(pc) { return pc.code && pc.code.trim(); }),
      max_reveals: document.getElementById('of-max-reveals').value || null,
      redemption_method: document.getElementById('of-redemption-method').value || 'auto'
    };

    // Collect location IDs if location checkboxes exist
    var locCheckboxes = document.querySelectorAll('.of-loc-checkbox');
    if (locCheckboxes.length > 0) {
      var allChecked = true;
      var checkedIds = [];
      locCheckboxes.forEach(function(cb) {
        if (cb.checked) checkedIds.push(parseInt(cb.value));
        else allChecked = false;
      });
      // If all checked, send empty array (= offer valid everywhere)
      // If some unchecked, send only the checked ones
      payload.locationIds = allChecked ? [] : checkedIds;
    }

    try {
      var url = isEdit
        ? '/api/web/portal/' + businessId + '/offers/' + offerId
        : '/api/web/portal/' + businessId + '/offers';
      var method = isEdit ? 'PUT' : 'POST';
      var csrfToken = document.querySelector('meta[name="csrf-token"]');

      var fetchOpts = { method: method };
      var csrfVal = csrfToken ? csrfToken.getAttribute('content') : '';

      if (_offerImageFile || _offerImageRemoved) {
        // Use FormData when image is involved
        var fd = new FormData();
        Object.keys(payload).forEach(function(k) {
          var v = payload[k];
          if (v === null || v === undefined) return;
          fd.append(k, typeof v === 'object' ? JSON.stringify(v) : v);
        });
        if (_offerImageFile) fd.append('image', _offerImageFile);
        if (_offerImageRemoved && !_offerImageFile) fd.append('remove_image', 'true');
        fetchOpts.headers = { 'X-CSRF-Token': csrfVal };
        fetchOpts.body = fd;
      } else {
        // Standard JSON submission
        fetchOpts.headers = { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfVal };
        fetchOpts.body = JSON.stringify(payload);
      }

      var res = await fetch(url, fetchOpts);

      var data = await res.json();

      if (!res.ok) {
        showMessage(data.message || 'A apărut o eroare la salvare.', 'error');
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg> Salvează';
        return;
      }

      // All offers (new and edited) go to pending_review — admin approves
      window.location.href = '/portal/' + businessId + '?offer_pending=1#oferte';

    } catch (err) {
      showMessage('Eroare de rețea. Verifică conexiunea și încearcă din nou.', 'error');
      submitBtn.disabled = false;
      submitBtn.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg> Salvează';
    }
  });

  // ─── Delete offer ──────────────────────────────────────────
  <% if (offer) { %>
  var deleteBtn = document.getElementById('of-delete-btn');
  deleteBtn.addEventListener('click', async function() {
    if (!confirm('Ești sigur că vrei să ștergi această ofertă? Această acțiune este ireversibilă.')) {
      return;
    }

    hideMessage();
    deleteBtn.disabled = true;
    deleteBtn.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="animation: spin 1s linear infinite;"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg> Se șterge...';

    try {
      var csrfToken = document.querySelector('meta[name="csrf-token"]');
      var res = await fetch('/api/web/portal/' + businessId + '/offers/' + offerId, {
        method: 'DELETE',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': csrfToken ? csrfToken.getAttribute('content') : ''
        }
      });

      var data = await res.json();

      if (!res.ok) {
        showMessage(data.message || 'A apărut o eroare la ștergere.', 'error');
        deleteBtn.disabled = false;
        deleteBtn.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg> Șterge oferta';
        return;
      }

      window.location.href = '/portal/' + businessId + '?offer_deleted=1#oferte';

    } catch (err) {
      showMessage('Eroare de rețea. Verifică conexiunea și încearcă din nou.', 'error');
      deleteBtn.disabled = false;
      deleteBtn.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg> Șterge oferta';
    }
  });
  <% } %>

  // ─── Live Preview Panel ─────────────────────────────────────
  (function initPreview() {
    var aside = document.querySelector('.ofp-preview-col');
    if (!aside) return; // safety — hidden on mobile anyway

    // ── Static business data (set once) ──
    var bizName     = aside.dataset.bizName     || '';
    var bizLogo     = aside.dataset.bizLogo     || '';
    var bizCover    = aside.dataset.bizCover    || '';
    var bizCity     = aside.dataset.bizCity      || '';
    var bizCategory = aside.dataset.bizCategory  || '';
    var offerImage  = aside.dataset.offerImage   || '';
    var initial     = bizName.charAt(0).toUpperCase() || '?';

    // Populate all static fields across the 4 cards
    aside.querySelectorAll('.ofp-biz-name').forEach(function(el)  { el.textContent = bizName; });
    aside.querySelectorAll('.ofp-city').forEach(function(el)      { el.textContent = bizCity; });
    aside.querySelectorAll('.ofp-cat').forEach(function(el)       { el.textContent = bizCategory; });

    // Helper: set the image content for a preview card's image area
    // Fallback chain: imgUrl → bizCover → bizLogo → letter
    // Exposed to outer scope so offer image upload can call it
    window._ofpSetPreviewImage = setPreviewImage;
    function setPreviewImage(container, imgUrl) {
      container.innerHTML = '';
      var coverSrc = imgUrl || bizCover;
      if (coverSrc) {
        var img = document.createElement('img');
        img.src = coverSrc;
        img.alt = bizName;
        img.style.cssText = 'width:100%;height:100%;object-fit:cover;display:block;';
        container.appendChild(img);
      } else if (bizLogo) {
        var logo = document.createElement('img');
        logo.src = bizLogo;
        logo.alt = bizName;
        logo.className = 'offer-placeholder-logo';
        container.appendChild(logo);
      } else {
        var letterBox = document.createElement('span');
        letterBox.className = 'offer-placeholder-letter';
        letterBox.textContent = initial;
        container.appendChild(letterBox);
      }
    }

    // Initial render: offer image → biz cover → biz logo → letter
    aside.querySelectorAll('.offer-image-placeholder').forEach(function(container) {
      setPreviewImage(container, offerImage);
    });

    // ── Form field references ──
    var titleInput    = document.getElementById('of-title');
    var discountType  = document.getElementById('of-discount-type');
    var discountValue = document.getElementById('of-discount-value');

    // ── All preview elements that need live updates ──
    var allTitles = aside.querySelectorAll('.ofp-title');
    var allBadges = aside.querySelectorAll('.ofp-badge');

    function formatBadge(type, val) {
      if (!val || val === '0') return '';
      switch (type) {
        case 'percentage': return '-' + val + '%';
        case 'fixed':      return '-' + val + ' lei';
        case 'special':    return val;
        default:           return val;
      }
    }

    function updatePreview() {
      // Title
      var title = titleInput.value.trim() || 'Titlul ofertei apare aici';
      allTitles.forEach(function(el) { el.textContent = title; });

      // Discount badge
      var type = discountType.value;
      var val  = discountValue.value.trim();
      var badgeText = formatBadge(type, val);

      allBadges.forEach(function(el) {
        if (badgeText) {
          el.textContent = badgeText;
          el.style.display = '';
        } else {
          el.textContent = '';
          el.style.display = 'none';
        }
      });
    }

    // ── Bind events ──
    titleInput.addEventListener('input', updatePreview);
    discountValue.addEventListener('input', updatePreview);
    discountType.addEventListener('change', updatePreview);

    // ── Tab switcher ──
    var tabs  = aside.querySelectorAll('.ofp-tab');
    var views = aside.querySelectorAll('.ofp-view');

    tabs.forEach(function(tab) {
      tab.addEventListener('click', function() {
        var target = this.dataset.tab;

        // Toggle active tab
        tabs.forEach(function(t) { t.classList.toggle('active', t === tab); });

        // Toggle active view
        views.forEach(function(v) {
          var isTarget = v.id === 'ofp-view-' + target;
          v.classList.toggle('active', isTarget);
          v.hidden = !isTarget;
        });
      });
    });

    // ── Initial render (edit mode pre-population) ──
    updatePreview();
  })();

})();
</script>

<style>
  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
</style>
