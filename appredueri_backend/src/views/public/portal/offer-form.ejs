              <% offerLocs.forEach(function(loc) {
                   // If editing and selectedLocs is empty, that means "all locations" — so check all
                   var isChecked = selectedLocs.length === 0 || selectedLocs.indexOf(loc.id) !== -1;
              %>
                <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; padding: 8px 10px; border: 1px solid var(--border-color); border-radius: 8px; background: var(--card-bg);">
