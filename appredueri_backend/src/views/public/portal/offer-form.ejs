                          <div class="fp-section-header">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><line x1="16" x2="8" y1="13" y2="13"/><line x1="16" x2="8" y1="17" y2="17"/></svg>
                            <span>Descriere</span>
                          </div>
                          <p class="fp-text-secondary" id="fp-offer-desc"></p>
                        </div>

                        <!-- Conditions -->
                        <div class="fp-section-card" id="fp-offer-cond-card" style="display:none;">
                          <div class="fp-section-header">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                            <span>Condiții</span>
                          </div>
                          <p class="fp-text-secondary" id="fp-offer-cond"></p>
                        </div>

                        <!-- Business card -->
                        <div class="fp-biz-card">
                          <div id="fp-offer-biz-logo-wrap"></div>
                          <p class="fp-biz-name" id="fp-offer-biz-name"></p>
                          <div class="fp-biz-meta">
                            <span class="fp-chip" id="fp-offer-biz-cat"></span>
                            <span class="fp-chip">
                              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                              <span id="fp-offer-biz-city"></span>
                            </span>
                          </div>
                        </div>

                        <!-- CTA -->
                        <div class="fp-cta">
                          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                          Profită acum
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="device-stripe"></div>
                <div class="device-header"></div>
                <div class="device-sensors"></div>
                <div class="device-btns"></div>
                <div class="device-power"></div>
                <div class="device-home"></div>
              </div>
              <p class="ofp-view-label">Cum apare în aplicația mobilă</p>
            </div>

          </div><!-- /.ofp-stage -->
        </div><!-- /.ofp-panel -->
        <!-- ═══ Offer Image Upload (Premium only) ═══ -->
        <div class="ofp-panel" style="margin-top: 16px;">
          <div class="ofp-panel-header">
            <span class="ofp-panel-label">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
              Imagine ofertă
            </span>
            <% if (!(tier && tier.plan && tier.plan.has_custom_offer_image)) { %>
              <span style="font-size: 0.6875rem; color: #a78bfa; background: rgba(167,139,250,0.12); padding: 2px 8px; border-radius: 10px;">Premium</span>
            <% } %>
          </div>
          <div style="padding: 16px;">
            <% if (tier && tier.plan && tier.plan.has_custom_offer_image) { %>
              <!-- Active upload state (Premium) -->
              <div id="ofp-img-area">
                <div id="ofp-img-preview" style="<%= (offer && offer.logo_url) ? '' : 'display:none;' %> margin-bottom: 12px;">
                  <img id="ofp-img-current" src="<%= (offer && offer.logo_url) || '' %>" alt="Imagine ofertă" style="width: 100%; border-radius: 8px; aspect-ratio: 4/3; object-fit: cover;">
                </div>
                <div id="ofp-img-placeholder" style="<%= (offer && offer.logo_url) ? 'display:none;' : '' %> border: 2px dashed var(--border-color); border-radius: 8px; padding: 24px; text-align: center; color: var(--text-secondary);">
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin-bottom: 8px;"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
                  <p style="font-size: 0.8125rem; margin: 0;">Nicio imagine selectată</p>
                </div>
                <div style="display: flex; gap: 8px; margin-top: 10px;">
                  <label class="btn-secondary-portal" style="cursor: pointer; font-size: 0.8125rem; padding: 6px 14px; flex: 1; text-align: center;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: -2px;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                    <span id="ofp-img-btn-text"><%= (offer && offer.logo_url) ? 'Schimbă imaginea' : 'Alege imagine' %></span>
                    <input type="file" id="ofp-img-input" accept="image/jpeg,image/png,image/webp" style="display:none;">
                  </label>
                  <button type="button" id="ofp-img-remove" class="btn-secondary-portal" style="font-size: 0.8125rem; padding: 6px 14px; color: #ef4444; <%= (offer && offer.logo_url) ? '' : 'display:none;' %>">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: -2px;"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                    Șterge
                  </button>
                </div>
                <p class="img-upload-hint" style="margin-top: 8px;">JPEG, PNG sau WebP · Max 10MB · Raport 4:3 recomandat (1200×900px)</p>
              </div>
            <% } else { %>
              <!-- Locked teaser (Free/Standard) -->
              <div style="text-align: center; padding: 20px 12px;">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#a78bfa" stroke-width="1.5" style="margin-bottom: 8px;"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                <p style="font-weight: 600; color: var(--text-primary); margin: 4px 0;">Imagine personalizată ofertă</p>
                <p style="font-size: 0.8125rem; color: var(--text-secondary); margin: 4px 0 12px;">Adaugă o imagine unică pentru fiecare ofertă. Disponibil cu planul Premium.</p>
                <a href="/preturi" class="btn-accent" style="display: inline-block; padding: 8px 20px; font-size: 0.8125rem; text-decoration: none;">Alege Premium</a>
              </div>
            <% } %>
          </div>
        </div>

      </aside>

    </div><!-- /.ofp-layout -->

  </div>
</section>

<%- include('../partials/footer') %>

<script nonce="<%= cspNonce %>">
(function() {
  const businessId = '<%= business.id %>';
  const offerId = '<%= offer ? offer.id : '' %>';
  const isEdit = !!offerId;

  // ─── Offer image upload (Premium only) ─────────────────────
  var _offerImageFile = null;
  var _offerImageRemoved = false;

  var ofpImgInput = document.getElementById('ofp-img-input');
  var ofpImgPreview = document.getElementById('ofp-img-preview');
  var ofpImgCurrent = document.getElementById('ofp-img-current');
  var ofpImgPlaceholder = document.getElementById('ofp-img-placeholder');
  var ofpImgRemoveBtn = document.getElementById('ofp-img-remove');
  var ofpImgBtnText = document.getElementById('ofp-img-btn-text');

  if (ofpImgInput) {
    ofpImgInput.addEventListener('change', function() {
      var file = this.files[0];
      if (!file) return;
      if (file.size > 10 * 1024 * 1024) {
        showMessage('Imaginea nu poate depăși 10MB', 'error');
        this.value = '';
        return;
      }
      _offerImageFile = file;
      _offerImageRemoved = false;
      var reader = new FileReader();
      reader.onload = function(e) {
        ofpImgCurrent.src = e.target.result;
        ofpImgPreview.style.display = '';
        ofpImgPlaceholder.style.display = 'none';
        ofpImgRemoveBtn.style.display = '';
        ofpImgBtnText.textContent = 'Schimbă imaginea';
        // Update all preview cards
        if (typeof window._ofpSetPreviewImage === 'function') {
          document.querySelectorAll('.offer-image-placeholder').forEach(function(container) {
            window._ofpSetPreviewImage(container, e.target.result);
          });
        }
      };
      reader.readAsDataURL(file);
      this.value = '';
    });
  }
  if (ofpImgRemoveBtn) {
    ofpImgRemoveBtn.addEventListener('click', function() {
      _offerImageFile = null;
      _offerImageRemoved = true;
      ofpImgCurrent.src = '';
      ofpImgPreview.style.display = 'none';
      ofpImgPlaceholder.style.display = '';
      ofpImgRemoveBtn.style.display = 'none';
      ofpImgBtnText.textContent = 'Alege imagine';
      // Reset preview cards to business cover/logo fallback
      if (typeof window._ofpSetPreviewImage === 'function') {
        document.querySelectorAll('.offer-image-placeholder').forEach(function(container) {
          window._ofpSetPreviewImage(container, '');
        });
      }
    });
  }

  // ─── Promo codes dynamic list ────────────────────────────────
  var promoCodes = <%- JSON.stringify(typeof promoCodes !== 'undefined' && promoCodes ? promoCodes : []).replace(/</g, '\\u003c') %>;
  var pcListEl = document.getElementById('pc-list');
  var pcAddBtn = document.getElementById('pc-add-btn');

  function escHtml(str) {
    var div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }

  function renderPromoCodes() {
    if (promoCodes.length === 0) {
      pcListEl.innerHTML = '<div class="pc-empty">Niciun cod promoțional adăugat</div>';
      return;
    }
    pcListEl.innerHTML = '';
    promoCodes.forEach(function(pc, idx) {
      var row = document.createElement('div');
      row.className = 'pc-row';
      row.dataset.idx = idx;
      row.innerHTML =
        '<input type="text" value="' + escHtml(pc.code || '') + '" ' +
          'placeholder="Ex: REDUCERE20" maxlength="100" data-field="code" data-idx="' + idx + '">' +
        '<label class="pc-toggle">' +
          '<input type="checkbox" ' + (pc.is_active !== false ? 'checked' : '') + ' data-field="toggle" data-idx="' + idx + '">' +
          '<span class="pc-toggle-slider"></span>' +
        '</label>' +
        '<span class="pc-status ' + (pc.is_active !== false ? 'active' : 'inactive') + '">' +
          (pc.is_active !== false ? 'Activ' : 'Inactiv') +
        '</span>' +
        '<button type="button" class="pc-remove" data-field="remove" data-idx="' + idx + '" title="Elimină codul" aria-label="Elimină codul">&times;</button>';
      pcListEl.appendChild(row);
    });
  }

  // Event delegation
  pcListEl.addEventListener('input', function(e) {
    var idx = parseInt(e.target.dataset.idx);
    if (e.target.dataset.field === 'code' && !isNaN(idx)) {
      promoCodes[idx].code = e.target.value;
    }
  });

  pcListEl.addEventListener('change', function(e) {
    var idx = parseInt(e.target.dataset.idx);
    if (e.target.dataset.field === 'toggle' && !isNaN(idx)) {
      promoCodes[idx].is_active = e.target.checked;
      var status = e.target.closest('.pc-row').querySelector('.pc-status');
      if (status) {
        status.textContent = e.target.checked ? 'Activ' : 'Inactiv';
        status.className = 'pc-status ' + (e.target.checked ? 'active' : 'inactive');
      }
    }
  });

  pcListEl.addEventListener('click', function(e) {
    var btn = e.target.closest('[data-field="remove"]');
    if (btn) {
      var idx = parseInt(btn.dataset.idx);
      if (!isNaN(idx)) {
        promoCodes.splice(idx, 1);
        renderPromoCodes();
      }
    }
  });

  pcAddBtn.addEventListener('click', function() {
    promoCodes.push({ code: '', is_active: true });
    renderPromoCodes();
    // Focus the new input
    var inputs = pcListEl.querySelectorAll('input[type="text"]');
    if (inputs.length) inputs[inputs.length - 1].focus();
  });

  renderPromoCodes();

  // ─── Discount type toggle ──────────────────────────────────
  const discountTypeSelect = document.getElementById('of-discount-type');
  const discountValueInput = document.getElementById('of-discount-value');

  discountTypeSelect.addEventListener('change', function() {
    if (this.value === 'special') {
      discountValueInput.type = 'text';
      discountValueInput.placeholder = 'Ex: 1+1 gratis';
      discountValueInput.removeAttribute('min');
      discountValueInput.removeAttribute('step');
    } else {
      discountValueInput.type = 'number';
      discountValueInput.placeholder = this.value === 'percentage' ? 'Ex: 20' : 'Ex: 50';
      discountValueInput.min = '0';
      discountValueInput.step = 'any';
    }
  });

  // ─── Booking type (legacy — kept for backward compatibility) ─

  // ─── Redemption method toggle ────────────────────────────────
  var redemptionSelect = document.getElementById('of-redemption-select');
  var redemptionHidden = document.getElementById('of-redemption-method');
  var redemptionCustomWrap = document.getElementById('of-redemption-custom-wrap');
  var redemptionCustomInput = document.getElementById('of-redemption-custom');

  var REDEMPTION_KEYS = ['auto','call','whatsapp','online','booking','appointment','order','checkout','show_page','custom'];

  function updateRedemptionMethod() {
    var val = redemptionSelect.value;
    if (val === 'custom') {
      redemptionCustomWrap.style.display = 'block';
      redemptionHidden.value = redemptionCustomInput.value.trim() || 'custom';
    } else {
      redemptionCustomWrap.style.display = 'none';
      redemptionHidden.value = val;
    }
  }

  redemptionSelect.addEventListener('change', updateRedemptionMethod);
  if (redemptionCustomInput) {
    redemptionCustomInput.addEventListener('input', function() {
      if (redemptionSelect.value === 'custom') {
        redemptionHidden.value = this.value.trim() || 'custom';
      }
    });
  }

  // Initialize from existing value (edit mode)
  (function() {
    var saved = redemptionHidden.value || 'auto';
    if (REDEMPTION_KEYS.indexOf(saved) !== -1 && saved !== 'custom') {
      redemptionSelect.value = saved;
    } else if (saved !== 'auto') {
      // Custom text — set select to "custom" and fill textarea
      redemptionSelect.value = 'custom';
      redemptionCustomInput.value = saved;
      redemptionCustomWrap.style.display = 'block';
    }
  })();

  // ─── Offer booking methods (multi-platform) ────────────────
  var _ofBmMode = 'inherit'; // 'inherit' or 'custom'
  var _ofBmPlatforms = [];
  var _ofBmSelected = {};

  window.setOfferBookingMode = function(mode) {
    _ofBmMode = mode;
    document.getElementById('of-bm-inherit-btn').classList.toggle('active', mode === 'inherit');
    document.getElementById('of-bm-custom-btn').classList.toggle('active', mode === 'custom');
    document.getElementById('of-bm-custom-section').style.display = mode === 'custom' ? 'block' : 'none';
    document.getElementById('of-bm-inherit-preview').style.display = mode === 'inherit' ? 'block' : 'none';
  };

  function renderOfBmGrid() {
    var grid = document.getElementById('of-booking-platforms-grid');
    if (!grid) return;
    grid.innerHTML = _ofBmPlatforms.map(function(p) {
      var active = _ofBmSelected[p.slug] ? ' active' : '';
      var icon = p.type === 'phone' ? '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>'
        : p.slug === 'whatsapp' ? '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>'
        : '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>';
      var inlineStyle = active ? 'border-color:' + p.color + '; color:' + p.color + '; background:' + p.color + '10;' : '';
      return '<div class="booking-option' + active + '" data-slug="' + p.slug + '" onclick="window.toggleOfBmPlatform(\'' + p.slug + '\')" style="' + inlineStyle + '">' + icon + ' ' + p.label + '</div>';
    }).join('');
  }

  function renderOfBmInputs() {
    var container = document.getElementById('of-booking-inputs-container');
    if (!container) return;
    var html = '';
    _ofBmPlatforms.forEach(function(p) {
      if (!_ofBmSelected[p.slug]) return;
      var sel = _ofBmSelected[p.slug];
      var placeholder = p.placeholder || 'https://';
      html += '<div style="margin-bottom: 10px; display: flex; align-items: center; gap: 8px;">';
      html += '<span style="min-width: 120px; font-size: 0.8125rem; font-weight: 600; color:' + p.color + ';">' + p.label + '</span>';
      if (p.hasCustomLabel) {
        html += '<input type="text" class="of-input" data-ofslug="' + p.slug + '" data-field="label" value="' + (sel.platform_label || '').replace(/"/g, '&quot;') + '" placeholder="Nume platformă" style="flex: 0 0 120px;">';
      }
      html += '<input type="' + (p.inputType || 'url') + '" class="of-input" data-ofslug="' + p.slug + '" data-field="value" value="' + (sel.value || '').replace(/"/g, '&quot;') + '" placeholder="' + placeholder + '" style="flex: 1;">';
      html += '<button type="button" onclick="window.toggleOfBmPlatform(\'' + p.slug + '\')" style="background:none;border:none;color:var(--text-tertiary);cursor:pointer;padding:4px;" title="Elimină">';
      html += '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>';
      html += '</div>';
    });
    if (!html) html = '<p style="color: var(--text-tertiary); font-size: 0.8125rem;">Nicio metodă selectată — oferta va moșteni din business.</p>';
    container.innerHTML = html;
  }

  window.toggleOfBmPlatform = function(slug) {
    if (_ofBmSelected[slug]) delete _ofBmSelected[slug];
    else _ofBmSelected[slug] = { value: '', platform_label: '' };
    renderOfBmGrid();
    renderOfBmInputs();
  };

  // Load offer booking methods on init
  (function initOfferBooking() {
    var csrfMeta = (document.querySelector('meta[name="csrf-token"]') || {}).content || '';
    if (!isEdit) {
      // New offer — just load platforms, default to inherit
      fetch('/api/web/portal/' + businessId + '/booking-methods', { credentials: 'same-origin' })
        .then(function(r) { return r.json(); })
        .then(function(data) {
          _ofBmPlatforms = data.platforms || [];
          var bizMethods = data.methods || [];
          var bizCount = bizMethods.length;
          document.getElementById('of-bm-inherit-info').textContent = bizCount > 0
            ? 'Se vor folosi cele ' + bizCount + ' metode de rezervare configurate pe business.'
            : 'Nicio metodă de rezervare configurată pe business.';
          renderOfBmGrid();
          renderOfBmInputs();
          if (typeof window._updateAppBookingChips === 'function') window._updateAppBookingChips(bizMethods);
        }).catch(function() {});
      return;
    }
    // Edit mode — load offer-specific methods
    fetch('/api/web/portal/' + businessId + '/offers/' + offerId + '/booking-methods', { credentials: 'same-origin' })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        _ofBmPlatforms = data.platforms || [];
        var offerMethods = data.methods || [];
        var bizMethods = data.businessMethods || [];
        document.getElementById('of-bm-inherit-info').textContent = bizMethods.length > 0
          ? 'Se vor folosi cele ' + bizMethods.length + ' metode de rezervare configurate pe business.'
          : 'Nicio metodă de rezervare configurată pe business.';
        if (offerMethods.length > 0) {
          // Has custom methods — switch to custom mode
          _ofBmSelected = {};
          offerMethods.forEach(function(m) {
            _ofBmSelected[m.platform] = { value: m.value, platform_label: m.platform_label || '' };
          });
          window.setOfferBookingMode('custom');
        }
        renderOfBmGrid();
        renderOfBmInputs();
        // App preview: show offer-specific methods, or fall back to business methods
        var chipMethods = offerMethods.length > 0 ? offerMethods : bizMethods;
        if (typeof window._updateAppBookingChips === 'function') window._updateAppBookingChips(chipMethods);
      }).catch(function() {});
  })();

  // ─── Message display ───────────────────────────────────────
  var msgEl = document.getElementById('of-message');

  function showMessage(text, type) {
    msgEl.textContent = text;
    msgEl.className = 'of-message of-message-' + type;
    msgEl.style.display = 'block';
    if (window.lenis) { window.lenis.scrollTo(msgEl, { offset: -(window.innerHeight / 2) + (msgEl.offsetHeight / 2) }); }
    else { msgEl.scrollIntoView({ behavior: 'smooth', block: 'center' }); }
  }

  function hideMessage() {
    msgEl.style.display = 'none';
  }

  // ─── Form submission ───────────────────────────────────────
  var form = document.getElementById('offer-form');
  var submitBtn = document.getElementById('of-submit-btn');

  form.addEventListener('submit', async function(e) {
    e.preventDefault();
    hideMessage();

    var title = document.getElementById('of-title').value.trim();
    if (!title) {
      showMessage('Titlul ofertei este obligatoriu.', 'error');
      return;
    }

    submitBtn.disabled = true;
    submitBtn.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="animation: spin 1s linear infinite;"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg> Se salvează...';

    var payload = {
      title: title,
      description: document.getElementById('of-description').value.trim(),
      discount_type: discountTypeSelect.value,
      discount_value: discountValueInput.value.trim(),
      conditions: document.getElementById('of-conditions').value.trim(),
      start_date: document.getElementById('of-start-date').value || null,
      end_date: document.getElementById('of-end-date').value || null,
      is_active: document.getElementById('of-is-active').checked,
      booking_type: _ofBmMode === 'custom' ? 'none' : 'inherit',
      promo_codes: promoCodes.filter(function(pc) { return pc.code && pc.code.trim(); }),
      max_reveals: document.getElementById('of-max-reveals').value || null,
      redemption_method: document.getElementById('of-redemption-method').value || 'auto'
    };

    // Collect location IDs if location checkboxes exist
    var locCheckboxes = document.querySelectorAll('.of-loc-checkbox');
    if (locCheckboxes.length > 0) {
      var allChecked = true;
      var checkedIds = [];
      locCheckboxes.forEach(function(cb) {
        if (cb.checked) checkedIds.push(parseInt(cb.value));
        else allChecked = false;
      });
      // If all checked, send empty array (= offer valid everywhere)
      // If some unchecked, send only the checked ones
      payload.locationIds = allChecked ? [] : checkedIds;
    }

    try {
      var url = isEdit
        ? '/api/web/portal/' + businessId + '/offers/' + offerId
        : '/api/web/portal/' + businessId + '/offers';
      var method = isEdit ? 'PUT' : 'POST';
      var csrfToken = document.querySelector('meta[name="csrf-token"]');

      var fetchOpts = { method: method };
      var csrfVal = csrfToken ? csrfToken.getAttribute('content') : '';

      if (_offerImageFile || _offerImageRemoved) {
        // Use FormData when image is involved
        var fd = new FormData();
        Object.keys(payload).forEach(function(k) {
          var v = payload[k];
          if (v === null || v === undefined) return;
          fd.append(k, typeof v === 'object' ? JSON.stringify(v) : v);
        });
        if (_offerImageFile) fd.append('image', _offerImageFile);
        if (_offerImageRemoved && !_offerImageFile) fd.append('remove_image', 'true');
        fetchOpts.headers = { 'X-CSRF-Token': csrfVal };
        fetchOpts.body = fd;
      } else {
        // Standard JSON submission
        fetchOpts.headers = { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfVal };
        fetchOpts.body = JSON.stringify(payload);
      }

      var res = await fetch(url, fetchOpts);

      var data = await res.json();

      if (!res.ok) {
        showMessage(data.message || 'A apărut o eroare la salvare.', 'error');
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg> Salvează';
        return;
      }

      // Save offer booking methods if custom mode
      var savedOfferId = data.offer_id || data.offerId || offerId;
      if (_ofBmMode === 'custom' && savedOfferId) {
        var bmMethods = [];
        _ofBmPlatforms.forEach(function(p) {
          if (!_ofBmSelected[p.slug]) return;
          var valInput = document.querySelector('[data-ofslug="' + p.slug + '"][data-field="value"]');
          var labelInput = document.querySelector('[data-ofslug="' + p.slug + '"][data-field="label"]');
          var val = valInput ? valInput.value.trim() : '';
          if (!val) return;
          bmMethods.push({ platform: p.slug, value: val, platform_label: labelInput ? labelInput.value.trim() : null });
        });
        try {
          var bmRes = await fetch('/api/web/portal/' + businessId + '/offers/' + savedOfferId + '/booking-methods', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfVal },
            credentials: 'same-origin',
            body: JSON.stringify({ methods: bmMethods })
          });
          if (!bmRes.ok) {
            var bmData = await bmRes.json().catch(function() { return {}; });
            showMessage('Eroare la salvarea metodelor de rezervare: ' + (bmData.message || 'Eroare necunoscută'), 'error');
            submitBtn.disabled = false;
            submitBtn.textContent = 'Salvează';
            return;
          }
        } catch (_bmErr) {
          console.error('[Booking] Save offer methods error:', _bmErr);
          showMessage('Eroare la salvarea metodelor de rezervare.', 'error');
          submitBtn.disabled = false;
          submitBtn.textContent = 'Salvează';
          return;
        }
      } else if (_ofBmMode === 'inherit' && savedOfferId) {
        // Clear any existing custom methods (revert to inherit)
        try {
          await fetch('/api/web/portal/' + businessId + '/offers/' + savedOfferId + '/booking-methods', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfVal },
            credentials: 'same-origin',
            body: JSON.stringify({ methods: [] })
          });
        } catch (_bmErr) { console.error('[Booking] Clear offer methods error:', _bmErr); }
      }

      // All offers (new and edited) go to pending_review — admin approves
      window.location.href = '/portal/' + businessId + '?offer_pending=1#oferte';

    } catch (err) {
      showMessage('Eroare de rețea. Verifică conexiunea și încearcă din nou.', 'error');
      submitBtn.disabled = false;
      submitBtn.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg> Salvează';
    }
  });

  // ─── Delete offer ──────────────────────────────────────────
  <% if (offer) { %>
  var deleteBtn = document.getElementById('of-delete-btn');
  deleteBtn.addEventListener('click', async function() {
    if (!confirm('Ești sigur că vrei să ștergi această ofertă? Această acțiune este ireversibilă.')) {
      return;
    }

    hideMessage();
    deleteBtn.disabled = true;
    deleteBtn.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="animation: spin 1s linear infinite;"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg> Se șterge...';

    try {
      var csrfToken = document.querySelector('meta[name="csrf-token"]');
      var res = await fetch('/api/web/portal/' + businessId + '/offers/' + offerId, {
        method: 'DELETE',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': csrfToken ? csrfToken.getAttribute('content') : ''
        }
      });

      var data = await res.json();

      if (!res.ok) {
        showMessage(data.message || 'A apărut o eroare la ștergere.', 'error');
        deleteBtn.disabled = false;
        deleteBtn.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg> Șterge oferta';
        return;
      }

      window.location.href = '/portal/' + businessId + '?offer_deleted=1#oferte';

    } catch (err) {
      showMessage('Eroare de rețea. Verifică conexiunea și încearcă din nou.', 'error');
      deleteBtn.disabled = false;
      deleteBtn.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg> Șterge oferta';
    }
  });
  <% } %>

  // ─── Live Preview Panel ─────────────────────────────────────
  (function initPreview() {
    var aside = document.querySelector('.ofp-preview-col');
    if (!aside) return; // safety — hidden on mobile anyway

    // ── Static business data (set once) ──
    var bizName     = aside.dataset.bizName     || '';
    var bizLogo     = aside.dataset.bizLogo     || '';
    var bizCover    = aside.dataset.bizCover    || '';
    var bizCity     = aside.dataset.bizCity      || '';
    var bizCategory = aside.dataset.bizCategory  || '';
    var offerImage  = aside.dataset.offerImage   || '';
    var initial     = bizName.charAt(0).toUpperCase() || '?';

    // Populate all static fields across the 4 cards + App preview
    aside.querySelectorAll('.ofp-biz-name').forEach(function(el)  { el.textContent = bizName; });
    aside.querySelectorAll('.ofp-city').forEach(function(el)      { el.textContent = bizCity; });
    aside.querySelectorAll('.ofp-cat').forEach(function(el)       { el.textContent = bizCategory; });

    // App preview — static business data
    var fpBizName = document.getElementById('fp-offer-biz-name');
    var fpBizCat  = document.getElementById('fp-offer-biz-cat');
    var fpBizCity = document.getElementById('fp-offer-biz-city');
    var fpBizLogoWrap = document.getElementById('fp-offer-biz-logo-wrap');
    if (fpBizName) fpBizName.textContent = bizName;
    if (fpBizCat)  fpBizCat.textContent = bizCategory;
    if (fpBizCity) fpBizCity.textContent = bizCity;
    if (fpBizLogoWrap) {
      if (bizLogo) {
        fpBizLogoWrap.innerHTML = '<img class="fp-biz-logo" src="' + bizLogo + '" alt="' + bizName + '">';
      } else {
        fpBizLogoWrap.innerHTML = '<div class="fp-biz-initial">' + initial + '</div>';
      }
    }

    // App hero image
    var fpHero = document.getElementById('fp-offer-hero');
    function updateAppHero(imgUrl) {
      if (!fpHero) return;
      var src = imgUrl || bizCover;
      fpHero.style.backgroundImage = src ? 'url(' + src + ')' : 'none';
    }
    updateAppHero(offerImage);

    // App booking chips — populated after booking methods load
    var fpBooking = document.getElementById('fp-offer-booking');
    var fpBookingList = document.getElementById('fp-offer-booking-list');
    var phoneIcon = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72"/></svg>';
    var whatsappIcon = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>';
    var webIcon = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>';

    window._updateAppBookingChips = function(methods) {
      if (!fpBooking || !fpBookingList) return;
      if (!methods || methods.length === 0) { fpBooking.style.display = 'none'; return; }
      fpBooking.style.display = '';
      fpBookingList.innerHTML = methods.map(function(m) {
        var platform = m.platform || '';
        var isPhone = platform === 'phone' || platform === 'telefon';
        var isWA = platform === 'whatsapp';
        var cls = isPhone ? 'phone' : isWA ? 'whatsapp' : 'website';
        var icon = isPhone ? phoneIcon : isWA ? whatsappIcon : webIcon;
        var label = m.platform_label || (isPhone ? 'Sună' : isWA ? 'WhatsApp' : platform);
        return '<span class="fp-booking-chip ' + cls + '">' + icon + label + '</span>';
      }).join('');
    };

    // Helper: set the image content for a preview card's image area
    // Fallback chain: imgUrl → bizCover → bizLogo → letter
    // Exposed to outer scope so offer image upload can call it
    window._ofpSetPreviewImage = function(container, imgUrl) {
      setPreviewImage(container, imgUrl);
      updateAppHero(imgUrl);
    };
    function setPreviewImage(container, imgUrl) {
      container.innerHTML = '';
      var coverSrc = imgUrl || bizCover;
      if (coverSrc) {
        var img = document.createElement('img');
        img.src = coverSrc;
        img.alt = bizName;
        img.style.cssText = 'width:100%;height:100%;object-fit:cover;display:block;';
        container.appendChild(img);
      } else if (bizLogo) {
        var logo = document.createElement('img');
        logo.src = bizLogo;
        logo.alt = bizName;
        logo.className = 'offer-placeholder-logo';
        container.appendChild(logo);
      } else {
        var letterBox = document.createElement('span');
        letterBox.className = 'offer-placeholder-letter';
        letterBox.textContent = initial;
        container.appendChild(letterBox);
      }
    }

    // Initial render: offer image → biz cover → biz logo → letter
    aside.querySelectorAll('.offer-image-placeholder').forEach(function(container) {
      setPreviewImage(container, offerImage);
    });

    // ── Form field references ──
    var titleInput    = document.getElementById('of-title');
    var discountType  = document.getElementById('of-discount-type');
    var discountValue = document.getElementById('of-discount-value');

    // ── All preview elements that need live updates ──
    var allTitles = aside.querySelectorAll('.ofp-title');
    var allBadges = aside.querySelectorAll('.ofp-badge');

    function formatBadge(type, val) {
      if (!val || val === '0') return '';
      switch (type) {
        case 'percentage': return '-' + val + '%';
        case 'fixed':      return '-' + val + ' lei';
        case 'special':    return val;
        default:           return val;
      }
    }

    // App preview elements
    var fpTitle = document.getElementById('fp-offer-title');
    var fpBadge = document.getElementById('fp-offer-badge');

    function updatePreview() {
      // Title — web cards + app
      var title = titleInput.value.trim() || 'Titlul ofertei apare aici';
      allTitles.forEach(function(el) { el.textContent = title; });
      if (fpTitle) fpTitle.textContent = title;

      // Discount badge — web cards + app
      var type = discountType.value;
      var val  = discountValue.value.trim();
      var badgeText = formatBadge(type, val);

      allBadges.forEach(function(el) {
        if (badgeText) { el.textContent = badgeText; el.style.display = ''; }
        else { el.textContent = ''; el.style.display = 'none'; }
      });
      if (fpBadge) {
        if (badgeText) { fpBadge.textContent = badgeText; fpBadge.style.display = ''; }
        else { fpBadge.textContent = ''; fpBadge.style.display = 'none'; }
      }
    }

    // ── Bind events ──
    titleInput.addEventListener('input', updatePreview);
    discountValue.addEventListener('input', updatePreview);
    discountType.addEventListener('change', updatePreview);

    // ── App preview: description + conditions + dates ──
    var descInput = document.getElementById('of-description');
    var condInput = document.getElementById('of-conditions');
    var fpDesc = document.getElementById('fp-offer-desc');
    var fpDescCard = document.getElementById('fp-offer-desc-card');
    var fpCond = document.getElementById('fp-offer-cond');
    var fpCondCard = document.getElementById('fp-offer-cond-card');

    if (descInput) {
      descInput.addEventListener('input', function() {
        var v = this.value.trim();
        if (fpDesc) fpDesc.textContent = v;
        if (fpDescCard) fpDescCard.style.display = v ? '' : 'none';
      });
      var dv = descInput.value.trim();
      if (fpDesc) fpDesc.textContent = dv;
      if (fpDescCard) fpDescCard.style.display = dv ? '' : 'none';
    }
    if (condInput) {
      condInput.addEventListener('input', function() {
        var v = this.value.trim();
        if (fpCond) fpCond.textContent = v;
        if (fpCondCard) fpCondCard.style.display = v ? '' : 'none';
      });
      var cv = condInput.value.trim();
      if (fpCond) fpCond.textContent = cv;
      if (fpCondCard) fpCondCard.style.display = cv ? '' : 'none';
    }

    // Dates
    var startDateInput = document.getElementById('of-start-date');
    var endDateInput   = document.getElementById('of-end-date');
    var fpDates    = document.getElementById('fp-offer-dates');
    var fpDateText = document.getElementById('fp-offer-date-text');
    var fpProgress = document.getElementById('fp-offer-progress');
    var fpStatus   = document.getElementById('fp-offer-status');

    function formatDateRo(ds) {
      if (!ds) return '';
      var d = new Date(ds);
      var m = ['ian.','feb.','mar.','apr.','mai','iun.','iul.','aug.','sep.','oct.','nov.','dec.'];
      var day = d.getDate() < 10 ? '0' + d.getDate() : d.getDate();
      return day + ' ' + m[d.getMonth()] + ' ' + d.getFullYear();
    }
    function updateDates() {
      if (!fpDates) return;
      var s = startDateInput ? startDateInput.value : '';
      var e = endDateInput ? endDateInput.value : '';
      if (!s && !e) { fpDates.style.display = 'none'; return; }
      fpDates.style.display = '';
      var text = 'Valabila: ';
      if (s) text += formatDateRo(s);
      if (s && e) text += ' - ';
      if (e) text += formatDateRo(e);
      if (fpDateText) fpDateText.textContent = text;
      var now = new Date(), sd = s ? new Date(s) : null, ed = e ? new Date(e) : null;
      if (sd && ed) {
        var total = ed - sd, elapsed = now - sd;
        var pct = total > 0 ? Math.max(0, Math.min(100, (elapsed / total) * 100)) : 0;
        if (fpProgress) {
          fpProgress.style.width = pct + '%';
          fpProgress.style.background = pct < 50 ? '#22c55e' : pct < 80 ? '#fbbf24' : '#ef4444';
        }
        if (fpStatus) {
          var active = now >= sd && now <= ed;
          fpStatus.textContent = active ? 'Activă' : (now > ed ? 'Expirată' : 'Viitoare');
          fpStatus.className = 'fp-status-badge ' + (active ? 'active' : 'expired');
        }
      }
    }
    if (startDateInput) startDateInput.addEventListener('change', updateDates);
    if (endDateInput) endDateInput.addEventListener('change', updateDates);
    updateDates();

    // ── Tab switcher ──
    var tabs  = aside.querySelectorAll('.ofp-tab');
    var views = aside.querySelectorAll('.ofp-view');

    tabs.forEach(function(tab) {
      tab.addEventListener('click', function() {
        var target = this.dataset.tab;

        // Toggle active tab
        tabs.forEach(function(t) { t.classList.toggle('active', t === tab); });

        // Toggle active view
        views.forEach(function(v) {
          var isTarget = v.id === 'ofp-view-' + target;
          v.classList.toggle('active', isTarget);
          v.hidden = !isTarget;
        });
      });
    });

    // ── Initial render (edit mode pre-population) ──
    updatePreview();
  })();

})();
</script>

<style>
  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
</style>
