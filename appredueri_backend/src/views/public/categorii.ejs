<%- include('partials/head', { pageTitle: t('categories.pageTitle'), activePage: 'categorii', pageDesc: t('categories.pageDesc') }) %>
<%- include('partials/navbar', { activePage: 'categorii', webUser: typeof webUser !== 'undefined' ? webUser : null }) %>

<section class="page-header">
  <div class="page-header-glow"></div>
  <div class="container">
    <h1 class="page-title text-gradient"><%= t('categories.pageTitle') %></h1>
    <p class="page-subtitle"><%= t('categories.subtitle', { count: categories.length }) %></p>
  </div>
</section>

<section class="section" style="padding-top: 0;">
  <div class="container">
    <div class="categories-page-grid">
      <% const categoryIcons = {
        'Clinica': '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 6v12"/><path d="M6 12h12"/><circle cx="12" cy="12" r="10"/></svg>',
        'Frizerie': '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="6" r="3"/><path d="M8.12 8.12 12 12"/><path d="M20 4 8.12 15.88"/><circle cx="6" cy="18" r="3"/><path d="M14.8 14.8 20 20"/></svg>',
        'Beauty': '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3L12 3Z"/></svg>',
        'Auto': '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.6A2 2 0 0 0 2 11v5c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><path d="M9 17h6"/><circle cx="17" cy="17" r="2"/></svg>',
        'Restaurant': '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2v0a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/></svg>',
        'Cafenea': '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 8h1a4 4 0 1 1 0 8h-1"/><path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"/><line x1="6" x2="6" y1="2" y2="4"/><line x1="10" x2="10" y1="2" y2="4"/><line x1="14" x2="14" y1="2" y2="4"/></svg>',
        'Fitness': '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6.5 6.5h11"/><path d="M6.5 17.5h11"/><path d="M4 10V6.5a2.5 2.5 0 0 1 5 0v11a2.5 2.5 0 0 0 5 0v-11a2.5 2.5 0 0 1 5 0V14"/><path d="M2 10h4"/><path d="M18 14h4"/></svg>',
        'Spa & Wellness': '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22c-4.97 0-9-2.24-9-5v-.09A14 14 0 0 1 12 12a14 14 0 0 1 9 4.91V17c0 2.76-4.03 5-9 5Z"/><path d="M12 2C6.48 2 2 6.48 2 12"/><path d="M12 2c5.52 0 10 4.48 10 10"/><path d="M12 2v10"/></svg>',
        'Veterinar': '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="4" r="2"/><circle cx="18" cy="8" r="2"/><circle cx="20" cy="16" r="2"/><path d="M9 10a5 5 0 0 1 5 5v3.5a3.5 3.5 0 0 1-6.84 1.045Q6.52 17.48 4.46 16.84A3.5 3.5 0 0 1 5.5 10Z"/></svg>',
        'Stomatologie': '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22c-1.5 0-2.5-1.2-3-2.6-.6-1.8-1-4.2-1.5-5.9-.3-1.1-.8-2-1.5-2.5-1.3-.9-2-2.3-2-4 0-2.8 2.2-5 5-5 1.3 0 2 .4 3 1 1-.6 1.7-1 3-1 2.8 0 5 2.2 5 5 0 1.7-.7 3.1-2 4-.7.5-1.2 1.4-1.5 2.5-.5 1.7-.9 4.1-1.5 5.9-.5 1.4-1.5 2.6-3 2.6Z"/></svg>',
        'Florarie': '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 7.5a4.5 4.5 0 1 1 4.5 4.5M12 7.5A4.5 4.5 0 1 0 7.5 12M12 7.5V9m-4.5 3a4.5 4.5 0 1 0 4.5 4.5M7.5 12H9m3 4.5a4.5 4.5 0 1 0 4.5-4.5M12 16.5V15m4.5-3H15"/><circle cx="12" cy="12" r="3"/><path d="m8 22 4-10 4 10"/></svg>',
        'Curatatorie': '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.38 3.46 16 2 12 4l-4-2-4.38 1.46A2 2 0 0 0 2 5.35V21a1 1 0 0 0 1 1h18a1 1 0 0 0 1-1V5.35a2 2 0 0 0-1.62-1.89Z"/><path d="M9 9.5a2.5 2.5 0 0 1 5 0c0 2-2.5 3-2.5 5"/><circle cx="11.5" cy="17" r=".5"/></svg>',
        'Foto & Video': '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3Z"/><circle cx="12" cy="13" r="3"/></svg>',
        'Magazine Online': '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg>'
      }; %>
      <% const defaultCatIcon = '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>'; %>
      <% categories.forEach(function(cat, index) { %>
        <a href="/oferte?category=<%= cat.id %>" class="category-card reveal reveal-delay-<%= (index % 5) + 1 %>">
          <div class="category-icon"><%- categoryIcons[cat.name] || defaultCatIcon %></div>
          <div class="category-name"><%= cat.name %></div>
          <div class="category-count"><%= cat.offer_count || 0 %> <%= t('common.offers') %></div>
        </a>
      <% }); %>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
