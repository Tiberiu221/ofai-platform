<%- include('partials/head', { pageTitle: 'Categorii', activePage: 'categorii', pageDesc: 'Explorează oferte pe categorii: restaurante, beauty, fitness, divertisment și multe altele.' }) %>
<%- include('partials/navbar', { activePage: 'categorii', webUser: typeof webUser !== 'undefined' ? webUser : null }) %>

<section class="page-header">
  <div class="page-header-glow"></div>
  <div class="container">
    <h1 class="page-title text-gradient">Categorii</h1>
    <p class="page-subtitle">Explorează oferte din <%= categories.length %> categorii disponibile</p>
  </div>
</section>

<section class="section" style="padding-top: 0;">
  <div class="container">
    <div class="categories-page-grid">
      <% const categoryIcons = { 'Clinica': '🏥', 'Frizerie': '💈', 'Beauty': '💄', 'Auto': '🚗', 'Cafenea': '☕', 'Fitness': '💪', 'Spa & Wellness': '🧖', 'Optica': '👓', 'Farmacie': '💊', 'Veterinar': '🐾', 'Stomatologie': '🦷', 'Florarie': '🌸', 'Curatatorie': '👔', 'Foto & Video': '📸', 'Magazine Online': '🛒' }; %>
      <% categories.forEach(function(cat, index) { %>
        <a href="/oferte?category=<%= cat.id %>" class="category-card reveal reveal-delay-<%= (index % 5) + 1 %>">
          <div class="category-icon"><%= categoryIcons[cat.name] || '📦' %></div>
          <div class="category-name"><%= cat.name %></div>
          <div class="category-count"><%= cat.offer_count || 0 %> oferte</div>
        </a>
      <% }); %>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
