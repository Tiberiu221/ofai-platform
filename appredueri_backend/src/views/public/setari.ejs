<%- include('partials/head', { pageTitle: 'Setări', activePage: 'setari' }) %>
<%- include('partials/navbar', { activePage: 'setari', webUser: webUser }) %>

<section class="page-header" style="padding-bottom: 24px;">
  <div class="page-header-glow"></div>
  <div class="container">
    <h1 class="page-title text-gradient">Setări</h1>
  </div>
</section>

<section class="section" style="padding-top: 0;">
  <div class="container" style="max-width: 640px;">

    <!-- Badges Gallery -->
    <%
      const earnedBadges = (typeof userBadges !== 'undefined' && userBadges) ? userBadges : [];
      const allBadgesDef = (typeof allBadges !== 'undefined' && allBadges) ? allBadges : [];
      const earnedIds = new Set(earnedBadges.map(b => b.id));
    %>
    <div class="settings-section reveal">
      <div class="badges-header" style="margin-bottom: 4px;">
        <h2 class="settings-section-title" style="margin: 0;">Insignele mele</h2>
        <span class="badges-count"><%= earnedBadges.length %>/<%= allBadgesDef.length %></span>
        <div class="badges-nav">
          <button class="badges-nav-btn" id="badges-prev" aria-label="Anterior" disabled>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
          </button>
          <button class="badges-nav-btn" id="badges-next" aria-label="Următor">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18"/></svg>
          </button>
        </div>
      </div>
      <p class="badges-subtitle">Selectează o insignă câștigată pentru recenzii</p>
      <div class="badges-strip-wrapper" id="badges-strip-wrapper">
        <div class="badges-strip" id="badges-strip">
          <!-- "Niciuna" option -->
          <div class="badge-item<%= !webUser.display_badge_id ? ' badge-selected' : '' %>" title="Fără insignă" onclick="selectDisplayBadge(null)" data-badge-id="none">
            <div class="badge-icon" style="background: var(--bg-surface); border-color: var(--border); color: var(--text-muted); --badge-color: var(--accent);">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </div>
            <span class="badge-name">Niciuna</span>
          </div>
          <!-- All badges: earned = selectable, locked = greyed out -->
          <% allBadgesDef.forEach(function(badge) {
            const isEarned = earnedIds.has(badge.id);
          %>
            <% if (isEarned) { %>
              <div class="badge-item<%= webUser.display_badge_id === badge.id ? ' badge-selected' : '' %>" title="<%= badge.description %>" onclick="selectDisplayBadge(<%= badge.id %>)" data-badge-id="<%= badge.id %>">
                <div class="badge-icon" style="background: <%= badge.color %>15; border-color: <%= badge.color %>40; color: <%= badge.color %>; --badge-color: <%= badge.color %>; --badge-glow: <%= badge.color %>30;">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="<%= badge.color %>"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                </div>
                <span class="badge-name"><%= badge.name %></span>
              </div>
            <% } else { %>
              <div class="badge-item badge-locked" title="<%= badge.description %>">
                <div class="badge-icon" style="background: var(--bg-surface); border-color: var(--border); color: var(--text-muted);">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="var(--text-muted)"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                </div>
                <span class="badge-name"><%= badge.name %></span>
              </div>
            <% } %>
          <% }); %>
        </div>
      </div>
    </div>
    <script nonce="<%= cspNonce %>">
    (function() {
      var strip = document.getElementById('badges-strip');
      var wrapper = document.getElementById('badges-strip-wrapper');
      var prevBtn = document.getElementById('badges-prev');
      var nextBtn = document.getElementById('badges-next');
      if (!strip || !wrapper) return;

      var SCROLL_STEP = 200;

      function updateNav() {
        var sl = strip.scrollLeft;
        var maxScroll = strip.scrollWidth - strip.clientWidth;
        var atStart = sl <= 8;
        var atEnd = sl >= maxScroll - 8;
        if (atStart) wrapper.classList.remove('scrolled-start');
        else wrapper.classList.add('scrolled-start');
        if (atEnd) wrapper.classList.add('scrolled-end');
        else wrapper.classList.remove('scrolled-end');
        if (prevBtn) prevBtn.disabled = atStart;
        if (nextBtn) nextBtn.disabled = atEnd;
      }
      strip.addEventListener('scroll', updateNav, { passive: true });

      if (prevBtn) prevBtn.addEventListener('click', function() {
        strip.scrollBy({ left: -SCROLL_STEP, behavior: 'smooth' });
      });
      if (nextBtn) nextBtn.addEventListener('click', function() {
        strip.scrollBy({ left: SCROLL_STEP, behavior: 'smooth' });
      });

      setTimeout(function() {
        var fits = strip.scrollWidth <= strip.clientWidth + 4;
        if (fits && prevBtn && nextBtn) {
          prevBtn.style.display = 'none';
          nextBtn.style.display = 'none';
        }
        updateNav();
      }, 100);

      var selected = strip.querySelector('.badge-selected');
      if (selected) {
        var offset = selected.offsetLeft - strip.clientWidth / 2 + selected.offsetWidth / 2;
        strip.scrollTo({ left: Math.max(0, offset), behavior: 'smooth' });
      }
    })();

    function selectDisplayBadge(badgeId) {
      document.querySelectorAll('.badge-item:not(.badge-locked)').forEach(function(el) {
        el.classList.remove('badge-selected');
      });
      if (badgeId === null) {
        var none = document.querySelector('[data-badge-id="none"]');
        if (none) none.classList.add('badge-selected');
      } else {
        var target = document.querySelector('[data-badge-id="' + badgeId + '"]');
        if (target) target.classList.add('badge-selected');
      }

      var strip = document.getElementById('badges-strip');
      var sel = strip.querySelector('.badge-selected');
      if (sel) {
        var offset = sel.offsetLeft - strip.clientWidth / 2 + sel.offsetWidth / 2;
        strip.scrollTo({ left: Math.max(0, offset), behavior: 'smooth' });
      }

      fetch('/api/web/account', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content || '' },
        credentials: 'same-origin',
        body: JSON.stringify({ display_badge_id: badgeId })
      }).then(function(r) { return r.json(); }).then(function(data) {
        if (data.success && window.showToast) showToast(data.message, 'success');
      }).catch(function() {
        if (window.showToast) showToast('Eroare la salvare', 'error');
      });
    }
    </script>

    <!-- Change Password (hidden for Google OAuth users) -->
    <% if (typeof isGoogleUser !== 'undefined' && isGoogleUser) { %>
    <div class="settings-section reveal">
      <h2 class="settings-section-title">Autentificare</h2>
      <p style="color: var(--text-secondary); font-size: 0.875rem;">Contul tău folosește <strong style="color: var(--accent);">Google Sign-In</strong>. Parola este gestionată de Google.</p>
    </div>
    <% } else { %>
    <div class="settings-section reveal">
      <h2 class="settings-section-title">Schimbă parola</h2>
      <form id="change-password-form" onsubmit="return changePassword(event)">
        <div class="auth-form-group">
          <label class="auth-label">Parola curentă</label>
          <input type="password" name="currentPassword" class="auth-input" required minlength="8">
        </div>
        <div class="auth-form-group">
          <label class="auth-label">Parola nouă</label>
          <input type="password" name="newPassword" class="auth-input" required minlength="8">
        </div>
        <div class="auth-form-group">
          <label class="auth-label">Confirmă parola nouă</label>
          <input type="password" name="confirmPassword" class="auth-input" required minlength="8">
        </div>
        <div id="password-error" class="auth-error" style="display: none;"></div>
        <div id="password-success" style="display: none; color: var(--success); font-size: 0.875rem; margin-bottom: 12px;"></div>
        <button type="submit" class="btn btn-primary" style="width: 100%;">Schimbă parola</button>
      </form>
    </div>
    <% } %>

    <!-- Preferences Link -->
    <div class="settings-section reveal">
      <a href="/preferinte" class="account-menu-item">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        <span>Preferințe oraș & categorii</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
      </a>
    </div>

    <!-- Privacy -->
    <div class="settings-section" style="margin-bottom: 20px;">
      <h3 style="font-size: 1rem; font-weight: 700; margin-bottom: 12px;">Confidentialitate</h3>
      <label style="display: flex; align-items: center; gap: 10px; cursor: pointer; padding: 12px 16px; background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px;">
        <input type="checkbox" id="show-picture-toggle" <%= webUser.show_picture_in_reviews !== false ? 'checked' : '' %> onchange="togglePictureVisibility(this.checked)" style="accent-color: var(--accent); width: 18px; height: 18px;">
        <div>
          <span style="font-weight: 600; font-size: 0.9rem;">Afiseaza poza de profil in recenzii</span>
          <p style="color: var(--text-secondary); font-size: 0.8rem; margin-top: 2px;">Cand este activ, poza ta de profil va fi vizibila in recenziile tale</p>
        </div>
      </label>
    </div>

    <!-- Logout -->
    <div class="settings-section reveal">
      <a href="/logout" class="btn btn-secondary" style="width: 100%;">Deconectare</a>
    </div>

    <!-- Delete Account -->
    <div class="settings-section settings-danger reveal">
      <h2 class="settings-section-title" style="color: var(--danger);">Zonă periculoasă</h2>
      <p style="color: var(--text-secondary); font-size: 0.875rem; margin-bottom: 16px;">Ștergerea contului este permanentă. Toate datele, favoritele și recenziile tale vor fi eliminate.</p>
      <button class="btn btn-ghost" style="color: var(--danger); border: 1px solid rgba(239, 68, 68, 0.3); width: 100%;" onclick="document.getElementById('delete-modal').style.display='flex'">Șterge contul</button>
    </div>

  </div>
</section>

<!-- Delete Account Modal -->
<div class="settings-modal" id="delete-modal" style="display: none;">
  <div class="settings-modal-content">
    <h3>Ești sigur?</h3>
    <% if (typeof isGoogleUser !== 'undefined' && isGoogleUser) { %>
    <p style="color: var(--text-secondary); margin-bottom: 16px;">Această acțiune este ireversibilă. Introdu adresa ta de email pentru confirmare.</p>
    <form onsubmit="return deleteAccount(event)">
      <div class="auth-form-group">
        <input type="email" name="deleteEmail" class="auth-input" placeholder="<%= webUser.email %>" required>
      </div>
      <div id="delete-error" class="auth-error" style="display: none;"></div>
      <div style="display: flex; gap: 12px;">
        <button type="button" class="btn btn-secondary" style="flex: 1;" onclick="document.getElementById('delete-modal').style.display='none'">Anulează</button>
        <button type="submit" class="btn" style="flex: 1; background: var(--danger); color: white;">Șterge contul</button>
      </div>
    </form>
    <% } else { %>
    <p style="color: var(--text-secondary); margin-bottom: 16px;">Această acțiune este ireversibilă. Introdu parola pentru confirmare.</p>
    <form onsubmit="return deleteAccount(event)">
      <div class="auth-form-group">
        <input type="password" name="deletePassword" class="auth-input" placeholder="Parola ta" required>
      </div>
      <div id="delete-error" class="auth-error" style="display: none;"></div>
      <div style="display: flex; gap: 12px;">
        <button type="button" class="btn btn-secondary" style="flex: 1;" onclick="document.getElementById('delete-modal').style.display='none'">Anulează</button>
        <button type="submit" class="btn" style="flex: 1; background: var(--danger); color: white;">Șterge contul</button>
      </div>
    </form>
    <% } %>
  </div>
</div>

<script nonce="<%= cspNonce %>">
  async function changePassword(e) {
    e.preventDefault();
    const form = e.target;
    const data = new FormData(form);
    const newPass = data.get('newPassword');
    const confirm = data.get('confirmPassword');
    const errEl = document.getElementById('password-error');
    const succEl = document.getElementById('password-success');
    errEl.style.display = 'none';
    succEl.style.display = 'none';

    if (newPass !== confirm) {
      errEl.textContent = 'Parolele nu coincid';
      errEl.style.display = '';
      return false;
    }

    try {
      const csrfToken = document.querySelector('meta[name="csrf-token"]');
      const res = await fetch('/api/web/change-password', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': csrfToken ? csrfToken.getAttribute('content') : ''
        },
        body: JSON.stringify({ currentPassword: data.get('currentPassword'), newPassword: newPass })
      });
      const json = await res.json();
      if (!res.ok) { errEl.textContent = json.message || 'Eroare'; errEl.style.display = ''; return false; }
      succEl.textContent = 'Parola a fost schimbată cu succes!';
      succEl.style.display = '';
      form.reset();
    } catch(err) { errEl.textContent = 'Eroare de rețea'; errEl.style.display = ''; }
    return false;
  }

  async function deleteAccount(e) {
    e.preventDefault();
    const form = e.target;
    const isGoogle = <%= typeof isGoogleUser !== 'undefined' && isGoogleUser ? 'true' : 'false' %>;
    const errEl = document.getElementById('delete-error');
    errEl.style.display = 'none';

    let bodyData;
    if (isGoogle) {
      const email = form.deleteEmail.value;
      if (email !== '<%= webUser.email %>') {
        errEl.textContent = 'Email-ul nu corespunde contului tău';
        errEl.style.display = '';
        return false;
      }
      bodyData = { email_confirm: email };
    } else {
      bodyData = { password: form.deletePassword.value };
    }

    try {
      const csrfToken = document.querySelector('meta[name="csrf-token"]');
      const res = await fetch('/api/web/delete-account', {
        method: 'DELETE',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': csrfToken ? csrfToken.getAttribute('content') : ''
        },
        body: JSON.stringify(bodyData)
      });
      const json = await res.json();
      if (!res.ok) { errEl.textContent = json.message || 'Eroare'; errEl.style.display = ''; return false; }
      window.location.href = '/';
    } catch(err) { errEl.textContent = 'Eroare de rețea'; errEl.style.display = ''; }
    return false;
  }
</script>

<script nonce="<%= cspNonce %>">
async function togglePictureVisibility(show) {
  try {
    const csrfToken = typeof getCsrfToken === 'function' ? getCsrfToken() : '';
    const res = await fetch('/api/web/account', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json', ...(csrfToken ? { 'X-CSRF-Token': csrfToken } : {}) },
      body: JSON.stringify({ show_picture_in_reviews: show })
    });
    const data = await res.json();
    if (data.success || res.ok) {
      if (typeof showToast === 'function') showToast(show ? 'Poza vizibila in recenzii' : 'Poza ascunsa din recenzii', 'success');
    }
  } catch (e) {
    if (typeof showToast === 'function') showToast('Eroare', 'error');
  }
}
</script>

<%- include('partials/footer') %>
