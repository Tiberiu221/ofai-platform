<%- include('partials/head', { pageTitle: 'Resetare parolă', activePage: null }) %>
<%- include('partials/navbar', { activePage: null, webUser: typeof webUser !== 'undefined' ? webUser : null }) %>

<!-- ═══════════════════════════════════════════════════════
     FORGOT PASSWORD PAGE
     ═══════════════════════════════════════════════════════ -->
<div class="auth-page">
  <canvas class="particle-canvas auth-particles"></canvas>
  <div class="auth-card">
    <!-- Logo -->
    <div class="auth-logo">
      <div class="auth-logo-icon">O</div>
      <span class="auth-logo-text">OFAI</span>
    </div>

    <!-- Title -->
    <h1 class="auth-title">Reseteaz&#259; parola</h1>
    <p class="auth-subtitle">Introdu email-ul pentru a primi un cod de resetare</p>

    <!-- Error message -->
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="auth-error">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
        <%= error %>
      </div>
    <% } %>

    <!-- Success message -->
    <% if (typeof message !== 'undefined' && message) { %>
      <div class="auth-success">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        <%= message %>
      </div>
    <% } %>

    <!-- Forgot Password Form -->
    <form action="/forgot-password" method="POST" class="auth-form">
      <div class="auth-form-group">
        <label for="email" class="auth-label">Email</label>
        <input
          type="email"
          id="email"
          name="email"
          class="auth-input"
          placeholder="exemplu@email.com"
          required
          autocomplete="email"
        >
      </div>

      <button type="submit" class="btn btn-primary btn-lg auth-submit">
        Trimite cod
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </button>
    </form>

    <!-- Reset Password Form (shown after code is sent) -->
    <% if (typeof showResetForm !== 'undefined' && showResetForm) { %>
      <div class="auth-reset-section">
        <h2 class="auth-reset-title">Introdu codul primit</h2>
        <p class="auth-reset-subtitle">Verific&#259; email-ul &#537;i introdu codul de resetare</p>

        <form action="/reset-password" method="POST" class="auth-form">
          <input type="hidden" name="email" value="<%= typeof email !== 'undefined' ? email : '' %>">

          <div class="auth-form-group">
            <label for="code" class="auth-label">Cod de resetare</label>
            <input
              type="text"
              id="code"
              name="code"
              class="auth-input"
              placeholder="Introdu codul din email"
              required
              autocomplete="one-time-code"
            >
          </div>

          <div class="auth-form-group">
            <label for="newPassword" class="auth-label">Parol&#259; nou&#259;</label>
            <input
              type="password"
              id="newPassword"
              name="newPassword"
              class="auth-input"
              placeholder="Minim 6 caractere"
              required
              minlength="6"
              autocomplete="new-password"
            >
          </div>

          <button type="submit" class="btn btn-primary btn-lg auth-submit">
            Schimb&#259; parola
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </button>
        </form>
      </div>
    <% } %>

    <!-- Back to login link -->
    <div class="auth-footer-link">
      <a href="/login" class="auth-link">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: -2px; margin-right: 4px;"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
        &#206;napoi la login
      </a>
    </div>
  </div>
</div>

<!-- Auth Page Styles -->
<style>
  .auth-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 120px 20px 80px;
    position: relative;
  }

  /* glow replaced by particle-canvas */

  .auth-card {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 440px;
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 24px;
    padding: 48px 40px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
  }

  .auth-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-bottom: 32px;
  }

  .auth-logo-icon {
    width: 40px;
    height: 40px;
    background: #fb923c;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 20px;
    color: #09090b;
  }

  .auth-logo-text {
    font-size: 24px;
    font-weight: 800;
    color: var(--text-primary, #fafafa);
    letter-spacing: -0.5px;
  }

  .auth-title {
    text-align: center;
    font-size: 28px;
    font-weight: 700;
    color: var(--text-primary, #fafafa);
    margin-bottom: 8px;
    letter-spacing: -0.5px;
  }

  .auth-subtitle {
    text-align: center;
    color: var(--text-secondary, #a1a1aa);
    font-size: 15px;
    margin-bottom: 32px;
  }

  .auth-error {
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.2);
    color: #fca5a5;
    padding: 12px 16px;
    border-radius: 12px;
    font-size: 14px;
    margin-bottom: 24px;
  }

  .auth-error svg {
    flex-shrink: 0;
    color: #f87171;
  }

  .auth-success {
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(34, 197, 94, 0.1);
    border: 1px solid rgba(34, 197, 94, 0.2);
    color: #86efac;
    padding: 12px 16px;
    border-radius: 12px;
    font-size: 14px;
    margin-bottom: 24px;
  }

  .auth-success svg {
    flex-shrink: 0;
    color: #4ade80;
  }

  .auth-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .auth-form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .auth-label {
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary, #a1a1aa);
  }

  .auth-input {
    width: 100%;
    padding: 12px 16px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    color: var(--text-primary, #fafafa);
    font-size: 15px;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
    font-family: inherit;
  }

  .auth-input::placeholder {
    color: rgba(255, 255, 255, 0.25);
  }

  .auth-input:focus {
    border-color: #fb923c;
    box-shadow: 0 0 0 3px rgba(251, 146, 60, 0.1);
  }

  .auth-submit {
    width: 100%;
    margin-top: 8px;
    justify-content: center;
  }

  .auth-footer-link {
    text-align: center;
    margin-top: 28px;
    font-size: 14px;
    color: var(--text-secondary, #a1a1aa);
  }

  .auth-link {
    color: #fb923c;
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s;
  }

  .auth-link:hover {
    color: #f59e0b;
  }

  .auth-reset-section {
    margin-top: 32px;
    padding-top: 32px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .auth-reset-title {
    font-size: 18px;
    font-weight: 600;
    color: var(--text-primary, #fafafa);
    margin-bottom: 8px;
    text-align: center;
  }

  .auth-reset-subtitle {
    font-size: 14px;
    color: var(--text-secondary, #a1a1aa);
    margin-bottom: 24px;
    text-align: center;
  }

  @media (max-width: 480px) {
    .auth-card {
      padding: 36px 24px;
      border-radius: 20px;
    }

    .auth-title {
      font-size: 24px;
    }
  }
</style>

<script>
// Step 1: Send reset code
document.querySelector('.auth-form').addEventListener('submit', async (e) => {
  e.preventDefault();
  const form = e.target;
  const btn = form.querySelector('.auth-submit');
  const email = form.querySelector('#email').value;

  const oldErr = form.parentElement.querySelector('.auth-error');
  if (oldErr) oldErr.remove();
  const oldSuccess = form.parentElement.querySelector('.auth-success');
  if (oldSuccess) oldSuccess.remove();

  btn.disabled = true;
  btn.textContent = 'Se trimite...';

  try {
    const resp = await fetch('/forgot-password', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email }),
    });
    const data = await resp.json();

    if (resp.ok) {
      // Show success + reveal reset form
      const successDiv = document.createElement('div');
      successDiv.className = 'auth-success';
      successDiv.textContent = data.message || 'Verifică email-ul pentru codul de resetare.';
      form.parentElement.insertBefore(successDiv, form);

      // Show reset section
      let resetSection = document.getElementById('reset-section');
      if (resetSection) resetSection.style.display = 'block';
      else {
        // Create reset form dynamically
        resetSection = document.createElement('div');
        resetSection.id = 'reset-section';
        resetSection.className = 'auth-reset-section';
        resetSection.innerHTML = `
          <h2 class="auth-reset-title">Introdu codul primit</h2>
          <p class="auth-reset-subtitle">Verifică email-ul și introdu codul de resetare</p>
          <form class="auth-form" id="resetForm">
            <input type="hidden" name="email" value="${email}">
            <div class="auth-form-group">
              <label for="code" class="auth-label">Cod de resetare</label>
              <input type="text" id="code" name="code" class="auth-input" placeholder="Introdu codul din email" required autocomplete="one-time-code">
            </div>
            <div class="auth-form-group">
              <label for="newPassword" class="auth-label">Parolă nouă</label>
              <input type="password" id="newPassword" name="newPassword" class="auth-input" placeholder="Minim 6 caractere" required minlength="6" autocomplete="new-password">
            </div>
            <button type="submit" class="btn btn-primary btn-lg auth-submit">Schimbă parola</button>
          </form>
        `;
        form.parentElement.appendChild(resetSection);

        // Step 2: Reset password handler
        document.getElementById('resetForm').addEventListener('submit', async (e2) => {
          e2.preventDefault();
          const resetForm = e2.target;
          const resetBtn = resetForm.querySelector('.auth-submit');
          const code = resetForm.querySelector('#code').value;
          const newPassword = resetForm.querySelector('#newPassword').value;
          const resetEmail = resetForm.querySelector('input[name="email"]').value;

          resetBtn.disabled = true;
          resetBtn.textContent = 'Se schimbă...';

          try {
            const resp2 = await fetch('/reset-password', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ email: resetEmail, code, newPassword }),
            });
            const data2 = await resp2.json();

            if (resp2.ok) {
              window.location.href = '/login';
            } else {
              const errDiv = document.createElement('div');
              errDiv.className = 'auth-error';
              errDiv.textContent = data2.message || 'Eroare la resetare';
              resetForm.insertBefore(errDiv, resetForm.firstChild);
              resetBtn.disabled = false;
              resetBtn.textContent = 'Schimbă parola';
            }
          } catch (err) {
            resetBtn.disabled = false;
            resetBtn.textContent = 'Schimbă parola';
          }
        });
      }

      btn.disabled = false;
      btn.textContent = 'Retrimite cod';
    } else {
      const errDiv = document.createElement('div');
      errDiv.className = 'auth-error';
      errDiv.textContent = data.message || 'Eroare';
      form.parentElement.insertBefore(errDiv, form);
      btn.disabled = false;
      btn.textContent = 'Trimite cod';
    }
  } catch (err) {
    btn.disabled = false;
    btn.textContent = 'Trimite cod';
  }
});
</script>

<%- include('partials/footer') %>
