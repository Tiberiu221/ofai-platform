<%- include('partials/head', { pageTitle: t('auth.resetPassword'), activePage: null }) %>
<%- include('partials/navbar', { activePage: null, webUser: typeof webUser !== 'undefined' ? webUser : null }) %>

<!-- ═══════════════════════════════════════════════════════
     FORGOT PASSWORD PAGE
     ═══════════════════════════════════════════════════════ -->
<div class="auth-page">
  <canvas class="particle-canvas auth-particles"></canvas>
  <div class="auth-card">
    <!-- Logo -->
    <div class="auth-logo">
      <img src="/images/ofai-wordmark-nobg.png?v=<%= typeof cacheBust !== 'undefined' ? cacheBust : '' %>" alt="OFAI" style="display:block;margin:0 auto 16px;height:56px;width:auto">
    </div>

    <!-- Title -->
    <h1 class="auth-title"><%= t('auth.resetPassword') %></h1>
    <p class="auth-subtitle"><%= t('auth.resetSubtitle') %></p>

    <!-- Error message -->
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="auth-error show">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
        <%= error %>
      </div>
    <% } %>

    <!-- Success message -->
    <% if (typeof message !== 'undefined' && message) { %>
      <div class="auth-success">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        <%= message %>
      </div>
    <% } %>

    <!-- Forgot Password Form -->
    <form class="auth-form" onsubmit="return false">
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
      <div class="auth-form-group">
        <label for="email" class="auth-label"><%= t('auth.email') %></label>
        <input
          type="email"
          id="email"
          name="email"
          class="auth-input"
          placeholder="exemplu@email.com"
          required
          autocomplete="email"
        >
      </div>

      <button type="submit" class="btn btn-primary btn-lg auth-submit">
        <%= t('auth.sendCode') %>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </button>
    </form>

    <!-- Reset Password Form (shown after code is sent) -->
    <% if (typeof showResetForm !== 'undefined' && showResetForm) { %>
      <div class="auth-reset-section">
        <h2 class="auth-reset-title"><%= t('auth.enterCode') %></h2>
        <p class="auth-reset-subtitle"><%= t('auth.verifyEmailCode') %></p>

        <form class="auth-form" onsubmit="return false">
          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
          <input type="hidden" name="email" value="<%= typeof email !== 'undefined' ? email : '' %>">

          <div class="auth-form-group">
            <label for="code" class="auth-label"><%= t('auth.resetCode') %></label>
            <input
              type="text"
              id="code"
              name="code"
              class="auth-input"
              placeholder="<%= t('auth.enterCodePlaceholder') %>"
              required
              autocomplete="one-time-code"
            >
          </div>

          <div class="auth-form-group">
            <label for="newPassword" class="auth-label"><%= t('auth.newPassword') %></label>
            <input
              type="password"
              id="newPassword"
              name="newPassword"
              class="auth-input"
              placeholder="<%= t('auth.passwordHint') %>"
              required
              minlength="8"
              autocomplete="new-password"
            >
          </div>

          <button type="submit" class="btn btn-primary btn-lg auth-submit">
            <%= t('auth.changePassword') %>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </button>
        </form>
      </div>
    <% } %>

    <!-- Back to login link -->
    <div class="auth-footer-link">
      <a href="/login" class="auth-link">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: -2px; margin-right: 4px;"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
        <%= t('auth.backToLogin') %>
      </a>
    </div>
  </div>
</div>

<!-- Auth page styles are in main.css -->

<script nonce="<%= cspNonce %>">
// i18n strings for JS
var i18n = {
  sending: '<%= t("auth.sending") %>',
  checkEmailForCode: '<%= t("auth.checkEmailForCode") %>',
  enterCode: '<%= t("auth.enterCode") %>',
  verifyEmailCode: '<%= t("auth.verifyEmailCode") %>',
  resetCode: '<%= t("auth.resetCode") %>',
  enterCodePlaceholder: '<%= t("auth.enterCodePlaceholder") %>',
  newPassword: '<%= t("auth.newPassword") %>',
  passwordHint: '<%= t("auth.passwordHint") %>',
  changePassword: '<%= t("auth.changePassword") %>',
  changing: '<%= t("auth.changing") %>',
  resendCode: '<%= t("auth.resendCode") %>',
  sendCode: '<%= t("auth.sendCode") %>',
  resetError: '<%= t("auth.resetError") %>',
};

// Step 1: Send reset code
document.querySelector('.auth-form').addEventListener('submit', async (e) => {
  e.preventDefault();
  const form = e.target;
  const btn = form.querySelector('.auth-submit');
  const email = form.querySelector('#email').value;

  const oldErr = form.parentElement.querySelector('.auth-error');
  if (oldErr) oldErr.remove();
  const oldSuccess = form.parentElement.querySelector('.auth-success');
  if (oldSuccess) oldSuccess.remove();

  btn.disabled = true;
  btn.textContent = i18n.sending;

  try {
    const resp = await fetch('/forgot-password', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content || ''
      },
      body: JSON.stringify({ email }),
    });
    const data = await resp.json();

    if (resp.ok) {
      // Show success + reveal reset form
      const successDiv = document.createElement('div');
      successDiv.className = 'auth-success';
      successDiv.textContent = data.message || i18n.checkEmailForCode;
      form.parentElement.insertBefore(successDiv, form);

      // Show reset section
      let resetSection = document.getElementById('reset-section');
      if (resetSection) resetSection.style.display = 'block';
      else {
        // Create reset form dynamically
        resetSection = document.createElement('div');
        resetSection.id = 'reset-section';
        resetSection.className = 'auth-reset-section';
        const safeEmail = email.replace(/[&<>"']/g, function(c) { return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; });
        resetSection.innerHTML = `
          <h2 class="auth-reset-title">${i18n.enterCode}</h2>
          <p class="auth-reset-subtitle">${i18n.verifyEmailCode}</p>
          <form class="auth-form" id="resetForm">
            <input type="hidden" name="email" value="${safeEmail}">
            <div class="auth-form-group">
              <label for="code" class="auth-label">${i18n.resetCode}</label>
              <input type="text" id="code" name="code" class="auth-input" placeholder="${i18n.enterCodePlaceholder}" required autocomplete="one-time-code">
            </div>
            <div class="auth-form-group">
              <label for="newPassword" class="auth-label">${i18n.newPassword}</label>
              <input type="password" id="newPassword" name="newPassword" class="auth-input" placeholder="${i18n.passwordHint}" required minlength="8" autocomplete="new-password">
            </div>
            <button type="submit" class="btn btn-primary btn-lg auth-submit">${i18n.changePassword}</button>
          </form>
        `;
        form.parentElement.appendChild(resetSection);

        // Step 2: Reset password handler
        document.getElementById('resetForm').addEventListener('submit', async (e2) => {
          e2.preventDefault();
          const resetForm = e2.target;
          const resetBtn = resetForm.querySelector('.auth-submit');
          const code = resetForm.querySelector('#code').value;
          const newPassword = resetForm.querySelector('#newPassword').value;
          const resetEmail = resetForm.querySelector('input[name="email"]').value;

          resetBtn.disabled = true;
          resetBtn.textContent = i18n.changing;

          try {
            const resp2 = await fetch('/reset-password', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content || ''
              },
              body: JSON.stringify({ email: resetEmail, code, newPassword }),
            });
            const data2 = await resp2.json();

            if (resp2.ok) {
              window.location.href = '/login';
            } else {
              const errDiv = document.createElement('div');
              errDiv.className = 'auth-error';
              errDiv.textContent = data2.message || i18n.resetError;
              resetForm.insertBefore(errDiv, resetForm.firstChild);
              resetBtn.disabled = false;
              resetBtn.textContent = i18n.changePassword;
            }
          } catch (err) {
            resetBtn.disabled = false;
            resetBtn.textContent = i18n.changePassword;
          }
        });
      }

      btn.disabled = false;
      btn.textContent = i18n.resendCode;
    } else {
      const errDiv = document.createElement('div');
      errDiv.className = 'auth-error';
      errDiv.textContent = data.message || 'Error';
      form.parentElement.insertBefore(errDiv, form);
      btn.disabled = false;
      btn.textContent = i18n.sendCode;
    }
  } catch (err) {
    btn.disabled = false;
    btn.textContent = i18n.sendCode;
  }
});
</script>

<%- include('partials/footer') %>
