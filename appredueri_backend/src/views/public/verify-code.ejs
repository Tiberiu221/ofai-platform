<%- include('partials/head', { pageTitle: t('auth.verifyCode'), activePage: null, noIndex: true }) %>
<%- include('partials/navbar', { activePage: null, webUser: typeof webUser !== 'undefined' ? webUser : null }) %>

<div class="auth-page">
  <canvas class="particle-canvas auth-particles"></canvas>
  <div class="auth-card">
    <div class="auth-logo">
      <img src="/images/ofai-wordmark-nobg.png?v=<%= typeof cacheBust !== 'undefined' ? cacheBust : '' %>" alt="OFAI" style="display:block;margin:0 auto 16px;height:56px;width:auto">
    </div>

    <h1 class="auth-title"><%= t('auth.verifyCode') %></h1>
    <p class="auth-subtitle"><%= t('auth.verifyCodeSubtitle') %></p>

    <div id="verify-error" class="auth-error" style="display:none"></div>

    <form class="auth-form" id="verifyForm" onsubmit="return false">
      <div class="auth-form-group">
        <label for="vc-email" class="auth-label"><%= t('auth.email') %></label>
        <input type="email" id="vc-email" name="email" class="auth-input" placeholder="exemplu@email.com" required autocomplete="email"
          value="<%= typeof prefillEmail !== 'undefined' ? prefillEmail : '' %>">
      </div>

      <div class="auth-form-group">
        <label for="vc-code" class="auth-label"><%= t('auth.resetCode') %></label>
        <input type="text" id="vc-code" name="code" class="auth-input" placeholder="<%= t('auth.enterCodePlaceholder') %>" required autocomplete="one-time-code" inputmode="numeric" maxlength="6">
      </div>

      <div class="auth-form-group">
        <label for="vc-password" class="auth-label"><%= t('auth.newPassword') %></label>
        <input type="password" id="vc-password" name="newPassword" class="auth-input" placeholder="<%= t('auth.passwordHint') %>" required minlength="8" autocomplete="new-password">
      </div>

      <button type="submit" class="btn btn-primary btn-lg auth-submit" id="vc-btn">
        <%= t('auth.changePassword') %>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </button>
    </form>

    <div class="auth-footer-link">
      <a href="/forgot-password" class="auth-link">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: -2px; margin-right: 4px;"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
        <%= t('auth.backToResetPassword') %>
      </a>
    </div>
  </div>
</div>

<script nonce="<%= cspNonce %>">
document.getElementById('verifyForm').addEventListener('submit', async function(e) {
  e.preventDefault();
  var btn = document.getElementById('vc-btn');
  var errEl = document.getElementById('verify-error');
  errEl.style.display = 'none';

  var email = document.getElementById('vc-email').value.trim();
  var code = document.getElementById('vc-code').value.trim();
  var newPassword = document.getElementById('vc-password').value;

  if (!email || !code || !newPassword) {
    errEl.textContent = '<%= t("auth.allFieldsRequired") %>';
    errEl.style.display = 'block';
    return;
  }

  btn.disabled = true;
  btn.textContent = '<%= t("auth.changing") %>';

  try {
    var resp = await fetch('/reset-password', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': (document.querySelector('meta[name="csrf-token"]') || {}).content || ''
      },
      body: JSON.stringify({ email: email, code: code, newPassword: newPassword })
    });
    var data = await resp.json();
    if (resp.ok) {
      window.location.href = '/login';
    } else {
      errEl.textContent = data.message || '<%= t("auth.resetError") %>';
      errEl.style.display = 'block';
      btn.disabled = false;
      btn.innerHTML = '<%= t("auth.changePassword") %> <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>';
    }
  } catch (err) {
    errEl.textContent = '<%= t("auth.resetError") %>';
    errEl.style.display = 'block';
    btn.disabled = false;
    btn.innerHTML = '<%= t("auth.changePassword") %> <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>';
  }
});
</script>

<%- include('partials/footer') %>
