<%- include('partials/head', {
  pageTitle: business.name,
  pageDesc: 'Descoperă ofertele și reducerile de la ' + business.name + (business.city ? ' din ' + business.city.name : '') + ' pe OFAI.',
  ogTitle: business.name + ' \— OFAI',
  ogDesc: 'Oferte și reduceri de la ' + business.name + (business.city ? ' în ' + business.city.name : ''),
  ogImage: business.cover_image || null,
  ogType: 'business.business',
  canonicalUrl: 'https://ofai.ro/business/' + business.id,
  ogUrl: 'https://ofai.ro/business/' + business.id
}) %>
<%- include('partials/navbar', { activePage: null, webUser: typeof webUser !== 'undefined' ? webUser : null }) %>

<!-- ═══════════════════════════════════════════════════════
     BREADCRUMB
     ═══════════════════════════════════════════════════════ -->
<div class="container">
  <nav class="bd-breadcrumb">
    <a href="/">Acasă</a>
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
    <a href="/business-uri">Business-uri</a>
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
    <span><%= business.name %></span>
  </nav>
</div>

<!-- ═══════════════════════════════════════════════════════
     HERO — Cover Image
     ═══════════════════════════════════════════════════════ -->
<section class="bd-hero">
  <% if (business.cover_image) { %>
    <img src="<%= business.cover_image %>" alt="<%= business.name %>" class="bd-hero-img" width="800" height="280" loading="lazy">
  <% } %>
  <div class="bd-hero-gradient"></div>
</section>

<!-- ═══════════════════════════════════════════════════════
     PROFILE (single column, premium left-aligned)
     ═══════════════════════════════════════════════════════ -->
<div class="bd-header-layout container">
  <section class="business-profile-section">
    <div class="bd-profile-top">
      <div class="bd-avatar">
        <% if (business.logo_url) { %>
          <img src="<%= business.logo_url %>" alt="<%= business.name %>" class="bd-avatar-img" width="80" height="80" loading="lazy">
        <% } else { %>
          <div class="bd-avatar-fallback"><%= business.name.charAt(0).toUpperCase() %></div>
        <% } %>
      </div>

      <div class="bd-profile-info">
        <h1 class="bd-business-name">
          <%= business.name %>
          <% if (business.badge_type === 'premium') { %>
            <span class="premium-badge-wrap" style="position: relative; display: inline-flex; cursor: help;">
              <svg class="premium-badge-icon" width="22" height="22" viewBox="0 0 24 24" fill="#a78bfa"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/></svg>
              <span class="premium-tooltip">Business Premium OFAI</span>
            </span>
          <% } else if (business.badge_type === 'verified' || business.is_verified) { %>
            <span class="verified-badge-wrap" style="position: relative; display: inline-flex; cursor: help;">
              <svg class="verified-badge" width="22" height="22" viewBox="0 0 24 24" fill="#fb923c"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/></svg>
              <span class="verified-tooltip">Business verificat de echipa OFAI</span>
            </span>
          <% } %>
        </h1>

        <div class="bd-rating-row">
          <div class="bd-stars">
            <% for (let i = 1; i <= 5; i++) { %>
              <% if (i <= Math.floor(business.rating || 0)) { %>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="#fb923c" stroke="#fb923c" stroke-width="1.5"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <% } else if (i - 0.5 <= (business.rating || 0)) { %>
                <svg width="18" height="18" viewBox="0 0 24 24" stroke="#fb923c" stroke-width="1.5" fill="none"><defs><linearGradient id="half-<%= i %>"><stop offset="50%" stop-color="#fb923c"/><stop offset="50%" stop-color="transparent"/></linearGradient></defs><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" fill="url(#half-<%= i %>)"/></svg>
              <% } else { %>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#52525b" stroke-width="1.5"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <% } %>
            <% } %>
          </div>
          <span class="bd-rating-text">
            <%= business.rating ? Number(business.rating).toFixed(1) : '0.0' %>
            <span class="bd-rating-count">(<%= business.rating_count || 0 %> recenzii)</span>
          </span>
        </div>

        <div class="bd-badges">
          <% if (business.category) { %>
            <a href="/oferte?category=<%= business.category.id %>" class="bd-badge">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
              <%= business.category.name %>
            </a>
          <% } %>
          <% if (business.city) { %>
            <a href="/oferte?city=<%= business.city.id %>" class="bd-badge">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              <%= business.city.name %>
            </a>
          <% } %>
          <span class="bd-badge offer-distance" data-lat="<%= business.lat || '' %>" data-lng="<%= business.lng || '' %>" style="display:none;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="3 11 22 2 13 21 11 13 3 11"/></svg>
            <span class="offer-distance-text"></span>
          </span>
        </div>
      </div>

      <div class="bd-profile-actions">
        <div style="display: flex; align-items: center; gap: 10px;">
          <button
            class="bd-follow-btn follow-btn btn btn-secondary"
            data-business-id="<%= business.id %>"
            data-following="<%= isFollowing ? 'true' : 'false' %>"
            onclick="toggleFollow(<%= business.id %>)"
          >
            <% if (isFollowing) { %>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
              Urmărești
            <% } else { %>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
              Urmărește
            <% } %>
          </button>
          <% if (parseInt(business.follower_count) >= 3) { %>
            <span style="font-size: 0.8125rem; color: var(--text-secondary);"><%= business.follower_count %> urmăritori</span>
          <% } %>
        </div>
        <button class="bd-share-btn btn btn-secondary" data-share-name="<%= business.name %>" data-track-bid="<%= business.id %>" aria-label="Distribuie business-ul">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg>
          Distribuie
        </button>
      </div>
    </div>
  </section>

  <div class="bd-actions">
    <% if (business.phone) { %>
      <a href="tel:<%= business.phone %>" class="bd-action-btn" onclick="trackClick(<%= business.id %>,'phone')">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        Sună
      </a>
    <% } %>
    <% if (business.website) { %>
      <a href="<%= business.website %>" target="_blank" rel="noopener noreferrer" class="bd-action-btn" onclick="trackClick(<%= business.id %>,'website')">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" x2="22" y1="12" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
        Website
      </a>
    <% } %>
    <% if (business.lat && business.lng) { %>
      <a href="https://www.google.com/maps/dir/?api=1&destination=<%= business.lat %>,<%= business.lng %>" target="_blank" rel="noopener noreferrer" class="bd-action-btn" onclick="trackClick(<%= business.id %>,'navigate')">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="3 11 22 2 13 21 11 13 3 11"/></svg>
        Navighează
      </a>
    <% } %>
  </div>

  <% if (business.booking && business.booking.type && business.booking.type !== 'none') { %>
  <div class="bd-booking-inline">
    <div class="booking-card">
      <% if (business.booking.type === 'phone' && business.booking.phone) { %>
        <a href="tel:<%= business.booking.phone %>" class="btn btn-primary bc-booking-btn" onclick="trackClick(<%= business.id %>,'phone')">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          Rezerva telefonic: <%= business.booking.phone %>
        </a>
      <% } else if (business.booking.type === 'whatsapp' && business.booking.whatsapp) { %>
        <a href="https://wa.me/<%= business.booking.whatsapp.replace(/[^0-9]/g, '') %>" target="_blank" rel="noopener noreferrer" class="btn btn-primary bc-booking-btn bc-whatsapp-btn" onclick="trackClick(<%= business.id %>,'whatsapp')">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/></svg>
          Rezerva pe WhatsApp
        </a>
      <% } else if (business.booking.type === 'url' && business.booking.url) { %>
        <a href="<%= business.booking.url %>" target="_blank" rel="noopener noreferrer" class="btn btn-primary bc-booking-btn" onclick="trackClick(<%= business.id %>,'booking_url')">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" x2="21" y1="14" y2="3"/></svg>
          Rezerva online
        </a>
      <% } %>
      <% if (business.booking.instructions) { %>
        <p class="bc-instructions"><%= business.booking.instructions %></p>
      <% } %>
    </div>
  </div>
  <% } %>
</div>

<!-- Geo Banner -->
<div class="bd-content">
  <div id="geo-banner" class="geo-banner" style="display:none;">
    <div class="geo-banner-content">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
      <span id="geo-banner-text">Activează locația pentru a vedea distanța</span>
      <button class="btn btn-primary" id="geo-activate-btn">Activează locația</button>
    </div>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════════
     1. OFERTE ACTIVE
     ═══════════════════════════════════════════════════════ -->
<% if (offers && offers.length > 0) { %>
<div class="bd-content">
  <div class="detail-card">
    <div class="detail-card-header">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" x2="7.01" y1="7" y2="7"/></svg>
      <span>Oferte active</span>
      <span class="detail-card-badge"><%= offers.length %> <%= offers.length === 1 ? 'ofertă' : 'oferte' %></span>
    </div>

    <% if (showPinch) { %>
      <div class="pinch-request-section" style="margin-bottom: 24px;">
        <div class="pinch-card" style="background: rgba(251, 146, 60, 0.08); border: 1px solid rgba(251, 146, 60, 0.15); border-radius: 12px; padding: 16px 20px; text-align: center;">
          <% if (requestCount > 0) { %>
            <p class="pinch-count" style="margin: 0 0 12px; font-size: 13px; color: var(--text-secondary);"><%= requestCount %> <%= requestCount === 1 ? 'persoană a cerut' : 'persoane au cerut' %> deja o ofertă</p>
          <% } %>
          <% if (typeof webUser !== 'undefined' && webUser) { %>
            <% if (userRequested) { %>
              <button class="pinch-btn pinch-btn-done" disabled style="padding: 10px 20px; background: rgba(82, 82, 91, 0.3); color: var(--text-secondary); border: none; border-radius: 8px; font-size: 14px; font-weight: 600; cursor: not-allowed;">
                ✓ Cerere trimisă
              </button>
            <% } else { %>
              <button class="pinch-btn" onclick="requestOffer(<%= business.id %>)" style="padding: 10px 20px; background: var(--accent); color: #09090b; border: none; border-radius: 8px; font-size: 14px; font-weight: 600; cursor: pointer; transition: all 0.2s;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: -2px;"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg> Cere mai multe oferte
              </button>
            <% } %>
          <% } else { %>
            <a href="/login?returnTo=/business/<%= business.id %>" class="pinch-btn pinch-btn-login" style="display: inline-block; padding: 10px 20px; background: var(--accent); color: #09090b; border: none; border-radius: 8px; font-size: 14px; font-weight: 600; text-decoration: none; transition: all 0.2s;">
              Conectează-te pentru a cere o ofertă
            </a>
          <% } %>
        </div>
      </div>
    <% } %>

    <div class="offers-grid">
      <% offers.forEach((offer, i) => { %>
        <a href="/oferta/<%= offer.id %>" class="offer-card reveal reveal-delay-<%= Math.min((i % 4) + 1, 5) %>">
          <div class="offer-image-wrapper">
            <% if (offer.image_url) { %>
              <img src="<%= offer.image_url %>" alt="<%= offer.title %>" class="offer-image" loading="lazy" width="400" height="225">
            <% } else if (offer.business_logo || business.logo_url) { %>
              <div class="offer-image-placeholder">
                <img src="<%= offer.business_logo || business.logo_url %>" alt="<%= business.name %>" class="offer-placeholder-logo" width="40" height="40">
              </div>
            <% } else { %>
              <div class="offer-image-placeholder">
                <span class="offer-placeholder-letter"><%= business.name.charAt(0) %></span>
              </div>
            <% } %>
            <div class="offer-badge">
              <% if (offer.discount_type === 'percent' || offer.discount_type === 'percentage') { %>
                -<%= offer.discount_value %>%
              <% } else { %>
                <%= offer.discount_value %> lei
              <% } %>
            </div>
            <% if (offer.end_date) { %>
              <div class="countdown-overlay" data-end-date="<%= new Date(offer.end_date).toISOString() %>"></div>
            <% } %>
            <div class="card-heart-btn<%= (userFavoriteIds || []).includes(offer.id) ? ' is-active' : '' %>" data-offer-id="<%= offer.id %>" data-favorited="<%= (userFavoriteIds || []).includes(offer.id) ? 'true' : 'false' %>" onclick="window.toggleCardFavorite(<%= offer.id %>, event)" role="button" tabindex="0" aria-label="Favorite"><svg class="heart-outline" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg><svg class="heart-filled" width="18" height="18" viewBox="0 0 24 24" fill="#ef4444" stroke="#ef4444" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg></div>
          </div>
          <div class="offer-content">
            <div class="offer-title"><%= offer.title %></div>
            <div class="offer-business"><%= offer.business ? offer.business.name : business.name %></div>
            <div class="offer-meta">
              <% if (business.city) { %>
                <span class="offer-meta-item">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                  <%= business.city.name %>
                </span>
              <% } %>
              <span class="offer-meta-item offer-distance" data-lat="<%= business.lat || '' %>" data-lng="<%= business.lng || '' %>" style="display:none;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="3 11 22 2 13 21 11 13 3 11"/></svg>
                <span class="offer-distance-text"></span>
              </span>
              <% if (business.category) { %>
                <span class="offer-meta-item">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                  <%= business.category.name %>
                </span>
              <% } %>
            </div>
          </div>
        </a>
      <% }); %>
    </div>
  </div>
</div>
<% } else if (showPinch) { %>
<!-- No offers — pinch CTA -->
<div class="bd-content">
  <div class="detail-card">
    <div class="detail-card-header">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" x2="7.01" y1="7" y2="7"/></svg>
      <span>Oferte</span>
    </div>

    <div class="pinch-request-section">
      <div class="pinch-card pinch-card-empty" style="background: linear-gradient(135deg, rgba(251, 146, 60, 0.1) 0%, rgba(251, 146, 60, 0.05) 100%); border: 2px solid rgba(251, 146, 60, 0.2); border-radius: 16px; padding: 40px 24px; text-align: center; max-width: 500px; margin: 0 auto;">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin: 0 auto 16px; opacity: 0.6;"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        <h3 style="margin: 0 0 8px; font-size: 18px; color: var(--text-primary);">Momentan nu există oferte active</h3>
        <p style="margin: 0 0 20px; font-size: 14px; color: var(--text-secondary); line-height: 1.5;">Cere o ofertă nouă și te vom notifica când business-ul adaugă una!</p>

        <% if (requestCount > 0) { %>
          <p class="pinch-count" style="margin: 0 0 16px; font-size: 13px; color: var(--accent); font-weight: 600;"><%= requestCount %> <%= requestCount === 1 ? 'persoană a cerut' : 'persoane au cerut' %> deja o ofertă</p>
        <% } %>

        <% if (typeof webUser !== 'undefined' && webUser) { %>
          <% if (userRequested) { %>
            <button class="pinch-btn pinch-btn-done" disabled style="padding: 12px 28px; background: rgba(82, 82, 91, 0.3); color: var(--text-secondary); border: none; border-radius: 10px; font-size: 15px; font-weight: 600; cursor: not-allowed;">
              ✓ Cerere trimisă
            </button>
          <% } else { %>
            <button class="pinch-btn" onclick="requestOffer(<%= business.id %>)" style="padding: 12px 28px; background: var(--accent); color: #09090b; border: none; border-radius: 10px; font-size: 15px; font-weight: 600; cursor: pointer; transition: all 0.2s; box-shadow: 0 4px 12px rgba(251, 146, 60, 0.3);">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: -2px;"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg> Vreau o ofertă!
            </button>
          <% } %>
        <% } else { %>
          <a href="/login?returnTo=/business/<%= business.id %>" class="pinch-btn pinch-btn-login" style="display: inline-block; padding: 12px 28px; background: var(--accent); color: #09090b; border: none; border-radius: 10px; font-size: 15px; font-weight: 600; text-decoration: none; transition: all 0.2s; box-shadow: 0 4px 12px rgba(251, 146, 60, 0.3);">
            Conectează-te pentru a cere o ofertă
          </a>
        <% } %>
      </div>
    </div>
  </div>
</div>
<% } %>

<!-- ═══════════════════════════════════════════════════════
     2. LOCAȚII
     ═══════════════════════════════════════════════════════ -->
<% if (business.locations && business.locations.length > 0) { %>
<div class="bd-content">
  <div class="detail-card">
    <div class="detail-card-header">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
      <span>Locații</span>
      <span class="detail-card-badge"><%= business.locations.length %> <%= business.locations.length === 1 ? 'locație' : 'locații' %></span>
    </div>

    <div class="bd-locations-grid">
      <% business.locations.forEach((loc, i) => { %>
        <div class="booking-card reveal reveal-delay-<%= Math.min(i + 1, 5) %>">
          <div class="bc-row">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            <span><%= loc.address %></span>
          </div>
          <% if (loc.phone) { %>
            <div class="bc-row">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              <a href="tel:<%= loc.phone %>" onclick="trackClick(<%= business.id %>,'phone')"><%= loc.phone %></a>
            </div>
          <% } %>
          <% if (loc.city) { %>
            <div class="bc-row">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
              <span><%= loc.city.name %></span>
            </div>
          <% } %>

          <div class="bc-actions-row">
            <% if (loc.lat && loc.lng) { %>
              <a href="https://www.google.com/maps/dir/?api=1&destination=<%= loc.lat %>,<%= loc.lng %>" target="_blank" rel="noopener noreferrer" class="btn btn-secondary bc-action-btn" onclick="trackClick(<%= business.id %>,'navigate')">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="3 11 22 2 13 21 11 13 3 11"/></svg>
                Navigheaz&#259;
              </a>
            <% } %>
            <% if (loc.booking_type === 'phone' && loc.booking_phone) { %>
              <a href="tel:<%= loc.booking_phone %>" class="btn btn-primary bc-action-btn" onclick="trackClick(<%= business.id %>,'phone')">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                Rezerv&#259;: <%= loc.booking_phone %>
              </a>
            <% } else if (loc.booking_type === 'whatsapp' && loc.booking_whatsapp) { %>
              <a href="https://wa.me/<%= loc.booking_whatsapp.replace(/[^0-9]/g, '') %>" target="_blank" rel="noopener noreferrer" class="btn bc-action-btn bc-whatsapp-btn" onclick="trackClick(<%= business.id %>,'whatsapp')">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/></svg>
                Rezerv&#259; pe WhatsApp
              </a>
            <% } else if (loc.booking_type === 'url' && loc.booking_url) { %>
              <a href="<%= loc.booking_url %>" target="_blank" rel="noopener noreferrer" class="btn btn-primary bc-action-btn" onclick="trackClick(<%= business.id %>,'booking_url')">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" x2="21" y1="14" y2="3"/></svg>
                Rezerv&#259; online
              </a>
            <% } %>
          </div>
          <% if (loc.booking_instructions) { %>
            <p class="bc-instructions"><%= loc.booking_instructions %></p>
          <% } %>
        </div>
      <% }); %>
    </div>
  </div>
</div>
<% } %>

<!-- ═══════════════════════════════════════════════════════
     3. SUMAR AI — Ce spun clienții
     ═══════════════════════════════════════════════════════ -->
<% if (reviewSummary) { %>
<div class="bd-content">
  <div class="detail-card" style="background: rgba(251, 146, 60, 0.04);">
    <div class="detail-card-header">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.912 5.813a2 2 0 0 0 1.275 1.275L21 12l-5.813 1.912a2 2 0 0 0-1.275 1.275L12 21l-1.912-5.813a2 2 0 0 0-1.275-1.275L3 12l5.813-1.912a2 2 0 0 0 1.275-1.275L12 3z"/></svg>
      <span>Ce spun clienții</span>
      <span class="detail-card-badge">AI &mdash; <%= reviewSummary.review_count %> recenzii</span>
    </div>
    <p class="ai-summary-text" style="margin: 0 0 12px;"><%= reviewSummary.text %></p>
    <a href="#reviews-section" style="display: inline-flex; align-items: center; gap: 6px; font-size: 0.8125rem; color: var(--accent); text-decoration: none; font-weight: 500; transition: opacity 0.2s;">
      Adaugă recenzia ta
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
    </a>
  </div>
</div>
<% } %>

<!-- ═══════════════════════════════════════════════════════
     4. DESPRE
     ═══════════════════════════════════════════════════════ -->
<% if (business.description) { %>
<div class="bd-content">
  <div class="detail-card">
    <div class="detail-card-header">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
      <span>Despre <%= business.name %></span>
    </div>
    <div class="bd-description"><%= business.description %></div>
  </div>
</div>
<% } %>

<!-- ═══════════════════════════════════════════════════════
     5. GALERIE (horizontal scroll strip)
     ═══════════════════════════════════════════════════════ -->
<% if (business.images && business.images.length > 0) { %>
<div class="bd-content">
  <div class="detail-card">
    <div class="detail-card-header">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
      <span>Galerie</span>
      <span class="detail-card-badge"><%= business.images.length %> <%= business.images.length === 1 ? 'imagine' : 'imagini' %></span>
    </div>
    <div class="bd-gallery-strip">
      <% business.images.forEach((img, i) => { %>
        <button class="bd-gallery-strip-item" onclick="trackClick(<%= business.id %>,'gallery'); openGallery(<%= i %>)" aria-label="Deschide galeria - imagine <%= i + 1 %>">
          <img src="<%= img.url %>" alt="<%= business.name %> - imagine <%= i + 1 %>" width="200" height="150" loading="lazy">
        </button>
      <% }); %>
    </div>
  </div>
</div>

<!-- Lightbox Modal -->
<div class="gallery-modal" id="gallery-modal">
  <div class="gallery-modal-backdrop" onclick="closeGallery()"></div>
  <div class="gallery-modal-content">
    <button class="gallery-modal-close" onclick="closeGallery()" aria-label="Inchide">&times;</button>
    <button class="gallery-nav gallery-prev" onclick="galleryPrev()" aria-label="Anterior">&lsaquo;</button>
    <img id="gallery-main-img" src="" alt="<%= business.name %>" width="800" height="600">
    <button class="gallery-nav gallery-next" onclick="galleryNext()" aria-label="Urmatorul">&rsaquo;</button>
    <div class="gallery-counter"><span id="gallery-idx">1</span> / <%= business.images.length %></div>
    <div class="gallery-thumbs">
      <% business.images.forEach((img, i) => { %>
        <img src="<%= img.url %>" onclick="galleryGoTo(<%= i %>)" class="gallery-thumb-item<%= i === 0 ? ' active' : '' %>" data-idx="<%= i %>" alt="<%= business.name %> - imagine <%= i + 1 %>" width="120" height="80" loading="lazy">
      <% }); %>
    </div>
  </div>
</div>
<% } %>

<!-- ═══════════════════════════════════════════════════════
     6. RECENZII
     ═══════════════════════════════════════════════════════ -->
<section id="reviews-section">
<div class="bd-content">
  <div class="detail-card">
    <div class="detail-card-header">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
      <span>Recenzii</span>
      <span class="detail-card-badge"><%= reviews.length %> <%= reviews.length === 1 ? 'recenzie' : 'recenzii' %></span>
      <% if (webUser) { %>
        <button class="btn btn-primary" id="toggle-review-form" style="margin-left: auto; font-size: 0.8125rem; padding: 8px 16px;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
          Scrie o recenzie
        </button>
      <% } else { %>
        <a href="/login?returnTo=/business/<%= business.id %>#reviews-section" class="btn btn-secondary" style="margin-left: auto; font-size: 0.8125rem; padding: 8px 16px; text-decoration: none;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
          Scrie o recenzie
        </a>
      <% } %>
    </div>

    <% if (parseInt(business.rating_count) >= 3 && business.rating_distribution && business.rating_distribution.length > 0) { %>
    <div class="bd-rating-breakdown">
      <% var totalReviews = parseInt(business.rating_count);
         business.rating_distribution.forEach(function(row) {
           var pct = totalReviews > 0 ? Math.round((parseInt(row.count) / totalReviews) * 100) : 0;
      %>
        <div class="bd-rating-breakdown-row">
          <span class="bd-rating-breakdown-label"><%= row.rating %></span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="#fb923c" stroke="#fb923c" stroke-width="1.5"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          <div class="bd-rating-breakdown-bar">
            <div class="bd-rating-breakdown-fill" style="width: <%= pct %>%;"></div>
          </div>
          <span class="bd-rating-breakdown-pct"><%= pct %>%</span>
        </div>
      <% }); %>
    </div>
    <% } %>

    <% if (webUser) { %>
      <div class="review-form" id="review-form" style="display: none;">
        <div class="rf-stars">
          <span class="star-select" data-rating="1">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#52525b" stroke-width="1.5"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          </span>
          <span class="star-select" data-rating="2">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#52525b" stroke-width="1.5"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          </span>
          <span class="star-select" data-rating="3">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#52525b" stroke-width="1.5"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          </span>
          <span class="star-select" data-rating="4">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#52525b" stroke-width="1.5"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          </span>
          <span class="star-select" data-rating="5">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#52525b" stroke-width="1.5"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          </span>
        </div>
        <textarea class="rf-textarea" id="review-comment" placeholder="Scrie recenzia ta..." rows="4"></textarea>
        <button class="btn btn-primary" id="submit-review" data-business-id="<%= business.id %>">
          Trimite recenzia
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </button>
      </div>
    <% } %>

    <div class="bd-reviews-list">
      <% if (reviews && reviews.length > 0) { %>
        <% reviews.forEach((review, i) => { %>
          <div class="review-card reveal reveal-delay-<%= Math.min((i % 4) + 1, 5) %>">
            <div class="rc-header">
              <div class="rc-avatar">
                <% if (review.profile_picture_url && review.show_picture_in_reviews) { %>
                  <img src="<%= review.profile_picture_url %>" alt="" width="40" height="40">
                <% } else { %>
                  <%= (review.first_name || 'U').charAt(0).toUpperCase() %>
                <% } %>
              </div>
              <div class="rc-meta">
                <div class="rc-name"><%= review.first_name ? (review.first_name + ' ' + (review.last_name ? review.last_name.charAt(0) + '.' : '')) : 'Utilizator anonim' %><% if (review.display_badge_color) { %> <svg class="rc-badge-star" width="14" height="14" viewBox="0 0 24 24" fill="<%= review.display_badge_color %>" style="vertical-align: middle; margin-left: 4px;"><title><%= review.display_badge_name %></title><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg><% } %></div>
                <div class="rc-date-stars">
                  <div class="rc-stars">
                    <% for (let s = 1; s <= 5; s++) { %>
                      <% if (s <= review.rating) { %>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="#fb923c" stroke="#fb923c" stroke-width="1.5"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                      <% } else { %>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#52525b" stroke-width="1.5"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                      <% } %>
                    <% } %>
                  </div>
                  <span class="rc-date"><%= new Date(review.created_at).toLocaleDateString('ro-RO', { year: 'numeric', month: 'short', day: 'numeric' }) %></span>
                </div>
              </div>
            </div>
            <% if (review.comment) { %>
              <p class="rc-comment"><%= review.comment %></p>
            <% } %>
            <% if (review.response_text) { %>
              <div class="rc-response">
                <div class="rc-response-label">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 10 20 15 15 20"/><path d="M4 4v7a4 4 0 0 0 4 4h12"/></svg>
                  Răspuns de la business
                </div>
                <p class="rc-response-text"><%= review.response_text %></p>
              </div>
            <% } %>
          </div>
        <% }); %>
      <% } else { %>
        <div class="bd-empty-state">
          <p>Nicio recenzie încă. Fii primul care lasă o recenzie!</p>
        </div>
      <% } %>
    </div>
  </div>
</div>
</section>

<!-- ═══════════════════════════════════════════════════════
     PAGE SCRIPTS
     ═══════════════════════════════════════════════════════ -->
<script>
document.addEventListener('DOMContentLoaded', function() {
  /* ─── Share button (safe — uses dataset instead of inline JS) ── */
  var shareBtn = document.querySelector('.bd-share-btn[data-share-name]');
  if (shareBtn) {
    shareBtn.addEventListener('click', function() {
      var name = this.dataset.shareName;
      var bid = parseInt(this.dataset.trackBid);
      trackClick(bid, 'share');
      window.shareOffer(name, '');
    });
  }

  /* ─── Toggle review form ──────────────────────────────── */
  var toggleBtn = document.getElementById('toggle-review-form');
  var reviewForm = document.getElementById('review-form');
  if (toggleBtn && reviewForm) {
    toggleBtn.addEventListener('click', function() {
      var isHidden = reviewForm.style.display === 'none';
      reviewForm.style.display = isHidden ? 'flex' : 'none';
      toggleBtn.textContent = isHidden ? 'Anulează' : 'Scrie o recenzie';
    });
  }

  /* ─── Star rating selector ────────────────────────────── */
  var stars = document.querySelectorAll('.star-select');
  var selectedRating = 0;
  stars.forEach(function(star) {
    star.addEventListener('click', function() {
      selectedRating = parseInt(this.getAttribute('data-rating'));
      stars.forEach(function(s) {
        var r = parseInt(s.getAttribute('data-rating'));
        if (r <= selectedRating) {
          s.classList.add('active');
        } else {
          s.classList.remove('active');
        }
      });
    });

    star.addEventListener('mouseenter', function() {
      var hoverRating = parseInt(this.getAttribute('data-rating'));
      stars.forEach(function(s) {
        var r = parseInt(s.getAttribute('data-rating'));
        if (r <= hoverRating) {
          s.classList.add('active');
        } else {
          if (r > selectedRating) {
            s.classList.remove('active');
          }
        }
      });
    });
  });

  var starsContainer = document.querySelector('.rf-stars');
  if (starsContainer) {
    starsContainer.addEventListener('mouseleave', function() {
      stars.forEach(function(s) {
        var r = parseInt(s.getAttribute('data-rating'));
        if (r <= selectedRating) {
          s.classList.add('active');
        } else {
          s.classList.remove('active');
        }
      });
    });
  }

  /* ─── Submit review ───────────────────────────────────── */
  var submitBtn = document.getElementById('submit-review');
  if (submitBtn) {
    submitBtn.addEventListener('click', function() {
      var businessId = this.getAttribute('data-business-id');
      var comment = document.getElementById('review-comment').value.trim();

      if (!selectedRating) {
        alert('Te rugăm să selectezi un rating.');
        return;
      }

      var csrfToken = document.querySelector('meta[name="csrf-token"]');
      fetch('/api/web/reviews', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': csrfToken ? csrfToken.getAttribute('content') : ''
        },
        body: JSON.stringify({
          business_id: businessId,
          rating: selectedRating,
          comment: comment
        })
      })
      .then(function(res) { return res.json(); })
      .then(function(data) {
        if (data.success) {
          window.location.reload();
        } else {
          alert(data.message || 'A apărut o eroare.');
        }
      })
      .catch(function() {
        alert('A apărut o eroare. Încearcă din nou.');
      });
    });
  }

  /* ─── Request Offer (Pinch) ───────────────────────────── */
  window.requestOffer = async function(businessId) {
    const btn = document.querySelector('.pinch-btn:not(.pinch-btn-done)');
    if (!btn) return;

    const originalText = btn.textContent;
    btn.textContent = 'Se trimite...';
    btn.disabled = true;

    try {
      const csrfToken = document.querySelector('meta[name="csrf-token"]');
      const res = await fetch('/api/web/offer-requests', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': csrfToken ? csrfToken.getAttribute('content') : ''
        },
        body: JSON.stringify({ business_id: businessId })
      });
      const data = await res.json();

      if (data.success) {
        // Update button to done state
        btn.textContent = '✓ Cerere trimisă';
        btn.classList.add('pinch-btn-done');
        btn.style.background = 'rgba(82, 82, 91, 0.3)';
        btn.style.color = 'var(--text-secondary)';
        btn.style.cursor = 'not-allowed';
        btn.style.boxShadow = 'none';

        // Update count
        const countEl = document.querySelector('.pinch-count');
        if (countEl) {
          const total = data.total || 1;
          countEl.textContent = total + (total === 1 ? ' persoană a cerut' : ' persoane au cerut') + ' deja o ofertă';
        } else if (data.total) {
          // Create count element if it doesn't exist
          const card = document.querySelector('.pinch-card');
          const count = document.createElement('p');
          count.className = 'pinch-count';
          count.style.cssText = 'margin: 0 0 16px; font-size: 13px; color: var(--accent); font-weight: 600;';
          count.textContent = data.total + (data.total === 1 ? ' persoană a cerut' : ' persoane au cerut') + ' deja o ofertă';
          btn.parentElement.insertBefore(count, btn);
        }

        // Auto-follow: update follow button UI if newly followed
        if (data.autoFollowed) {
          const followBtn = document.querySelector('.bd-follow-btn[data-business-id="' + businessId + '"]');
          if (followBtn && followBtn.dataset.following !== 'true') {
            followBtn.dataset.following = 'true';
            followBtn.classList.add('following');
            followBtn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg> Urmărești';
          }
        }

        if (window.showToast) {
          window.showToast('Cerere trimisă! Te vom notifica când apar oferte noi.', 'success');
        }
      } else if (res.status === 429) {
        btn.textContent = originalText;
        btn.disabled = false;
        if (window.showToast) {
          window.showToast(data.message || 'Ai trimis deja o cerere recentă. Încearcă din nou mai târziu.', 'error');
        } else {
          alert(data.message || 'Ai trimis deja o cerere recentă.');
        }
      } else {
        throw new Error(data.message || 'Eroare la trimiterea cererii');
      }
    } catch (err) {
      console.error('Pinch error:', err);
      btn.textContent = originalText;
      btn.disabled = false;
      if (window.showToast) {
        window.showToast(err.message || 'A apărut o eroare. Încearcă din nou.', 'error');
      } else {
        alert('A apărut o eroare. Încearcă din nou.');
      }
    }
  };

  /* Follow button — handled by window.toggleFollow() in main.js */
});
</script>

