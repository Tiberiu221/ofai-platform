<!-- ═══════════════════════════════════════════════════════
     PAGE SCRIPTS
     ═══════════════════════════════════════════════════════ -->
<script>
document.addEventListener('DOMContentLoaded', function() {
  /* ─── Toggle review form ──────────────────────────────── */
  var toggleBtn = document.getElementById('toggle-review-form');
  var reviewForm = document.getElementById('review-form');
  if (toggleBtn && reviewForm) {
    toggleBtn.addEventListener('click', function() {
      var isHidden = reviewForm.style.display === 'none';
      reviewForm.style.display = isHidden ? 'flex' : 'none';
      toggleBtn.textContent = isHidden ? 'Anulează' : 'Scrie o recenzie';
    });
  }

  /* ─── Star rating selector ────────────────────────────── */
  var stars = document.querySelectorAll('.star-select');
  var selectedRating = 0;
  stars.forEach(function(star) {
    star.addEventListener('click', function() {
      selectedRating = parseInt(this.getAttribute('data-rating'));
      stars.forEach(function(s) {
        var r = parseInt(s.getAttribute('data-rating'));
        if (r <= selectedRating) {
          s.classList.add('active');
        } else {
          s.classList.remove('active');
        }
      });
    });

    star.addEventListener('mouseenter', function() {
      var hoverRating = parseInt(this.getAttribute('data-rating'));
      stars.forEach(function(s) {
        var r = parseInt(s.getAttribute('data-rating'));
        if (r <= hoverRating) {
          s.classList.add('active');
        } else {
          if (r > selectedRating) {
            s.classList.remove('active');
          }
        }
      });
    });
  });

  var starsContainer = document.querySelector('.rf-stars');
  if (starsContainer) {
    starsContainer.addEventListener('mouseleave', function() {
      stars.forEach(function(s) {
        var r = parseInt(s.getAttribute('data-rating'));
        if (r <= selectedRating) {
          s.classList.add('active');
        } else {
          s.classList.remove('active');
        }
      });
    });
  }

  /* ─── Submit review ───────────────────────────────────── */
  var submitBtn = document.getElementById('submit-review');
  if (submitBtn) {
    submitBtn.addEventListener('click', function() {
      var businessId = this.getAttribute('data-business-id');
      var comment = document.getElementById('review-comment').value.trim();

      if (!selectedRating) {
        alert('Te rugăm să selectezi un rating.');
        return;
      }

      fetch('/api/web/reviews', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          business_id: businessId,
          rating: selectedRating,
          comment: comment
        })
      })
      .then(function(res) { return res.json(); })
      .then(function(data) {
        if (data.success) {
          window.location.reload();
        } else {
          alert(data.message || 'A apărut o eroare.');
        }
      })
      .catch(function() {
        alert('A apărut o eroare. Încearcă din nou.');
      });
    });
  }

  /* ─── Follow button ───────────────────────────────────── */
  var followBtn = document.querySelector('.follow-btn');
  if (followBtn) {
    followBtn.addEventListener('click', function() {
      var businessId = this.getAttribute('data-business-id');
      var isFollowing = this.getAttribute('data-following') === 'true';
      var btn = this;

      var url = isFollowing
        ? '/api/web/subscriptions/' + businessId
        : '/api/web/subscriptions';
      var opts = { method: isFollowing ? 'DELETE' : 'POST', headers: { 'Content-Type': 'application/json' } };
      if (!isFollowing) opts.body = JSON.stringify({ business_id: businessId });

      fetch(url, opts)
      .then(function(res) {
        if (res.status === 401) { window.location.href = '/login'; return; }
        return res.json();
      })
      .then(function(data) {
        if (!data) return;
        if (data.success || data.message) {
          var newState = !isFollowing;
          btn.setAttribute('data-following', newState.toString());
          btn.innerHTML = newState
            ? '<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg> Urmărești'
