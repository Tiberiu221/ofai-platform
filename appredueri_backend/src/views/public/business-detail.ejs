<%- include('partials/head', {
  pageTitle: business.name,
  pageDesc: 'Descoperă ofertele și reducerile de la ' + business.name + (business.city ? ' din ' + business.city.name : '') + ' pe OFAI.',
  ogTitle: business.name + ' \— OFAI',
  ogDesc: 'Oferte și reduceri de la ' + business.name + (business.city ? ' în ' + business.city.name : ''),
  ogImage: business.cover_image || null,
  ogType: 'business.business'
}) %>
<%- include('partials/navbar', { activePage: null, webUser: typeof webUser !== 'undefined' ? webUser : null }) %>

<!-- ═══════════════════════════════════════════════════════
     BREADCRUMB
     ═══════════════════════════════════════════════════════ -->
<div class="container">
  <nav class="bd-breadcrumb">
    <a href="/">Acasă</a>
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
    <a href="/oferte">Business-uri</a>
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
    <span><%= business.name %></span>
  </nav>
</div>

<!-- ═══════════════════════════════════════════════════════
     HERO — Cover Image
     ═══════════════════════════════════════════════════════ -->
<section class="business-detail-hero">
  <% if (business.cover_image) { %>
    <img src="<%= business.cover_image %>" alt="<%= business.name %>" class="bd-hero-img">
  <% } %>
  <div class="bd-hero-gradient"></div>
</section>

<!-- ═══════════════════════════════════════════════════════
     PROFILE SECTION
     ═══════════════════════════════════════════════════════ -->
<section class="business-profile-section container">
  <div class="bd-profile-top">
    <div class="bd-avatar">
      <% if (business.logo_url) { %>
        <img src="<%= business.logo_url %>" alt="<%= business.name %>" class="bd-avatar-img">
      <% } else { %>
        <div class="bd-avatar-fallback"><%= business.name.charAt(0).toUpperCase() %></div>
      <% } %>
    </div>

    <div class="bd-profile-info">
      <h1 class="bd-business-name"><%= business.name %></h1>

      <div class="bd-rating-row">
        <div class="bd-stars">
          <% for (let i = 1; i <= 5; i++) { %>
            <% if (i <= Math.floor(business.rating || 0)) { %>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="#fb923c" stroke="#fb923c" stroke-width="1.5"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            <% } else if (i - 0.5 <= (business.rating || 0)) { %>
              <svg width="18" height="18" viewBox="0 0 24 24" stroke="#fb923c" stroke-width="1.5" fill="none"><defs><linearGradient id="half-<%= i %>"><stop offset="50%" stop-color="#fb923c"/><stop offset="50%" stop-color="transparent"/></linearGradient></defs><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" fill="url(#half-<%= i %>)"/></svg>
            <% } else { %>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#52525b" stroke-width="1.5"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            <% } %>
          <% } %>
        </div>
        <span class="bd-rating-text">
          <%= business.rating ? Number(business.rating).toFixed(1) : '0.0' %>
          <span class="bd-rating-count">(<%= business.rating_count || 0 %> recenzii)</span>
        </span>
      </div>

      <div class="bd-badges">
        <% if (business.category) { %>
          <a href="/oferte?category=<%= business.category.id %>" class="bd-badge">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
            <%= business.category.name %>
          </a>
        <% } %>
        <% if (business.city) { %>
          <a href="/oferte?city=<%= business.city.id %>" class="bd-badge">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            <%= business.city.name %>
          </a>
        <% } %>
      </div>
    </div>

    <button
      class="follow-btn btn btn-secondary"
      data-business-id="<%= business.id %>"
      data-following="<%= isFollowing ? 'true' : 'false' %>"
    >
      <% if (isFollowing) { %>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        Urmărești
      <% } else { %>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        Urmărește
      <% } %>
    </button>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════
     ACTION BAR
     ═══════════════════════════════════════════════════════ -->
<div class="business-action-bar container">
  <div class="bd-actions">
    <% if (business.phone) { %>
      <a href="tel:<%= business.phone %>" class="bd-action-btn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        Sună
      </a>
    <% } %>
    <% if (business.website) { %>
      <a href="<%= business.website %>" target="_blank" rel="noopener noreferrer" class="bd-action-btn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" x2="22" y1="12" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
        Website
      </a>
    <% } %>
    <% if (business.lat && business.lng) { %>
      <a href="https://www.google.com/maps/dir/?api=1&destination=<%= business.lat %>,<%= business.lng %>" target="_blank" rel="noopener noreferrer" class="bd-action-btn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="3 11 22 2 13 21 11 13 3 11"/></svg>
        Navighează
      </a>
    <% } %>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════════
     BOOKING SECTION (Business-level)
     ═══════════════════════════════════════════════════════ -->
<% if (business.booking && business.booking.type && business.booking.type !== 'none') { %>
<div class="container" style="padding-bottom: 32px;">
  <div class="booking-card" style="max-width: 500px;">
    <% if (business.booking.type === 'phone' && business.booking.phone) { %>
      <a href="tel:<%= business.booking.phone %>" class="btn btn-primary bc-booking-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        Rezerva telefonic: <%= business.booking.phone %>
      </a>
    <% } else if (business.booking.type === 'whatsapp' && business.booking.whatsapp) { %>
      <a href="https://wa.me/<%= business.booking.whatsapp.replace(/[^0-9]/g, '') %>" target="_blank" rel="noopener noreferrer" class="btn btn-primary bc-booking-btn" style="background: rgba(37, 211, 102, 0.12); border: 1px solid rgba(37, 211, 102, 0.25); color: #25d366;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/></svg>
        Rezerva pe WhatsApp
      </a>
    <% } else if (business.booking.type === 'url' && business.booking.url) { %>
      <a href="<%= business.booking.url %>" target="_blank" rel="noopener noreferrer" class="btn btn-primary bc-booking-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" x2="21" y1="14" y2="3"/></svg>
        Rezerva online
      </a>
    <% } %>
    <% if (business.booking.instructions) { %>
      <p class="bc-instructions"><%= business.booking.instructions %></p>
    <% } %>
  </div>
</div>
<% } %>

<!-- ═══════════════════════════════════════════════════════
     DESCRIPTION
     ═══════════════════════════════════════════════════════ -->
<% if (business.description) { %>
<section class="section">
  <div class="container">
    <div class="bd-section-header">
      <h2 class="bd-section-title">Despre</h2>
    </div>
    <div class="bd-description"><%= business.description %></div>
  </div>
</section>
<% } %>

<!-- ═══════════════════════════════════════════════════════
     ACTIVE OFFERS
     ═══════════════════════════════════════════════════════ -->
<% if (offers && offers.length > 0) { %>
<section class="section">
  <div class="container">
    <div class="bd-section-header">
      <h2 class="bd-section-title">Oferte active</h2>
      <span class="bd-count-badge"><%= offers.length %></span>
    </div>

    <div class="offers-grid">
      <% offers.forEach((offer, i) => { %>
        <a href="/oferta/<%= offer.id %>" class="offer-card reveal reveal-delay-<%= Math.min((i % 4) + 1, 5) %>">
          <div class="offer-image-wrapper">
            <img
              src="<%= offer.image_url || (offer.business && offer.business.logo_url) || 'https://picsum.photos/seed/offer-' + offer.id + '/800/500' %>"
              alt="<%= offer.title %>"
              class="offer-image"
              loading="lazy"
            >
            <div class="offer-badge">
              <% if (offer.discount_type === 'percent') { %>
                -<%= offer.discount_value %>%
              <% } else { %>
                <%= offer.discount_value %> lei
              <% } %>
            </div>
          </div>
          <div class="offer-content">
            <div class="offer-business"><%= offer.business ? offer.business.name : business.name %></div>
            <div class="offer-title"><%= offer.title %></div>
            <div class="offer-meta">
              <% if (business.city) { %>
                <span class="offer-meta-item">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                  <%= business.city.name %>
                </span>
              <% } %>
              <% if (business.category) { %>
                <span class="offer-meta-item">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                  <%= business.category.name %>
                </span>
              <% } %>
            </div>
          </div>
        </a>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<!-- ═══════════════════════════════════════════════════════
     LOCATIONS
     ═══════════════════════════════════════════════════════ -->
<% if (business.locations && business.locations.length > 0) { %>
<section class="section" style="background: var(--bg-secondary);">
  <div class="container">
    <div class="bd-section-header">
      <h2 class="bd-section-title">Locații</h2>
    </div>

    <div class="bd-locations-grid">
      <% business.locations.forEach((loc, i) => { %>
        <div class="booking-card reveal reveal-delay-<%= Math.min(i + 1, 5) %>">
          <div class="bc-row">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            <span><%= loc.address %></span>
          </div>
          <% if (loc.phone) { %>
            <div class="bc-row">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              <a href="tel:<%= loc.phone %>"><%= loc.phone %></a>
            </div>
          <% } %>
          <% if (loc.city) { %>
            <div class="bc-row">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
              <span><%= loc.city.name %></span>
            </div>
          <% } %>

          <div class="bc-actions-row">
            <% if (loc.lat && loc.lng) { %>
              <a href="https://www.google.com/maps/dir/?api=1&destination=<%= loc.lat %>,<%= loc.lng %>" target="_blank" rel="noopener noreferrer" class="btn btn-secondary bc-action-btn" style="font-size: 0.8125rem;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="3 11 22 2 13 21 11 13 3 11"/></svg>
                Navigheaz&#259;
              </a>
            <% } %>
            <% if (loc.booking_type === 'phone' && loc.booking_phone) { %>
              <a href="tel:<%= loc.booking_phone %>" class="btn btn-primary bc-action-btn" style="font-size: 0.8125rem;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                Rezerv&#259;: <%= loc.booking_phone %>
              </a>
            <% } else if (loc.booking_type === 'whatsapp' && loc.booking_whatsapp) { %>
              <a href="https://wa.me/<%= loc.booking_whatsapp.replace(/[^0-9]/g, '') %>" target="_blank" rel="noopener noreferrer" class="btn bc-action-btn bc-whatsapp-btn" style="font-size: 0.8125rem;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/></svg>
                Rezerv&#259; pe WhatsApp
              </a>
            <% } else if (loc.booking_type === 'url' && loc.booking_url) { %>
              <a href="<%= loc.booking_url %>" target="_blank" rel="noopener noreferrer" class="btn btn-primary bc-action-btn" style="font-size: 0.8125rem;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" x2="21" y1="14" y2="3"/></svg>
                Rezerv&#259; online
              </a>
            <% } %>
          </div>
          <% if (loc.booking_instructions) { %>
            <p class="bc-instructions"><%= loc.booking_instructions %></p>
          <% } %>
        </div>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<!-- ═══════════════════════════════════════════════════════
     AI REVIEW SUMMARY
     ═══════════════════════════════════════════════════════ -->
<% if (reviewSummary) { %>
<section class="section">
  <div class="container">
    <div class="ai-summary-card reveal">
      <div class="ai-summary-header">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.912 5.813a2 2 0 0 0 1.275 1.275L21 12l-5.813 1.912a2 2 0 0 0-1.275 1.275L12 21l-1.912-5.813a2 2 0 0 0-1.275-1.275L3 12l5.813-1.912a2 2 0 0 0 1.275-1.275L12 3z"/></svg>
        <span class="ai-summary-label">Sumar AI &mdash; Pe baza a <%= reviewSummary.review_count %> recenzii</span>
      </div>
      <p class="ai-summary-text"><%= reviewSummary.text %></p>
    </div>
  </div>
</section>
<% } %>

<!-- ═══════════════════════════════════════════════════════
     REVIEWS
     ═══════════════════════════════════════════════════════ -->
<section class="section" style="background: var(--bg-secondary);">
  <div class="container">
    <div class="bd-section-header">
      <h2 class="bd-section-title">Recenzii</h2>
      <span class="bd-count-badge"><%= reviews.length %></span>
    </div>

    <% if (webUser) { %>
      <button class="btn btn-primary" id="toggle-review-form" style="margin-bottom: 32px;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
        Scrie o recenzie
      </button>

      <div class="review-form" id="review-form" style="display: none;">
        <div class="rf-stars">
          <span class="star-select" data-rating="1">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#52525b" stroke-width="1.5"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          </span>
          <span class="star-select" data-rating="2">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#52525b" stroke-width="1.5"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          </span>
          <span class="star-select" data-rating="3">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#52525b" stroke-width="1.5"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          </span>
          <span class="star-select" data-rating="4">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#52525b" stroke-width="1.5"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          </span>
          <span class="star-select" data-rating="5">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#52525b" stroke-width="1.5"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          </span>
        </div>
        <textarea class="rf-textarea" id="review-comment" placeholder="Scrie recenzia ta..." rows="4"></textarea>
        <button class="btn btn-primary" id="submit-review" data-business-id="<%= business.id %>">
          Trimite recenzia
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </button>
      </div>
    <% } %>

    <div class="bd-reviews-list">
      <% if (reviews && reviews.length > 0) { %>
        <% reviews.forEach((review, i) => { %>
          <div class="review-card reveal reveal-delay-<%= Math.min((i % 4) + 1, 5) %>">
            <div class="rc-header">
              <div class="rc-avatar">
                <%= (review.first_name || 'A').charAt(0).toUpperCase() %>
              </div>
              <div class="rc-meta">
                <div class="rc-name"><%= review.first_name %> <%= review.last_name ? review.last_name.charAt(0) + '.' : '' %></div>
                <div class="rc-date-stars">
                  <div class="rc-stars">
                    <% for (let s = 1; s <= 5; s++) { %>
                      <% if (s <= review.rating) { %>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="#fb923c" stroke="#fb923c" stroke-width="1.5"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                      <% } else { %>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#52525b" stroke-width="1.5"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                      <% } %>
                    <% } %>
                  </div>
                  <span class="rc-date"><%= new Date(review.created_at).toLocaleDateString('ro-RO', { year: 'numeric', month: 'short', day: 'numeric' }) %></span>
                </div>
              </div>
            </div>
            <% if (review.comment) { %>
              <p class="rc-comment"><%= review.comment %></p>
            <% } %>
            <% if (review.response_text) { %>
              <div class="rc-response">
                <div class="rc-response-label">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 10 20 15 15 20"/><path d="M4 4v7a4 4 0 0 0 4 4h12"/></svg>
                  Răspuns de la business
                </div>
                <p class="rc-response-text"><%= review.response_text %></p>
              </div>
            <% } %>
          </div>
        <% }); %>
      <% } else { %>
        <div class="bd-empty-state">
          <p>Nicio recenzie încă. Fii primul care lasă o recenzie!</p>
        </div>
      <% } %>
    </div>
  </div>
</section>

