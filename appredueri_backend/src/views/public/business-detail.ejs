.pinch-btn:not(.pinch-btn-done):hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 16px rgba(251, 146, 60, 0.4) !important;
}

.pinch-btn:not(.pinch-btn-done):active {
  transform: translateY(0);
}

