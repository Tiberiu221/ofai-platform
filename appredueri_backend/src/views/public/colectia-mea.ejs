<%- include('partials/head', { pageTitle: 'Colecția mea', activePage: 'colectie' }) %>
<%- include('partials/navbar', { activePage: 'colectie', webUser: webUser }) %>

<section class="page-header" style="padding-bottom: 24px;">
  <div class="page-header-glow"></div>
  <div class="container">
    <h1 class="page-title text-gradient">Colec&#539;ia mea</h1>
  </div>
</section>

<section class="section" style="padding-top: 0;">
  <div class="container">

    <!-- Tab Toggle -->
    <div class="collection-tabs">
      <button class="collection-tab active" data-tab="businesses" onclick="switchCollectionTab('businesses')">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        Business-uri
        <span class="collection-tab-badge"><%= subscriptions.length %></span>
      </button>
      <button class="collection-tab" data-tab="offers" onclick="switchCollectionTab('offers')">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
        Oferte
        <span class="collection-tab-badge"><%= favorites.length %></span>
      </button>
    </div>

    <!-- Category Filter Pills -->
    <% if (categories && categories.length > 0) { %>
      <div class="collection-categories">
        <a href="/colectia-mea?sort=<%= sort %>&tab=<%= typeof selectedTab !== 'undefined' ? selectedTab : '' %>" class="filter-pill<%= !selectedCategory ? ' active' : '' %>">Toate</a>
        <% categories.forEach(function(cat) { %>
          <a href="/colectia-mea?sort=<%= sort %>&category=<%= cat.id %>&tab=<%= typeof selectedTab !== 'undefined' ? selectedTab : '' %>" class="filter-pill<%= selectedCategory === cat.id ? ' active' : '' %>"><%= cat.name %></a>
        <% }); %>
      </div>
    <% } %>

    <!-- Sort Bar -->
    <div class="sort-bar">
      <span class="sort-bar-label">Sortare:</span>
      <button type="button" class="filter-pill<%= sort === 'recent' ? ' active' : '' %>" data-sort="recent" onclick="changeSort('recent')">Recent ad&#259;ugate</button>
      <button type="button" class="filter-pill<%= sort === 'rating' ? ' active' : '' %>" data-sort="rating" onclick="changeSort('rating')">Rating</button>
      <button type="button" class="filter-pill" data-tab-sort="offers" data-sort="discount" onclick="changeSort('discount')"><%= sort === 'discount' ? '&#8595;% ' : '' %>Reducere</button>
      <button type="button" class="filter-pill" data-tab-sort="offers" data-sort="ending_soon" onclick="changeSort('ending_soon')"><%= sort === 'ending_soon' ? '&#9200; ' : '' %>Expir&#259; cur&#226;nd</button>
      <button type="button" class="filter-pill" data-tab-sort="businesses" data-sort="offers" onclick="changeSort('offers')">Oferte active</button>
      <button type="button" class="filter-pill" id="sort-distance-btn" onclick="sortCollectionByDistance()" style="opacity: 0.5;" title="Activ&#259; loca&#539;ia">&#128205; Distan&#539;&#259;</button>
    </div>

    <!-- Geo Banner -->
    <div id="geo-banner" class="geo-banner" style="display:none;">
      <div class="geo-banner-content">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
        <span id="geo-banner-text">Activeaz&#259; loca&#539;ia pentru a vedea distan&#539;a</span>
        <button class="btn btn-primary" id="geo-activate-btn">Activeaz&#259; loca&#539;ia</button>
      </div>
    </div>

    <!-- Search bar -->
    <div class="collection-search">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
      <input type="text" id="collection-search-input" placeholder="Caut&#259; &#238;n colec&#539;ie..." autocomplete="off">
    </div>

    <!-- Businesses Tab -->
    <div class="collection-panel" id="panel-businesses">
      <% if (subscriptions.length === 0) { %>
        <div class="collection-empty">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="1.5"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          <p>Nu urm&#259;re&#537;ti niciun business &#238;nc&#259;</p>
          <a href="/oferte" class="btn btn-primary">Descooper&#259; oferte</a>
        </div>
      <% } else { %>
        <div class="collection-grid" id="businesses-grid">
          <% subscriptions.forEach(function(b) { %>
            <div class="collection-item collection-biz-card" id="biz-<%= b.id %>" data-name="<%= (b.name || '').toLowerCase() %>" data-city="<%= (b.city_name || '').toLowerCase() %>" data-category="<%= (b.category_name || '').toLowerCase() %>">
              <a href="/business/<%= b.id %>" class="collection-card-link">
                <div class="collection-card-cover">
                  <% if (b.cover_image_url) { %>
                    <img src="<%= b.cover_image_url %>" alt="<%= b.name %>" loading="lazy" width="400" height="200">
                  <% } %>
                  <div class="collection-card-cover-gradient"></div>
                  <% if (b.active_offers_count > 0) { %>
                    <span class="collection-offers-badge"><%= b.active_offers_count %> ofert<%= b.active_offers_count == 1 ? 'ă' : 'e' %></span>
                  <% } %>
                </div>
                <div class="collection-card-body">
                  <div class="collection-card-avatar">
                    <% if (b.logo_url) { %>
                      <img src="<%= b.logo_url %>" alt="<%= b.name %>" loading="lazy" width="48" height="48">
                    <% } else { %>
                      <span><%= b.name.charAt(0) %></span>
                    <% } %>
                  </div>
                  <div class="collection-card-info">
                    <h3><%= b.name %></h3>
                    <% if (parseFloat(b.rating_avg) > 0) { %>
                      <div class="collection-card-rating">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="#fb923c" stroke="#fb923c" stroke-width="1"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                        <span><%= parseFloat(b.rating_avg).toFixed(1) %></span>
                      </div>
                    <% } %>
                    <p class="collection-card-meta">
                      <%= b.category_name || '' %><%= b.city_name ? ' &middot; ' + b.city_name : '' %>
                      <span class="offer-distance collection-distance" data-lat="<%= b.lat || '' %>" data-lng="<%= b.lng || '' %>" style="display:none;">
                        &middot; <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: -1px;"><polygon points="3 11 22 2 13 21 11 13 3 11"/></svg>
                        <span class="offer-distance-text"></span>
                      </span>
                    </p>
                  </div>
                </div>
              </a>
              <button class="btn btn-ghost collection-remove-btn" onclick="unfollowBusiness(<%= b.id %>)" title="Nu mai urm&#259;ri" aria-label="Nu mai urm&#259;ri">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
              </button>
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>

    <!-- Offers Tab -->
    <div class="collection-panel" id="panel-offers" style="display: none;">
      <% if (favorites.length === 0) { %>
        <div class="collection-empty">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="1.5"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
          <p>Nu ai nicio ofert&#259; salvat&#259;</p>
          <a href="/oferte" class="btn btn-primary">Exploreaz&#259; oferte</a>
        </div>
      <% } else { %>
        <div class="collection-grid collection-offers-grid" id="offers-grid">
          <% favorites.forEach(function(o) { %>
            <div class="collection-item collection-offer-card" id="fav-<%= o.id %>" data-name="<%= (o.title || '').toLowerCase() %>" data-business="<%= (o.business_name || '').toLowerCase() %>" data-city="<%= (o.city_name || '').toLowerCase() %>">
              <a href="/oferta/<%= o.id %>" class="collection-card-link">
                <div class="collection-card-cover">
                  <% if (o.image_url) { %>
                    <img src="<%= o.image_url %>" alt="<%= o.title %>" loading="lazy" width="400" height="225">
                  <% } %>
                  <div class="collection-card-cover-gradient"></div>
                  <span class="collection-discount-badge">
                    <% if (o.discount_type === 'percent' || o.discount_type === 'percentage') { %>
                      -<%= o.discount_value %>%
                    <% } else { %>
                      -<%= o.discount_value %> lei
                    <% } %>
                  </span>
                </div>
                <div class="collection-card-body" style="padding-top: 14px;">
                  <div class="collection-card-info" style="padding-left: 0;">
                    <h3><%= o.title %></h3>
                    <p class="collection-card-meta">
                      <%= o.business_name || '' %><%= o.city_name ? ' &middot; ' + o.city_name : '' %>
                      <span class="offer-distance collection-distance" data-lat="<%= o.lat || '' %>" data-lng="<%= o.lng || '' %>" style="display:none;">
                        &middot; <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: -1px;"><polygon points="3 11 22 2 13 21 11 13 3 11"/></svg>
                        <span class="offer-distance-text"></span>
                      </span>
                    </p>
                  </div>
                </div>
              </a>
              <button class="btn btn-ghost collection-remove-btn" onclick="removeFavorite(<%= o.id %>)" title="Elimin&#259; din favorite" aria-label="Elimin&#259; din favorite">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
              </button>
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>

  </div>
</section>

<style>
  .collection-categories {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding-bottom: 8px;
    margin-bottom: 12px;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .collection-categories::-webkit-scrollbar { display: none; }
  .collection-categories .filter-pill {
    white-space: nowrap;
    flex-shrink: 0;
  }

  .collection-search {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 16px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    margin-bottom: 24px;
    transition: border-color 0.2s;
  }
  .collection-search:focus-within {
    border-color: var(--accent);
  }
  .collection-search input {
    flex: 1;
    background: none;
    border: none;
    outline: none;
    color: var(--text-primary);
    font-size: 0.9375rem;
    font-family: inherit;
  }
  .collection-search input::placeholder {
    color: var(--text-muted);
  }

  .collection-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 20px;
  }

  .collection-item {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .collection-card-link {
    display: flex;
    flex-direction: column;
    flex: 1;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--bg-card);
    border: 1px solid var(--border);
    transition: all 0.3s var(--ease-smooth);
  }
  .collection-card-link:hover {
    border-color: var(--border-accent);
    transform: translateY(-3px);
    box-shadow: 0 12px 32px rgba(0,0,0,0.25);
  }

  .collection-card-cover {
    position: relative;
    height: 120px;
    background: linear-gradient(135deg, rgba(251,146,60,0.1) 0%, var(--bg-surface) 100%);
    overflow: hidden;
  }
  .collection-card-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--ease-smooth);
  }
  .collection-card-link:hover .collection-card-cover img {
    transform: scale(1.05);
  }
  .collection-card-cover-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(6,6,10,0.7) 0%, transparent 60%);
    pointer-events: none;
  }

  .collection-offers-badge {
    position: absolute;
    top: 10px;
    right: 10px;
    padding: 3px 10px;
    background: var(--accent-muted);
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 700;
    border-radius: var(--radius-full);
    z-index: 2;
  }

  .collection-discount-badge {
    position: absolute;
    top: 10px;
    right: 10px;
    padding: 4px 12px;
    background: var(--accent);
    color: var(--bg-primary);
    font-size: 0.8125rem;
    font-weight: 700;
    border-radius: var(--radius-sm);
    z-index: 2;
    box-shadow: 0 2px 8px rgba(251,146,60,0.3);
  }

  .collection-card-body {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    flex: 1;
  }

  .collection-card-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    background: var(--bg-surface);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: -32px;
    border: 2px solid var(--bg-primary);
    box-shadow: 0 2px 8px rgba(0,0,0,0.3);
    z-index: 2;
  }
  .collection-card-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .collection-card-avatar span {
    font-weight: 700;
    color: var(--accent);
    font-size: 1rem;
  }

  .collection-card-info {
    min-width: 0;
    flex: 1;
  }
  .collection-card-info h3 {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-bottom: 2px;
  }
  .collection-card-rating {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--accent);
    margin-bottom: 2px;
  }
  .collection-card-meta {
    font-size: 0.8125rem;
    color: var(--text-tertiary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .collection-distance {
    font-size: 0.8125rem;
    color: var(--text-tertiary);
  }

  .collection-remove-btn {
    position: absolute;
    top: 10px;
    left: 10px;
    width: 32px;
    height: 32px;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(9,9,11,0.7);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255,255,255,0.1);
    color: var(--text-secondary);
    z-index: 3;
    opacity: 0;
    transition: all 0.2s;
  }
  .collection-item:hover .collection-remove-btn {
    opacity: 1;
  }
  .collection-remove-btn:hover {
    background: var(--danger);
    color: white;
    border-color: var(--danger);
  }

  .collection-no-results {
    text-align: center;
    padding: 48px 0;
    color: var(--text-tertiary);
    font-size: 0.9375rem;
    display: none;
  }

  @media (max-width: 600px) {
    .collection-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  function switchCollectionTab(tab) {
    document.querySelectorAll('.collection-tab').forEach(function(t) { t.classList.remove('active'); });
    document.querySelector('[data-tab="' + tab + '"]').classList.add('active');
    document.getElementById('panel-businesses').style.display = tab === 'businesses' ? '' : 'none';
    document.getElementById('panel-offers').style.display = tab === 'offers' ? '' : 'none';
    document.getElementById('collection-search-input').value = '';
    filterCollection('');
    // Show/hide sort buttons relevant to current tab
    document.querySelectorAll('[data-tab-sort]').forEach(function(btn) {
      btn.style.display = btn.getAttribute('data-tab-sort') === tab ? '' : 'none';
    });
    // Mark active sort pills
    var currentSort = new URLSearchParams(window.location.search).get('sort') || 'recent';
    document.querySelectorAll('.sort-bar .filter-pill').forEach(function(btn) {
      var sortVal = btn.getAttribute('data-sort');
      if (sortVal) btn.classList.toggle('active', sortVal === currentSort);
    });
  }

  function changeSort(sortValue) {
    var currentTab = document.querySelector('.collection-tab.active').getAttribute('data-tab');
    var params = new URLSearchParams(window.location.search);
    params.set('sort', sortValue);
    params.set('tab', currentTab);
    window.location.href = '/colectia-mea?' + params.toString();
  }

  // Client-side distance sort using functions from main.js
  function sortCollectionByDistance() {
    var cached = sessionStorage.getItem('ofai_user_pos');
    if (!cached) {
      // Trigger geo activation
      var btn = document.getElementById('geo-activate-btn');
      if (btn) btn.click();
      // Retry after geo is activated
      var retryCount = 0;
      var retryInterval = setInterval(function() {
        retryCount++;
        if (retryCount > 30) { clearInterval(retryInterval); return; }
        var pos = sessionStorage.getItem('ofai_user_pos');
        if (pos) {
          clearInterval(retryInterval);
          sortCollectionByDistance();
        }
      }, 500);
      return;
    }

    var pos = JSON.parse(cached);
    var activePanel = document.querySelector('.collection-panel:not([style*="display: none"])') || document.getElementById('panel-businesses');
    var grid = activePanel.querySelector('.collection-grid');
    if (!grid) return;

    var items = Array.from(grid.querySelectorAll('.collection-item'));
    items.forEach(function(item) {
      var distEl = item.querySelector('.offer-distance[data-lat][data-lng]');
      if (!distEl) { item._dist = 99999; return; }
      var lat = parseFloat(distEl.getAttribute('data-lat'));
      var lng = parseFloat(distEl.getAttribute('data-lng'));
      if (!lat || !lng) { item._dist = 99999; return; }
      item._dist = haversineKm(pos.lat, pos.lng, lat, lng);
    });

    items.sort(function(a, b) { return a._dist - b._dist; });
    items.forEach(function(item) { grid.appendChild(item); });

    // Update active pill
    document.querySelectorAll('.sort-bar .filter-pill').forEach(function(btn) { btn.classList.remove('active'); });
    document.getElementById('sort-distance-btn').classList.add('active');

    // Update distances display
    if (typeof updateDistances === 'function') updateDistances(pos.lat, pos.lng);
  }

  function filterCollection(query) {
    var q = query.toLowerCase().trim();
    var activePanel = document.querySelector('.collection-panel:not([style*="display: none"])') || document.getElementById('panel-businesses');
    var items = activePanel.querySelectorAll('.collection-item');
    var visibleCount = 0;
    items.forEach(function(item) {
      var name = item.getAttribute('data-name') || '';
      var city = item.getAttribute('data-city') || '';
      var category = item.getAttribute('data-category') || '';
      var business = item.getAttribute('data-business') || '';
      var match = !q || name.indexOf(q) !== -1 || city.indexOf(q) !== -1 || category.indexOf(q) !== -1 || business.indexOf(q) !== -1;
      item.style.display = match ? '' : 'none';
      if (match) visibleCount++;
    });
  }

  document.getElementById('collection-search-input').addEventListener('input', function() {
    filterCollection(this.value);
  });

  async function unfollowBusiness(id) {
    try {
      var csrfToken = document.querySelector('meta[name="csrf-token"]');
      var res = await fetch('/api/web/subscriptions/' + id, {
        method: 'DELETE',
        headers: { 'X-CSRF-Token': csrfToken ? csrfToken.getAttribute('content') : '' }
      });
      if (res.status === 401) { window.location.href = '/login'; return; }
      var el = document.getElementById('biz-' + id);
      if (el) el.remove();
      if (typeof showToast === 'function') showToast('Business eliminat din colec\u021Bie');
    } catch(e) { console.error(e); }
  }

  async function removeFavorite(id) {
    try {
      var csrfToken = document.querySelector('meta[name="csrf-token"]');
      var res = await fetch('/api/web/favorites/' + id, {
        method: 'DELETE',
        headers: { 'X-CSRF-Token': csrfToken ? csrfToken.getAttribute('content') : '' }
      });
      if (res.status === 401) { window.location.href = '/login'; return; }
      var el = document.getElementById('fav-' + id);
      if (el) el.remove();
      if (typeof showToast === 'function') showToast('Oferta eliminat\u0103 din favorite');
    } catch(e) { console.error(e); }
  }

  // Init on page load
  (function() {
    var urlParams = new URLSearchParams(window.location.search);
    var tab = urlParams.get('tab');
    if (tab === 'offers') {
      switchCollectionTab('offers');
    } else {
      // Ensure correct sort pills visibility for default businesses tab
      switchCollectionTab('businesses');
    }

    // Initialize geolocation (reuses initGeolocation from main.js)
    if (typeof initGeolocation === 'function') {
      initGeolocation();
    }
  })();
</script>

<%- include('partials/footer') %>
