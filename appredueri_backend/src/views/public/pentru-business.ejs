<%- include('partials/head', { pageTitle: 'Pentru Business', activePage: null, pageDesc: 'Adaugă business-ul tău pe OFAI și atrage clienți noi cu oferte și reduceri exclusive.' }) %>
<%- include('partials/navbar', { activePage: null, webUser: typeof webUser !== 'undefined' ? webUser : null }) %>

<section class="hero" style="min-height: auto; padding: 120px var(--container-px) 80px;">
  <div class="hero-glow"></div>
  <div class="hero-grid-bg"></div>
  <div class="hero-content">
    <div class="hero-pill">
      <span class="hero-pill-dot"></span>
      <span>Platformă pentru business-uri locale</span>
    </div>
    <h1 class="hero-title text-gradient">
      Crește-ți afacerea cu <span class="accent">OFAI</span>
    </h1>
    <p class="hero-subtitle">
      Ajunge la mii de clienți noi din orașul tău. Publică oferte, primește recenzii și construiește-ți comunitatea de clienți fideli.
    </p>
    <div class="hero-ctas">
      <a href="/register" class="btn btn-primary btn-lg">
        Începe gratuit
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
      <a href="mailto:business@ofai.ro" class="btn btn-secondary btn-lg">Contactează-ne</a>
    </div>
  </div>
</section>

<!-- Benefits -->
<section class="section">
  <div class="container">
    <div class="section-header reveal">
      <div class="section-label">De ce OFAI</div>
      <h2 class="section-title">Beneficii pentru afacerea ta</h2>
    </div>
    <div class="steps-grid">
      <div class="step-card reveal reveal-delay-1">
        <div class="step-number">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <div class="step-title">Clienți noi</div>
        <div class="step-desc">Ajunge la mii de utilizatori activi din orașul tău care caută oferte și reduceri.</div>
      </div>
      <div class="step-card reveal reveal-delay-2">
        <div class="step-number">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        </div>
        <div class="step-title">Recenzii & Rating</div>
        <div class="step-desc">Primește recenzii autentice de la clienți și construiește-ți reputația online.</div>
      </div>
      <div class="step-card reveal reveal-delay-3">
        <div class="step-number">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
        </div>
        <div class="step-title">Dashboard complet</div>
        <div class="step-desc">Gestionează ofertele, locațiile și informațiile business-ului tău dintr-un singur loc.</div>
      </div>
    </div>
  </div>
</section>

<!-- How it works -->
<section class="section" style="background: var(--bg-secondary);">
  <div class="container">
    <div class="section-header reveal">
      <div class="section-label">Cum funcționează</div>
      <h2 class="section-title">3 pași simpli</h2>
    </div>
    <div class="steps-grid">
      <div class="step-card reveal reveal-delay-1">
        <div class="step-number">1</div>
        <div class="step-title">Creează un cont</div>
        <div class="step-desc">Înregistrează-te gratuit pe platformă și configurează profilul afacerii tale.</div>
      </div>
      <div class="step-card reveal reveal-delay-2">
        <div class="step-number">2</div>
        <div class="step-title">Publică oferte</div>
        <div class="step-desc">Adaugă oferte și reduceri cu imagini, descrieri și condiții de utilizare.</div>
      </div>
      <div class="step-card reveal reveal-delay-3">
        <div class="step-number">3</div>
        <div class="step-title">Atrage clienți</div>
        <div class="step-desc">Clienții descoperă ofertele tale, fac rezervări și lasă recenzii.</div>
      </div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="cta-section">
  <div class="container">
    <div class="cta-box reveal">
      <div class="cta-box-glow"></div>
      <h2 class="cta-title">Gata să începi?</h2>
      <p class="cta-subtitle">Înscrie-ți afacerea pe OFAI și începe să atragi clienți noi chiar azi.</p>
      <a href="/register" class="btn btn-primary btn-lg" style="position: relative; z-index: 1;">Creează cont gratuit</a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
