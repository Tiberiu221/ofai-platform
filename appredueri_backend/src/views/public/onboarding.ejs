<%- include('partials/head', { pageTitle: 'Bun venit', activePage: null }) %>

<!-- ═══════════════════════════════════════════════════════
     ONBOARDING — 2-Step Preference Selection
     ═══════════════════════════════════════════════════════ -->
<div class="onboarding-page" style="opacity:0">
  <canvas class="particle-canvas auth-particles"></canvas>

  <!-- Progress Dots -->
  <div class="onboarding-dots">
    <span class="onboarding-dot active" id="dot-1"></span>
    <span class="onboarding-dot" id="dot-2"></span>
  </div>

  <!-- ─── Step 1: Cities ─── -->
  <div class="onboarding-step active" id="step-1">
    <div class="onboarding-card">
      <h1 class="onboarding-title">Bun venit, <%= webUser.first_name || 'acolo' %>!</h1>
      <p class="onboarding-subtitle">Alege orașele tale</p>
      <p class="onboarding-hint">Poți selecta mai multe</p>

      <div class="onboarding-pills" id="city-pills">
        <% cities.forEach(function(city, i) { %>
          <button type="button"
            class="onboarding-pill"
            data-city-id="<%= city.id %>"
            onclick="toggleOnboardingCity(this)"
            style="animation-delay: <%= (i * 50) %>ms">
            <%= city.name %>
          </button>
        <% }); %>
      </div>

      <div class="onboarding-actions">
        <button type="button" class="btn btn-primary btn-lg onboarding-next" onclick="goToStep(2)">
          Continuă
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </button>
        <button type="button" class="btn btn-ghost onboarding-skip" onclick="goToStep(2)">Sari peste</button>
      </div>
    </div>
  </div>

  <!-- ─── Step 2: Categories ─── -->
  <div class="onboarding-step" id="step-2">
    <div class="onboarding-card">
      <h1 class="onboarding-title">Ce te interesează?</h1>
      <p class="onboarding-subtitle">Alege categoriile preferate</p>
      <p class="onboarding-hint">Poți selecta mai multe</p>

      <%
        const catIcons = {
          'Clinica': '🏥', 'Frizerie': '💈', 'Beauty': '💄', 'Auto': '🚗',
          'Restaurant': '🍽️', 'Cafenea': '☕', 'Fitness': '💪', 'Spa & Wellness': '🧖',
          'Optica': '👓', 'Farmacie': '💊', 'Veterinar': '🐾', 'Stomatologie': '🦷',
          'Florarie': '🌸', 'Curatatorie': '👔', 'Foto & Video': '📸'
        };
      %>

      <div class="onboarding-pills" id="category-pills">
        <button type="button"
          class="onboarding-pill selected"
          id="cat-toate"
          onclick="selectAllOnboardingCategories(this)"
          style="animation-delay: 0ms">
          Toate
        </button>
        <% categories.forEach(function(cat, i) { %>
          <button type="button"
            class="onboarding-pill onboarding-pill--cat"
            data-category-id="<%= cat.id %>"
            onclick="toggleOnboardingCategory(this)"
            style="animation-delay: <%= ((i + 1) * 50) %>ms">
            <span class="onboarding-pill-icon"><%= catIcons[cat.name] || '📦' %></span>
            <%= cat.name %>
          </button>
        <% }); %>
      </div>

      <div class="onboarding-actions">
        <button type="button" class="btn btn-primary btn-lg onboarding-next" onclick="finishOnboarding()">
          Finalizează
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        </button>
        <button type="button" class="btn btn-ghost onboarding-skip" onclick="finishOnboarding()">Sari peste</button>
      </div>
    </div>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════════
     ONBOARDING STYLES
     ═══════════════════════════════════════════════════════ -->
<style>
  /* Hide navbar & footer on onboarding */
  .navbar, footer, .footer { display: none !important; }

  .onboarding-page {
    opacity: 1; /* override inline opacity:0 — prevents FOUC */
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 24px;
    position: relative;
    overflow: hidden;
  }

  /* Progress dots */
  .onboarding-dots {
    position: fixed;
    top: 32px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 10px;
    z-index: 10;
  }

  .onboarding-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.15);
    border: 1.5px solid rgba(255, 255, 255, 0.25);
    transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .onboarding-dot.active {
    background: var(--accent, #fb923c);
    border-color: var(--accent, #fb923c);
    transform: scale(1.3);
    box-shadow: 0 0 12px rgba(251, 146, 60, 0.4);
  }

  .onboarding-dot.done {
    background: var(--accent, #fb923c);
    border-color: var(--accent, #fb923c);
    opacity: 0.5;
  }

  /* Steps */
  .onboarding-step {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    opacity: 0;
    transform: translateX(60px);
    pointer-events: none;
    transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .onboarding-step.active {
    opacity: 1;
    transform: translateX(0);
    pointer-events: auto;
  }

  .onboarding-step.exit-left {
    opacity: 0;
    transform: translateX(-60px);
    pointer-events: none;
  }

  /* Card */
  .onboarding-card {
    max-width: 520px;
    width: 100%;
    text-align: center;
  }

  .onboarding-title {
    font-family: 'DM Serif Display', serif;
    font-size: 2rem;
    color: var(--text-primary, #fafafa);
    margin-bottom: 8px;
    line-height: 1.2;
  }

  .onboarding-subtitle {
    font-size: 1.1rem;
    color: var(--text-secondary, #a1a1aa);
    margin-bottom: 4px;
  }

  .onboarding-hint {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.35);
    margin-bottom: 32px;
    font-style: italic;
  }

  /* Pills container */
  .onboarding-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
    margin-bottom: 40px;
  }

  /* Individual pill */
  .onboarding-pill {
    padding: 10px 20px;
    border-radius: 24px;
    font-size: 0.9rem;
    font-weight: 500;
    background: var(--bg-surface, #131318);
    border: 1.5px solid var(--border, rgba(255, 255, 255, 0.08));
    color: var(--text-secondary, #a1a1aa);
    cursor: pointer;
    user-select: none;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    opacity: 0;
    transform: translateY(12px);
    animation: onboardingPillIn 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .onboarding-step.active .onboarding-pill {
    animation: onboardingPillIn 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .onboarding-step:not(.active) .onboarding-pill {
    animation: none;
    opacity: 0;
    transform: translateY(12px);
  }

  .onboarding-pill:hover {
    border-color: var(--accent, #fb923c);
    color: var(--text-primary, #fafafa);
    background: rgba(251, 146, 60, 0.06);
  }

  .onboarding-pill.selected {
    background: var(--accent, #fb923c);
    border-color: var(--accent, #fb923c);
    color: var(--bg-primary, #06060a);
    font-weight: 600;
    animation: onboardingPillBounce 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    box-shadow: 0 2px 12px rgba(251, 146, 60, 0.25);
  }

  /* Category pill with icon */
  .onboarding-pill--cat {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .onboarding-pill-icon {
    font-size: 1.1rem;
    line-height: 1;
  }

  /* Actions */
  .onboarding-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .onboarding-next {
    min-width: 200px;
  }

  .onboarding-skip {
    font-size: 0.85rem;
    opacity: 0.5;
    transition: opacity 0.2s;
  }

  .onboarding-skip:hover {
    opacity: 0.8;
  }

  /* Animations */
  @keyframes onboardingPillIn {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes onboardingPillBounce {
    0% { transform: scale(1); }
    40% { transform: scale(0.93); }
    70% { transform: scale(1.04); }
    100% { transform: scale(1); }
  }

  /* Mobile responsive */
  @media (max-width: 480px) {
    .onboarding-title { font-size: 1.6rem; }
    .onboarding-subtitle { font-size: 1rem; }
    .onboarding-pill { padding: 8px 16px; font-size: 0.85rem; }
    .onboarding-card { padding: 0 8px; }
  }
</style>

<!-- ═══════════════════════════════════════════════════════
     ONBOARDING SCRIPT
     ═══════════════════════════════════════════════════════ -->
<script>
  const selectedCityIds = [];
  const selectedCategoryIds = [];
  let currentStep = 1;

  function toggleOnboardingCity(el) {
    const id = parseInt(el.dataset.cityId);
    el.classList.toggle('selected');

    if (el.classList.contains('selected')) {
      if (!selectedCityIds.includes(id)) selectedCityIds.push(id);
    } else {
      const idx = selectedCityIds.indexOf(id);
      if (idx > -1) selectedCityIds.splice(idx, 1);
    }
  }

  function toggleOnboardingCategory(el) {
    const id = parseInt(el.dataset.categoryId);
    el.classList.toggle('selected');

    // Deselect "Toate" when selecting individual category
    const toateBtn = document.getElementById('cat-toate');
    if (toateBtn) toateBtn.classList.remove('selected');

    if (el.classList.contains('selected')) {
      if (!selectedCategoryIds.includes(id)) selectedCategoryIds.push(id);
    } else {
      const idx = selectedCategoryIds.indexOf(id);
      if (idx > -1) selectedCategoryIds.splice(idx, 1);
    }

    // If nothing selected, re-activate "Toate"
    if (selectedCategoryIds.length === 0 && toateBtn) toateBtn.classList.add('selected');
  }

  function selectAllOnboardingCategories(el) {
    // Deselect all individual categories
    document.querySelectorAll('#category-pills .onboarding-pill[data-category-id]').forEach(function(p) {
      p.classList.remove('selected');
    });
    el.classList.add('selected');
    selectedCategoryIds.length = 0;
  }

  function goToStep(step) {
    const prev = document.getElementById('step-' + currentStep);
    const next = document.getElementById('step-' + step);
    const prevDot = document.getElementById('dot-' + currentStep);
    const nextDot = document.getElementById('dot-' + step);

    // Animate out current
    prev.classList.remove('active');
    prev.classList.add('exit-left');

    // Update dots
    if (prevDot) { prevDot.classList.remove('active'); prevDot.classList.add('done'); }
    if (nextDot) nextDot.classList.add('active');

    // Animate in next (slight delay for stagger)
    setTimeout(() => {
      next.classList.add('active');
      currentStep = step;
    }, 150);
  }

  async function finishOnboarding() {
    // Save preferences via existing API
    try {
      const csrfToken = document.querySelector('meta[name="csrf-token"]');
      const res = await fetch('/api/web/preferences', {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': csrfToken ? csrfToken.getAttribute('content') : ''
        },
        body: JSON.stringify({
          preferred_city_ids: selectedCityIds,
          preferred_category_ids: selectedCategoryIds
        })
      });

      if (!res.ok) console.error('Failed to save preferences');
    } catch (err) {
      console.error('Onboarding save error:', err);
    }

    // Redirect to home page
    window.location.href = '/';
  }
</script>

<%- include('partials/footer') %>
