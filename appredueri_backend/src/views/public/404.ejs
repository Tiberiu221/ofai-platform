<%- include('partials/head', { pageTitle: t('errors.notFoundTitle'), activePage: null, noIndex: true }) %>
<%- include('partials/navbar', { activePage: null, webUser: typeof webUser !== 'undefined' ? webUser : null }) %>

<section class="error-page">
  <div class="error-page-glow"></div>
  <div class="error-page-content">
    <div class="error-code">404</div>
    <h1 class="error-title"><%= t('errors.notFoundHeading') %></h1>
    <p class="error-desc"><%= t('errors.notFoundDesc') %></p>
    <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
      <a href="/" class="btn btn-primary btn-lg"><%= t('errors.home') %></a>
      <a href="/oferte" class="btn btn-secondary btn-lg"><%= t('errors.exploreOffers') %></a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
