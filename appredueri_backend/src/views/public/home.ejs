<%- include('partials/head', { pageTitle: t('home.pageTitle'), activePage: 'home', pageDesc: t('home.pageDesc'), canonicalUrl: 'https://ofai.ro', ogUrl: 'https://ofai.ro' }) %>
<%- include('partials/navbar', { activePage: 'home', webUser: typeof webUser !== 'undefined' ? webUser : null }) %>

<!-- ═══════════════════════════════════════════════════════
     HERO SECTION
     ═══════════════════════════════════════════════════════ -->
<section class="hero">
  <div class="hero-glow"></div>
  <div class="hero-glow-secondary"></div>
  <div class="hero-grid-bg"></div>
  <canvas class="particle-canvas hero-particles"></canvas>

  <div class="hero-content">
    <div class="hero-pill">
      <span class="hero-pill-dot"></span>
      <span><strong><%= stats.newOffers %>+</strong> <%= t('home.heroPill') %></span>
    </div>

    <h1 class="hero-title text-gradient">
      <%= t('home.heroTitle') %> <span class="accent"><%= t('home.heroTitleAccent') %></span>
    </h1>

    <p class="hero-subtitle">
      <%= t('home.heroSubtitle') %>
    </p>

    <div class="search-wrapper" style="margin-bottom: 40px;">
      <form action="/oferte" method="GET">
        <input type="text" name="q" class="search-bar" placeholder="<%= t('common.searchPlaceholder') %>">
        <div class="search-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        </div>
      </form>
    </div>

    <div class="hero-ctas">
      <a href="/oferte" class="btn btn-primary btn-lg">
        <%= t('home.exploreOffers') %>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
      <a href="/pentru-business" class="btn btn-secondary btn-lg">
        <%= t('home.forBusiness') %>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
      </a>
    </div>

    <!-- Trust Pillars -->
    <div class="trust-pillars">
      <div class="trust-pill">
        <div class="trust-pill-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></div>
        <div class="trust-pill-text">
          <div class="trust-pill-title"><%= t('home.trustFree') %></div>
          <div class="trust-pill-desc"><%= t('home.trustFreeDesc') %></div>
        </div>
      </div>
      <div class="trust-pill">
        <div class="trust-pill-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg></div>
        <div class="trust-pill-text">
          <div class="trust-pill-title"><%= t('home.trustVerified') %></div>
          <div class="trust-pill-desc"><%= t('home.trustVerifiedDesc') %></div>
        </div>
      </div>
      <div class="trust-pill">
        <div class="trust-pill-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg></div>
        <div class="trust-pill-text">
          <div class="trust-pill-title"><%= t('home.trustPersonalized') %></div>
          <div class="trust-pill-desc"><%= t('home.trustPersonalizedDesc') %></div>
        </div>
      </div>
    </div>

    <div class="hero-stats">
      <div class="hero-stat">
        <div class="hero-stat-value" data-count="<%= stats.totalBusinesses %>" data-suffix="+"><%= stats.totalBusinesses %>+</div>
        <div class="hero-stat-label"><%= t('home.statBusinesses') %></div>
      </div>
      <div class="hero-stat">
        <div class="hero-stat-value" data-count="<%= stats.totalOffers %>" data-suffix="+"><%= stats.totalOffers %>+</div>
        <div class="hero-stat-label"><%= t('home.statOffers') %></div>
      </div>
      <div class="hero-stat">
        <div class="hero-stat-value" data-count="<%= stats.totalCategories %>" data-suffix="+"><%= stats.totalCategories %>+</div>
        <div class="hero-stat-label"><%= t('home.statCategories') %></div>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════
     MARQUEE — Business-uri partenere
     ═══════════════════════════════════════════════════════ -->
<section class="marquee-section">
  <div class="marquee-label"><%= t('home.marqueeLabel') %></div>
  <div class="marquee-track">
    <% const marqueeItems = featuredBusinesses.concat(featuredBusinesses); %>
    <% marqueeItems.forEach(biz => { %>
      <div class="marquee-item">
        <img src="<%= biz.logo_url %>" alt="<%= biz.name %>" loading="lazy" width="40" height="40" onerror="this.style.display='none'">
        <span><%= biz.name %></span>
      </div>
    <% }); %>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════
     HOW IT WORKS (mutat sus — vizitatorii noi trebuie sa inteleaga flow-ul devreme)
     ═══════════════════════════════════════════════════════ -->
<section class="section" id="how-it-works">
  <div class="container">
    <div class="section-header reveal">
      <div class="section-label"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3L12 3Z"/></svg> <%= t('home.howLabel') %></div>
      <h2 class="section-title text-gradient"><%= t('home.howTitle') %></h2>
      <p class="section-subtitle"><%= t('home.howSubtitle') %></p>
    </div>

    <div class="steps-grid">
      <div class="step-card reveal reveal-delay-1">
        <div class="step-number">1</div>
        <h3 class="step-title"><%= t('home.step1Title') %></h3>
        <p class="step-desc"><%= t('home.step1Desc') %></p>
      </div>
      <div class="step-card reveal reveal-delay-2">
        <div class="step-number">2</div>
        <h3 class="step-title"><%= t('home.step2Title') %></h3>
        <p class="step-desc"><%= t('home.step2Desc') %></p>
      </div>
      <div class="step-card reveal reveal-delay-3">
        <div class="step-number">3</div>
        <h3 class="step-title"><%= t('home.step3Title') %></h3>
        <p class="step-desc"><%= t('home.step3Desc') %></p>
      </div>
    </div>

    <% if (!webUser) { %>
    <div style="text-align: center; margin-top: 40px;" class="reveal reveal-delay-4">
      <a href="/register" class="btn btn-secondary btn-lg">
        <%= t('home.createFreeAccount') %>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" x2="19" y1="8" y2="14"/><line x1="22" x2="16" y1="11" y2="11"/></svg>
      </a>
    </div>
    <% } %>

  </div>
</section>

<!-- ═══════════════════════════════════════════════════════
     FEATURED OFFERS — Bento Grid
     ═══════════════════════════════════════════════════════ -->
<section class="section" style="background: var(--bg-secondary);">
  <div class="container">
    <% if (typeof hasPreferences !== 'undefined' && hasPreferences && preferredCityName) { %>
    <div class="preferences-banner reveal" style="display: flex; align-items: center; gap: 12px; padding: 12px 20px; background: rgba(251, 146, 60, 0.08); border: 1px solid rgba(251, 146, 60, 0.2); border-radius: var(--radius-lg); margin-bottom: 24px;">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
      <span style="color: var(--text-secondary); font-size: 0.875rem;"><%= t('common.offerFrom') %> <strong style="color: var(--text-primary);"><%= preferredCityName %></strong></span>
      <a href="/preferinte" style="color: var(--accent); font-size: 0.875rem; margin-left: auto; text-decoration: none;"><%= t('common.change') %></a>
    </div>
    <% } %>

    <% if (dealOfDay) { %>
    <div class="section-header reveal">
      <div class="section-label"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg> <%= t('home.recommendedLabel') %></div>
      <h2 class="section-title text-gradient"><%= t('common.dealOfDay') %></h2>
    </div>
    <div class="reveal" style="margin-bottom: 40px;">
      <a href="/oferta/<%= dealOfDay.id %>" class="offer-card featured" style="display: block;">
        <div class="offer-image-wrapper">
          <% if (dealOfDay.image_url) { %>
            <img src="<%= dealOfDay.image_url %>" alt="<%= dealOfDay.title %>" class="offer-image" loading="lazy" width="600" height="400">
          <% } else { %>
            <div class="offer-image-placeholder">
              <span class="offer-placeholder-letter"><%= (dealOfDay.business_name || 'O').charAt(0) %></span>
            </div>
          <% } %>
          <% if (dealOfDay.discount_value) { %>
            <div class="offer-badge">
              <% if (dealOfDay.discount_type === 'percent' || dealOfDay.discount_type === 'percentage') { %>
                -<%= dealOfDay.discount_value %>%
              <% } else { %>
                <%= dealOfDay.discount_value %> lei
              <% } %>
            </div>
          <% } %>
          <div style="position: absolute; top: 12px; left: 52px; background: var(--accent); color: #000; font-size: 0.625rem; font-weight: 700; padding: 3px 10px; border-radius: 4px; text-transform: uppercase; letter-spacing: 0.04em; z-index: 2;"><%= t('common.dealOfDay') %></div>
          <% if (dealOfDay.end_date) { %>
            <div class="countdown-overlay" data-end-date="<%= new Date(dealOfDay.end_date).toISOString() %>"></div>
          <% } %>
          <div class="card-heart-btn<%= (userFavoriteIds || []).includes(dealOfDay.id) ? ' is-active' : '' %>" data-offer-id="<%= dealOfDay.id %>" data-favorited="<%= (userFavoriteIds || []).includes(dealOfDay.id) ? 'true' : 'false' %>" onclick="window.toggleCardFavorite(<%= dealOfDay.id %>, event)" role="button" tabindex="0" aria-label="Favorite"><svg class="heart-outline" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg><svg class="heart-filled" width="18" height="18" viewBox="0 0 24 24" fill="#ef4444" stroke="#ef4444" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg></div>
        </div>
        <div class="offer-content">
          <div class="offer-content-text">
            <div class="offer-title"><%= dealOfDay.title %></div>
            <div class="offer-business"><%= dealOfDay.business_name %><% const _dbt = dealOfDay.business_badge_type || (dealOfDay.business_verified ? 'verified' : null); if (_dbt === 'premium') { %> <svg class="premium-badge-icon" width="14" height="14" viewBox="0 0 24 24" fill="#a78bfa"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/></svg><% } else if (_dbt === 'verified') { %> <svg class="verified-badge" width="14" height="14" viewBox="0 0 24 24" fill="#fb923c"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/></svg><% } %></div>
            <div class="offer-meta">
              <% if (dealOfDay.city_name) { %>
                <span><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg> <%= dealOfDay.city_name %></span>
              <% } %>
            </div>
          </div>
        </div>
      </a>
    </div>
    <% } %>

    <div class="section-header reveal">
      <div class="section-label"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg> <%= t('home.popularLabel') %></div>
      <h2 class="section-title text-gradient"><%= t('home.topOffers') %></h2>
      <p class="section-subtitle"><%= t('home.topOffersSubtitle') %></p>
    </div>

    <!-- Geo Banner -->
    <div id="geo-banner" class="geo-banner" style="display:none;">
      <div class="geo-banner-content">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
        <span id="geo-banner-text"><%= t('common.geoEnable') %></span>
        <button class="btn btn-primary" id="geo-activate-btn"><%= t('common.geoButton') %></button>
      </div>
    </div>

    <div class="offers-bento">
      <% featuredOffers.forEach((offer, i) => { %>
        <a href="/oferta/<%= offer.id %>" class="offer-card reveal reveal-delay-<%= Math.min(i + 1, 5) %><%= i === 0 ? ' featured' : '' %>">
          <div class="offer-image-wrapper">
            <% if (offer.image_url) { %>
              <img src="<%= offer.image_url %>" alt="<%= offer.title %>" class="offer-image" loading="lazy" width="400" height="240">
            <% } else if (offer.business_logo) { %>
              <div class="offer-image-placeholder">
                <img src="<%= offer.business_logo %>" alt="<%= offer.business_name %>" class="offer-placeholder-logo">
              </div>
            <% } else { %>
              <div class="offer-image-placeholder">
                <span class="offer-placeholder-letter"><%= offer.business_name.charAt(0) %></span>
              </div>
            <% } %>
            <% if (offer.is_trending) { %>
              <div class="trending-badge"><%= t('common.trending') %></div>
            <% } %>
            <div class="offer-badge">
              <% if (offer.discount_type === 'percent' || offer.discount_type === 'percentage') { %>
                -<%= offer.discount_value %>%
              <% } else { %>
                <%= offer.discount_value %> lei
              <% } %>
            </div>
            <% if (offer.end_date) { %>
              <div class="countdown-overlay" data-end-date="<%= new Date(offer.end_date).toISOString() %>"></div>
            <% } %>
            <div class="card-heart-btn<%= (userFavoriteIds || []).includes(offer.id) ? ' is-active' : '' %>" data-offer-id="<%= offer.id %>" data-favorited="<%= (userFavoriteIds || []).includes(offer.id) ? 'true' : 'false' %>" onclick="window.toggleCardFavorite(<%= offer.id %>, event)" role="button" tabindex="0" aria-label="Favorite"><svg class="heart-outline" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg><svg class="heart-filled" width="18" height="18" viewBox="0 0 24 24" fill="#ef4444" stroke="#ef4444" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg></div>
          </div>
          <div class="offer-content">
            <% if (i === 0) { %>
              <div class="offer-content-text">
            <% } %>
            <div class="offer-title"><%= offer.title %></div>
            <div class="offer-business"><%= offer.business_name %><% const _fbt = offer.business_badge_type || (offer.business_verified ? 'verified' : null); if (_fbt === 'premium') { %> <svg class="premium-badge-icon" width="14" height="14" viewBox="0 0 24 24" fill="#a78bfa"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/></svg><% } else if (_fbt === 'verified') { %> <svg class="verified-badge" width="14" height="14" viewBox="0 0 24 24" fill="#fb923c"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/></svg><% } %></div>
            <% if (parseFloat(offer.rating_avg) > 0) { %>
              <div class="offer-rating">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="#fb923c" stroke="#fb923c" stroke-width="1"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                <span><%= parseFloat(offer.rating_avg).toFixed(1) %></span>
                <span class="offer-rating-count">(<%= offer.rating_count %>)</span>
              </div>
            <% } %>
            <% if (i === 0) { %>
              </div>
            <% } %>
            <div class="offer-meta">
              <span class="offer-meta-item">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                <%= offer.city_name %>
              </span>
              <span class="offer-meta-item offer-distance" data-lat="<%= offer.business_lat || '' %>" data-lng="<%= offer.business_lng || '' %>" style="display:none;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="3 11 22 2 13 21 11 13 3 11"/></svg>
                <span class="offer-distance-text"></span>
              </span>
              <span class="offer-meta-item">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                <%= offer.category_name %>
              </span>
            </div>
          </div>
        </a>
      <% }); %>
    </div>

    <div style="text-align: center; margin-top: 48px;" class="reveal">
      <a href="/oferte" class="btn btn-secondary btn-lg">
        <%= t('home.seeAllOffers') %>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════
     PROMOTED OFFERS (Premium businesses)
     ═══════════════════════════════════════════════════════ -->
<% if (typeof promotedOffers !== 'undefined' && promotedOffers && promotedOffers.length > 0) { %>
<section class="section">
  <div class="container">
    <div class="section-header reveal">
      <div class="section-label"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg> <%= t('home.partnersLabel') %></div>
      <h2 class="section-title text-gradient"><%= t('home.promotedOffers') %></h2>
      <p class="section-subtitle"><%= t('home.promotedSubtitle') %></p>
    </div>

    <div class="offers-bento promoted-grid">
      <% promotedOffers.forEach((offer, i) => { %>
        <a href="/oferta/<%= offer.id %>" class="offer-card reveal reveal-delay-<%= Math.min(i + 1, 3) %>">
          <div class="offer-image-wrapper">
            <% if (offer.image_url) { %>
              <img src="<%= offer.image_url %>" alt="<%= offer.title %>" class="offer-image" loading="lazy" width="400" height="240">
            <% } else if (offer.business_logo) { %>
              <div class="offer-image-placeholder">
                <img src="<%= offer.business_logo %>" alt="<%= offer.business_name %>" class="offer-placeholder-logo">
              </div>
            <% } else { %>
              <div class="offer-image-placeholder">
                <span class="offer-placeholder-letter"><%= (offer.business_name || 'O').charAt(0) %></span>
              </div>
            <% } %>
            <span class="promoted-badge"><%= t('common.promoted') %></span>
            <% if (offer.discount_value) { %>
              <div class="offer-badge">
                <% if (offer.discount_type === 'percent' || offer.discount_type === 'percentage') { %>
                  -<%= offer.discount_value %>%
                <% } else { %>
                  <%= offer.discount_value %> lei
                <% } %>
              </div>
            <% } %>
            <% if (offer.end_date) { %>
