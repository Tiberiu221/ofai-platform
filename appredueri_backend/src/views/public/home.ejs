<%- include('partials/head', { pageTitle: 'Reduceri & Oferte din România', activePage: 'home', pageDesc: 'Descoperă cele mai bune reduceri și oferte de la business-urile din orașul tău. Restaurante, beauty, fitness și multe altele.', canonicalUrl: 'https://ofai.ro', ogUrl: 'https://ofai.ro' }) %>
<%- include('partials/navbar', { activePage: 'home', webUser: typeof webUser !== 'undefined' ? webUser : null }) %>

<!-- ═══════════════════════════════════════════════════════
     HERO SECTION
     ═══════════════════════════════════════════════════════ -->
<section class="hero">
  <div class="hero-glow"></div>
  <div class="hero-glow-secondary"></div>
  <div class="hero-grid-bg"></div>
  <canvas class="particle-canvas hero-particles"></canvas>

  <div class="hero-content">
    <div class="hero-pill">
      <span class="hero-pill-dot"></span>
      <span><strong><%= stats.newOffers %>+</strong> oferte noi săptămâna aceasta</span>
    </div>

    <h1 class="hero-title text-gradient">
      Cele mai bune oferte din <span class="accent">orașul tău</span>
    </h1>

    <p class="hero-subtitle">
      Descoperă reduceri verificate la frizerii, restaurante, fitness și 12+ categorii. Gratuit. Fără reclame. Fără catch.
    </p>

    <div class="search-wrapper" style="margin-bottom: 40px;">
      <form action="/oferte" method="GET">
        <input type="text" name="q" class="search-bar" placeholder="Caută oferte, business-uri, categorii...">
        <div class="search-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        </div>
      </form>
    </div>

    <div class="hero-ctas">
      <a href="/oferte" class="btn btn-primary btn-lg">
        Explorează oferte
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
      <a href="/pentru-business" class="btn btn-secondary btn-lg">
        Pentru Business
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
      </a>
    </div>

    <!-- Trust Pillars -->
    <div class="trust-pillars">
      <div class="trust-pill">
        <div class="trust-pill-icon">🔒</div>
        <div class="trust-pill-text">
          <div class="trust-pill-title">100% Gratuit</div>
          <div class="trust-pill-desc">Fără costuri ascunse, fără abonamente</div>
        </div>
      </div>
      <div class="trust-pill">
        <div class="trust-pill-icon">✅</div>
        <div class="trust-pill-text">
          <div class="trust-pill-title">Business-uri Verificate</div>
          <div class="trust-pill-desc">Echipa OFAI verifică fiecare partener</div>
        </div>
      </div>
      <div class="trust-pill">
        <div class="trust-pill-icon">🎯</div>
        <div class="trust-pill-text">
          <div class="trust-pill-title">Oferte Personalizate</div>
          <div class="trust-pill-desc">Bazate pe orașul și preferințele tale</div>
        </div>
      </div>
    </div>

    <div class="hero-stats">
      <div class="hero-stat">
        <div class="hero-stat-value" data-count="<%= stats.totalBusinesses %>" data-suffix="+"><%= stats.totalBusinesses %>+</div>
        <div class="hero-stat-label">Business-uri</div>
      </div>
      <div class="hero-stat">
        <div class="hero-stat-value" data-count="<%= stats.totalOffers %>" data-suffix="+"><%= stats.totalOffers %>+</div>
        <div class="hero-stat-label">Oferte active</div>
      </div>
      <div class="hero-stat">
        <div class="hero-stat-value" data-count="<%= stats.totalCities %>"><%= stats.totalCities %></div>
        <div class="hero-stat-label">Orașe</div>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════
     MARQUEE — Business-uri partenere
     ═══════════════════════════════════════════════════════ -->
<section class="marquee-section">
  <div class="marquee-label">Business-uri partenere pe platformă</div>
  <div class="marquee-track">
    <% const marqueeItems = featuredBusinesses.concat(featuredBusinesses); %>
    <% marqueeItems.forEach(biz => { %>
      <div class="marquee-item">
        <img src="<%= biz.logo_url %>" alt="<%= biz.name %>" loading="lazy" width="40" height="40" onerror="this.style.display='none'">
        <span><%= biz.name %></span>
      </div>
    <% }); %>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════
     HOW IT WORKS (mutat sus — vizitatorii noi trebuie sa inteleaga flow-ul devreme)
     ═══════════════════════════════════════════════════════ -->
<section class="section" id="how-it-works">
  <div class="container">
    <div class="section-header reveal">
      <div class="section-label">✨ Simplu</div>
      <h2 class="section-title text-gradient">Cum funcționează?</h2>
      <p class="section-subtitle">Trei pași simpli pentru a accesa cele mai bune oferte</p>
    </div>

    <div class="steps-grid">
      <div class="step-card reveal reveal-delay-1">
        <div class="step-number">1</div>
        <h3 class="step-title">Alege orașul și categoriile</h3>
        <p class="step-desc">Setează preferințele tale în 30 de secunde. Primești doar oferte relevante pentru tine.</p>
      </div>
      <div class="step-card reveal reveal-delay-2">
        <div class="step-number">2</div>
        <h3 class="step-title">Salvează și urmărește</h3>
        <p class="step-desc">Adaugă ofertele la favorite. Urmărește business-urile preferate și primești notificări când apar reduceri noi.</p>
      </div>
      <div class="step-card reveal reveal-delay-3">
        <div class="step-number">3</div>
        <h3 class="step-title">Folosește reducerea</h3>
        <p class="step-desc">Mergi la business, arată codul promo sau menționează oferta. Atât de simplu!</p>
      </div>
    </div>

    <% if (!webUser) { %>
    <div style="text-align: center; margin-top: 40px;" class="reveal reveal-delay-4">
      <a href="/register" class="btn btn-secondary btn-lg">
        Creează cont gratuit
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" x2="19" y1="8" y2="14"/><line x1="22" x2="16" y1="11" y2="11"/></svg>
      </a>
    </div>
    <% } %>

  </div>
</section>

<!-- ═══════════════════════════════════════════════════════
     FEATURED OFFERS — Bento Grid
     ═══════════════════════════════════════════════════════ -->
<section class="section" style="background: var(--bg-secondary);">
  <div class="container">
    <% if (typeof hasPreferences !== 'undefined' && hasPreferences && preferredCityName) { %>
    <div class="preferences-banner reveal" style="display: flex; align-items: center; gap: 12px; padding: 12px 20px; background: rgba(251, 146, 60, 0.08); border: 1px solid rgba(251, 146, 60, 0.2); border-radius: var(--radius-lg); margin-bottom: 24px;">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
      <span style="color: var(--text-secondary); font-size: 0.875rem;">Oferte din <strong style="color: var(--text-primary);"><%= preferredCityName %></strong></span>
      <a href="/preferinte" style="color: var(--accent); font-size: 0.875rem; margin-left: auto; text-decoration: none;">Schimbă</a>
    </div>
    <% } %>

    <% if (dealOfDay) { %>
    <div class="section-header reveal">
      <div class="section-label">⭐ Recomandat</div>
      <h2 class="section-title text-gradient">Oferta Zilei</h2>
    </div>
    <div class="reveal" style="margin-bottom: 40px;">
      <a href="/oferta/<%= dealOfDay.id %>" class="offer-card featured" style="display: block;">
        <div class="offer-image-wrapper">
          <% if (dealOfDay.image_url) { %>
            <img src="<%= dealOfDay.image_url %>" alt="<%= dealOfDay.title %>" class="offer-image" loading="lazy" width="600" height="400">
          <% } else { %>
            <div class="offer-image-placeholder">
              <span class="offer-placeholder-letter"><%= (dealOfDay.business_name || 'O').charAt(0) %></span>
            </div>
          <% } %>
          <% if (dealOfDay.discount_value) { %>
            <div class="offer-badge">
              <% if (dealOfDay.discount_type === 'percent' || dealOfDay.discount_type === 'percentage') { %>
                -<%= dealOfDay.discount_value %>%
              <% } else { %>
                <%= dealOfDay.discount_value %> lei
              <% } %>
            </div>
          <% } %>
          <div style="position: absolute; top: 12px; left: 52px; background: var(--accent); color: #000; font-size: 0.625rem; font-weight: 700; padding: 3px 10px; border-radius: 4px; text-transform: uppercase; letter-spacing: 0.04em; z-index: 2;">Oferta Zilei</div>
          <% if (dealOfDay.end_date) { %>
            <div class="countdown-overlay" data-end-date="<%= new Date(dealOfDay.end_date).toISOString() %>"></div>
          <% } %>
          <div class="card-heart-btn<%= (userFavoriteIds || []).includes(dealOfDay.id) ? ' is-active' : '' %>" data-offer-id="<%= dealOfDay.id %>" data-favorited="<%= (userFavoriteIds || []).includes(dealOfDay.id) ? 'true' : 'false' %>" onclick="window.toggleCardFavorite(<%= dealOfDay.id %>, event)" role="button" tabindex="0" aria-label="Favorite"><svg class="heart-outline" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg><svg class="heart-filled" width="18" height="18" viewBox="0 0 24 24" fill="#ef4444" stroke="#ef4444" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg></div>
        </div>
        <div class="offer-content">
          <div class="offer-content-text">
            <div class="offer-title"><%= dealOfDay.title %></div>
            <div class="offer-business"><%= dealOfDay.business_name %></div>
            <div class="offer-meta">
              <% if (dealOfDay.city_name) { %>
                <span><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg> <%= dealOfDay.city_name %></span>
              <% } %>
              <% if (parseInt(dealOfDay.save_count) >= 3) { %>
                <span><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg> <%= dealOfDay.save_count %> salvari</span>
              <% } %>
            </div>
          </div>
        </div>
      </a>
    </div>
    <% } %>

    <div class="section-header reveal">
      <div class="section-label">🔥 Populare</div>
      <h2 class="section-title text-gradient">Oferte de top</h2>
      <p class="section-subtitle">Cele mai căutate reduceri din această săptămână</p>
    </div>

    <!-- Geo Banner -->
    <div id="geo-banner" class="geo-banner" style="display:none;">
      <div class="geo-banner-content">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
        <span id="geo-banner-text">Activează locația pentru a vedea distanța</span>
        <button class="btn btn-primary" id="geo-activate-btn">Activează locația</button>
      </div>
    </div>

    <div class="offers-bento">
      <% featuredOffers.forEach((offer, i) => { %>
        <a href="/oferta/<%= offer.id %>" class="offer-card reveal reveal-delay-<%= Math.min(i + 1, 5) %><%= i === 0 ? ' featured' : '' %>">
          <div class="offer-image-wrapper">
            <% if (offer.image_url) { %>
              <img src="<%= offer.image_url %>" alt="<%= offer.title %>" class="offer-image" loading="lazy" width="400" height="240">
            <% } else if (offer.business_logo) { %>
              <div class="offer-image-placeholder">
                <img src="<%= offer.business_logo %>" alt="<%= offer.business_name %>" class="offer-placeholder-logo">
              </div>
            <% } else { %>
              <div class="offer-image-placeholder">
                <span class="offer-placeholder-letter"><%= offer.business_name.charAt(0) %></span>
              </div>
            <% } %>
            <% if (offer.is_trending) { %>
              <div class="trending-badge">Trending</div>
            <% } %>
            <div class="offer-badge">
              <% if (offer.discount_type === 'percent' || offer.discount_type === 'percentage') { %>
                -<%= offer.discount_value %>%
              <% } else { %>
                <%= offer.discount_value %> lei
              <% } %>
            </div>
            <% if (offer.end_date) { %>
              <div class="countdown-overlay" data-end-date="<%= new Date(offer.end_date).toISOString() %>"></div>
            <% } %>
            <div class="card-heart-btn<%= (userFavoriteIds || []).includes(offer.id) ? ' is-active' : '' %>" data-offer-id="<%= offer.id %>" data-favorited="<%= (userFavoriteIds || []).includes(offer.id) ? 'true' : 'false' %>" onclick="window.toggleCardFavorite(<%= offer.id %>, event)" role="button" tabindex="0" aria-label="Favorite"><svg class="heart-outline" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg><svg class="heart-filled" width="18" height="18" viewBox="0 0 24 24" fill="#ef4444" stroke="#ef4444" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg></div>
          </div>
          <div class="offer-content">
            <% if (i === 0) { %>
              <div class="offer-content-text">
            <% } %>
            <div class="offer-title"><%= offer.title %></div>
            <div class="offer-business"><%= offer.business_name %></div>
            <% if (parseFloat(offer.rating_avg) > 0) { %>
              <div class="offer-rating">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="#fb923c" stroke="#fb923c" stroke-width="1"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                <span><%= parseFloat(offer.rating_avg).toFixed(1) %></span>
                <span class="offer-rating-count">(<%= offer.rating_count %>)</span>
              </div>
            <% } %>
            <% if (i === 0) { %>
              </div>
            <% } %>
            <div class="offer-meta">
              <span class="offer-meta-item">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                <%= offer.city_name %>
              </span>
              <span class="offer-meta-item offer-distance" data-lat="<%= offer.business_lat || '' %>" data-lng="<%= offer.business_lng || '' %>" style="display:none;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="3 11 22 2 13 21 11 13 3 11"/></svg>
                <span class="offer-distance-text"></span>
              </span>
              <% if (parseInt(offer.favorite_count) >= 5) { %>
                <span class="offer-meta-item offer-social-proof">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                  <%= offer.favorite_count %> salvari
                </span>
              <% } %>
              <span class="offer-meta-item">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                <%= offer.category_name %>
              </span>
            </div>
          </div>
        </a>
      <% }); %>
    </div>

    <div style="text-align: center; margin-top: 48px;" class="reveal">
      <a href="/oferte" class="btn btn-secondary btn-lg">
        Vezi toate ofertele
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════
     PROMOTED OFFERS (Premium businesses)
     ═══════════════════════════════════════════════════════ -->
<% if (typeof promotedOffers !== 'undefined' && promotedOffers && promotedOffers.length > 0) { %>
<section class="section">
  <div class="container">
    <div class="section-header reveal">
      <div class="section-label">⭐ Parteneri</div>
      <h2 class="section-title text-gradient">Oferte Promovate</h2>
      <p class="section-subtitle">De la business-urile noastre partenere</p>
    </div>

    <div class="offers-bento promoted-grid">
      <% promotedOffers.forEach((offer, i) => { %>
        <a href="/oferta/<%= offer.id %>" class="offer-card reveal reveal-delay-<%= Math.min(i + 1, 3) %>">
          <div class="offer-image-wrapper">
            <% if (offer.image_url) { %>
              <img src="<%= offer.image_url %>" alt="<%= offer.title %>" class="offer-image" loading="lazy" width="400" height="240">
            <% } else if (offer.business_logo) { %>
              <div class="offer-image-placeholder">
                <img src="<%= offer.business_logo %>" alt="<%= offer.business_name %>" class="offer-placeholder-logo">
              </div>
            <% } else { %>
              <div class="offer-image-placeholder">
                <span class="offer-placeholder-letter"><%= (offer.business_name || 'O').charAt(0) %></span>
              </div>
            <% } %>
            <span class="promoted-badge">Promovat</span>
            <% if (offer.discount_value) { %>
              <div class="offer-badge">
                <% if (offer.discount_type === 'percent' || offer.discount_type === 'percentage') { %>
                  -<%= offer.discount_value %>%
                <% } else { %>
                  <%= offer.discount_value %> lei
                <% } %>
              </div>
            <% } %>
            <% if (offer.end_date) { %>
              <div class="countdown-overlay" data-end-date="<%= new Date(offer.end_date).toISOString() %>"></div>
            <% } %>
            <div class="card-heart-btn<%= (userFavoriteIds || []).includes(offer.id) ? ' is-active' : '' %>" data-offer-id="<%= offer.id %>" data-favorited="<%= (userFavoriteIds || []).includes(offer.id) ? 'true' : 'false' %>" onclick="window.toggleCardFavorite(<%= offer.id %>, event)" role="button" tabindex="0" aria-label="Favorite"><svg class="heart-outline" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg><svg class="heart-filled" width="18" height="18" viewBox="0 0 24 24" fill="#ef4444" stroke="#ef4444" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg></div>
          </div>
          <div class="offer-content">
            <div class="offer-title"><%= offer.title %></div>
            <div class="offer-business"><%= offer.business_name %></div>
            <% if (parseFloat(offer.rating_avg) > 0) { %>
              <div class="offer-rating">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="#fb923c" stroke="#fb923c" stroke-width="1"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                <span><%= parseFloat(offer.rating_avg).toFixed(1) %></span>
                <span class="offer-rating-count">(<%= offer.rating_count %>)</span>
              </div>
            <% } %>
            <div class="offer-meta">
              <span class="offer-meta-item">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                <%= offer.city_name %>
              </span>
              <span class="offer-meta-item">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                <%= offer.category_name %>
              </span>
            </div>
          </div>
        </a>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<!-- ═══════════════════════════════════════════════════════
     TOP BUSINESSES
     ═══════════════════════════════════════════════════════ -->
<% if (topBusinesses && topBusinesses.length > 0) { %>
<section class="section">
  <div class="container">
    <div class="section-header reveal">
      <div class="section-label">🏢 Business-uri</div>
      <h2 class="section-title text-gradient">Business-uri populare</h2>
      <p class="section-subtitle">Descoperă cele mai active business-uri de pe platformă</p>
    </div>

    <div class="businesses-grid">
      <% topBusinesses.forEach((biz, i) => { %>
        <a href="/business/<%= biz.id %>" class="biz-card reveal reveal-delay-<%= Math.min((i % 4) + 1, 5) %>">
          <div class="biz-card-cover">
            <% if (biz.cover_image_url) { %>
              <img src="<%= biz.cover_image_url %>" alt="<%= biz.name %>" loading="lazy" width="320" height="160">
            <% } %>
            <div class="card-heart-btn<%= (userFollowedIds || []).includes(biz.id) ? ' is-active' : '' %>" data-business-id="<%= biz.id %>" onclick="window.toggleCardFollow(<%= biz.id %>, event)" role="button" tabindex="0" aria-label="Urmărește"><svg class="heart-outline" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg><svg class="heart-filled" width="18" height="18" viewBox="0 0 24 24" fill="#ef4444" stroke="#ef4444" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg></div>
          </div>
          <div class="biz-card-avatar">
            <% if (biz.logo_url) { %>
              <img src="<%= biz.logo_url %>" alt="<%= biz.name %>">
            <% } else { %>
              <span class="biz-card-letter"><%= biz.name.charAt(0) %></span>
            <% } %>
          </div>
          <div class="biz-card-body">
            <div class="biz-card-name"><%= biz.name %></div>
            <% if (parseFloat(biz.rating_avg) > 0) { %>
              <div class="biz-card-rating">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="#fb923c" stroke="#fb923c" stroke-width="1"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                <span><%= parseFloat(biz.rating_avg).toFixed(1) %></span>
                <span class="biz-card-rating-count">(<%= biz.rating_count %>)</span>
              </div>
            <% } %>
            <div class="biz-card-meta">
              <% if (biz.category_name) { %>
                <span class="biz-card-tag"><%= biz.category_name %></span>
              <% } %>
              <% if (biz.city_name) { %>
                <span class="biz-card-tag"><%= biz.city_name %></span>
              <% } %>
            </div>
            <div class="biz-card-bottom">
              <span class="biz-card-offers"><%= biz.offer_count %> oferte active</span>
              <span class="offer-distance biz-card-distance" data-lat="<%= biz.lat || '' %>" data-lng="<%= biz.lng || '' %>" style="display:none;">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="3 11 22 2 13 21 11 13 3 11"/></svg>
                <span class="offer-distance-text"></span>
              </span>
            </div>
          </div>
        </a>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<!-- ═══════════════════════════════════════════════════════
     CATEGORIES SECTION (mutat dupa oferte — proof first, taxonomy later)
     ═══════════════════════════════════════════════════════ -->
<section class="section" id="categories">
  <div class="container">
    <div class="section-header reveal">
      <div class="section-label">📂 Categorii</div>
      <h2 class="section-title text-gradient">Ce te interesează?</h2>
      <p class="section-subtitle">Explorează oferte din categoriile care te pasionează</p>
    </div>

    <div class="categories-grid">
      <% const catIcons = {
        'Clinica': '🏥', 'Frizerie': '💈', 'Beauty': '💄', 'Auto': '🚗',
        'Cafenea': '☕', 'Fitness': '💪', 'Spa & Wellness': '🧖',
        'Optica': '👓', 'Farmacie': '💊', 'Veterinar': '🐾', 'Stomatologie': '🦷',
        'Florarie': '🌸', 'Curatatorie': '👔', 'Foto & Video': '📸', 'Magazine Online': '🛒'
      }; %>
      <% categories.forEach((cat, i) => { %>
        <a href="/oferte?category=<%= cat.id %>" class="category-card reveal reveal-delay-<%= Math.min(i % 5 + 1, 5) %>">
          <div class="category-icon"><%= catIcons[cat.name] || '📦' %></div>
          <div class="category-name"><%= cat.name %></div>
          <div class="category-count"><%= cat.offer_count || 0 %> oferte</div>
        </a>
      <% }); %>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════
     NEW OFFERS FROM FOLLOWED BUSINESSES
     ═══════════════════════════════════════════════════════ -->
<% if (followedOffers && followedOffers.length > 0) { %>
<section class="section" style="padding-top: 48px; padding-bottom: 48px;">
  <div class="container">
    <div class="section-header reveal">
      <div class="section-label">🔔 Pentru tine</div>
      <h2 class="section-title" style="font-size: 1.5rem;">Noutăți de la business-urile tale</h2>
    </div>
    <div class="offers-grid offers-grid-auto">
      <% followedOffers.forEach((fo, i) => { %>
        <a href="/oferta/<%= fo.id %>" class="offer-card reveal reveal-delay-<%= Math.min(i + 1, 4) %>">
          <div class="offer-image-wrapper">
            <% if (fo.image_url) { %>
              <img src="<%= fo.image_url %>" alt="<%= fo.title %>" class="offer-image" loading="lazy" width="400" height="240">
            <% } else { %>
              <div class="offer-image-placeholder">
                <span class="offer-placeholder-letter"><%= fo.business_name.charAt(0) %></span>
              </div>
            <% } %>
            <div class="offer-badge">
              <% if (fo.discount_type === 'percent' || fo.discount_type === 'percentage') { %>
                -<%= fo.discount_value %>%
              <% } else { %>
                <%= fo.discount_value %> lei
              <% } %>
            </div>
            <% if (fo.end_date) { %>
              <div class="countdown-overlay" data-end-date="<%= new Date(fo.end_date).toISOString() %>"></div>
            <% } %>
            <div class="card-heart-btn<%= (userFavoriteIds || []).includes(fo.id) ? ' is-active' : '' %>" data-offer-id="<%= fo.id %>" data-favorited="<%= (userFavoriteIds || []).includes(fo.id) ? 'true' : 'false' %>" onclick="window.toggleCardFavorite(<%= fo.id %>, event)" role="button" tabindex="0" aria-label="Favorite"><svg class="heart-outline" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg><svg class="heart-filled" width="18" height="18" viewBox="0 0 24 24" fill="#ef4444" stroke="#ef4444" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg></div>
          </div>
          <div class="offer-content">
            <div class="offer-title"><%= fo.title %></div>
            <div class="offer-business"><%= fo.business_name %></div>
          </div>
        </a>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<!-- ═══════════════════════════════════════════════════════
     CITIES SECTION
     ═══════════════════════════════════════════════════════ -->
<section class="section" style="background: var(--bg-secondary);">
  <div class="container">
    <div class="section-header reveal">
      <div class="section-label">📍 Orașe</div>
      <h2 class="section-title text-gradient">Disponibil în orașul tău</h2>
      <p class="section-subtitle">Oferte locale din cele mai mari orașe din România</p>
    </div>

    <div class="scroll-container">
      <button class="scroll-arrow scroll-arrow-left" aria-label="Scroll stânga">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      </button>
      <div class="cities-scroll">
        <% const cityImages = {
          'Bucuresti/Ilfov': 'https://images.pexels.com/photos/9504777/pexels-photo-9504777.jpeg?auto=compress&cs=tinysrgb&w=520&h=320&fit=crop',
          'Cluj-Napoca': 'https://images.pexels.com/photos/31414128/pexels-photo-31414128.jpeg?auto=compress&cs=tinysrgb&w=520&h=320&fit=crop',
          'Timisoara': 'https://images.pexels.com/photos/13796020/pexels-photo-13796020.jpeg?auto=compress&cs=tinysrgb&w=520&h=320&fit=crop',
          'Iasi': 'https://images.pexels.com/photos/9464331/pexels-photo-9464331.jpeg?auto=compress&cs=tinysrgb&w=520&h=320&fit=crop',
          'Constanta': 'https://images.pexels.com/photos/241946/pexels-photo-241946.jpeg?auto=compress&cs=tinysrgb&w=520&h=320&fit=crop',
          'Brasov': 'https://images.pexels.com/photos/11534893/pexels-photo-11534893.jpeg?auto=compress&cs=tinysrgb&w=520&h=320&fit=crop',
          'Craiova': 'https://images.pexels.com/photos/5740926/pexels-photo-5740926.jpeg?auto=compress&cs=tinysrgb&w=520&h=320&fit=crop',
          'Sibiu': 'https://images.pexels.com/photos/16752617/pexels-photo-16752617.jpeg?auto=compress&cs=tinysrgb&w=520&h=320&fit=crop',
          'Oradea': 'https://images.pexels.com/photos/34440234/pexels-photo-34440234.jpeg?auto=compress&cs=tinysrgb&w=520&h=320&fit=crop',
          'Galati': 'https://images.pexels.com/photos/30619583/pexels-photo-30619583.jpeg?auto=compress&cs=tinysrgb&w=520&h=320&fit=crop',
          'Arad': 'https://images.pexels.com/photos/10811627/pexels-photo-10811627.jpeg?auto=compress&cs=tinysrgb&w=520&h=320&fit=crop',
          'Ploiesti': 'https://images.pexels.com/photos/9849228/pexels-photo-9849228.jpeg?auto=compress&cs=tinysrgb&w=520&h=320&fit=crop',
          'Pitesti': 'https://images.pexels.com/photos/17297918/pexels-photo-17297918.jpeg?auto=compress&cs=tinysrgb&w=520&h=320&fit=crop',
          'Baia Mare': 'https://images.pexels.com/photos/18358279/pexels-photo-18358279.jpeg?auto=compress&cs=tinysrgb&w=520&h=320&fit=crop',
          'Targu Mures': 'https://images.pexels.com/photos/30743448/pexels-photo-30743448.jpeg?auto=compress&cs=tinysrgb&w=520&h=320&fit=crop'
        }; %>
        <% cities.forEach((city, i) => { %>
          <a href="/oferte?city=<%= city.id %>" class="city-card reveal reveal-delay-<%= Math.min(i % 5 + 1, 5) %>">
            <div class="city-card-bg" style="background-image: url('<%= cityImages[city.name] || '' %>');"></div>
            <div class="city-card-content">
              <div class="city-card-name"><%= city.name %></div>
              <div class="city-card-count"><%= city.business_count || 0 %> business-uri</div>
            </div>
          </a>
        <% }); %>
      </div>
      <button class="scroll-arrow scroll-arrow-right" aria-label="Scroll dreapta">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
      </button>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════
     CTA SECTION
     ═══════════════════════════════════════════════════════ -->
<section class="cta-section">
  <div class="container">
    <div class="cta-box reveal">
      <div class="cta-box-glow"></div>
      <h2 class="cta-title text-gradient">Ai un business? Listează-te gratuit</h2>
      <p class="cta-subtitle">
        Crește-ți vizibilitatea și atrage clienți noi cu reduceri atractive.
      </p>
      <div class="cta-benefits">
        <div class="cta-benefit">
          <span class="cta-benefit-icon">📊</span>
          <span>Dashboard propriu</span>
        </div>
        <div class="cta-benefit">
          <span class="cta-benefit-icon">⭐</span>
          <span>Recenzii de la clienți</span>
        </div>
        <div class="cta-benefit">
          <span class="cta-benefit-icon">📈</span>
          <span>Statistici de audiență</span>
        </div>
      </div>
      <p class="cta-guarantee">Fără comisioane · Fără contracte · Anulează oricând</p>
      <a href="/pentru-business" class="btn btn-primary btn-lg">
        Înscrie-ți afacerea
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>