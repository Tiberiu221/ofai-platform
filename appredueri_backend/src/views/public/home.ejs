<%- include('partials/head', { pageTitle: 'Reduceri & Oferte', activePage: 'home' }) %>
<%- include('partials/navbar', { activePage: 'home', webUser: typeof webUser !== 'undefined' ? webUser : null }) %>

<!-- ═══════════════════════════════════════════════════════
     HERO SECTION
     ═══════════════════════════════════════════════════════ -->
<section class="hero">
  <div class="hero-glow"></div>
  <div class="hero-glow-secondary"></div>
  <div class="hero-grid-bg"></div>
  <canvas class="particle-canvas hero-particles"></canvas>

  <div class="hero-content">
    <div class="hero-pill">
      <span class="hero-pill-dot"></span>
      <span><strong><%= stats.newOffers %>+</strong> oferte noi săptămâna aceasta</span>
    </div>

    <h1 class="hero-title text-gradient">
      Reduceri de la business-uri <span class="accent">locale</span>
    </h1>

    <p class="hero-subtitle">
      Descoperă cele mai bune oferte de la peste <%= stats.totalBusinesses.toLocaleString('ro-RO') %> business-uri din <%= stats.totalCities %> orașe. Restaurante, beauty, fitness și multe altele.
    </p>

    <div class="search-wrapper" style="margin-bottom: 40px;">
      <form action="/oferte" method="GET">
        <input type="text" name="q" class="search-bar" placeholder="Caută oferte, business-uri, categorii...">
        <div class="search-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        </div>
      </form>
    </div>

    <div class="hero-ctas">
      <a href="/oferte" class="btn btn-primary btn-lg">
        Explorează oferte
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
      <a href="#how-it-works" class="btn btn-secondary btn-lg">Cum funcționează?</a>
    </div>

    <div class="hero-stats">
      <div class="hero-stat">
        <div class="hero-stat-value" data-count="<%= stats.totalBusinesses %>" data-suffix="+"><%= stats.totalBusinesses %>+</div>
        <div class="hero-stat-label">Business-uri</div>
      </div>
      <div class="hero-stat">
        <div class="hero-stat-value" data-count="<%= stats.totalOffers %>" data-suffix="+"><%= stats.totalOffers %>+</div>
        <div class="hero-stat-label">Oferte active</div>
      </div>
      <div class="hero-stat">
        <div class="hero-stat-value" data-count="<%= stats.totalCities %>"><%= stats.totalCities %></div>
        <div class="hero-stat-label">Orașe</div>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════
     MARQUEE — Business-uri partenere
     ═══════════════════════════════════════════════════════ -->
<section class="marquee-section">
  <div class="marquee-label">Business-uri partenere pe platformă</div>
  <div class="marquee-track">
    <% const marqueeItems = featuredBusinesses.concat(featuredBusinesses); %>
    <% marqueeItems.forEach(biz => { %>
      <div class="marquee-item">
        <img src="<%= biz.logo_url %>" alt="<%= biz.name %>" loading="lazy" width="40" height="40" onerror="this.style.display='none'">
        <span><%= biz.name %></span>
      </div>
    <% }); %>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════
     CATEGORIES SECTION
     ═══════════════════════════════════════════════════════ -->
<section class="section" id="categories">
  <div class="container">
    <div class="section-header reveal">
      <div class="section-label">📂 Categorii</div>
      <h2 class="section-title text-gradient">Ce te interesează?</h2>
      <p class="section-subtitle">Explorează oferte din categoriile care te pasionează</p>
    </div>

    <div class="categories-grid">
      <% const catIcons = {
        'Clinica': '🏥', 'Frizerie': '💈', 'Beauty': '💄', 'Auto': '🚗',
        'Restaurant': '🍽️', 'Cafenea': '☕', 'Fitness': '💪', 'Spa & Wellness': '🧖',
        'Optica': '👓', 'Farmacie': '💊', 'Veterinar': '🐾', 'Stomatologie': '🦷',
        'Florarie': '🌸', 'Curatatorie': '👔', 'Foto & Video': '📸'
      }; %>
      <% categories.forEach((cat, i) => { %>
        <a href="/oferte?category=<%= cat.id %>" class="category-card reveal reveal-delay-<%= Math.min(i % 5 + 1, 5) %>">
          <div class="category-icon"><%= catIcons[cat.name] || '📦' %></div>
          <div class="category-name"><%= cat.name %></div>
          <div class="category-count"><%= cat.offer_count || 0 %> oferte</div>
        </a>
      <% }); %>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════
     NEW OFFERS FROM FOLLOWED BUSINESSES
     ═══════════════════════════════════════════════════════ -->
<% if (followedOffers && followedOffers.length > 0) { %>
<section class="section" style="padding-top: 48px; padding-bottom: 48px;">
  <div class="container">
    <div class="section-header reveal">
      <div class="section-label">🔔 Pentru tine</div>
      <h2 class="section-title" style="font-size: 1.5rem;">Noutati de la business-urile tale</h2>
    </div>
    <div class="offers-grid offers-grid-auto">
      <% followedOffers.forEach((fo, i) => { %>
        <a href="/oferta/<%= fo.id %>" class="offer-card reveal reveal-delay-<%= Math.min(i + 1, 4) %>">
          <div class="offer-image-wrapper">
            <% if (fo.image_url) { %>
              <img src="<%= fo.image_url %>" alt="<%= fo.title %>" class="offer-image" loading="lazy">
            <% } else { %>
              <div class="offer-image-placeholder">
                <span class="offer-placeholder-letter"><%= fo.business_name.charAt(0) %></span>
              </div>
            <% } %>
            <div class="offer-badge">
              <% if (fo.discount_type === 'percent' || fo.discount_type === 'percentage') { %>
                -<%= fo.discount_value %>%
              <% } else { %>
                <%= fo.discount_value %> lei
              <% } %>
            </div>
            <% if (fo.end_date) { const _dl = Math.ceil((new Date(fo.end_date) - new Date()) / 86400000); if (_dl > 0 && _dl <= 7) { %>
              <div class="urgency-badge"><%= _dl === 1 ? 'Ultima zi!' : 'Expir\u0103 \xeen ' + _dl + ' zile' %></div>
            <% } } %>
          </div>
          <div class="offer-content">
            <div class="offer-content-row">
              <% if (fo.business_logo) { %>
                <div class="offer-logo">
                  <img src="<%= fo.business_logo %>" alt="<%= fo.business_name %>" loading="lazy">
                </div>
              <% } %>
              <div class="offer-content-text">
                <div class="offer-business"><%= fo.business_name %></div>
                <div class="offer-title"><%= fo.title %></div>
              </div>
            </div>
          </div>
        </a>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<!-- ═══════════════════════════════════════════════════════
     FEATURED OFFERS — Bento Grid
     ═══════════════════════════════════════════════════════ -->
<section class="section" style="background: var(--bg-secondary);">
  <div class="container">
    <% if (typeof hasPreferences !== 'undefined' && hasPreferences && preferredCityName) { %>
    <div class="preferences-banner reveal" style="display: flex; align-items: center; gap: 12px; padding: 12px 20px; background: rgba(251, 146, 60, 0.08); border: 1px solid rgba(251, 146, 60, 0.2); border-radius: var(--radius-lg); margin-bottom: 24px;">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
      <span style="color: var(--text-secondary); font-size: 0.875rem;">Oferte din <strong style="color: var(--text-primary);"><%= preferredCityName %></strong></span>
      <a href="/preferinte" style="color: var(--accent); font-size: 0.875rem; margin-left: auto; text-decoration: none;">Schimbă</a>
    </div>
    <% } %>

    <div class="section-header reveal">
      <div class="section-label">🔥 Populare</div>
      <h2 class="section-title text-gradient">Oferte de top</h2>
      <p class="section-subtitle">Cele mai căutate reduceri din această săptămână</p>
    </div>

    <!-- Geo Banner -->
    <div id="geo-banner" class="geo-banner" style="display:none;">
      <div class="geo-banner-content">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
        <span id="geo-banner-text">Activeaza locatia pentru a vedea distanta</span>
        <button class="btn btn-primary" id="geo-activate-btn">Activeaza locatia</button>
      </div>
    </div>

    <div class="offers-bento">
      <% featuredOffers.forEach((offer, i) => { %>
        <a href="/oferta/<%= offer.id %>" class="offer-card reveal reveal-delay-<%= Math.min(i + 1, 5) %><%= i === 0 ? ' featured' : '' %>">
          <div class="offer-image-wrapper">
            <% if (offer.image_url) { %>
              <img src="<%= offer.image_url %>" alt="<%= offer.title %>" class="offer-image" loading="lazy">
            <% } else if (offer.business_logo) { %>
              <div class="offer-image-placeholder">
                <img src="<%= offer.business_logo %>" alt="<%= offer.business_name %>" class="offer-placeholder-logo">
              </div>
            <% } else { %>
              <div class="offer-image-placeholder">
                <span class="offer-placeholder-letter"><%= offer.business_name.charAt(0) %></span>
              </div>
            <% } %>
            <div class="offer-badge">
              <% if (offer.discount_type === 'percent' || offer.discount_type === 'percentage') { %>
                -<%= offer.discount_value %>%
              <% } else { %>
                <%= offer.discount_value %> lei
              <% } %>
            </div>
            <% if (offer.end_date) { const _dl = Math.ceil((new Date(offer.end_date) - new Date()) / 86400000); if (_dl > 0 && _dl <= 7) { %>
              <div class="urgency-badge"><%= _dl === 1 ? 'Ultima zi!' : 'Expir\u0103 \xeen ' + _dl + ' zile' %></div>
            <% } } %>
          </div>
          <div class="offer-content">
            <div class="offer-content-row">
              <% if (offer.business_logo && i !== 0) { %>
                <div class="offer-logo">
                  <img src="<%= offer.business_logo %>" alt="<%= offer.business_name %>" loading="lazy">
                </div>
              <% } %>
              <div class="offer-content-text">
                <div class="offer-business"><%= offer.business_name %></div>
                <div class="offer-title"><%= offer.title %></div>
                <% if (parseFloat(offer.rating_avg) > 0) { %>
                  <div class="offer-rating">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="#fb923c" stroke="#fb923c" stroke-width="1"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                    <span><%= parseFloat(offer.rating_avg).toFixed(1) %></span>
                    <span class="offer-rating-count">(<%= offer.rating_count %>)</span>
                  </div>
                <% } %>
              </div>
            </div>
            <div class="offer-meta">
              <span class="offer-meta-item">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                <%= offer.city_name %>
              </span>
              <span class="offer-meta-item offer-distance" data-lat="<%= offer.business_lat || '' %>" data-lng="<%= offer.business_lng || '' %>" style="display:none;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="3 11 22 2 13 21 11 13 3 11"/></svg>
                <span class="offer-distance-text"></span>
              </span>
              <% if (parseInt(offer.favorite_count) >= 5) { %>
                <span class="offer-meta-item offer-social-proof">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                  <%= offer.favorite_count %> salvari
                </span>
              <% } %>
              <span class="offer-meta-item">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                <%= offer.category_name %>
              </span>
            </div>
          </div>
        </a>
      <% }); %>
    </div>

    <div style="text-align: center; margin-top: 48px;" class="reveal">
      <a href="/oferte" class="btn btn-secondary btn-lg">
        Vezi toate ofertele
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════
     TOP BUSINESSES
     ═══════════════════════════════════════════════════════ -->
<% if (topBusinesses && topBusinesses.length > 0) { %>
<section class="section">
  <div class="container">
    <div class="section-header reveal">
      <div class="section-label">🏢 Business-uri</div>
      <h2 class="section-title text-gradient">Business-uri populare</h2>
      <p class="section-subtitle">Descoperă cele mai active business-uri de pe platformă</p>
    </div>

    <div class="businesses-grid">
      <% topBusinesses.forEach((biz, i) => { %>
        <a href="/business/<%= biz.id %>" class="biz-card reveal reveal-delay-<%= Math.min((i % 4) + 1, 5) %>">
          <div class="biz-card-cover">
            <% if (biz.cover_image_url) { %>
              <img src="<%= biz.cover_image_url %>" alt="<%= biz.name %>" loading="lazy">
            <% } %>
          </div>
          <div class="biz-card-avatar">
            <% if (biz.logo_url) { %>
              <img src="<%= biz.logo_url %>" alt="<%= biz.name %>">
            <% } else { %>
              <span class="biz-card-letter"><%= biz.name.charAt(0) %></span>
            <% } %>
          </div>
          <div class="biz-card-body">
            <div class="biz-card-name"><%= biz.name %></div>
            <% if (parseFloat(biz.rating_avg) > 0) { %>
              <div class="biz-card-rating">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="#fb923c" stroke="#fb923c" stroke-width="1"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                <span><%= parseFloat(biz.rating_avg).toFixed(1) %></span>
                <span class="biz-card-rating-count">(<%= biz.rating_count %>)</span>
              </div>
            <% } %>
            <div class="biz-card-meta">
              <% if (biz.category_name) { %>
                <span class="biz-card-tag"><%= biz.category_name %></span>
              <% } %>
              <% if (biz.city_name) { %>
                <span class="biz-card-tag"><%= biz.city_name %></span>
              <% } %>
            </div>
            <div class="biz-card-bottom">
              <span class="biz-card-offers"><%= biz.offer_count %> oferte active</span>
              <span class="offer-distance biz-card-distance" data-lat="<%= biz.lat || '' %>" data-lng="<%= biz.lng || '' %>" style="display:none;">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="3 11 22 2 13 21 11 13 3 11"/></svg>
                <span class="offer-distance-text"></span>
              </span>
            </div>
          </div>
        </a>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<!-- ═══════════════════════════════════════════════════════
     HOW IT WORKS
     ═══════════════════════════════════════════════════════ -->
<section class="section" id="how-it-works">
  <div class="container">
    <div class="section-header reveal">
      <div class="section-label">✨ Simplu</div>
      <h2 class="section-title text-gradient">Cum funcționează?</h2>
      <p class="section-subtitle">Trei pași simpli pentru a accesa cele mai bune oferte</p>
    </div>

    <div class="steps-grid">
      <div class="step-card reveal reveal-delay-1">
        <div class="step-number">1</div>
        <h3 class="step-title">Descoperă</h3>
        <p class="step-desc">Caută oferte în orașul tău sau explorează pe categorii. Filtrează după ce te interesează.</p>
      </div>
      <div class="step-card reveal reveal-delay-2">
        <div class="step-number">2</div>
        <h3 class="step-title">Salvează</h3>
        <p class="step-desc">Adaugă ofertele preferate la favorite și urmărește business-urile care te interesează.</p>
      </div>
      <div class="step-card reveal reveal-delay-3">
        <div class="step-number">3</div>
        <h3 class="step-title">Profită</h3>
        <p class="step-desc">Mergi la business și prezintă oferta. Bucură-te de reducere!</p>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════
     CITIES SECTION
     ═══════════════════════════════════════════════════════ -->
<section class="section" style="background: var(--bg-secondary);">
  <div class="container">
    <div class="section-header reveal">
      <div class="section-label">📍 Orașe</div>
      <h2 class="section-title text-gradient">Disponibil în orașul tău</h2>
      <p class="section-subtitle">Oferte locale din cele mai mari orașe din România</p>
    </div>

    <div class="scroll-container">
      <button class="scroll-arrow scroll-arrow-left" aria-label="Scroll stânga">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      </button>
      <div class="cities-scroll">
        <% const cityImages = {
          'Bucuresti': 'https://images.pexels.com/photos/28898472/pexels-photo-28898472.jpeg?auto=compress&cs=tinysrgb&w=520&h=320&fit=crop',
          'Cluj-Napoca': 'https://images.pexels.com/photos/1444108/pexels-photo-1444108.jpeg?auto=compress&cs=tinysrgb&w=520&h=320&fit=crop',
          'Timisoara': 'https://images.pexels.com/photos/15022383/pexels-photo-15022383.jpeg?auto=compress&cs=tinysrgb&w=520&h=320&fit=crop',
          'Iasi': 'https://images.pexels.com/photos/14337862/pexels-photo-14337862.jpeg?auto=compress&cs=tinysrgb&w=520&h=320&fit=crop',
          'Constanta': 'https://images.pexels.com/photos/28748312/pexels-photo-28748312.jpeg?auto=compress&cs=tinysrgb&w=520&h=320&fit=crop',
          'Brasov': 'https://images.pexels.com/photos/11534893/pexels-photo-11534893.jpeg?auto=compress&cs=tinysrgb&w=520&h=320&fit=crop',
          'Craiova': 'https://images.pexels.com/photos/5740926/pexels-photo-5740926.jpeg?auto=compress&cs=tinysrgb&w=520&h=320&fit=crop',
          'Sibiu': 'https://images.pexels.com/photos/33319463/pexels-photo-33319463.jpeg?auto=compress&cs=tinysrgb&w=520&h=320&fit=crop',
          'Oradea': 'https://images.pexels.com/photos/34440234/pexels-photo-34440234.jpeg?auto=compress&cs=tinysrgb&w=520&h=320&fit=crop',
          'Galati': 'https://images.pexels.com/photos/32313663/pexels-photo-32313663.jpeg?auto=compress&cs=tinysrgb&w=520&h=320&fit=crop',
          'Arad': 'https://images.pexels.com/photos/10811595/pexels-photo-10811595.jpeg?auto=compress&cs=tinysrgb&w=520&h=320&fit=crop',
          'Ploiesti': 'https://images.pexels.com/photos/9849228/pexels-photo-9849228.jpeg?auto=compress&cs=tinysrgb&w=520&h=320&fit=crop',
          'Pitesti': 'https://images.pexels.com/photos/28898472/pexels-photo-28898472.jpeg?auto=compress&cs=tinysrgb&w=520&h=320&fit=crop',
          'Baia Mare': 'https://images.pexels.com/photos/18358279/pexels-photo-18358279.jpeg?auto=compress&cs=tinysrgb&w=520&h=320&fit=crop',
          'Targu Mures': 'https://images.pexels.com/photos/30743448/pexels-photo-30743448.jpeg?auto=compress&cs=tinysrgb&w=520&h=320&fit=crop'
        }; %>
        <% cities.forEach((city, i) => { %>
          <a href="/oferte?city=<%= city.id %>" class="city-card reveal reveal-delay-<%= Math.min(i % 5 + 1, 5) %>">
            <div class="city-card-bg" style="background-image: url('<%= cityImages[city.name] || '' %>');"></div>
            <div class="city-card-content">
              <div class="city-card-name"><%= city.name %></div>
              <div class="city-card-count"><%= city.business_count || 0 %> business-uri</div>
            </div>
          </a>
        <% }); %>
      </div>
      <button class="scroll-arrow scroll-arrow-right" aria-label="Scroll dreapta">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
      </button>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════
     CTA SECTION
     ═══════════════════════════════════════════════════════ -->
<section class="cta-section">
  <div class="container">
    <div class="cta-box reveal">
      <div class="cta-box-glow"></div>
      <h2 class="cta-title text-gradient">Ai un business? Adaugă-l pe OFAI</h2>
      <p class="cta-subtitle">
        Crește-ți vizibilitatea și atrage clienți noi cu oferte și reduceri atractive. Gratuit.
      </p>
      <a href="/pentru-business" class="btn btn-primary btn-lg">
        Înregistrează business-ul
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
