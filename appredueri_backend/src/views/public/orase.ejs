<%- include('partials/head', { pageTitle: t('cities.pageTitle'), activePage: 'orase', pageDesc: t('cities.pageDesc') }) %>
<%- include('partials/navbar', { activePage: 'orase', webUser: typeof webUser !== 'undefined' ? webUser : null }) %>

<section class="page-header">
  <div class="page-header-glow"></div>
  <div class="container">
    <h1 class="page-title text-gradient"><%= t('cities.pageTitle') %></h1>
    <p class="page-subtitle"><%= t('cities.subtitle', { count: cities.length }) %></p>
  </div>
</section>

<section class="section" style="padding-top: 0;">
  <div class="container">
    <div class="cities-page-grid">
      <% cities.forEach(function(city, index) { %>
        <a href="/oferte?city=<%= city.id %>" class="city-page-card reveal reveal-delay-<%= (index % 5) + 1 %>">
          <div class="city-page-card-bg"></div>
          <div class="city-page-card-content">
            <div class="city-page-card-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            </div>
            <h3 class="city-page-card-name"><%= city.name %></h3>
            <span class="city-page-card-count"><%= city.business_count || 0 %> <%= t('common.businessesCount') %></span>
          </div>
        </a>
      <% }); %>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
