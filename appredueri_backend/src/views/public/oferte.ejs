<%- include('partials/head') %>
<%- include('partials/navbar', { activePage: 'oferte', webUser: typeof webUser !== 'undefined' ? webUser : null }) %>

<!-- ═══════════════════════════════════════════════════════
     PAGE HEADER
     ═══════════════════════════════════════════════════════ -->
<div class="page-header">
  <div class="page-header-glow"></div>
  <div class="container">
    <h1 class="page-title text-gradient">Oferte & Reduceri</h1>
    <p class="page-subtitle"><%= totalOffers.toLocaleString('ro-RO') %> oferte active<%= typeof selectedCityName !== 'undefined' && selectedCityName ? ' în ' + selectedCityName : ' în ' + totalCities + ' orașe' %></p>

    <div class="search-wrapper" style="margin-top: 32px;">
      <form action="/oferte" method="GET" id="searchForm">
        <input
          type="text"
          name="q"
          class="search-bar"
          placeholder="Caută oferte, business-uri..."
          value="<%= typeof query !== 'undefined' ? query : '' %>"
        >
        <div class="search-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        </div>
        <% if (typeof selectedCity !== 'undefined' && selectedCity) { %>
          <input type="hidden" name="city" value="<%= selectedCity %>">
        <% } %>
        <% if (typeof selectedCategory !== 'undefined' && selectedCategory) { %>
          <input type="hidden" name="category" value="<%= selectedCategory %>">
        <% } %>
      </form>
    </div>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════════
     FILTER BAR
     ═══════════════════════════════════════════════════════ -->
<div class="container">
  <!-- ── Row 1: Preferences toggle + Category chips ────── -->
  <div class="filter-bar-v2">
    <div class="scroll-container">
      <button class="scroll-arrow scroll-arrow-left" aria-label="Scroll stânga">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      </button>
      <div class="filter-bar">
        <% if (typeof webUser !== 'undefined' && webUser) { %>
          <% if (typeof userHasPrefs !== 'undefined' && userHasPrefs) { %>
            <a href="/oferte<%= (typeof prefsActive !== 'undefined' && prefsActive) ? (typeof query !== 'undefined' && query ? '?q=' + encodeURIComponent(query) : '') : '?prefs=1' + (typeof query !== 'undefined' && query ? '&q=' + encodeURIComponent(query) : '') %>"
               class="filter-pill filter-pill-prefs<%= (typeof prefsActive !== 'undefined' && prefsActive) ? ' active' : '' %>"
               title="<%= (typeof userPrefsCityNames !== 'undefined' ? userPrefsCityNames : []).concat(typeof userPrefsCategoryNames !== 'undefined' ? userPrefsCategoryNames : []).join(', ') %>">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: -2px;"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg> Preferințe
            </a>
          <% } else { %>
            <a href="/preferinte?returnTo=<%= encodeURIComponent('/oferte' + (typeof query !== 'undefined' && query ? '?q=' + encodeURIComponent(query) : '')) %>"
               class="filter-pill filter-pill-prefs filter-pill-disabled"
               title="Setează preferințele din Cont">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: -2px;"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg> Preferințe
            </a>
          <% } %>
        <% } %>
        <a href="/oferte<%= query ? '?q=' + encodeURIComponent(query) : '' %>" class="filter-pill<%= !selectedCategory && !(typeof prefsActive !== 'undefined' && prefsActive) ? ' active' : '' %>">Toate</a>
        <% categories.forEach(cat => { %>
          <a href="/oferte?category=<%= cat.id %><%= selectedCity ? '&city=' + selectedCity : '' %><%= query ? '&q=' + encodeURIComponent(query) : '' %><%= selectedSort && selectedSort !== 'newest' ? '&sort=' + selectedSort : '' %>"
             class="filter-pill<%= selectedCategory == cat.id ? ' active' : '' %>">
            <%= cat.name %>
          </a>
        <% }); %>
      </div>
      <button class="scroll-arrow scroll-arrow-right" aria-label="Scroll dreapta">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
      </button>
    </div>
  </div>

  <!-- ── Row 2: Sort chips + Reset + City escape hatch ── -->
  <div class="filter-bar-v2 filter-bar-v2-sort">
    <div class="sort-chips">
      <a href="/oferte?sort=newest<%= selectedCategory ? '&category=' + selectedCategory : '' %><%= selectedCity ? '&city=' + selectedCity : '' %><%= query ? '&q=' + encodeURIComponent(query) : '' %>"
         class="filter-pill filter-pill-sort<%= selectedSort === 'newest' ? ' active' : '' %>">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: -2px;"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg> Noi
      </a>
      <a href="/oferte?sort=popular<%= selectedCategory ? '&category=' + selectedCategory : '' %><%= selectedCity ? '&city=' + selectedCity : '' %><%= query ? '&q=' + encodeURIComponent(query) : '' %>"
         class="filter-pill filter-pill-sort<%= selectedSort === 'popular' ? ' active' : '' %>">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: -2px;"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg> Populare
      </a>
      <a href="/oferte?sort=discount<%= selectedCategory ? '&category=' + selectedCategory : '' %><%= selectedCity ? '&city=' + selectedCity : '' %><%= query ? '&q=' + encodeURIComponent(query) : '' %>"
         class="filter-pill filter-pill-sort<%= selectedSort === 'discount' ? ' active' : '' %>">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: -2px;"><circle cx="9" cy="9" r="2"/><circle cx="15" cy="15" r="2"/><path d="M7.5 16.5 16.5 7.5"/></svg> Reducere
      </a>
      <a href="/oferte?sort=ending_soon<%= selectedCategory ? '&category=' + selectedCategory : '' %><%= selectedCity ? '&city=' + selectedCity : '' %><%= query ? '&q=' + encodeURIComponent(query) : '' %>"
         class="filter-pill filter-pill-sort<%= selectedSort === 'ending_soon' ? ' active' : '' %>">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: -2px;"><path d="M10 2h4"/><path d="M12 14v-4"/><circle cx="12" cy="14" r="8"/></svg> Expiră
      </a>
      <button type="button" class="filter-pill filter-pill-sort" id="sort-distance-btn" onclick="sortByDistance()" style="opacity: 0.5;" title="Activează locația">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: -2px;"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg> Distanță
      </button>
    </div>

    <% const hasActiveFilters = selectedCategory || selectedCity || (typeof prefsActive !== 'undefined' && prefsActive) || (selectedSort && selectedSort !== 'newest'); %>
    <% if (hasActiveFilters) { %>
      <a href="/oferte" class="filter-reset">✕ Resetează</a>
    <% } %>

    <div class="filter-city-escape">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: -2px;"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg> <%= typeof selectedCityName !== 'undefined' && selectedCityName ? selectedCityName : 'Toate orașele' %>
      · <a href="/preferinte?returnTo=<%= encodeURIComponent('/oferte') %>">Schimbă</a>
    </div>
  </div>

  <!-- Geo Banner -->
  <div id="geo-banner" class="geo-banner" style="display:none;">
    <div class="geo-banner-content">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
      <span id="geo-banner-text">Activează locația pentru a vedea distanța</span>
      <button class="btn btn-primary" id="geo-activate-btn">Activează locația</button>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════
       OFFERS GRID
       ═══════════════════════════════════════════════════════ -->
  <% if (offers.length > 0) { %>
    <p class="results-count">Afișând <%= offers.length %> din <%= totalOffers.toLocaleString('ro-RO') %> oferte</p>
  <% } %>

  <% if (offers.length === 0) { %>
    <div style="text-align: center; padding: 80px 0;">
      <div style="font-size: 3rem; margin-bottom: 16px;">🔍</div>
      <h3 style="font-size: 1.25rem; margin-bottom: 8px;">Nicio ofertă găsită</h3>
      <p style="color: var(--text-secondary);">Încearcă alte filtre sau caută altceva.</p>
      <a href="/oferte" class="btn btn-secondary" style="margin-top: 24px;">Resetează filtrele</a>
    </div>
  <% } else { %>
    <div class="offers-grid">
      <% offers.forEach((offer, i) => { %>
        <a href="/oferta/<%= offer.id %>" class="offer-card reveal reveal-delay-<%= Math.min((i % 4) + 1, 5) %>">
          <div class="offer-image-wrapper">
            <% if (offer.image_url) { %>
              <img src="<%= offer.image_url %>" alt="<%= offer.title %>" class="offer-image" loading="lazy" width="400" height="225">
            <% } else if (offer.business_logo) { %>
              <div class="offer-image-placeholder">
                <img src="<%= offer.business_logo %>" alt="<%= offer.business_name %>" class="offer-placeholder-logo" width="40" height="40">
              </div>
            <% } else { %>
              <div class="offer-image-placeholder">
                <span class="offer-placeholder-letter"><%= offer.business_name.charAt(0) %></span>
              </div>
            <% } %>
            <% if (offer.is_promoted) { %>
              <span class="promoted-badge">Promovat</span>
            <% } %>
            <div class="offer-badge">
              <% if (offer.discount_type === 'percent' || offer.discount_type === 'percentage') { %>
                -<%= offer.discount_value %>%
              <% } else { %>
                <%= offer.discount_value %> lei
              <% } %>
            </div>
            <% if (offer.end_date) { const _dl = Math.ceil((new Date(offer.end_date) - new Date()) / 86400000); if (_dl > 0 && _dl <= 7) { %>
              <div class="urgency-badge"><%= _dl === 1 ? 'Ultima zi!' : 'Expiră în ' + _dl + ' zile' %></div>
            <% } } %>
            <div class="card-heart-btn<%= (userFavoriteIds || []).includes(offer.id) ? ' is-active' : '' %>" data-offer-id="<%= offer.id %>" data-favorited="<%= (userFavoriteIds || []).includes(offer.id) ? 'true' : 'false' %>" onclick="window.toggleCardFavorite(<%= offer.id %>, event)" role="button" tabindex="0" aria-label="Favorite"><svg class="heart-outline" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg><svg class="heart-filled" width="18" height="18" viewBox="0 0 24 24" fill="#ef4444" stroke="#ef4444" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg></div>
          </div>
          <div class="offer-content">
            <div class="offer-title"><%= offer.title %></div>
            <div class="offer-business"><%= offer.business_name %><% const _bt = offer.business_badge_type || (offer.business_verified ? 'verified' : null); if (_bt === 'premium') { %> <svg class="premium-badge-icon" width="14" height="14" viewBox="0 0 24 24" fill="#a78bfa"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/></svg><% } else if (_bt === 'verified') { %> <svg class="verified-badge" width="14" height="14" viewBox="0 0 24 24" fill="#fb923c"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/></svg><% } %></div>
            <% if (parseFloat(offer.rating_avg) > 0) { %>
              <div class="offer-rating">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="#fb923c" stroke="#fb923c" stroke-width="1"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                <span><%= parseFloat(offer.rating_avg).toFixed(1) %></span>
                <span class="offer-rating-count">(<%= offer.rating_count %>)</span>
              </div>
            <% } %>
            <div class="offer-meta">
              <span class="offer-meta-item">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                <%= offer.city_name %>
              </span>
              <span class="offer-meta-item offer-distance" data-lat="<%= offer.business_lat || '' %>" data-lng="<%= offer.business_lng || '' %>" style="display:none;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="3 11 22 2 13 21 11 13 3 11"/></svg>
                <span class="offer-distance-text"></span>
              </span>
              <% if (parseInt(offer.favorite_count) >= 5) { %>
                <span class="offer-meta-item offer-social-proof">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                  <%= offer.favorite_count %> salvari
                </span>
              <% } %>
              <span class="offer-meta-item">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                <%= offer.category_name %>
              </span>
            </div>
          </div>
        </a>
      <% }); %>
    </div>

    <!-- Pagination -->
    <% if (totalPages > 1) { %>
      <div style="display: flex; justify-content: center; gap: 8px; padding: 48px 0 80px;">
        <% for (let p = 1; p <= Math.min(totalPages, 10); p++) { %>
          <a href="/oferte?page=<%= p %><%= selectedCategory ? '&category=' + selectedCategory : '' %><%= selectedCity ? '&city=' + selectedCity : '' %><%= query ? '&q=' + encodeURIComponent(query) : '' %><%= selectedSort && selectedSort !== 'newest' ? '&sort=' + selectedSort : '' %>"
             class="filter-pill<%= currentPage == p ? ' active' : '' %>"
             style="min-width: 40px; justify-content: center;">
            <%= p %>
          </a>
        <% } %>
        <% if (totalPages > 10) { %>
          <span class="filter-pill" style="cursor: default;">...</span>
          <a href="/oferte?page=<%= totalPages %><%= selectedCategory ? '&category=' + selectedCategory : '' %><%= selectedCity ? '&city=' + selectedCity : '' %><%= query ? '&q=' + encodeURIComponent(query) : '' %>"
             class="filter-pill<%= currentPage == totalPages ? ' active' : '' %>"
             style="min-width: 40px; justify-content: center;">
            <%= totalPages %>
          </a>
        <% } %>
      </div>
    <% } %>
  <% } %>
</div>

<%- include('partials/footer') %>
