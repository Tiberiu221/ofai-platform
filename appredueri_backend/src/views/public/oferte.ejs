<%- include('partials/head', { pageTitle: 'Oferte și Reduceri', activePage: 'oferte', pageDesc: 'Toate ofertele și reducerile active din România. Găsește cele mai bune deal-uri de la restaurante, beauty, fitness și altele.', canonicalUrl: 'https://ofai.ro/oferte', ogUrl: 'https://ofai.ro/oferte' }) %>
<%- include('partials/navbar', { activePage: 'oferte', webUser: typeof webUser !== 'undefined' ? webUser : null }) %>

<!-- ═══════════════════════════════════════════════════════
     PAGE HEADER
     ═══════════════════════════════════════════════════════ -->
<div class="page-header">
  <div class="page-header-glow"></div>
  <div class="container">
    <h1 class="page-title text-gradient">Oferte & Reduceri</h1>
    <p class="page-subtitle"><%= totalOffers.toLocaleString('ro-RO') %> oferte active în <%= totalCities %> orașe</p>

    <div class="search-wrapper" style="margin-top: 32px;">
      <form action="/oferte" method="GET" id="searchForm">
        <input
          type="text"
          name="q"
          class="search-bar"
          placeholder="Caută oferte, business-uri..."
          value="<%= typeof query !== 'undefined' ? query : '' %>"
        >
        <div class="search-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        </div>
        <% if (typeof selectedCity !== 'undefined' && selectedCity) { %>
          <input type="hidden" name="city" value="<%= selectedCity %>">
        <% } %>
        <% if (typeof selectedCategory !== 'undefined' && selectedCategory) { %>
          <input type="hidden" name="category" value="<%= selectedCategory %>">
        <% } %>
      </form>
    </div>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════════
     FILTER BAR
     ═══════════════════════════════════════════════════════ -->
<div class="container">
  <div class="scroll-container">
    <button class="scroll-arrow scroll-arrow-left" aria-label="Scroll stânga">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
    </button>
    <div class="filter-bar">
      <a href="/oferte" class="filter-pill<%= !selectedCategory ? ' active' : '' %>">Toate</a>
      <% categories.forEach(cat => { %>
        <a href="/oferte?category=<%= cat.id %><%= selectedCity ? '&city=' + selectedCity : '' %><%= query ? '&q=' + encodeURIComponent(query) : '' %>"
           class="filter-pill<%= selectedCategory == cat.id ? ' active' : '' %>">
          <%= cat.name %>
        </a>
      <% }); %>
    </div>
    <button class="scroll-arrow scroll-arrow-right" aria-label="Scroll dreapta">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
    </button>
  </div>

  <% if (cities && cities.length > 0) { %>
    <div class="scroll-container">
      <button class="scroll-arrow scroll-arrow-left" aria-label="Scroll stânga">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      </button>
      <div class="filter-bar" style="padding-top: 0;">
        <span class="sort-bar-label">Oraș:</span>
        <a href="/oferte?<%= selectedCategory ? 'category=' + selectedCategory + '&' : '' %><%= query ? 'q=' + encodeURIComponent(query) : '' %>"
           class="filter-pill<%= !selectedCity ? ' active' : '' %>">Toate</a>
        <% cities.forEach(city => { %>
          <a href="/oferte?city=<%= city.id %><%= selectedCategory ? '&category=' + selectedCategory : '' %><%= query ? '&q=' + encodeURIComponent(query) : '' %>"
             class="filter-pill<%= selectedCity == city.id ? ' active' : '' %>">
            <%= city.name %>
          </a>
        <% }); %>
      </div>
      <button class="scroll-arrow scroll-arrow-right" aria-label="Scroll dreapta">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
      </button>
    </div>
  <% } %>

  <!-- ═══════════════════════════════════════════════════════
       SORT BAR
       ═══════════════════════════════════════════════════════ -->
  <div class="sort-bar">
    <span class="sort-bar-label">Sortare:</span>
    <a href="/oferte?sort=newest<%= selectedCategory ? '&category=' + selectedCategory : '' %><%= selectedCity ? '&city=' + selectedCity : '' %><%= query ? '&q=' + encodeURIComponent(query) : '' %>"
       class="filter-pill<%= selectedSort === 'newest' ? ' active' : '' %>">Cele mai noi</a>
    <a href="/oferte?sort=popular<%= selectedCategory ? '&category=' + selectedCategory : '' %><%= selectedCity ? '&city=' + selectedCity : '' %><%= query ? '&q=' + encodeURIComponent(query) : '' %>"
       class="filter-pill<%= selectedSort === 'popular' ? ' active' : '' %>">Populare</a>
    <a href="/oferte?sort=discount<%= selectedCategory ? '&category=' + selectedCategory : '' %><%= selectedCity ? '&city=' + selectedCity : '' %><%= query ? '&q=' + encodeURIComponent(query) : '' %>"
       class="filter-pill<%= selectedSort === 'discount' ? ' active' : '' %>">Reducere mare</a>
    <button type="button" class="filter-pill" id="sort-distance-btn" onclick="sortByDistance()" style="opacity: 0.5;" title="Activează locația pentru sortare după distanță">Distanță</button>
  </div>

  <!-- Geo Banner -->
  <div id="geo-banner" class="geo-banner" style="display:none;">
    <div class="geo-banner-content">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
      <span id="geo-banner-text">Activeaza locatia pentru a vedea distanta</span>
      <button class="btn btn-primary" id="geo-activate-btn">Activeaza locatia</button>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════
       OFFERS GRID
       ═══════════════════════════════════════════════════════ -->
  <% if (offers.length === 0) { %>
    <div style="text-align: center; padding: 80px 0;">
      <div style="font-size: 3rem; margin-bottom: 16px;">🔍</div>
      <h3 style="font-size: 1.25rem; margin-bottom: 8px;">Nicio ofertă găsită</h3>
      <p style="color: var(--text-secondary);">Încearcă alte filtre sau caută altceva.</p>
      <a href="/oferte" class="btn btn-secondary" style="margin-top: 24px;">Resetează filtrele</a>
    </div>
  <% } else { %>
    <div class="offers-grid">
      <% offers.forEach((offer, i) => { %>
        <a href="/oferta/<%= offer.id %>" class="offer-card reveal reveal-delay-<%= Math.min((i % 4) + 1, 5) %>">
          <div class="offer-image-wrapper">
            <% if (offer.image_url) { %>
              <img src="<%= offer.image_url %>" alt="<%= offer.title %>" class="offer-image" loading="lazy" width="400" height="225">
            <% } else if (offer.business_logo) { %>
              <div class="offer-image-placeholder">
                <img src="<%= offer.business_logo %>" alt="<%= offer.business_name %>" class="offer-placeholder-logo" width="40" height="40">
              </div>
            <% } else { %>
              <div class="offer-image-placeholder">
                <span class="offer-placeholder-letter"><%= offer.business_name.charAt(0) %></span>
              </div>
            <% } %>
            <div class="offer-badge">
              <% if (offer.discount_type === 'percent' || offer.discount_type === 'percentage') { %>
                -<%= offer.discount_value %>%
              <% } else { %>
                <%= offer.discount_value %> lei
              <% } %>
            </div>
            <% if (offer.end_date) { const _dl = Math.ceil((new Date(offer.end_date) - new Date()) / 86400000); if (_dl > 0 && _dl <= 7) { %>
              <div class="urgency-badge"><%= _dl === 1 ? 'Ultima zi!' : 'Expir\u0103 \xeen ' + _dl + ' zile' %></div>
            <% } } %>
          </div>
          <div class="offer-content">
            <div class="offer-content-row">
              <% if (offer.business_logo) { %>
                <div class="offer-logo">
                  <img src="<%= offer.business_logo %>" alt="<%= offer.business_name %>" loading="lazy" width="40" height="40">
                </div>
              <% } %>
              <div class="offer-content-text">
                <div class="offer-business"><%= offer.business_name %></div>
                <div class="offer-title"><%= offer.title %></div>
                <% if (offer.description) { %>
                  <div class="offer-description"><%= offer.description.length > 80 ? offer.description.substring(0, 80) + '...' : offer.description %></div>
                <% } %>
                <% if (parseFloat(offer.rating_avg) > 0) { %>
                  <div class="offer-rating">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="#fb923c" stroke="#fb923c" stroke-width="1"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                    <span><%= parseFloat(offer.rating_avg).toFixed(1) %></span>
                    <span class="offer-rating-count">(<%= offer.rating_count %>)</span>
                  </div>
                <% } %>
              </div>
            </div>
            <div class="offer-meta">
              <span class="offer-meta-item">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                <%= offer.city_name %>
              </span>
              <span class="offer-meta-item offer-distance" data-lat="<%= offer.business_lat || '' %>" data-lng="<%= offer.business_lng || '' %>" style="display:none;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="3 11 22 2 13 21 11 13 3 11"/></svg>
                <span class="offer-distance-text"></span>
              </span>
              <% if (parseInt(offer.favorite_count) >= 5) { %>
                <span class="offer-meta-item offer-social-proof">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                  <%= offer.favorite_count %> salvari
                </span>
              <% } %>
              <span class="offer-meta-item">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                <%= offer.category_name %>
              </span>
            </div>
          </div>
        </a>
      <% }); %>
    </div>

    <!-- Pagination -->
    <% if (totalPages > 1) { %>
      <div style="display: flex; justify-content: center; gap: 8px; padding: 48px 0 80px;">
        <% for (let p = 1; p <= Math.min(totalPages, 10); p++) { %>
          <a href="/oferte?page=<%= p %><%= selectedCategory ? '&category=' + selectedCategory : '' %><%= selectedCity ? '&city=' + selectedCity : '' %><%= query ? '&q=' + encodeURIComponent(query) : '' %><%= selectedSort && selectedSort !== 'newest' ? '&sort=' + selectedSort : '' %>"
             class="filter-pill<%= currentPage == p ? ' active' : '' %>"
             style="min-width: 40px; justify-content: center;">
            <%= p %>
          </a>
        <% } %>
        <% if (totalPages > 10) { %>
          <span class="filter-pill" style="cursor: default;">...</span>
          <a href="/oferte?page=<%= totalPages %><%= selectedCategory ? '&category=' + selectedCategory : '' %><%= selectedCity ? '&city=' + selectedCity : '' %><%= query ? '&q=' + encodeURIComponent(query) : '' %>"
             class="filter-pill<%= currentPage == totalPages ? ' active' : '' %>"
             style="min-width: 40px; justify-content: center;">
            <%= totalPages %>
          </a>
        <% } %>
      </div>
    <% } %>
  <% } %>
</div>

<%- include('partials/footer') %>
