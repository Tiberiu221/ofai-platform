<%- include('partials/head', {
  pageTitle: offer.title,
  pageDesc: offer.description ? offer.description.substring(0, 160) : '',
  ogTitle: offer.title,
  ogDesc: offer.description ? offer.description.substring(0, 160) : '',
  ogImage: offer.image_url,
  ogType: 'article',
  canonicalUrl: 'https://ofai.ro/oferta/' + offer.id,
  ogUrl: 'https://ofai.ro/oferta/' + offer.id
}) %>

<!-- ═══════════════════════════════════════════════════════
     OFFER DETAIL PAGE STYLES
     ═══════════════════════════════════════════════════════ -->
<style>
  /* ─── BREADCRUMB ──────────────────────────────────────── */
  .breadcrumb {
    padding: 100px 0 16px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8125rem;
    color: var(--text-tertiary);
    flex-wrap: wrap;
  }

  .breadcrumb a {
    color: var(--text-secondary);
    transition: color 0.2s ease;
  }

  .breadcrumb a:hover {
    color: var(--accent);
  }

  .breadcrumb .breadcrumb-sep {
    color: var(--text-muted);
    user-select: none;
  }

  .breadcrumb .breadcrumb-current {
    color: var(--text-primary);
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 300px;
  }

  /* ─── HERO ────────────────────────────────────────────── */
  .offer-detail-hero {
    position: relative;
    width: 100%;
    max-width: var(--container-max);
    margin: 0 auto 0;
    padding: 0 var(--container-px);
  }

  .offer-detail-hero-inner {
    position: relative;
    width: 100%;
    min-height: 400px;
    border-radius: var(--radius-xl);
    overflow: hidden;
    border: 1px solid var(--border);
  }

  .offer-detail-hero-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    transition: transform 0.6s var(--ease-smooth);
  }

  .offer-detail-hero-inner:hover .offer-detail-hero-bg {
    transform: scale(1.03);
  }

  .offer-detail-hero-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(6, 6, 10, 0.75) 0%, rgba(6, 6, 10, 0.4) 40%, transparent 70%);
    pointer-events: none;
  }

  .offer-detail-hero-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 48px 32px 28px;
    z-index: 2;
    background: linear-gradient(to top, rgba(6, 6, 10, 0.85) 0%, transparent 100%);
  }

  .offer-detail-hero-overlay h1 {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: #fff;
    text-shadow: 0 2px 16px rgba(0,0,0,0.8), 0 0 40px rgba(0,0,0,0.5);
    margin-bottom: 8px;
  }

  .offer-detail-hero-overlay .hero-business-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--accent);
    text-shadow: 0 1px 8px rgba(0,0,0,0.4);
    transition: opacity 0.2s ease;
  }

  .offer-detail-hero-overlay .hero-business-link:hover {
    opacity: 0.8;
  }

  .offer-detail-hero-actions {
    position: absolute;
    top: 16px;
    right: 16px;
    display: flex;
    align-items: center;
    gap: 12px;
    z-index: 3;
  }

  .offer-detail-hero .offer-badge {
    position: relative;
    top: auto;
    right: auto;
    padding: 12px 24px;
    border-radius: var(--radius-sm);
    background: var(--accent);
    color: var(--bg-primary);
    font-weight: 700;
    font-size: 1.5rem;
    z-index: 2;
    box-shadow: 0 4px 16px rgba(251, 146, 60, 0.35);
  }

  .bookmark-btn {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    background: rgba(9, 9, 11, 0.6);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-primary);
    cursor: pointer;
    transition: all 0.3s var(--ease-smooth);
  }

  .bookmark-btn:hover {
    background: rgba(9, 9, 11, 0.8);
    border-color: rgba(255, 255, 255, 0.2);
    transform: scale(1.05);
  }

  .bookmark-btn.is-favorited {
    color: #ef4444;
  }

  .bookmark-btn .heart-outline,
  .bookmark-btn .heart-filled {
    display: none;
  }

  .bookmark-btn:not(.is-favorited) .heart-outline {
    display: block;
  }

  .bookmark-btn.is-favorited .heart-filled {
    display: block;
  }

  /* ─── CONTENT LAYOUT ──────────────────────────────────── */
  .offer-detail-content {
    max-width: 1200px;
    margin: 0 auto;
    padding: 48px var(--container-px) 80px;
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 48px;
    align-items: start;
  }

  /* ─── LEFT COLUMN ─────────────────────────────────────── */
  .offer-detail-main {}

  .offer-detail-badges {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }

  .offer-detail-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border-radius: var(--radius-full);
    background: var(--bg-card);
    border: 1px solid var(--border);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text-secondary);
  }

  .offer-detail-description {
    font-size: 1rem;
    line-height: 1.8;
    color: var(--text-secondary);
    white-space: pre-wrap;
    margin-bottom: 48px;
  }

  /* ─── COUNTDOWN ROW ───────────────────────────────────── */
  .offer-detail-countdown-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 12px 0 20px;
    padding: 10px 16px;
    border-radius: var(--radius-sm);
    background: rgba(251, 146, 60, 0.06);
    border: 1px solid rgba(251, 146, 60, 0.12);
  }

  .offer-detail-countdown-row svg {
    color: var(--accent);
    flex-shrink: 0;
  }

  .offer-detail-countdown-row .countdown-inline {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--accent);
  }

  .redemption-steps {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .redemption-step {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  .redemption-step svg {
    flex-shrink: 0;
  }

  /* ─── LOCATIONS ───────────────────────────────────────── */
  .offer-locations-grid {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .booking-card {
    padding: 20px 24px;
    border-radius: var(--radius-md);
    background: var(--bg-card);
    border: 1px solid var(--border);
    transition: border-color 0.3s ease;
  }

  .booking-card:hover {
    border-color: var(--border-hover);
  }

  .booking-card-address {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 0.9375rem;
    color: var(--text-primary);
    margin-bottom: 12px;
    line-height: 1.5;
  }

  .booking-card-address svg {
    flex-shrink: 0;
    margin-top: 3px;
    color: var(--accent);
  }

  .booking-card-phone {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin-bottom: 14px;
    transition: color 0.2s ease;
  }

  .booking-card-phone:hover {
    color: var(--accent);
  }

  .booking-card-phone svg {
    flex-shrink: 0;
    color: var(--text-tertiary);
  }

  .booking-card-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid var(--border);
  }

  .btn-booking {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    border-radius: var(--radius-sm);
    font-size: 0.875rem;
    font-weight: 600;
    transition: all 0.3s var(--ease-smooth);
  }

  .btn-booking-primary {
    background: linear-gradient(135deg, #f97316, #fb923c);
    color: var(--bg-primary);
    box-shadow: 0 2px 12px rgba(251, 146, 60, 0.25);
  }

  .btn-booking-primary:hover {
    box-shadow: 0 4px 24px rgba(251, 146, 60, 0.4);
    transform: translateY(-1px);
  }

  .btn-booking-whatsapp {
    background: rgba(37, 211, 102, 0.12);
    border: 1px solid rgba(37, 211, 102, 0.25);
    color: #25d366;
  }

  .btn-booking-whatsapp:hover {
    background: rgba(37, 211, 102, 0.2);
    transform: translateY(-1px);
  }

  .btn-booking-secondary {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--border);
    color: var(--text-primary);
  }

  .btn-booking-secondary:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: var(--border-hover);
    transform: translateY(-1px);
  }

  .booking-card-instructions {
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px solid var(--border);
    font-size: 0.8125rem;
    color: var(--text-tertiary);
    line-height: 1.6;
  }

  /* ─── RIGHT SIDEBAR ───────────────────────────────────── */
  .business-sidebar-card {
    position: sticky;
    top: 100px;
    padding: 32px 28px;
    border-radius: var(--radius-lg);
    background: var(--bg-card);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--border);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
    text-align: center;
  }

  .business-sidebar-logo {
    width: 80px;
    height: 80px;
    border-radius: var(--radius-md);
    margin: 0 auto 16px;
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--bg-surface);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .business-sidebar-logo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .business-sidebar-logo .logo-initial {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--accent);
  }

  .business-sidebar-name {
    font-size: 1.125rem;
    font-weight: 700;
    margin-bottom: 10px;
    color: var(--text-primary);
  }

  .business-sidebar-name a {
    transition: color 0.2s ease;
  }

  .business-sidebar-name a:hover {
    color: var(--accent);
  }

  .business-sidebar-rating {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    margin-bottom: 6px;
  }

  .business-sidebar-rating-count {
    font-size: 0.8125rem;
    color: var(--text-tertiary);
    margin-bottom: 16px;
  }

  .business-sidebar-meta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }

  .business-sidebar-meta .offer-detail-badge {
    font-size: 0.75rem;
    padding: 4px 12px;
  }

  .business-sidebar-cta {
    display: block;
    width: 100%;
    padding: 14px 20px;
    border-radius: var(--radius-sm);
    background: linear-gradient(135deg, rgba(255,255,255,0.08), rgba(255,255,255,0.04));
    border: 1px solid var(--border);
    color: var(--text-primary);
    font-weight: 600;
    font-size: 0.9375rem;
    text-align: center;
    transition: all 0.3s var(--ease-smooth);
  }

  .business-sidebar-cta:hover {
    background: rgba(251, 146, 60, 0.1);
    border-color: var(--accent);
    color: var(--accent);
    transform: translateY(-1px);
  }

  /* ─── RESPONSIVE ──────────────────────────────────────── */
  @media (max-width: 1024px) {
    .offer-detail-content {
      grid-template-columns: 1fr 320px;
      gap: 36px;
    }
  }

  @media (max-width: 768px) {
    .breadcrumb {
      padding-top: 88px;
    }

    .offer-detail-hero-inner {
      min-height: 280px;
      border-radius: var(--radius-lg);
    }

    .offer-detail-hero-overlay {
      padding: 20px;
    }

    .offer-detail-hero-overlay h1 {
      font-size: 1.5rem;
    }

    .offer-detail-content {
      grid-template-columns: 1fr;
      gap: 32px;
      padding-top: 28px;
      padding-bottom: 60px;
      padding-left: 20px;
      padding-right: 20px;
    }

    .business-sidebar-card {
      position: static;
    }

    .offer-detail-hero-actions {
      top: 12px;
      right: 12px;
      gap: 8px;
    }

    .offer-detail-hero .offer-badge {
      padding: 8px 16px;
      font-size: 1.125rem;
    }

    .bookmark-btn {
      width: 40px;
      height: 40px;
    }
  }

  @media (max-width: 480px) {
    .offer-detail-badges {
      gap: 6px;
    }

    .booking-card-actions {
      flex-direction: column;
    }

    .btn-booking {
      justify-content: center;
    }
  }

  /* ─── PROMO CODE REVEAL ─────────────────────────────── */
  .promo-code-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 16px 20px;
    border-radius: var(--radius-sm);
    background: rgba(255,255,255,0.04);
    border: 1px dashed rgba(255,255,255,0.1);
    min-height: 56px;
  }

  .promo-code-blur {
    font-family: 'Courier New', monospace;
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 4px;
    color: var(--text-tertiary);
    filter: blur(6px);
    user-select: none;
    transition: filter 0.4s ease;
  }

  .promo-code-blur.revealed {
    filter: blur(0);
    color: var(--accent);
    letter-spacing: 2px;
  }

  .promo-reveal-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    border-radius: var(--radius-sm);
    background: var(--accent);
    color: #000;
    font-weight: 600;
    font-size: 0.875rem;
    border: none;
    cursor: pointer;
    transition: all 0.3s var(--ease-smooth);
    white-space: nowrap;
  }

  .promo-reveal-btn:hover {
    background: #f59e0b;
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(251,146,60,0.3);
  }

  .promo-reveal-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
  }

  .promo-copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    border-radius: var(--radius-sm);
    background: rgba(255,255,255,0.08);
    border: 1px solid var(--border);
    color: var(--text-primary);
    font-size: 0.8125rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .promo-copy-btn:hover {
    background: rgba(255,255,255,0.12);
    border-color: var(--border-hover);
  }

  .promo-copy-btn.copied {
    background: rgba(34,197,94,0.15);
    border-color: rgba(34,197,94,0.3);
    color: #22c55e;
  }

  .promo-login-hint {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8125rem;
    color: var(--text-tertiary);
  }

  .promo-login-hint a {
    color: var(--accent);
    font-weight: 600;
    transition: color 0.2s ease;
  }

  .promo-login-hint a:hover {
    color: #f59e0b;
  }

  .promo-code-revealed-row {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  @media (max-width: 480px) {
    .promo-code-placeholder {
      flex-direction: column;
      gap: 12px;
    }

    .promo-code-revealed-row {
      flex-direction: column;
      align-items: stretch;
    }

    .promo-copy-btn {
      justify-content: center;
    }
  }
</style>

<%- include('partials/navbar', { activePage: activePage, webUser: webUser }) %>

<!-- ═══════════════════════════════════════════════════════
     BREADCRUMB
     ═══════════════════════════════════════════════════════ -->
<nav class="breadcrumb container">
  <a href="/">Acasa</a>
  <span class="breadcrumb-sep">/</span>
  <a href="/oferte">Oferte</a>
  <span class="breadcrumb-sep">/</span>
  <span class="breadcrumb-current"><%= offer.title %></span>
</nav>

<!-- ═══════════════════════════════════════════════════════
     HERO SECTION
     ═══════════════════════════════════════════════════════ -->
<section class="offer-detail-hero">
  <div class="offer-detail-hero-inner">
    <% if (offer.image_url) { %>
      <div class="offer-detail-hero-bg" style="background-image: url('<%= offer.image_url %>');"></div>
    <% } else { %>
      <div class="offer-detail-hero-bg" style="background: linear-gradient(135deg, rgba(251,146,60,0.15) 0%, var(--bg-surface) 100%);"></div>
    <% } %>
    <div class="offer-detail-hero-gradient"></div>

    <div class="offer-detail-hero-actions">
      <div class="offer-badge">
        <% if (offer.discount_type === 'percent' || offer.discount_type === 'percentage') { %>
          -<%= offer.discount_value %>%
        <% } else { %>
          -<%= offer.discount_value %> lei
        <% } %>
      </div>
      <button
        class="bookmark-btn<%= isFavorite ? ' is-favorited' : '' %>"
        data-offer-id="<%= offer.id %>"
        data-favorited="<%= isFavorite ? 'true' : 'false' %>"
        onclick="window.toggleFavorite(<%= offer.id %>)"
        aria-label="Adaugă la favorite"
      >
        <span class="heart-outline">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        </span>
        <span class="heart-filled">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        </span>
      </button>
      <button class="share-btn" data-share-title="<%= offer.title %>" data-share-biz="<%= offer.business.name %>" data-track-bid="<%= offer.business.id %>" data-track-oid="<%= offer.id %>" aria-label="Distribuie oferta">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
      </button>
    </div>

    <!-- Title + Business overlaid on hero -->
    <div class="offer-detail-hero-overlay">
      <h1><%= offer.title %></h1>
      <a href="/business/<%= offer.business.id %>" class="hero-business-link">
        <%= offer.business.name %>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17l9.2-9.2M17 17V7H7"/></svg>
      </a>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════
     CONTENT — Two Column Layout
     ═══════════════════════════════════════════════════════ -->
<div class="offer-detail-content container">

  <!-- ─── LEFT COLUMN (Main) ─────────────────────────── -->
  <div class="offer-detail-main">

    <% if (offer.is_trending || offer.save_count >= 3) { %>
      <div class="activity-pills">
        <% if (offer.is_trending) { %>
          <span class="activity-pill trending">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M13.5.67s.74 2.65.74 4.8c0 2.06-1.35 3.73-3.41 3.73-2.07 0-3.63-1.67-3.63-3.73l.03-.36C5.21 7.51 4 10.62 4 14c0 4.42 3.58 8 8 8s8-3.58 8-8C20 8.61 17.41 3.8 13.5.67zM11.71 19c-1.78 0-3.22-1.4-3.22-3.14 0-1.62 1.05-2.76 2.81-3.12 1.77-.36 3.6-1.21 4.62-2.58.39 1.29.59 2.65.59 4.04 0 2.65-2.15 4.8-4.8 4.8z"/></svg>
            Trending
          </span>
        <% } %>
        <% if (offer.save_count >= 3) { %>
          <span class="activity-pill saves">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
            <%= offer.save_count %> salvari
          </span>
        <% } %>
      </div>
    <% } %>

    <div class="offer-detail-badges">
      <% if (offer.business.category) { %>
        <span class="offer-detail-badge">
          <%= offer.business.category.name %>
        </span>
      <% } %>
      <% if (offer.business.city) { %>
        <span class="offer-detail-badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          <%= offer.business.city.name %>
        </span>
      <% } %>
    </div>

    <%
      const _startD = offer.start_date ? new Date(offer.start_date) : null;
      const _endD = offer.end_date ? new Date(offer.end_date) : null;
      const _dateOpts = { day: 'numeric', month: 'long', year: 'numeric' };
      const _validStart = _startD && _startD.getFullYear() > 2000;
      const _validEnd = _endD && _endD.getFullYear() > 2000;
    %>
    <% if (_validStart || _validEnd) { %>
    <div class="detail-card">
      <div class="detail-card-header">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        Perioadă
        <% if (_validEnd) { %>
          <% var _daysLeft = Math.ceil((new Date(offer.end_date) - new Date()) / 86400000); %>
          <% if (_daysLeft > 0) { %>
            <span class="detail-card-badge">Activă</span>
          <% } else { %>
            <span class="detail-card-badge" style="background: rgba(239,68,68,0.12); color: #ef4444; border-color: rgba(239,68,68,0.2);">Expirată</span>
          <% } %>
        <% } %>
      </div>
      <div style="font-size: 0.9375rem; color: var(--text-secondary);">
        <% if (_validStart && _validEnd) { %>
          <strong style="color: var(--text-primary);"><%= _startD.toLocaleDateString('ro-RO', _dateOpts) %></strong>
          —
          <strong style="color: var(--text-primary);"><%= _endD.toLocaleDateString('ro-RO', _dateOpts) %></strong>
        <% } else if (_validEnd) { %>
          Până la <strong style="color: var(--text-primary);"><%= _endD.toLocaleDateString('ro-RO', _dateOpts) %></strong>
        <% } else { %>
          Din <strong style="color: var(--text-primary);"><%= _startD.toLocaleDateString('ro-RO', _dateOpts) %></strong>
        <% } %>
      </div>
      <% if (_validStart && _validEnd) { %>
        <% var _totalDays = Math.ceil((_endD - _startD) / 86400000); var _elapsed = Math.ceil((new Date() - _startD) / 86400000); var _pct = Math.min(100, Math.max(0, Math.round((_elapsed / _totalDays) * 100))); %>
        <div class="detail-period-bar"><div class="detail-period-bar-fill" style="width: <%= _pct %>%;"></div></div>
        <% var _dLeft = Math.ceil((_endD - new Date()) / 86400000); %>
        <% if (_dLeft > 0) { %>
          <div class="detail-period-text">Expiră în <%= _dLeft %> zile</div>
        <% } %>
      <% } %>
    </div>
    <% } %>

    <% if (offer.end_date) {
      var _cdDiff = new Date(offer.end_date) - new Date();
      var _cdDays = Math.ceil(_cdDiff / 86400000);
      if (_cdDays > 0 && _cdDays <= 7) { %>
      <div class="offer-detail-countdown-row">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        <span class="countdown-inline" data-end-date="<%= new Date(offer.end_date).toISOString() %>"></span>
      </div>
    <% } } %>

    <%
      // Determine which booking type to show in redemption instructions
      var hasPhoneBooking = false;
      var hasWhatsappBooking = false;
      var hasUrlBooking = false;
      if (offer.locations && offer.locations.length > 0) {
        hasPhoneBooking = offer.locations.some(loc => loc.booking_type === 'phone' && loc.booking_phone);
        hasWhatsappBooking = offer.locations.some(loc => loc.booking_type === 'whatsapp' && loc.booking_whatsapp);
        hasUrlBooking = offer.locations.some(loc => loc.booking_type === 'url' && loc.booking_url);
      }
    %>
    <div class="detail-card">
      <div class="detail-card-header">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        Cum profiți de ofertă?
      </div>
      <div class="redemption-steps">
        <% if (hasPhoneBooking) { %>
          <div class="redemption-step">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <span>Sună și menționează OFAI la rezervare</span>
          </div>
        <% } else if (hasWhatsappBooking) { %>
          <div class="redemption-step">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="#25d366"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            <span>Scrie pe WhatsApp și menționează OFAI</span>
          </div>
        <% } else if (hasUrlBooking) { %>
          <div class="redemption-step">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            <span>Rezervă online prin link-ul de rezervare</span>
          </div>
        <% } else if (offer.business.category && offer.business.category.name === 'Magazine Online') { %>
          <div class="redemption-step">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
            <span>Accesează site-ul și aplică codul sau menționează oferta la checkout</span>
          </div>
        <% } else { %>
          <div class="redemption-step">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
            <span>Arată această pagină la casă pentru a beneficia de reducere</span>
          </div>
        <% } %>
      </div>
    </div>

    <% if (offer.has_promo_code) { %>
      <div class="detail-card detail-card-promo" id="promo-code-section">
        <div class="detail-card-header">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
          Cod promoțional
          <span class="detail-card-badge detail-card-badge-exclusive">EXCLUSIV</span>
        </div>

        <% if (!webUser) { %>
          <div class="promo-code-placeholder">
            <span class="promo-code-blur">XXXXXXXX</span>
          </div>
          <div style="text-align: center; margin-top: 12px;">
            <div class="promo-login-hint">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              <a href="/login?returnTo=/oferta/<%= offer.id %>">Conectează-te</a> sau <a href="/register?returnTo=/oferta/<%= offer.id %>">creează cont gratuit</a>
            </div>
          </div>
        <% } else { %>
          <% var codesExhausted = offer.max_reveals && (parseInt(offer.max_reveals) - parseInt(offer.reveal_count || 0)) <= 0; %>
          <div class="promo-code-placeholder" id="promo-code-container">
            <span class="promo-code-blur" id="promo-code-text">XXXXXXXX</span>
            <% if (codesExhausted) { %>
              <button class="promo-reveal-btn" disabled style="opacity: 0.5; cursor: not-allowed;">Coduri epuizate</button>
            <% } else { %>
              <button class="promo-reveal-btn" id="promo-reveal-btn" onclick="revealPromoCode(<%= offer.id %>)">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                Dezvăluie codul promo
              </button>
            <% } %>
          </div>
          <% if (offer.max_reveals) { %>
            <% var remaining = Math.max(0, parseInt(offer.max_reveals) - parseInt(offer.reveal_count || 0)); var pctUsed = Math.round((parseInt(offer.reveal_count || 0) / parseInt(offer.max_reveals)) * 100); %>
            <div class="detail-scarcity-bar"><div class="detail-scarcity-bar-fill" style="width: <%= pctUsed %>%;"></div></div>
            <div class="detail-scarcity-text">
              <% if (remaining === 0) { %>
                Codurile s-au epuizat
              <% } else { %>
                doar <%= remaining %> coduri rămase din <%= offer.max_reveals %>
              <% } %>
            </div>
          <% } %>
        <% } %>
      </div>
    <% } %>

    <% if (offer.description) { %>
      <div class="detail-card">
        <div class="detail-card-header">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6"/><path d="M16 13H8"/><path d="M16 17H8"/><path d="M10 9H8"/></svg>
          Descriere
        </div>
        <p style="font-size: 0.9375rem; line-height: 1.8; color: var(--text-secondary); white-space: pre-wrap; margin: 0;"><%= offer.description %></p>
      </div>
    <% } %>

    <% if (offer.conditions) { %>
      <div class="detail-card">
        <div class="detail-card-header">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          Condiții
        </div>
        <p style="font-size: 0.9375rem; line-height: 1.7; color: var(--text-secondary); white-space: pre-wrap;"><%= offer.conditions %></p>
      </div>
    <% } %>

    <% if (offer.locations && offer.locations.length > 0) { %>
      <div class="detail-card">
        <div class="detail-card-header">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          Locații (<%= offer.locations.length %>)
        </div>
        <div class="offer-locations-grid">
          <% offer.locations.forEach(function(loc) { %>
            <div class="booking-card">
              <div class="booking-card-address">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                <span><%= loc.address %><% if (loc.cityName) { %>, <%= loc.cityName %><% } %></span>
              </div>

              <% if (loc.phone) { %>
                <a href="tel:<%= loc.phone %>" class="booking-card-phone" onclick="trackClick(<%= offer.business.id %>,'phone',<%= offer.id %>)">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                  <%= loc.phone %>
                </a>
              <% } %>

              <div class="booking-card-actions">
                <% if (loc.lat && loc.lng) { %>
                  <a href="https://www.google.com/maps/dir/?api=1&destination=<%= loc.lat %>,<%= loc.lng %>" target="_blank" rel="noopener noreferrer" class="btn-booking btn-booking-primary" onclick="trackClick(<%= offer.business.id %>,'navigate',<%= offer.id %>)">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="3 11 22 2 13 21 11 13 3 11"/></svg>
                    Navigheaz&#259;
                  </a>
                <% } %>
                <% if (loc.booking_type === 'phone' && loc.booking_phone) { %>
                  <a href="tel:<%= loc.booking_phone %>" class="btn-booking btn-booking-secondary" onclick="trackClick(<%= offer.business.id %>,'phone',<%= offer.id %>)">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                    Rezerv&#259;: <%= loc.booking_phone %>
                  </a>
                <% } else if (loc.booking_type === 'whatsapp' && loc.booking_whatsapp) { %>
                  <a href="https://wa.me/<%= loc.booking_whatsapp.replace(/[^0-9]/g, '') %>" target="_blank" rel="noopener noreferrer" class="btn-booking btn-booking-whatsapp" onclick="trackClick(<%= offer.business.id %>,'whatsapp',<%= offer.id %>)">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/></svg>
                    Rezerv&#259; pe WhatsApp
                  </a>
                <% } else if (loc.booking_type === 'url' && loc.booking_url) { %>
                  <a href="<%= loc.booking_url %>" target="_blank" rel="noopener noreferrer" class="btn-booking btn-booking-secondary" onclick="trackClick(<%= offer.business.id %>,'booking_url',<%= offer.id %>)">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" x2="21" y1="14" y2="3"/></svg>
                    Rezerv&#259; online
                  </a>
                <% } %>
              </div>
              <% if (loc.booking_instructions) { %>
                <div class="booking-card-instructions"><%= loc.booking_instructions %></div>
              <% } %>
            </div>
          <% }); %>
        </div>
      </div>
    <% } %>
  </div>

  <!-- ─── RIGHT COLUMN (Sidebar) ─────────────────────── -->
  <aside>
    <div class="business-sidebar-card">
      <div class="business-sidebar-logo">
        <% if (offer.business.logo_url) { %>
          <img src="<%= offer.business.logo_url %>" alt="<%= offer.business.name %>" loading="lazy" width="80" height="80">
        <% } else { %>
          <span class="logo-initial"><%= offer.business.name.charAt(0).toUpperCase() %></span>
        <% } %>
      </div>

      <div class="business-sidebar-name">
        <a href="/business/<%= offer.business.id %>"><%= offer.business.name %></a>
      </div>

      <div class="business-sidebar-rating">
        <% var rating = offer.business.rating || 0; %>
        <% for (var i = 1; i <= 5; i++) { %>
          <% if (i <= Math.round(rating)) { %>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="#fb923c" stroke="#fb923c" stroke-width="1"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          <% } else { %>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#71717a" stroke-width="1"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          <% } %>
        <% } %>
        <% if (rating > 0) { %>
          <span style="font-size: 0.875rem; font-weight: 600; color: var(--accent); margin-left: 4px;"><%= Number(rating).toFixed(1) %></span>
        <% } %>
      </div>

      <div class="business-sidebar-rating-count">
        <% if (offer.business.rating_count && offer.business.rating_count > 0) { %>
          <%= offer.business.rating_count %> recenzi<%= offer.business.rating_count === 1 ? 'e' : 'i' %>
        <% } else { %>
          Nicio recenzie
        <% } %>
      </div>

      <div class="business-sidebar-meta">
        <% if (offer.business.category) { %>
          <span class="offer-detail-badge"><%= offer.business.category.name %></span>
        <% } %>
        <% if (offer.business.city) { %>
          <span class="offer-detail-badge">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <%= offer.business.city.name %>
          </span>
        <% } %>
      </div>

      <a href="/business/<%= offer.business.id %>" class="business-sidebar-cta">
        Vezi business-ul
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: inline; vertical-align: middle; margin-left: 4px;"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>
  </aside>

  <% if (typeof similarOffers !== 'undefined' && similarOffers && similarOffers.length > 0) { %>
    <section class="similar-offers-section" style="grid-column: 1 / -1;">
      <h3>Oferte similare</h3>
      <div class="similar-offers-grid">
        <% similarOffers.forEach(function(so) { %>
          <a href="/oferta/<%= so.id %>" class="offer-card offer-card-compact">
            <div class="offer-image-wrapper">
              <img src="<%= so.image_url || '/images/placeholder.jpg' %>" alt="<%= so.title %>" class="offer-image" loading="lazy" width="400" height="225">
              <% if (so.discount_value) { %>
                <div class="offer-badge">
                  <%= so.discount_type === 'percentage' || so.discount_type === 'percent' ? '-' + so.discount_value + '%' : so.discount_value + ' lei' %>
                </div>
              <% } %>
              <div class="card-heart-btn<%= (userFavoriteIds || []).includes(so.id) ? ' is-active' : '' %>" data-offer-id="<%= so.id %>" data-favorited="<%= (userFavoriteIds || []).includes(so.id) ? 'true' : 'false' %>" onclick="window.toggleCardFavorite(<%= so.id %>, event)" role="button" tabindex="0" aria-label="Favorite"><svg class="heart-outline" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg><svg class="heart-filled" width="18" height="18" viewBox="0 0 24 24" fill="#ef4444" stroke="#ef4444" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg></div>
            </div>
            <div class="offer-content">
              <div class="offer-title"><%= so.title %></div>
              <div class="offer-business"><%= so.business_name %></div>
              <% if (so.city_name) { %>
                <div class="offer-meta">
                  <span class="offer-meta-item">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                    <%= so.city_name %>
                  </span>
                </div>
              <% } %>
            </div>
          </a>
        <% }); %>
      </div>
    </section>
  <% } %>
</div>

<% if (offer.has_promo_code && webUser) { %>
<script>
  // Share button (safe — uses dataset instead of inline JS)
  (function() {
    var btn = document.querySelector('.share-btn[data-share-title]');
    if (btn) {
      btn.addEventListener('click', function() {
        var title = this.dataset.shareTitle;
        var biz = this.dataset.shareBiz;
        var bid = parseInt(this.dataset.trackBid);
        var oid = parseInt(this.dataset.trackOid);
        trackClick(bid, 'share', oid);
        window.shareOffer(title, biz);
      });
    }
  })();

  async function revealPromoCode(offerId) {
    const btn = document.getElementById('promo-reveal-btn');
    const codeText = document.getElementById('promo-code-text');
    const container = document.getElementById('promo-code-container');

    if (!btn || !codeText) return;

    // Disable button and show loading
    btn.disabled = true;
    btn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="spin"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg> Se incarca...';

    try {
      const csrfToken = document.querySelector('meta[name="csrf-token"]');
      const resp = await fetch('/api/web/offers/' + offerId + '/reveal-code', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': csrfToken ? csrfToken.getAttribute('content') : ''
        },
        credentials: 'same-origin'
      });

      if (!resp.ok) {
        const data = await resp.json().catch(() => ({}));
        throw new Error(data.message || 'Eroare la dezvaluirea codului');
      }

      const data = await resp.json();

      if (data.promo_code) {
        // Show revealed code
        codeText.textContent = data.promo_code;
        codeText.classList.add('revealed');

        // Replace button with copy button (use textContent to prevent XSS)
        container.innerHTML =
          '<div class="promo-code-revealed-row">' +
            '<span class="promo-code-blur revealed" id="promo-code-value"></span>' +
            '<button class="promo-copy-btn" id="promo-copy-btn" onclick="copyPromoCode()">' +
              '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>' +
              'Copiaza codul' +
            '</button>' +
          '</div>';
        document.getElementById('promo-code-value').textContent = data.promo_code;
      }
    } catch (err) {
      btn.disabled = false;
      btn.innerHTML =
        '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>' +
        ' Dezvăluie codul';
      alert(err.message || 'Eroare la dezvăluirea codului');
    }
  }

  function copyPromoCode() {
    var codeEl = document.getElementById('promo-code-value');
    var copyBtn = document.getElementById('promo-copy-btn');
    if (!codeEl || !copyBtn) return;

    var code = codeEl.textContent;

    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(code).then(function() {
        showCopied(copyBtn);
        // Track copy code action
        if (window.trackClick) {
          trackClick(<%= offer.business.id %>, 'copy_code', <%= offer.id %>);
        }
      }).catch(function() {
        fallbackCopy(code, copyBtn);
      });
    } else {
      fallbackCopy(code, copyBtn);
    }
  }

  function fallbackCopy(text, btn) {
    var ta = document.createElement('textarea');
    ta.value = text;
    ta.style.position = 'fixed';
    ta.style.opacity = '0';
    document.body.appendChild(ta);
    ta.select();
    try {
      document.execCommand('copy');
      showCopied(btn);
      // Track copy code action
      if (window.trackClick) {
        trackClick(<%= offer.business.id %>, 'copy_code', <%= offer.id %>);
      }
    } catch(e) {}
    document.body.removeChild(ta);
  }

  function showCopied(btn) {
    btn.classList.add('copied');
    btn.innerHTML =
      '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>' +
      ' Copiat!';
    setTimeout(function() {
      btn.classList.remove('copied');
      btn.innerHTML =
        '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>' +
        ' Copiaza codul';
    }, 2000);
  }
</script>
<style>
  @keyframes spin { to { transform: rotate(360deg); } }
  .spin { animation: spin 1s linear infinite; }
</style>
<% } %>

<%- include('partials/footer') %>
