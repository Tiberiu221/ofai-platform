          <%= t('footer.brandDesc') %>
        </p>
      </div>
      <div>
        <h4 class="footer-col-title"><%= t('footer.platform') %></h4>
        <div class="footer-links">
          <a href="/oferte" class="footer-link"><%= t('nav.offers') %></a>
          <a href="/business-uri" class="footer-link"><%= t('nav.businesses') %></a>
          <a href="/categorii" class="footer-link"><%= t('nav.categories') %></a>
          <a href="/orase" class="footer-link"><%= t('nav.cities') %></a>
          <a href="/blog" class="footer-link"><%= t('footer.blog') %></a>
        </div>
      </div>
      <div>
        <h4 class="footer-col-title"><%= t('footer.business') %></h4>
        <div class="footer-links">
          <a href="/pentru-business" class="footer-link"><%= t('footer.addBusiness') %></a>
          <a href="/ajutor" class="footer-link"><%= t('footer.helpSupport') %></a>
        </div>
      </div>
      <div>
        <h4 class="footer-col-title"><%= t('footer.legal') %></h4>
        <div class="footer-links">
          <a href="/termeni" class="footer-link"><%= t('footer.terms') %></a>
          <a href="/confidentialitate" class="footer-link"><%= t('footer.privacy') %></a>
