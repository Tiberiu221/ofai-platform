<!-- Toast container -->
<div id="toast-container"></div>

<!-- Cookie Consent Banner -->
<div id="cookie-banner" style="display:none; position:fixed; bottom:0; left:0; right:0; z-index:9999; background:rgba(9,9,11,0.95); border-top:1px solid rgba(255,255,255,0.08); backdrop-filter:blur(12px); -webkit-backdrop-filter:blur(12px); padding:16px 24px;">
  <div style="max-width:1200px; margin:0 auto; display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap;">
    <p style="margin:0; font-size:13px; color:#a1a1aa; line-height:1.5;">
      Folosim cookie-uri esen&#539;iale pentru func&#539;ionarea site-ului.
      <a href="/confidentialitate" style="color:#fb923c; text-decoration:none;">Politic&#259; de Confiden&#539;ialitate</a>
    </p>
    <button onclick="acceptCookies()" style="padding:8px 20px; background:#fb923c; color:#09090b; border:none; border-radius:8px; font-size:13px; font-weight:600; cursor:pointer; white-space:nowrap;">Accept</button>
  </div>
</div>
<script nonce="<%= cspNonce %>">
(function() {
  if (!localStorage.getItem('cookie_consent')) {
    var b = document.getElementById('cookie-banner');
    if (b) b.style.display = 'block';
  }
})();
function acceptCookies() {
  localStorage.setItem('cookie_consent', '1');
  var b = document.getElementById('cookie-banner');
  if (b) b.style.display = 'none';
}

// Click tracking helper (internal analytics + GA4)
window.trackClick = function(businessId, actionType, offerId) {
  var csrfMeta = document.querySelector('meta[name="csrf-token"]');
  var headers = { 'Content-Type': 'application/json' };
  if (csrfMeta && csrfMeta.content) headers['X-CSRF-Token'] = csrfMeta.content;
  fetch('/api/web/clicks', {
    method: 'POST',
    headers: headers,
    credentials: 'same-origin',
    body: JSON.stringify({ business_id: businessId, offer_id: offerId || null, action_type: actionType })
  }).catch(function() {});
  // GA4 event mirror
  if (typeof gaEvent === 'function') {
    gaEvent('business_action', { action_type: actionType, business_id: businessId, offer_id: offerId || null });
  }
};
</script>

<!-- Lenis Smooth Scroll -->
<script src="https://cdn.jsdelivr.net/npm/lenis@1/dist/lenis.min.js"></script>

<!-- JavaScript -->
<script src="/js/main.js?v=<%= typeof cacheBust !== 'undefined' ? cacheBust : '8' %>"></script>
</body>
</html>
