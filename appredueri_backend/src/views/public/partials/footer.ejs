    </div>
    <div class="footer-bottom">
      <span><%= t('footer.copyright', { year: new Date().getFullYear() }) %></span>
    </div>
  </div>
</footer>

<!-- Toast container -->
<div id="toast-container"></div>

<!-- Cookie Consent Banner -->
<div id="cookie-banner" style="display:none; position:fixed; bottom:0; left:0; right:0; z-index:9999; background:rgba(9,9,11,0.95); border-top:1px solid rgba(255,255,255,0.08); backdrop-filter:blur(12px); -webkit-backdrop-filter:blur(12px); padding:16px 24px;">
  <div style="max-width:1200px; margin:0 auto; display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap;">
    <p style="margin:0; font-size:13px; color:#a1a1aa; line-height:1.5;">
      <%= t('cookie.message') %>
      <a href="/confidentialitate" style="color:#fb923c; text-decoration:none;"><%= t('cookie.privacyLink') %></a>
    </p>
    <div style="display:flex; gap:8px; flex-shrink:0;">
      <button onclick="rejectCookies()" style="padding:8px 16px; background:transparent; color:#a1a1aa; border:1px solid rgba(255,255,255,0.12); border-radius:8px; font-size:13px; cursor:pointer; white-space:nowrap;"><%= t('cookie.reject') %></button>
      <button onclick="acceptCookies()" style="padding:8px 20px; background:#fb923c; color:#09090b; border:none; border-radius:8px; font-size:13px; font-weight:600; cursor:pointer; white-space:nowrap;"><%= t('cookie.accept') %></button>
    </div>
  </div>
</div>
<script nonce="<%= cspNonce %>">
(function() {
  var _cc = localStorage.getItem('cookie_consent');
  if (!_cc || (_cc !== 'accepted' && _cc !== 'rejected')) {
    var b = document.getElementById('cookie-banner');
    if (b) b.style.display = 'block';
  }
})();
function acceptCookies() {
  localStorage.setItem('cookie_consent', 'accepted');
  var b = document.getElementById('cookie-banner');
  if (b) b.style.display = 'none';
}
function rejectCookies() {
  localStorage.setItem('cookie_consent', 'rejected');
  var b = document.getElementById('cookie-banner');
  if (b) b.style.display = 'none';
  // Disable GA4 if loaded
  if (window.gtag) window['ga-disable-' + (document.querySelector('script[src*="gtag"]')?.src?.match(/id=([^&]+)/)?.[1] || '')] = true;
}

// Click tracking helper (internal analytics + GA4)
window.trackClick = function(businessId, actionType, offerId) {
  var csrfMeta = document.querySelector('meta[name="csrf-token"]');
  var headers = { 'Content-Type': 'application/json' };
  if (csrfMeta && csrfMeta.content) headers['X-CSRF-Token'] = csrfMeta.content;
  fetch('/api/web/clicks', {
    method: 'POST',
    headers: headers,
    credentials: 'same-origin',
    body: JSON.stringify({ business_id: businessId, offer_id: offerId || null, action_type: actionType })
  }).catch(function() {});
  // GA4 event mirror
  if (typeof gaEvent === 'function') {
    gaEvent('business_action', { action_type: actionType, business_id: businessId, offer_id: offerId || null });
  }
};
</script>

<!-- Lenis Smooth Scroll -->
<script src="https://cdn.jsdelivr.net/npm/lenis@1/dist/lenis.min.js"></script>

<!-- JavaScript -->
<script src="/js/main.js?v=<%= typeof cacheBust !== 'undefined' ? cacheBust : '8' %>"></script>

<!-- Service Worker -->
<script nonce="<%= cspNonce %>">
if ('serviceWorker' in navigator) {
  navigator.serviceWorker.register('/sw.js?v=<%= typeof cacheBust !== "undefined" ? cacheBust : "" %>').catch(function() {});
}
</script>
</body>
</html>
