<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle + ' — OFAI' : 'OFAI — Reduceri & Oferte din România' %></title>
  <meta name="description" content="<%= typeof pageDesc !== 'undefined' ? pageDesc : 'Descoperă cele mai bune reduceri și oferte de la business-urile din orașul tău. Restaurante, beauty, fitness și multe altele.' %>">

  <!-- Favicon (OFAI wordmark on dark background) -->
  <link rel="icon" type="image/png" href="/images/ofai-favicon.png">

  <!-- PWA -->
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#6C5CE7">
  <link rel="apple-touch-icon" href="/images/ofai-icon-192.png">

  <!-- Font preloading -->
  <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <!-- CSRF Token -->
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

  <!-- CSS -->
  <link rel="stylesheet" href="/css/main.css?v=<%= typeof cacheBust !== 'undefined' ? cacheBust : '7' %>">

  <!-- Open Graph -->
  <meta property="og:title" content="<%= typeof ogTitle !== 'undefined' && ogTitle ? ogTitle : 'OFAI — Reduceri & Oferte din România' %>">
  <meta property="og:description" content="<%= typeof ogDesc !== 'undefined' && ogDesc ? ogDesc : 'Descoperă cele mai bune reduceri de la business-urile din orașul tău.' %>">
  <meta property="og:type" content="<%= typeof ogType !== 'undefined' && ogType ? ogType : 'website' %>">
  <meta property="og:url" content="<%= typeof ogUrl !== 'undefined' && ogUrl ? ogUrl : 'https://ofai.ro' %>">
  <% if (typeof ogImage !== 'undefined' && ogImage) { %>
  <meta property="og:image" content="<%= ogImage %>">
  <% } else { %>
  <meta property="og:image" content="https://ofai.ro/images/og-default.svg">
  <% } %>
  <meta property="og:locale" content="ro_RO">
  <meta property="og:site_name" content="OFAI">

  <!-- Canonical URL -->
  <% if (typeof canonicalUrl !== 'undefined' && canonicalUrl) { %>
  <link rel="canonical" href="<%= canonicalUrl %>">
  <% } %>

  <!-- Pagination SEO -->
  <% if (typeof seoPage !== 'undefined' && typeof seoTotalPages !== 'undefined' && typeof seoBaseUrl !== 'undefined') { %>
    <% var _sep = seoBaseUrl.includes('?') ? '&' : '?'; %>
    <% if (seoPage > 1) { %><link rel="prev" href="<%= seoBaseUrl %><%= seoPage === 2 ? '' : _sep + 'page=' + (seoPage - 1) %>"><% } %>
    <% if (seoPage < seoTotalPages) { %><link rel="next" href="<%= seoBaseUrl %><%= _sep %>page=<%= seoPage + 1 %>"><% } %>
  <% } %>

  <!-- Noindex for filtered/auth pages -->
  <% if (typeof noIndex !== 'undefined' && noIndex) { %>
  <meta name="robots" content="noindex, follow">
  <% } %>

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= typeof ogTitle !== 'undefined' && ogTitle ? ogTitle : 'OFAI — Reduceri & Oferte din România' %>">
  <meta name="twitter:description" content="<%= typeof ogDesc !== 'undefined' && ogDesc ? ogDesc : 'Descoperă cele mai bune reduceri de la business-urile din orașul tău.' %>">
  <meta name="twitter:image" content="<%= typeof ogImage !== 'undefined' && ogImage ? ogImage : 'https://ofai.ro/images/og-default.svg' %>">

  <!-- Structured Data (JSON-LD) -->
  <% if (typeof structuredData !== 'undefined' && structuredData) { %>
    <% if (Array.isArray(structuredData)) { %>
      <% structuredData.forEach(function(sd) { %>
  <script type="application/ld+json"><%- JSON.stringify(sd).replace(/</g, '\\u003c').replace(/>/g, '\\u003e') %></script>
      <% }); %>
    <% } else { %>
  <script type="application/ld+json"><%- JSON.stringify(structuredData).replace(/</g, '\\u003c').replace(/>/g, '\\u003e') %></script>
    <% } %>
  <% } %>
  <% if (typeof loadChartJs !== 'undefined' && loadChartJs) { %>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
  <% } %>
  <% if (typeof loadOnboardingCss !== 'undefined' && loadOnboardingCss) { %>
  <link rel="stylesheet" href="/css/onboarding.css?v=<%= typeof cacheBust !== 'undefined' ? cacheBust : '1' %>">
  <% } %>
  <% if (typeof loadPortalCss !== 'undefined' && loadPortalCss) { %>
  <link rel="stylesheet" href="/css/portal.css?v=<%= typeof cacheBust !== 'undefined' ? cacheBust : '1' %>">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/cropperjs@1/dist/cropper.min.css">
  <script src="https://cdn.jsdelivr.net/npm/cropperjs@1/dist/cropper.min.js" defer></script>
  <% } %>
  <% if (typeof loadBlogCss !== 'undefined' && loadBlogCss) { %>
  <link rel="stylesheet" href="/css/blog.css?v=<%= typeof cacheBust !== 'undefined' ? cacheBust : '1' %>">
  <% } %>
  <!-- Google Analytics 4 -->
  <% if (typeof gaMeasurementId !== 'undefined' && gaMeasurementId) { %>
  <script async src="https://www.googletagmanager.com/gtag/js?id=<%= gaMeasurementId %>" nonce="<%= cspNonce %>"></script>
  <script nonce="<%= cspNonce %>">
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', '<%= gaMeasurementId %>', {
      page_title: document.title,
      send_page_view: true
    });
  </script>
  <% } %>
</head>
<body>
