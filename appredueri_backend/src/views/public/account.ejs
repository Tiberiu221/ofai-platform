<%- include('partials/head', { pageTitle: t('account.pageTitle'), activePage: 'cont' }) %>
<%- include('partials/navbar', { activePage: 'cont', webUser: webUser }) %>

<section class="page-header" style="padding-bottom: 24px;">
  <div class="page-header-glow"></div>
  <div class="container">
    <h1 class="page-title text-gradient"><%= t('account.pageTitle') %></h1>
  </div>
</section>

<section class="section" style="padding-top: 0;">
  <div class="container" style="max-width: 640px;">

    <!-- Profile Header -->
    <div class="account-profile-card reveal">
      <div style="display: flex; flex-direction: column; align-items: center; gap: 6px;">
        <div class="profile-upload-wrapper">
          <div class="account-avatar" id="profile-avatar">
            <% if (webUser.profile_picture_url) { %>
              <img src="<%= webUser.profile_picture_url %>" alt="" width="80" height="80" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;">
            <% } else { %>
              <%= webUser.first_name ? webUser.first_name.charAt(0).toUpperCase() : 'U' %>
            <% } %>
          </div>
          <button type="button" class="profile-upload-btn" onclick="document.getElementById('profile-pic-input').click()" title="<%= t('account.changeProfilePic') %>">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
          </button>
          <input type="file" id="profile-pic-input" accept="image/jpeg,image/png,image/webp" style="display: none;" onchange="uploadProfilePicture(this)">
        </div>
        <% if (webUser.profile_picture_url) { %>
          <button type="button" class="btn-text-danger" onclick="deleteProfilePicture()" style="font-size: 0.75rem; margin-top: 4px;"><%= t('account.deletePhoto') %></button>
        <% } %>
      </div>
      <div class="account-info">
        <div id="profile-view">
          <h2 class="account-name"><%= webUser.first_name || '' %> <%= webUser.last_name || '' %></h2>
          <p class="account-email"><%= webUser.email %></p>
          <button class="btn btn-ghost" onclick="showProfileEditForm()" style="margin-top: 8px; padding: 6px 12px; font-size: 0.875rem;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 4px;"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            <%= t('account.editProfile') %>
          </button>
          <% if (typeof lastProfileEdit !== 'undefined' && lastProfileEdit) { %>
            <%
              const lastEdit = new Date(lastProfileEdit);
              const now = new Date();
              const daysSince = Math.floor((now - lastEdit) / (1000 * 60 * 60 * 24));
              const daysLeft = 30 - daysSince;
            %>
            <% if (daysLeft > 0) { %>
              <p style="font-size: 0.8125rem; color: var(--text-muted); margin-top: 8px;">
                Poți edita din nou de pe <%= new Date(lastEdit.getTime() + 30 * 24 * 60 * 60 * 1000).toLocaleDateString('ro-RO') %>
              </p>
            <% } %>
          <% } %>
        </div>
        <form id="profile-edit-form" style="display: none;">
          <div style="margin-bottom: 12px;">
            <label style="display: block; font-size: 0.875rem; color: var(--text-secondary); margin-bottom: 6px;"><%= t('account.firstName') %></label>
            <input type="text" id="edit-first-name" value="<%= webUser.first_name || '' %>" style="width: 100%; padding: 10px 14px; background: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius-sm); color: var(--text-primary); font-size: 0.9375rem; font-family: inherit;">
          </div>
          <div style="margin-bottom: 16px;">
            <label style="display: block; font-size: 0.875rem; color: var(--text-secondary); margin-bottom: 6px;"><%= t('account.lastName') %></label>
            <input type="text" id="edit-last-name" value="<%= webUser.last_name || '' %>" style="width: 100%; padding: 10px 14px; background: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius-sm); color: var(--text-primary); font-size: 0.9375rem; font-family: inherit;">
          </div>
          <div style="display: flex; gap: 8px;">
            <button type="submit" class="btn btn-primary" style="flex: 1;"><%= t('account.save') %></button>
            <button type="button" class="btn btn-ghost" onclick="hideProfileEditForm()"><%= t('account.cancel') %></button>
          </div>
        </form>
      </div>
    </div>

    <!-- Menu Items -->
    <% const br = typeof bizRequest !== 'undefined' ? bizRequest : null; %>
    <div class="account-menu reveal">
      <% if (br && br.status === 'pending') { %>
      <a href="/pentru-business#adauga-business" class="account-menu-item">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fbbf24" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        <span><%= br.name %> — <%= t('account.inReview') %></span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
      </a>
      <% } else if (typeof hasBusinesses !== 'undefined' && hasBusinesses) { %>
      <a href="/portal" class="account-menu-item account-portal-link">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fb923c" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8"/><path d="M12 17v4"/></svg>
        <span><%= t('account.goToPortal') %></span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
      </a>
      <% } else if (br && br.status === 'approved') { %>
      <a href="/portal" class="account-menu-item account-portal-link">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        <span><%= br.name %> — <%= t('account.onPlatform') %></span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
      </a>
      <% } else if (br && br.status === 'rejected') { %>
      <a href="/pentru-business#adauga-business" class="account-menu-item">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
        <span><%= br.name %> — <%= t('account.correctAndResend') %></span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
      </a>
      <% } else { %>
      <a href="/pentru-business" class="account-menu-item">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fb923c" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
        <span><%= t('account.addBusinessFree') %></span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
      </a>
      <% } %>
      <a href="/colectia-mea" class="account-menu-item">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
        <span><%= t('account.myCollection') %></span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
      </a>
      <a href="/preferinte" class="account-menu-item">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        <span><%= t('account.preferences') %></span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
      </a>
      <a href="/setari" class="account-menu-item">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        <span><%= t('account.settings') %></span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
      </a>
      <a href="/ajutor" class="account-menu-item">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        <span><%= t('account.helpSupport') %></span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
      </a>
      <a href="/termeni" class="account-menu-item">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        <span><%= t('account.termsConditions') %></span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
      </a>
    </div>

    <!-- Logout -->
    <a href="/logout" class="btn btn-secondary" style="width: 100%; margin-top: 24px;"><%= t('account.logout') %></a>

    <p style="text-align: center; margin-top: 32px; color: var(--text-muted); font-size: 0.8125rem;">OFAI v1.0.0</p>

  </div>
</section>

<script nonce="<%= cspNonce %>">
  var i18n = {
    profileUpdated: '<%= t("account.profileUpdated") %>',
    profileUpdateError: '<%= t("account.profileUpdateError") %>',
    connectionError: '<%= t("account.connectionError") %>',
    photoUpdated: '<%= t("account.photoUpdated") %>',
    photoDeleted: '<%= t("account.photoDeleted") %>',
    imageTooLarge: '<%= t("account.imageTooLarge") %>',
    uploadError: '<%= t("account.uploadError") %>',
    confirmDeletePhoto: '<%= t("account.confirmDeletePhoto") %>',
    error: '<%= t("account.error") %>'
  };
  function showProfileEditForm() {
    document.getElementById('profile-view').style.display = 'none';
    document.getElementById('profile-edit-form').style.display = 'block';
  }

  function hideProfileEditForm() {
    document.getElementById('profile-view').style.display = 'block';
    document.getElementById('profile-edit-form').style.display = 'none';
  }

  document.getElementById('profile-edit-form').addEventListener('submit', async function(e) {
    e.preventDefault();
    const firstName = document.getElementById('edit-first-name').value.trim();
    const lastName = document.getElementById('edit-last-name').value.trim();

    try {
      const csrfToken = document.querySelector('meta[name="csrf-token"]');
      const res = await fetch('/api/web/profile', {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': csrfToken ? csrfToken.getAttribute('content') : ''
        },
        body: JSON.stringify({ first_name: firstName, last_name: lastName })
      });

      const data = await res.json();

      if (res.ok) {
        if (typeof showToast === 'function') {
          showToast(data.message || i18n.profileUpdated, 'success');
        } else {
          alert(data.message || i18n.profileUpdated);
        }
        // Reload page to show updated profile
        setTimeout(() => window.location.reload(), 1000);
      } else {
        if (typeof showToast === 'function') {
          showToast(data.message || i18n.profileUpdateError, 'error');
        } else {
          alert(data.message || i18n.profileUpdateError);
        }
      }
    } catch (err) {
      console.error('Profile update error:', err);
      if (typeof showToast === 'function') {
        showToast(i18n.connectionError, 'error');
      } else {
        alert(i18n.connectionError);
      }
    }
  });
</script>

<script nonce="<%= cspNonce %>">
async function uploadProfilePicture(input) {
  if (!input.files || !input.files[0]) return;
  const file = input.files[0];
  if (file.size > 5 * 1024 * 1024) {
    if (typeof showToast === 'function') showToast(i18n.imageTooLarge, 'error');
    return;
  }
  const formData = new FormData();
  formData.append('profile_picture', file);
  try {
    const csrfToken = typeof getCsrfToken === 'function' ? getCsrfToken() : '';
    const res = await fetch('/api/web/account/profile-picture', {
      method: 'POST',
      headers: csrfToken ? { 'X-CSRF-Token': csrfToken } : {},
      body: formData
    });
    const data = await res.json();
    if (data.success) {
      if (typeof showToast === 'function') showToast(i18n.photoUpdated, 'success');
      setTimeout(() => location.reload(), 800);
    } else {
      if (typeof showToast === 'function') showToast(data.message || i18n.uploadError, 'error');
    }
  } catch (e) {
    if (typeof showToast === 'function') showToast(i18n.uploadError, 'error');
  }
}

async function deleteProfilePicture() {
  if (!confirm(i18n.confirmDeletePhoto)) return;
  try {
    const csrfToken = typeof getCsrfToken === 'function' ? getCsrfToken() : '';
    const res = await fetch('/api/web/account/profile-picture', {
      method: 'DELETE',
      headers: { 'Content-Type': 'application/json', ...(csrfToken ? { 'X-CSRF-Token': csrfToken } : {}) }
    });
    const data = await res.json();
    if (data.success) {
      if (typeof showToast === 'function') showToast(i18n.photoDeleted, 'success');
      setTimeout(() => location.reload(), 800);
    }
  } catch (e) {
    if (typeof showToast === 'function') showToast(i18n.error, 'error');
  }
}
</script>

<%- include('partials/footer') %>
