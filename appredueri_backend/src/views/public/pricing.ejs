<%- include('partials/head', { pageTitle: t('pricing.choosePlan'), activePage: activePage }) %>
<%- include('partials/navbar', { activePage: activePage, webUser: typeof webUser !== 'undefined' ? webUser : null }) %>

<main class="pricing-page">
  <div class="pricing-container">

    <!-- Header -->
    <div class="pricing-header">
      <h1 class="pricing-title"><%= t('pricing.choosePlan') %></h1>
      <p class="pricing-subtitle"><%= t('pricing.subtitle') %></p>

      <!-- Billing Toggle -->
      <div class="billing-toggle">
        <span class="billing-label" id="billing-monthly-label"><%= t('pricing.monthly') %></span>
        <button class="billing-switch" id="billing-switch" onclick="toggleBilling()" aria-label="<%= t('pricing.toggleBilling') %>">
          <span class="billing-switch-thumb" id="billing-thumb"></span>
        </button>
        <span class="billing-label" id="billing-yearly-label">
          <%= t('pricing.yearly') %>
          <span class="billing-save-badge">-17%</span>
        </span>
      </div>
    </div>

    <!-- Plans Grid -->
    <div class="pricing-grid">
      <% plans.forEach(function(plan) { %>
        <div class="pricing-card<%= plan.slug === 'premium' ? ' pricing-card--premium' : '' %><%= plan.slug === 'standard' ? ' pricing-card--popular' : '' %>" data-plan="<%= plan.slug %>">

          <% if (plan.slug === 'standard') { %>
            <div class="pricing-popular-badge"><%= t('pricing.mostPopular') %></div>
          <% } %>
          <% if (plan.slug === 'premium') { %>
            <div class="pricing-premium-badge">Premium</div>
          <% } %>

          <div class="pricing-card-header">
            <h2 class="pricing-plan-name"><%= plan.name %></h2>

            <!-- Price -->
            <div class="pricing-price">
              <span class="pricing-amount" data-monthly="<%= plan.price_monthly %>" data-yearly="<%= plan.price_yearly %>">
                <%= plan.price_monthly === 0 ? '0' : (plan.price_monthly / 100).toFixed(0) %>
              </span>
              <div class="pricing-price-meta">
                <span class="pricing-currency">RON</span>
                <span class="pricing-period"><%= t('pricing.perMonth') %></span>
              </div>
            </div>
            <% if (plan.price_monthly > 0) { %>
              <p class="pricing-yearly-note" id="yearly-note-<%= plan.slug %>" style="display: none;">
                <%- t('pricing.billedYearly', { amount: (plan.price_yearly / 100).toFixed(0) }) %>
              </p>
            <% } %>
          </div>

          <div class="pricing-card-body">
            <!-- Features List -->
            <ul class="pricing-features">
              <li class="pricing-feature">
                <svg class="pricing-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                <span><%= plan.max_active_offers === null ? t('pricing.unlimitedOffers') : t('pricing.activeOffers', { count: plan.max_active_offers }) %></span>
              </li>
              <li class="pricing-feature">
                <svg class="pricing-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                <span><%= plan.max_gallery_images === null ? t('pricing.unlimitedGallery') : t('pricing.galleryImages', { count: plan.max_gallery_images }) %></span>
              </li>
              <li class="pricing-feature">
                <svg class="pricing-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                <span><%= plan.max_locations === null ? t('pricing.unlimitedLocations') : (plan.max_locations === 1 ? t('pricing.location_one', { count: plan.max_locations }) : t('pricing.location_other', { count: plan.max_locations })) %></span>
              </li>
              <li class="pricing-feature">
                <svg class="pricing-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                <span><%= plan.max_promo_codes_per_offer === null ? t('pricing.unlimitedPromo') : t('pricing.promoPerOffer', { count: plan.max_promo_codes_per_offer }) %></span>
              </li>
              <li class="pricing-feature">
                <svg class="pricing-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                <span><%= t('pricing.statisticsDays', { days: plan.analytics_days }) %></span>
              </li>
              <% if (plan.badge_type) { %>
              <li class="pricing-feature">
                <% if (plan.badge_type === 'premium') { %>
                  <svg class="pricing-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#a78bfa" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                  <span style="color: #a78bfa;"><%= t('pricing.badgePremium') %></span>
                <% } else { %>
                  <svg class="pricing-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                  <span><%= t('pricing.badgeVerified') %></span>
                <% } %>
              </li>
              <% } %>
              <li class="pricing-feature">
                <svg class="pricing-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                <span><%= t('pricing.reviewResponses') %></span>
              </li>
              <li class="pricing-feature">
                <svg class="pricing-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                <span><%= t('pricing.bookings') %></span>
              </li>
              <% if (plan.has_concierge) { %>
              <li class="pricing-feature">
                <svg class="pricing-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                <span><%= t('pricing.concierge') %></span>
              </li>
              <% } %>
              <% if (plan.has_priority_support) { %>
                <li class="pricing-feature">
                  <svg class="pricing-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#a78bfa" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                  <span style="color: #a78bfa;"><%= t('pricing.prioritySupport') %></span>
                </li>
              <% } %>
            </ul>
          </div>

          <!-- CTA Button -->
          <div class="pricing-card-footer">
            <% if (plan.slug === 'free') { %>
              <a href="/pentru-business" class="pricing-cta pricing-cta--free"><%= t('pricing.startFree') %></a>
            <% } else if (plan.slug === 'standard') { %>
              <a href="#" onclick="choosePlan('standard'); return false;" class="pricing-cta pricing-cta--standard" data-plan-slug="standard">
                <%= t('pricing.chooseStandard') %>
              </a>
            <% } else { %>
              <a href="#" onclick="choosePlan('premium'); return false;" class="pricing-cta pricing-cta--premium" data-plan-slug="premium">
                <%= t('pricing.choosePremium') %>
              </a>
            <% } %>
          </div>
        </div>
      <% }); %>
    </div>

    <!-- Detailed Comparison Table -->
    <div class="pricing-comparison">
      <h2 class="pricing-comparison-title"><%= t('pricing.detailedComparison') %></h2>
      <div class="pricing-comparison-table-wrapper">
        <table class="pricing-comparison-table">
          <thead>
            <tr>
              <th class="pricing-comparison-feature-col"><%= t('pricing.feature') %></th>
              <th><%= t('pricing.free') %></th>
              <th class="pricing-col-standard">Standard</th>
              <th class="pricing-col-premium">Premium</th>
            </tr>
          </thead>
          <tbody>
            <tr class="pricing-comparison-category">
              <td colspan="4"><%= t('pricing.limits') %></td>
            </tr>
            <tr>
              <td><%= t('pricing.activeOffersLabel') %></td>
              <td>2</td>
              <td>6</td>
              <td><%= t('pricing.unlimited') %></td>
            </tr>
            <tr>
              <td><%= t('pricing.galleryImagesLabel') %></td>
              <td>8</td>
              <td>16</td>
              <td><%= t('pricing.unlimited') %></td>
            </tr>
            <tr>
              <td><%= t('pricing.locationsLabel') %></td>
              <td>1</td>
              <td>3</td>
              <td><%= t('pricing.unlimited') %></td>
            </tr>
            <tr>
              <td><%= t('pricing.promoCodesLabel') %></td>
              <td>1</td>
              <td>1</td>
              <td><%= t('pricing.unlimited') %></td>
            </tr>
            <tr>
              <td><%= t('pricing.statisticsPeriod') %></td>
              <td>7 <%= t('pricing.days') %></td>
              <td>30 <%= t('pricing.days') %></td>
              <td>90 <%= t('pricing.days') %></td>
            </tr>

            <tr>
              <td><%= t('pricing.badge') %></td>
              <td><svg class="cmp-x" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></td>
              <td><span style="color: #fb923c;"><%= t('pricing.verified') %></span></td>
              <td><span style="color: #a78bfa;">Premium</span></td>
            </tr>

            <tr class="pricing-comparison-category">
              <td colspan="4"><%= t('pricing.customerInteraction') %></td>
            </tr>
            <tr>
              <td><%= t('pricing.reviewResponses') %></td>
              <td><svg class="cmp-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg></td>
              <td><svg class="cmp-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg></td>
              <td><svg class="cmp-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg></td>
            </tr>
            <tr>
              <td><%= t('pricing.bookings') %></td>
              <td><svg class="cmp-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg></td>
              <td><svg class="cmp-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg></td>
              <td><svg class="cmp-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg></td>
            </tr>

            <tr class="pricing-comparison-category">
              <td colspan="4"><%= t('pricing.notifications') %></td>
            </tr>
            <tr>
              <td><%= t('pricing.pushNewOffer') %></td>
              <td><svg class="cmp-x" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></td>
              <td><svg class="cmp-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg></td>
              <td><svg class="cmp-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg></td>
            </tr>
            <tr>
              <td><%= t('pricing.customPush') %></td>
              <td><svg class="cmp-x" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></td>
              <td><svg class="cmp-x" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></td>
              <td><svg class="cmp-check cmp-check--premium" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg></td>
            </tr>

            <tr class="pricing-comparison-category">
              <td colspan="4"><%= t('pricing.statisticsAnalytics') %></td>
            </tr>
            <tr>
              <td><%= t('pricing.statsCharts') %></td>
              <td><svg class="cmp-x" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></td>
              <td><svg class="cmp-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg></td>
              <td><svg class="cmp-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg></td>
            </tr>
            <tr>
              <td><%= t('pricing.csvExport') %></td>
              <td><svg class="cmp-x" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></td>
              <td><svg class="cmp-x" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></td>
              <td><svg class="cmp-check cmp-check--premium" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg></td>
            </tr>

            <tr class="pricing-comparison-category">
              <td colspan="4"><%= t('pricing.visibilityPromotion') %></td>
            </tr>
            <tr>
              <td><%= t('pricing.promotedPlacement') %></td>
              <td><svg class="cmp-x" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></td>
              <td><svg class="cmp-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg></td>
              <td><svg class="cmp-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg></td>
            </tr>
            <tr>
              <td><%= t('pricing.searchPriority') %></td>
              <td><svg class="cmp-x" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></td>
              <td><svg class="cmp-x" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></td>
              <td><svg class="cmp-check cmp-check--premium" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg></td>
            </tr>

            <tr class="pricing-comparison-category">
              <td colspan="4"><%= t('pricing.support') %></td>
            </tr>
            <tr>
              <td><%= t('pricing.concierge') %></td>
              <td><svg class="cmp-x" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></td>
              <td><svg class="cmp-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg></td>
              <td><svg class="cmp-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg></td>
            </tr>
            <tr>
              <td><%= t('pricing.prioritySupport') %></td>
              <td><svg class="cmp-x" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></td>
              <td><svg class="cmp-x" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></td>
              <td><svg class="cmp-check cmp-check--premium" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- FAQ Section -->
    <div class="pricing-faq">
      <h2 class="pricing-faq-title"><%= t('pricing.faqTitle') %></h2>
      <div class="pricing-faq-grid">
        <% for (var i = 1; i <= 10; i++) { %>
        <div class="pricing-faq-item">
          <h3><%= t('pricing.faq' + i + 'q') %></h3>
          <p><%= t('pricing.faq' + i + 'a') %></p>
        </div>
        <% } %>
      </div>
    </div>

  </div>

  <!-- Business Selector Modal -->
  <div id="biz-select-modal" style="display: none; position: fixed; inset: 0; z-index: 1000;">
    <div onclick="closeBizModal()" style="position: absolute; inset: 0; background: rgba(0,0,0,0.6); backdrop-filter: blur(4px);"></div>
    <div style="position: relative; margin: auto; top: 50%; transform: translateY(-50%); max-width: 520px; width: calc(100% - 32px); background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; box-shadow: 0 20px 60px rgba(0,0,0,0.4);">
      <div style="display: flex; align-items: center; justify-content: space-between; padding: 24px 28px; border-bottom: 1px solid var(--border);">
        <div>
          <h3 style="margin: 0; font-size: 1.15rem; font-weight: 600; color: var(--text-primary);"><%= t('pricing.selectBusiness') %></h3>
          <p style="margin: 4px 0 0; font-size: 0.8125rem; color: var(--text-tertiary);"><%= t('pricing.selectBusinessDesc') %></p>
        </div>
        <button onclick="closeBizModal()" style="background: none; border: none; color: var(--text-tertiary); font-size: 1.5rem; cursor: pointer; line-height: 1; padding: 0;">&times;</button>
      </div>
      <div id="biz-select-list" style="padding: 16px 20px; display: flex; flex-direction: column; gap: 10px; max-height: 400px; overflow-y: auto;">
        <!-- Business items injected by JS -->
      </div>
    </div>
  </div>
</main>

<script nonce="<%= cspNonce %>">
(function() {
  var isYearly = false;
  var _userBusinesses = <%- JSON.stringify(userBusinesses || []) %>;
  var _isLoggedIn = <%= webUser ? 'true' : 'false' %>;

  window.toggleBilling = function() {
    isYearly = !isYearly;
    var thumb = document.getElementById('billing-thumb');
    var monthlyLabel = document.getElementById('billing-monthly-label');
    var yearlyLabel = document.getElementById('billing-yearly-label');

    thumb.style.transform = isYearly ? 'translateX(24px)' : 'translateX(0)';
    monthlyLabel.style.color = isYearly ? 'var(--text-tertiary)' : 'var(--text-primary)';
    yearlyLabel.style.color = isYearly ? 'var(--text-primary)' : 'var(--text-tertiary)';

    // Update prices
    document.querySelectorAll('.pricing-amount').forEach(function(el) {
      var monthly = parseInt(el.dataset.monthly);
      var yearly = parseInt(el.dataset.yearly);
      if (isYearly && yearly > 0) {
        el.textContent = Math.round(yearly / 12 / 100);
      } else {
        el.textContent = monthly === 0 ? '0' : Math.round(monthly / 100);
      }
    });

    // Toggle yearly notes
    document.querySelectorAll('[id^="yearly-note-"]').forEach(function(el) {
      el.style.display = isYearly ? 'block' : 'none';
    });
  };

  // Business selector for pricing CTAs
  window.choosePlan = function(planSlug) {
    if (!_isLoggedIn) {
      window.location.href = '/register?returnTo=/preturi';
      return;
    }
    if (_userBusinesses.length === 0) {
      window.location.href = '/pentru-business';
      return;
    }
    if (_userBusinesses.length === 1) {
      window.location.href = '/portal/' + _userBusinesses[0].id + '?tab=subscription';
      return;
    }
    // Multiple businesses — show modal
    var list = document.getElementById('biz-select-list');
    var html = '';
    _userBusinesses.forEach(function(biz) {
      var initial = (biz.name || '?')[0].toUpperCase();
      var logoHtml = biz.logo_url
        ? '<img src="' + biz.logo_url + '" alt="" style="width: 42px; height: 42px; border-radius: 10px; object-fit: cover;">'
        : '<div style="width: 42px; height: 42px; border-radius: 10px; background: linear-gradient(135deg, #f97316, #fb923c); display: flex; align-items: center; justify-content: center; color: #06060a; font-weight: 700; font-size: 1rem;">' + initial + '</div>';
      html += '<button onclick="selectBusiness(' + biz.id + ')" style="display: flex; align-items: center; gap: 14px; width: 100%; padding: 14px 18px; background: var(--bg-primary); border: 1px solid var(--border); border-radius: var(--radius-md); cursor: pointer; transition: all 0.2s; text-align: left;" onmouseover="this.style.borderColor=\'var(--accent)\'" onmouseout="this.style.borderColor=\'var(--border)\'">';
      html += logoHtml;
      html += '<span style="flex: 1; font-size: 0.9rem; font-weight: 500; color: var(--text-primary);">' + biz.name + '</span>';
      if (biz.plan_slug === 'premium') {
        html += '<span style="display: inline-flex; align-items: center; gap: 3px; padding: 2px 8px; font-size: 0.625rem; font-weight: 600; color: #a78bfa; background: rgba(167,139,250,0.12); border: 1px solid rgba(167,139,250,0.25); border-radius: 9999px; white-space: nowrap;"><svg width="8" height="8" viewBox="0 0 24 24" fill="#a78bfa" stroke="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>Premium</span>';
      } else if (biz.plan_slug === 'standard') {
        html += '<span style="display: inline-flex; align-items: center; gap: 3px; padding: 2px 8px; font-size: 0.625rem; font-weight: 600; color: #fb923c; background: rgba(251,146,60,0.12); border: 1px solid rgba(251,146,60,0.25); border-radius: 9999px; white-space: nowrap;"><svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="#fb923c" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>Standard</span>';
      }
      html += '</button>';
    });
    list.innerHTML = html;
    document.getElementById('biz-select-modal').style.display = 'block';
  };

  window.selectBusiness = function(bizId) {
    window.location.href = '/portal/' + bizId + '?tab=subscription';
  };

  window.closeBizModal = function() {
    document.getElementById('biz-select-modal').style.display = 'none';
  };

  // Close modal on Escape key
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeBizModal();
  });
})();
</script>

