<%- include('partials/head', { pageTitle: t('help.pageTitle'), activePage: null, pageDesc: t('help.pageDesc') }) %>

<style>
  .help-contact-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 32px;
    text-align: center;
    margin-bottom: 40px;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .help-contact-icon {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    background: rgba(251, 146, 60, 0.08);
    border: 1px solid rgba(251, 146, 60, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 20px;
  }
  .help-contact-card h2 {
    font-size: 1.375rem;
    font-weight: 800;
    margin-bottom: 8px;
  }
  .help-contact-desc {
    color: var(--text-secondary);
    font-size: 0.875rem;
    line-height: 1.5;
    margin-bottom: 20px;
  }
  .help-contact-items {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .help-contact-item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    background: rgba(251, 146, 60, 0.06);
    border: 1px solid rgba(251, 146, 60, 0.2);
    border-radius: var(--radius-md);
    color: var(--accent);
    font-weight: 600;
    font-size: 0.875rem;
    transition: all 0.2s;
  }
  .help-contact-item:hover {
    background: rgba(251, 146, 60, 0.12);
    border-color: rgba(251, 146, 60, 0.35);
  }
  .help-links {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .help-link-item {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 20px;
    border-bottom: 1px solid var(--border);
    color: var(--text-primary);
    font-weight: 600;
    font-size: 0.9375rem;
    transition: background 0.2s;
  }
  .help-link-item:last-child {
    border-bottom: none;
  }
  .help-link-item:hover {
    background: rgba(255, 255, 255, 0.03);
  }
  .help-link-item span {
    flex: 1;
  }
  .help-link-item svg:first-child {
    flex-shrink: 0;
  }
</style>

<%- include('partials/navbar', { activePage: null, webUser: typeof webUser !== 'undefined' ? webUser : null }) %>

<section class="page-header" style="padding-bottom: 24px;">
  <div class="page-header-glow"></div>
  <div class="container">
    <h1 class="page-title text-gradient"><%= t('help.heading') %></h1>
    <p class="page-subtitle"><%= t('help.subtitle') %></p>
  </div>
</section>

<section class="section" style="padding-top: 0;">
  <div class="container" style="max-width: 720px;">

    <!-- Contact Card -->
    <div class="help-contact-card reveal">
      <div class="help-contact-icon">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
      </div>
      <h2><%= t('help.needHelp') %></h2>
      <p class="help-contact-desc"><%= t('help.supportDesc') %></p>
      <div class="help-contact-items">
        <a href="mailto:support@ofai.ro" class="help-contact-item">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          <span>Email</span>
        </a>
      </div>
      <a href="mailto:support@ofai.ro?subject=Suport%20OFAI" class="btn btn-primary" style="width: 100%; margin-top: 20px; justify-content: center;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        <%= t('help.sendMessage') %>
      </a>
    </div>

    <!-- FAQ -->
    <h2 style="margin-bottom: 20px; font-size: 1.25rem; font-weight: 700;"><%= t('help.faqTitle') %></h2>

    <div class="help-faq reveal">
      <div class="faq-item">
        <div class="faq-question">
          <span><%= t('help.faq1q') %></span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
        </div>
        <div class="faq-answer">
          <div class="faq-answer-inner">
            <p><%= t('help.faq1a') %></p>
          </div>
        </div>
      </div>

      <div class="faq-item">
        <div class="faq-question">
          <span><%= t('help.faq2q') %></span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
        </div>
        <div class="faq-answer">
          <div class="faq-answer-inner">
            <p><%= t('help.faq2a') %></p>
          </div>
        </div>
      </div>

      <div class="faq-item">
        <div class="faq-question">
          <span><%= t('help.faq3q') %></span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
        </div>
        <div class="faq-answer">
          <div class="faq-answer-inner">
            <p><%- t('help.faq3a') %></p>
          </div>
        </div>
      </div>

      <div class="faq-item">
        <div class="faq-question">
          <span><%= t('help.faq4q') %></span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
        </div>
        <div class="faq-answer">
          <div class="faq-answer-inner">
            <p><%= t('help.faq4a') %></p>
          </div>
        </div>
      </div>

      <div class="faq-item">
        <div class="faq-question">
          <span><%= t('help.faq5q') %></span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
        </div>
        <div class="faq-answer">
          <div class="faq-answer-inner">
            <p><%- t('help.faq5a') %></p>
