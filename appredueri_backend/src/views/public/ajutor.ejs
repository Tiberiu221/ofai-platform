          <span><%= t('help.faq7q') %></span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
        </div>
        <div class="faq-answer">
          <div class="faq-answer-inner">
            <p><%- t('help.faq7a') %></p>
          </div>
        </div>
      </div>
    </div>

    <!-- Quick Links -->
    <h2 style="margin-top: 40px; margin-bottom: 16px; font-size: 1.25rem; font-weight: 700;"><%= t('help.quickLinks') %></h2>

    <div class="help-links reveal">
      <a href="/termeni" class="help-link-item">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
        <span><%= t('help.termsLink') %></span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
