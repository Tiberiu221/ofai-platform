<%- include('partials/head', { pageTitle: 'Conectare', activePage: null }) %>
<%- include('partials/navbar', { activePage: null, webUser: typeof webUser !== 'undefined' ? webUser : null }) %>

<!-- ═══════════════════════════════════════════════════════
     LOGIN PAGE
     ═══════════════════════════════════════════════════════ -->
<div class="auth-page">
  <canvas class="particle-canvas auth-particles"></canvas>
  <div class="auth-card">
    <!-- Logo -->
    <div class="auth-logo">
      <div class="auth-logo-icon">O</div>
      <span class="auth-logo-text">OFAI</span>
    </div>

    <!-- Title -->
    <h1 class="auth-title">Bine ai revenit!</h1>
    <p class="auth-subtitle">Conecteaz&#259;-te la contul t&#259;u OFAI</p>

    <!-- Error message -->
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="auth-error">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
        <%= error %>
      </div>
    <% } %>

    <!-- Login Form -->
    <form action="/login" method="POST" class="auth-form">
      <div class="auth-form-group">
        <label for="email" class="auth-label">Email</label>
        <input
          type="email"
          id="email"
          name="email"
          class="auth-input"
          placeholder="exemplu@email.com"
          required
          autocomplete="email"
        >
      </div>

      <div class="auth-form-group">
        <label for="password" class="auth-label">Parol&#259;</label>
        <input
          type="password"
          id="password"
          name="password"
          class="auth-input"
          placeholder="Introdu parola"
          required
          autocomplete="current-password"
        >
      </div>

      <div class="auth-form-group" style="text-align: right; margin-top: -4px;">
        <a href="/forgot-password" class="auth-link-inline">Ai uitat parola?</a>
      </div>

      <button type="submit" class="btn btn-primary btn-lg auth-submit">
        Conecteaz&#259;-te
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </button>
    </form>

    <!-- Register link -->
    <div class="auth-footer-link">
      Nu ai cont? <a href="/register" class="auth-link">&#206;nregistreaz&#259;-te</a>
    </div>
  </div>
</div>

<!-- Auth Page Styles -->
<style>
  .auth-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 120px 20px 80px;
    position: relative;
  }

  /* glow replaced by particle-canvas */

  .auth-card {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 440px;
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 24px;
    padding: 48px 40px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
  }

  .auth-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-bottom: 32px;
  }

  .auth-logo-icon {
    width: 40px;
    height: 40px;
    background: #fb923c;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 20px;
    color: #09090b;
  }

  .auth-logo-text {
    font-size: 24px;
    font-weight: 800;
    color: var(--text-primary, #fafafa);
    letter-spacing: -0.5px;
  }

  .auth-title {
    text-align: center;
    font-size: 28px;
    font-weight: 700;
    color: var(--text-primary, #fafafa);
    margin-bottom: 8px;
    letter-spacing: -0.5px;
  }

  .auth-subtitle {
    text-align: center;
    color: var(--text-secondary, #a1a1aa);
    font-size: 15px;
    margin-bottom: 32px;
  }

  .auth-error {
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.2);
    color: #fca5a5;
    padding: 12px 16px;
    border-radius: 12px;
    font-size: 14px;
    margin-bottom: 24px;
  }

  .auth-error svg {
    flex-shrink: 0;
    color: #f87171;
  }

  .auth-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .auth-form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .auth-label {
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary, #a1a1aa);
  }

  .auth-input {
    width: 100%;
    padding: 12px 16px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    color: var(--text-primary, #fafafa);
    font-size: 15px;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
    font-family: inherit;
  }

  .auth-input::placeholder {
    color: rgba(255, 255, 255, 0.25);
  }

  .auth-input:focus {
    border-color: #fb923c;
    box-shadow: 0 0 0 3px rgba(251, 146, 60, 0.1);
  }

  .auth-submit {
    width: 100%;
    margin-top: 8px;
    justify-content: center;
  }

  .auth-link-inline {
    color: #fb923c;
    font-size: 13px;
    text-decoration: none;
    transition: color 0.2s;
  }

  .auth-link-inline:hover {
    color: #f59e0b;
  }

  .auth-footer-link {
    text-align: center;
    margin-top: 28px;
    font-size: 14px;
    color: var(--text-secondary, #a1a1aa);
  }

  .auth-link {
    color: #fb923c;
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s;
  }

  .auth-link:hover {
    color: #f59e0b;
  }

  .auth-success {
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(34, 197, 94, 0.1);
    border: 1px solid rgba(34, 197, 94, 0.2);
    color: #86efac;
    padding: 12px 16px;
    border-radius: 12px;
    font-size: 14px;
    margin-bottom: 24px;
  }

  .auth-success svg {
    flex-shrink: 0;
    color: #4ade80;
  }

  .auth-divider {
    display: flex;
    align-items: center;
    gap: 16px;
    margin: 8px 0;
    color: var(--text-secondary, #a1a1aa);
    font-size: 13px;
  }

  .auth-divider::before,
  .auth-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: rgba(255, 255, 255, 0.06);
  }

  .auth-hint {
    font-size: 12px;
    color: var(--text-secondary, #a1a1aa);
    margin-top: 2px;
  }

  .auth-reset-section {
    margin-top: 32px;
    padding-top: 32px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .auth-reset-title {
    font-size: 18px;
    font-weight: 600;
    color: var(--text-primary, #fafafa);
    margin-bottom: 8px;
    text-align: center;
  }

  .auth-reset-subtitle {
    font-size: 14px;
    color: var(--text-secondary, #a1a1aa);
    margin-bottom: 24px;
    text-align: center;
  }

  @media (max-width: 480px) {
    .auth-card {
      padding: 36px 24px;
      border-radius: 20px;
    }

    .auth-title {
      font-size: 24px;
    }
  }
</style>

<script>
document.querySelector('.auth-form').addEventListener('submit', async (e) => {
  e.preventDefault();
  const form = e.target;
  const btn = form.querySelector('.auth-submit');
  const email = form.querySelector('#email').value;
  const password = form.querySelector('#password').value;
  const _qs = new URLSearchParams(window.location.search);
  const returnTo = _qs.get('returnTo') || '/cont';

  const oldErr = form.parentElement.querySelector('.auth-error');
  if (oldErr) oldErr.remove();

  btn.disabled = true;
  btn.textContent = 'Se conectează...';

  try {
    const resp = await fetch('/login', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email, password, returnTo }),
    });
    const data = await resp.json();

    if (resp.ok && data.success) {
      window.location.href = data.redirect || '/cont';
    } else {
      const errDiv = document.createElement('div');
      errDiv.className = 'auth-error';
      errDiv.textContent = data.message || 'Eroare la conectare';
      form.parentElement.insertBefore(errDiv, form);
      btn.disabled = false;
      btn.textContent = 'Conectează-te';
    }
  } catch (err) {
    const errDiv = document.createElement('div');
    errDiv.className = 'auth-error';
    errDiv.textContent = 'Eroare de rețea. Verifică conexiunea la internet.';
    const existing = form.parentElement.querySelector('.auth-error');
    if (existing) existing.remove();
    form.parentElement.insertBefore(errDiv, form);
    btn.disabled = false;
    btn.textContent = 'Conectează-te';
  }
});
</script>

<%- include('partials/footer') %>
