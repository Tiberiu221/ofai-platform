<%- include('partials/head', { pageTitle: 'Conectare', activePage: null }) %>
<%- include('partials/navbar', { activePage: null, webUser: typeof webUser !== 'undefined' ? webUser : null }) %>

<!-- ═══════════════════════════════════════════════════════
     LOGIN PAGE
     ═══════════════════════════════════════════════════════ -->
<div class="auth-page">
  <canvas class="particle-canvas auth-particles"></canvas>
  <div class="auth-card">
    <!-- Logo -->
    <div class="auth-logo">
      <div class="auth-logo-icon">O</div>
      <span class="auth-logo-text">OFAI</span>
    </div>

    <!-- Title -->
    <h1 class="auth-title">Bine ai revenit!</h1>
    <p class="auth-subtitle">Conecteaz&#259;-te la contul t&#259;u OFAI</p>

    <!-- Error message -->
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="auth-error">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
        <%= error %>
      </div>
    <% } %>

    <!-- Login Form -->
    <form action="/login" method="POST" class="auth-form">
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
      <div class="auth-form-group">
        <label for="email" class="auth-label">Email</label>
        <input
          type="email"
          id="email"
          name="email"
          class="auth-input"
          placeholder="exemplu@email.com"
          required
          autocomplete="email"
        >
      </div>

      <div class="auth-form-group">
        <label for="password" class="auth-label">Parol&#259;</label>
        <input
          type="password"
          id="password"
          name="password"
          class="auth-input"
          placeholder="Introdu parola"
          required
          autocomplete="current-password"
        >
      </div>

      <div class="auth-form-group" style="text-align: right; margin-top: -4px;">
        <a href="/forgot-password" class="auth-link-inline">Ai uitat parola?</a>
      </div>

      <button type="submit" class="btn btn-primary btn-lg auth-submit">
        Conecteaz&#259;-te
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </button>
    </form>

    <% if (typeof googleClientId !== 'undefined' && googleClientId) { %>
    <!-- Google Sign-In Divider -->
    <div class="auth-divider"><span>sau</span></div>

    <!-- Google Sign-In -->
    <div id="g_id_onload"
      data-client_id="<%= googleClientId %>"
      data-callback="handleGoogleCallback"
      data-auto_prompt="false">
    </div>
    <div class="google-btn-wrapper">
      <div id="g_id_signin"
        data-type="standard"
        data-shape="rectangular"
        data-theme="filled_black"
        data-text="signin_with"
        data-size="large"
        data-logo_alignment="left"
        data-width="360">
      </div>
    </div>
    <% } %>

    <!-- Register link -->
    <div class="auth-footer-link">
      Nu ai cont? <a href="/register" class="auth-link" id="register-link">&#206;nregistreaz&#259;-te</a>
    </div>
  </div>
</div>

<!-- Auth page styles are in main.css -->

<% if (typeof googleClientId !== 'undefined' && googleClientId) { %>
<script src="https://accounts.google.com/gsi/client" async defer></script>
<% } %>
<script>
// Read returnTo from URL once on page load
const _qs = new URLSearchParams(window.location.search);
const returnTo = _qs.get('returnTo') || '/cont';

// Propagate returnTo to register link immediately
if (returnTo !== '/cont') {
  const regLink = document.getElementById('register-link');
  if (regLink) regLink.href = '/register?returnTo=' + encodeURIComponent(returnTo);
}

// Google Sign-In callback
function handleGoogleCallback(response) {
  fetch('/auth/google', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || ''
    },
    body: JSON.stringify({ idToken: response.credential })
  })
  .then(r => r.json())
  .then(data => {
    if (data.success) {
      const card = document.querySelector('.auth-card');
      if (card) {
        card.style.transition = 'opacity 0.2s, transform 0.2s';
        card.style.opacity = '0';
        card.style.transform = 'scale(0.98)';
      }
      setTimeout(() => { window.location.href = data.redirect || '/cont'; }, 200);
    } else {
      if (typeof showToast === 'function') showToast(data.message || 'Eroare la autentificarea Google', 'error');
    }
  })
  .catch(() => {
    if (typeof showToast === 'function') showToast('Eroare de rețea', 'error');
  });
}

// Use shared auth form handler
document.addEventListener('DOMContentLoaded', () => {
  window.submitAuthForm({
    formEl: document.querySelector('.auth-form'),
    endpoint: '/login',
    getPayload: (form) => ({
      email: form.querySelector('#email').value,
      password: form.querySelector('#password').value,
      returnTo
    }),
    successRedirect: '/cont'
  });
});
</script>

<%- include('partials/footer') %>
