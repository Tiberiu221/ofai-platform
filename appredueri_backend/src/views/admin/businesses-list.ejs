<%- include('partials/layout-top', { pageTitle: 'Business-uri', activePage: 'businesses' }) %>

<div class="a-page-header">
  <h1>Business-uri</h1>
  <a href="/admin/businesses/new" class="a-btn">+ Adaugă business nou</a>
</div>

<% if (typeof error !== "undefined" && error === "has_offers") { %>
  <div class="error-msg">
    Nu poți șterge acest business pentru că are oferte asociate.
    Șterge sau mută mai întâi ofertele lui, apoi revino aici.
  </div>
<% } %>

<!-- Filtre și căutare -->
<form method="get" action="/admin/businesses" class="filters">
  <div class="filters-row">
    <label>
      Caută
      <input type="text" name="q" value="<%= filters.q || '' %>" placeholder="Nume sau adresă..." />
    </label>
    <label>
      Oraș
      <select name="city_id">
        <option value="">Toate</option>
        <% (cities || []).forEach(function(c) { %>
          <option value="<%= c.id %>" <%= String(filters.city_id) === String(c.id) ? "selected" : "" %>><%= c.name %></option>
        <% }); %>
      </select>
    </label>
    <label>
      Categorie
      <select name="category_id">
        <option value="">Toate</option>
        <% (categories || []).forEach(function(cat) { %>
          <option value="<%= cat.id %>" <%= String(filters.category_id) === String(cat.id) ? "selected" : "" %>><%= cat.name %></option>
        <% }); %>
      </select>
    </label>
    <div class="filters-actions">
      <button type="submit" class="a-btn">Aplică</button>
      <a href="/admin/businesses" class="a-btn a-btn-secondary">Resetează</a>
    </div>
  </div>
</form>

<% if (!businesses || businesses.length === 0) { %>
  <p>Nu există business-uri în sistem.</p>
<% } else { %>
  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>Nume</th>
        <th>Oraș</th>
        <th>Categorie</th>
        <th>Adresă</th>
        <th>Telefon</th>
        <th>Verificat</th>
        <th style="width: 220px;">Acțiuni</th>
      </tr>
    </thead>
    <tbody>
      <% businesses.forEach(function(b) { %>
        <tr>
          <td><%= b.id %></td>
          <td><%= b.name %></td>
          <td><%= b.city_name %></td>
          <td><%= b.category_name %></td>
          <td><%= b.address || "" %></td>
          <td><%= b.phone || "" %></td>
          <td><%= b.is_verified ? '✅' : '' %></td>
          <td>
            <a href="/admin/businesses/<%= b.id %>/locations" class="button button-small info">
              Locații
            </a>

            <a href="/admin/businesses/<%= b.id %>/edit" class="button button-small">
              Editează
            </a>

            <form method="post" action="/admin/businesses/<%= b.id %>/delete" style="display:inline;" data-confirm="Sigur vrei să ștergi acest business?">
              <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
              <button type="submit" class="button button-small danger">
                Șterge
              </button>
            </form>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
  <% const _qs = Object.entries(filters || {}).filter(([k,v]) => v).map(([k,v]) => k + '=' + encodeURIComponent(v)).join('&'); %>
  <%- include('partials/pagination', { pagination, baseUrl: '/admin/businesses', currentQuery: _qs }) %>
<% } %>

<%- include('partials/layout-bottom') %>
