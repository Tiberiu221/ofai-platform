<!doctype html>
<html lang="ro">

<head>
  <meta charset="utf-8" />
  <title>Admin - Business-uri</title>
  <style>
    body {
      font-family: sans-serif;
      padding: 20px;
      color: #e5e7eb;
      background: #0f0f13;
    }

    h1 {
      margin-bottom: 16px;
      color: #f3f4f6;
    }

    table {
      border-collapse: collapse;
      width: 100%;
      margin-top: 12px;
    }

    th,
    td {
      border: 1px solid #2e2e33;
      padding: 8px;
      font-size: 14px;
      text-align: left;
    }

    th {
      background: #1f1f23;
      color: #9ca3af;
    }

    /* Butoane */
    a.button,
    button.button {
      display: inline-block;
      padding: 6px 10px;
      background: #2563eb;
      color: white;
      text-decoration: none;
      border-radius: 4px;
      font-size: 14px;
      border: none;
      cursor: pointer;
    }

    a.button.secondary {
      background: #4b5563;
    }

    a.button.info {
      background: #0891b2;
    }

    /* Turcoaz pentru Locații */
    a.button.danger,
    button.button.danger {
      background: #dc2626;
      border: none;
      cursor: pointer;
    }

    .button-small {
      padding: 4px 8px;
      font-size: 12px;
      margin-right: 4px;
    }

    .error-msg {
      margin-top: 8px;
      padding: 8px;
      border-radius: 4px;
      background: #3b1111;
      color: #fca5a5;
      border: 1px solid #5c1d1d;
      max-width: 700px;
    }
  </style>
</head>

<body>
  <h1>Business-uri</h1>

  <% if (typeof error !=="undefined" && error==="has_offers" ) { %>
    <div class="error-msg">
      Nu poți șterge acest business pentru că are oferte asociate.
      Șterge sau mută mai întâi ofertele lui, apoi revino aici.
    </div>
    <% } %>

      <p>
        <a href="/admin/businesses/new" class="button">+ Adaugă business nou</a>
        &nbsp;|&nbsp;
        <a href="/admin/business-requests" class="button" style="background: #d97706;">Cereri Business</a>
        &nbsp;|&nbsp;
        <a href="/admin/offers" class="button secondary">Vezi oferte</a>
        &nbsp;|&nbsp;
        <a href="/admin/review-summaries" class="button secondary">Review Summaries</a>
      </p>

      <% if (!businesses || businesses.length===0) { %>
        <p>Nu există business-uri în sistem.</p>
        <% } else { %>
          <table>
            <thead>
              <tr>
                <th>ID</th>
                <th>Nume</th>
                <th>Oraș</th>
                <th>Categorie</th>
                <th>Adresă</th>
                <th>Telefon</th>
                <th style="width: 220px;">Acțiuni</th>
              </tr>
            </thead>
            <tbody>
              <% businesses.forEach(function(b) { %>
                <tr>
                  <td>
                    <%= b.id %>
                  </td>
                  <td>
                    <%= b.name %>
                  </td>
                  <td>
                    <%= b.city_name %>
                  </td>
                  <td>
                    <%= b.category_name %>
                  </td>
                  <td>
                    <%= b.address || "" %>
                  </td>
                  <td>
                    <%= b.phone || "" %>
                  </td>
                  <td>
                    <a href="/admin/businesses/<%= b.id %>/locations" class="button button-small info">
                      Locații
                    </a>

                    <a href="/admin/businesses/<%= b.id %>/edit" class="button button-small">
                      Editează
                    </a>

                    <form method="post" action="/admin/businesses/<%= b.id %>/delete" style="display:inline;"
                      onsubmit="return confirm('Sigur vrei să ștergi acest business?');">
                      <button type="submit" class="button button-small danger">
                        Șterge
                      </button>
                    </form>
                  </td>
                </tr>
                <% }); %>
            </tbody>
          </table>
          <% } %>
</body>

</html>