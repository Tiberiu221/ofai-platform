<%- include('partials/layout-top', { pageTitle: 'Locații Business', activePage: 'businesses' }) %>

<a href="/admin/businesses" class="back-link">← Înapoi la Business-uri</a>

<h2>Locații pentru: <strong><%= business.name %></strong></h2>

<div class="form-box">
  <h3 style="margin-top:0;">Adaugă o locație nouă</h3>
  <form action="/admin/businesses/<%= business.id %>/locations" method="POST">
    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

    <div class="form-group">
      <label>Oraș</label>
      <select name="city_id" required>
        <% cities.forEach(city => { %>
          <option value="<%= city.id %>"><%= city.name %></option>
        <% }) %>
      </select>
    </div>

    <div class="form-group">
      <label>Adresă</label>
      <input type="text" name="address" placeholder="Str. Exemplu nr. 1" required>
    </div>

    <div class="form-group">
      <label>Telefon (opțional)</label>
      <input type="text" name="phone" placeholder="07xx...">
    </div>

    <div class="form-group">
      <label>Link Google Maps</label>
      <div style="display: flex; gap: 10px; max-width: 600px;">
        <input type="text" name="maps_url" id="add-maps-url" placeholder="https://maps.app.goo.gl/..." style="flex: 1;">
        <button type="button" class="button button-small" onclick="adminDetectCoords('add')">Auto-detect</button>
      </div>
      <div class="hint">Paste un link Google Maps pentru a extrage automat coordonatele.</div>
    </div>

    <div class="form-group">
      <label>Coordonate (Lat / Lng)</label>
      <div style="display: flex; gap: 10px; max-width: 400px;">
        <input type="number" step="any" name="lat" id="add-lat" placeholder="Lat (ex: 44.42)">
        <input type="number" step="any" name="lng" id="add-lng" placeholder="Lng (ex: 26.10)">
      </div>
      <div class="hint">Poți lăsa gol dacă nu ai coordonate sau folosește Auto-detect.</div>
    </div>

    <div style="margin-top: 15px;">
      <button type="submit" class="button">Salvează Locația</button>
    </div>
  </form>
</div>

<h3>Locații existente (<%= locations.length %>)</h3>

<% if (locations.length === 0) { %>
  <p style="color: #9ca3af; font-style: italic;">Acest business nu are locații secundare definite.</p>
<% } else { %>

  <p class="hint">Editează câmpurile direct în tabel și apasă "Salvează".</p>

  <table>
    <thead>
      <tr>
        <th style="min-width: 160px;">Oraș</th>
        <th>Adresă</th>
        <th style="min-width: 140px;">Telefon</th>
        <th style="min-width: 260px;">Maps URL / Coordonate</th>
        <th style="width: 180px;">Acțiuni</th>
      </tr>
    </thead>

    <tbody>
      <% locations.forEach(loc => { %>
        <% const formId = `edit-loc-${loc.id}`; %>
        <% const locCityId = (loc.city_id ?? loc.cityId ?? loc.cityID); %>

        <!-- form separat (valid HTML), apoi inputurile din row îl referă prin atributul form="" -->
        <form id="<%= formId %>" action="/admin/businesses/<%= business.id %>/locations/<%= loc.id %>" method="POST">
          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
        </form>

        <tr>
          <td>
            <select name="city_id" required form="<%= formId %>">
              <% cities.forEach(city => { %>
                <% const selectedById = (locCityId != null && Number(locCityId) === Number(city.id)); %>
                <% const selectedByName = (!selectedById && loc.city_name && city.name === loc.city_name); %>
                <% const selected = selectedById || selectedByName; %>
                <option value="<%= city.id %>" <%= selected ? "selected" : "" %>><%= city.name %></option>
              <% }) %>
            </select>
          </td>

          <td>
            <input type="text" name="address" value="<%= loc.address || "" %>" required form="<%= formId %>" />
          </td>

          <td>
            <input type="text" name="phone" value="<%= loc.phone || "" %>" placeholder="07xx..." form="<%= formId %>" />
          </td>

          <td>
            <div style="display: flex; gap: 6px; margin-bottom: 4px;">
              <input type="text" name="maps_url" value="<%= loc.maps_url || '' %>" placeholder="Maps link..." form="<%= formId %>" id="maps-url-<%= loc.id %>" style="flex: 1; font-size: 0.8rem;" />
              <button type="button" class="button button-small" onclick="adminDetectCoords('<%= loc.id %>')" style="white-space: nowrap;">Detect</button>
            </div>
            <div class="coords-row">
              <input type="number" step="any" name="lat" value="<%= (loc.lat ?? '') %>" placeholder="Lat" form="<%= formId %>" id="lat-<%= loc.id %>" />
              <input type="number" step="any" name="lng" value="<%= (loc.lng ?? '') %>" placeholder="Lng" form="<%= formId %>" id="lng-<%= loc.id %>" />
            </div>

            <% if(loc.lat && loc.lng) { %>
              <div class="hint">Curent: <code><%= loc.lat %>, <%= loc.lng %></code></div>
            <% } else { %>
              <div class="hint" style="color:#f87171;">Lipsă coordonate</div>
            <% } %>
          </td>

          <td>
            <div class="row-actions">
              <button type="submit" class="button button-small" form="<%= formId %>">Salvează</button>

              <form action="/admin/businesses/<%= business.id %>/locations/<%= loc.id %>/delete" method="POST" data-confirm="Sigur vrei să ștergi această locație?" style="margin:0;">
                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                <button type="submit" class="button button-small danger">Șterge</button>
              </form>
            </div>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<script nonce="<%= cspNonce %>">
function adminDetectCoords(locIdOrAdd) {
  var mapsInput, latInput, lngInput;
  if (locIdOrAdd === 'add') {
    mapsInput = document.getElementById('add-maps-url');
    latInput = document.getElementById('add-lat');
    lngInput = document.getElementById('add-lng');
  } else {
    mapsInput = document.getElementById('maps-url-' + locIdOrAdd);
    latInput = document.getElementById('lat-' + locIdOrAdd);
    lngInput = document.getElementById('lng-' + locIdOrAdd);
  }

  var url = mapsInput.value.trim();
  if (!url) { alert('Introdu un link Google Maps'); return; }

  var csrfToken = document.querySelector('meta[name="csrf-token"]');
  fetch('/api/web/parse-maps-link', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'X-CSRF-Token': csrfToken ? csrfToken.getAttribute('content') : ''
    },
    body: JSON.stringify({ url: url })
  })
  .then(function(res) { return res.json(); })
  .then(function(data) {
    if (data.error) { alert('Eroare: ' + data.error); return; }
    latInput.value = data.lat;
    lngInput.value = data.lng;
    if (data.mapsUrl) mapsInput.value = data.mapsUrl;
    alert('Coordonate detectate: ' + data.lat + ', ' + data.lng);
  })
  .catch(function(err) { alert('Eroare la detectare: ' + err.message); });
}
</script>

<%- include('partials/layout-bottom') %>
