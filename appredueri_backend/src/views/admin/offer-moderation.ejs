<%- include('partials/layout-top', { pageTitle: 'Moderare Oferte', activePage: 'offer-moderation' }) %>

<h1>Moderare Oferte</h1>

<% if (message) { %>
  <div class="alert alert-success"><%= message %></div>
<% } %>
<% if (error) { %>
  <div class="alert alert-danger"><%= error %></div>
<% } %>

<% if (offers.length === 0) { %>
  <p>Nu sunt oferte care necesita verificare.</p>
<% } else { %>
  <p style="color: #9ca3af; font-size: 13px;">
    <%= pendingCount %> oferte in asteptare
    &bull;
    Click pe un rand pentru detalii
  </p>

  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>Titlu</th>
        <th>Business</th>
        <th>Discount</th>
        <th>AI Score</th>
        <th>Flags</th>
        <th>ID</th>
        <th style="width: 180px;">Actiuni</th>
      </tr>
    </thead>
    <tbody>
      <% offers.forEach(function(o, idx) { %>
        <tr class="clickable" onclick="toggleDetails(<%= idx %>)">
          <td><%= o.id %></td>
          <td><strong><%= o.title %></strong></td>
          <td>
            <a href="/admin/businesses/<%= o.business_id %>/edit" style="color: #60a5fa;" onclick="event.stopPropagation()"><%= o.business_name %></a>
          </td>
          <td>
            <% if (o.discount_type === 'percentage' && o.discount_value) { %>
              -<%= o.discount_value %>%
            <% } else if (o.discount_type === 'fixed' && o.discount_value) { %>
              -<%= o.discount_value %> RON
            <% } else { %>
              <%= o.discount_type || '—' %>
            <% } %>
          </td>
          <td>
            <% if (o.ai_score === null || o.ai_score === undefined) { %>
              <span class="score-badge score-none">N/A</span>
            <% } else if (o.ai_score >= 70) { %>
              <span class="score-badge score-high"><%= o.ai_score %></span>
            <% } else if (o.ai_score >= 40) { %>
              <span class="score-badge score-medium"><%= o.ai_score %></span>
            <% } else { %>
              <span class="score-badge score-low"><%= o.ai_score %></span>
            <% } %>
          </td>
          <td>
            <% var flags = []; %>
            <% try { flags = typeof o.ai_flags === 'string' ? JSON.parse(o.ai_flags) : (o.ai_flags || []); } catch(e) {} %>
            <% flags.forEach(function(f) { %>
              <span class="flag-tag"><%= f %></span>
            <% }); %>
            <% if (flags.length === 0) { %><span style="color: #6b7280;">—</span><% } %>
          </td>
          <td>#<%= o.id %></td>
          <td onclick="event.stopPropagation()">
            <form action="/admin/offer-moderation/<%= o.id %>/approve" method="POST" style="display: inline;">
              <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
              <button type="submit" class="btn-approve">Aproba</button>
            </form>
            <button type="button" class="btn-reject" onclick="openRejectModal(<%= o.id %>)">Respinge</button>
          </td>
        </tr>
        <tr class="details-row" id="details-<%= idx %>">
          <td colspan="8">
            <div class="detail-grid">
              <% if (o.logo_url) { %>
                <div style="grid-column: 1 / -1; margin-bottom: 8px;">
                  <img src="<%= o.logo_url %>" alt="<%= o.title %>" style="width:120px; height:120px; object-fit:cover; border-radius:8px; border:1px solid #374151;">
                </div>
              <% } %>
              <div>
                <div class="detail-label">Descriere</div>
                <div class="detail-value"><%= o.description || '(fara descriere)' %></div>
              </div>
              <div>
                <div class="detail-label">Conditii</div>
                <div class="detail-value"><%= o.conditions || '(fara conditii)' %></div>
              </div>
              <div>
                <div class="detail-label">Perioada</div>
                <div class="detail-value">
                  <% if (o.start_date && o.end_date) { %>
                    <%= new Date(o.start_date).toLocaleDateString('ro-RO', { day: 'numeric', month: 'long', year: 'numeric' }) %>
                    &nbsp;—&nbsp;
                    <%= new Date(o.end_date).toLocaleDateString('ro-RO', { day: 'numeric', month: 'long', year: 'numeric' }) %>
                  <% } else if (o.start_date) { %>
                    De la <%= new Date(o.start_date).toLocaleDateString('ro-RO', { day: 'numeric', month: 'long', year: 'numeric' }) %>
                  <% } else if (o.end_date) { %>
                    Pana la <%= new Date(o.end_date).toLocaleDateString('ro-RO', { day: 'numeric', month: 'long', year: 'numeric' }) %>
                  <% } else { %>
                    (fara perioada)
                  <% } %>
                </div>
              </div>
            </div>
            <% if (o.ai_reasoning) { %>
              <div class="ai-reasoning">
                <strong>AI Reasoning:</strong> <%= o.ai_reasoning %>
              </div>
            <% } %>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
  <%- include('partials/pagination', { pagination, baseUrl: '/admin/offer-moderation', currentQuery: '' }) %>
<% } %>

<!-- Reject Modal -->
<div id="reject-modal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.6); z-index:1000; display:none; align-items:center; justify-content:center;">
  <div style="background:var(--a-bg-card, #1e1e2e); border-radius:12px; padding:24px; width:90%; max-width:480px; box-shadow:0 8px 32px rgba(0,0,0,0.4);">
    <h3 style="margin:0 0 16px; font-size:16px;">Respinge oferta</h3>
    <form id="reject-form" method="POST" action="">
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
      <label style="display:block; font-size:13px; color:#9ca3af; margin-bottom:6px;">Motiv respingere (vizibil pentru business owner)</label>
      <textarea name="rejection_reason" id="reject-reason" rows="3" required
                placeholder="Ex: Titlul nu este descriptiv. Te rugam sa adaugi detalii despre oferta."
                style="width:100%; padding:10px; border-radius:8px; border:1px solid #374151; background:var(--a-bg, #111); color:#fff; font-size:14px; resize:vertical; box-sizing:border-box;"></textarea>
      <div style="display:flex; gap:10px; margin-top:16px; justify-content:flex-end;">
        <button type="button" onclick="closeRejectModal()" style="padding:8px 16px; border-radius:8px; border:1px solid #374151; background:transparent; color:#9ca3af; cursor:pointer;">Anuleaza</button>
        <button type="submit" class="btn-reject" style="padding:8px 16px;">Respinge</button>
      </div>
    </form>
  </div>
</div>

<script nonce="<%= cspNonce %>">
  function toggleDetails(idx) {
    var row = document.getElementById('details-' + idx);
    row.style.display = row.style.display === 'table-row' ? 'none' : 'table-row';
  }

  function openRejectModal(offerId) {
    var modal = document.getElementById('reject-modal');
    var form = document.getElementById('reject-form');
    form.action = '/admin/offer-moderation/' + offerId + '/reject';
    document.getElementById('reject-reason').value = '';
    modal.style.display = 'flex';
  }

  function closeRejectModal() {
    document.getElementById('reject-modal').style.display = 'none';
  }

  // Close modal on backdrop click
  document.getElementById('reject-modal').addEventListener('click', function(e) {
    if (e.target === this) closeRejectModal();
  });
</script>

<%- include('partials/layout-bottom') %>
