<!doctype html>
<html lang="ro">
  <head>
    <meta charset="utf-8" />
    <title>Admin - Ofertă nouă</title>
    <style>
      body { font-family: sans-serif; padding: 20px; }
      h1 { margin-bottom: 16px; }
      form { max-width: 600px; }
      label { display: block; margin-top: 10px; font-weight: bold; }
      input[type="text"],
      input[type="number"],
      input[type="date"],
      textarea,
      select {
        width: 100%;
        padding: 6px;
        margin-top: 4px;
        box-sizing: border-box;
      }
      textarea { min-height: 80px; }
      button {
        margin-top: 16px;
        padding: 8px 16px;
        background: #28a745;
        color: white;
        border: none;
        border-radius: 4px;
        cursor: pointer;
      }
      a { text-decoration: none; color: #007bff; }
      small { font-size: 12px; color: #6b7280; }
    </style>
  </head>
  <body>
    <h1>Ofertă nouă</h1>

    <p><a href="/admin/offers">« Înapoi la listă</a></p>

    <!-- IMPORTANT: enctype pentru upload imagine -->
    <form method="post" action="/admin/offers/new" enctype="multipart/form-data">
      <label for="business_id">Business</label>
      <select name="business_id" id="business_id" required>
        <option value="">Alege un business...</option>
        <% businesses.forEach(function(b) { %>
          <option value="<%= b.id %>">
            <%= b.city_name %> - <%= b.category_name %> - <%= b.name %>
          </option>
        <% }); %>
      </select>

      <label for="title">Titlu ofertă</label>
      <input type="text" id="title" name="title" required />

      <label for="description">Descriere</label>
      <textarea id="description" name="description"></textarea>

      <label for="discount_type">Tip reducere</label>
      <select id="discount_type" name="discount_type" required>
        <option value="percent">Procent (%)</option>
        <option value="fixed">Suma fixă (lei)</option>
      </select>

      <label for="discount_value">Valoare reducere</label>
      <input
        type="number"
        id="discount_value"
        name="discount_value"
        min="1"
        required
      />

      <label for="conditions">Condiții</label>
      <textarea id="conditions" name="conditions"></textarea>

      <label for="start_date">Data început</label>
      <input type="date" id="start_date" name="start_date" />

      <label for="end_date">Data sfârșit</label>
      <input type="date" id="end_date" name="end_date" />

      <label>
        <input type="checkbox" name="is_active" checked />
        Ofertă activă
      </label>

      <hr />

      <label for="image">Imagine ofertă (hero)</label>
      <input
        type="file"
        id="image"
        name="image"
        accept="image/*"
      />
      <small>
        Această imagine va fi folosită în pagina ofertei. Dacă există și imagini
        la business, vor apărea împreună în slideshow.
      </small>

      <button type="submit">Salvează oferta</button>
    </form>
  </body>
</html>
