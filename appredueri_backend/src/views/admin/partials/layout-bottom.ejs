    </main>
  </div>

  <!-- Toast Container -->
  <div class="a-toast-container" id="toast-container"></div>

  <!-- Confirm Modal -->
  <div class="a-modal-overlay" id="confirm-modal" style="display:none;">
    <div class="a-modal">
      <div class="a-modal-header">Confirmare</div>
      <div class="a-modal-body" id="confirm-message"></div>
      <div class="a-modal-footer">
        <button class="a-btn a-btn-secondary" onclick="closeConfirmModal()">Anulează</button>
        <button class="a-btn a-btn-danger" id="confirm-ok-btn">Confirmă</button>
      </div>
    </div>
  </div>

  <script src="/js/admin.js"></script>
</body>
</html>
