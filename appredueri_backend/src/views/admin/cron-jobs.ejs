<%- include('partials/layout-top', { pageTitle: 'Cron Jobs', activePage: 'cron-jobs' }) %>

<div class="a-page-header">
  <h1>Cron Jobs</h1>
</div>

<!-- Runtime Stats -->
<div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 24px;">
  <div class="a-card" style="text-align: center; padding: 16px;">
    <div style="font-size: 24px; font-weight: 600; color: var(--a-warning-bright);"><%= runtimeStats.expiredTokens %></div>
    <div class="a-text-muted" style="font-size: 12px;">Tokens expirate (de curatat)</div>
  </div>
  <div class="a-card" style="text-align: center; padding: 16px;">
    <div style="font-size: 24px; font-weight: 600; color: var(--a-text-muted);"><%= runtimeStats.oldPushLogs %></div>
    <div class="a-text-muted" style="font-size: 12px;">Push logs vechi (>90 zile)</div>
  </div>
  <div class="a-card" style="text-align: center; padding: 16px;">
    <div style="font-size: 24px; font-weight: 600; color: var(--a-success-bright);"><%= runtimeStats.emailsLast24h %></div>
    <div class="a-text-muted" style="font-size: 12px;">Emailuri trimise (24h)</div>
  </div>
</div>

<h2>Joburi programate (<%= jobs.length %>)</h2>

<table>
  <thead>
    <tr>
      <th>#</th>
      <th>Nume</th>
      <th>Schedule (UTC)</th>
      <th>Descriere</th>
      <th>Frecventa</th>
    </tr>
  </thead>
  <tbody>
    <% jobs.forEach(function(job, i) { %>
      <tr>
        <td><%= i + 1 %></td>
        <td style="font-weight: 500;"><%= job.name %></td>
        <td><code><%= job.schedule %></code></td>
        <td class="a-text-muted" style="font-size: 13px;"><%= job.description %></td>
        <td style="font-size: 12px;">
          <%
            var s = job.schedule;
            var freq = 'Custom';
            if (s.startsWith('*/5')) freq = 'La 5 min';
            else if (s.includes('* * *') && !s.includes('/')) freq = 'Zilnic';
            else if (s.includes('* * 0') || s.includes('* * 7')) freq = 'Saptamanal (D)';
            else if (s.includes('* * 2')) freq = 'Saptamanal (Ma)';
            else if (s.includes('1 * *') && !s.includes('* 1')) freq = 'Lunar (1)';
            else if (s.includes('*/2 * *')) freq = 'La 2 zile';
          %>
          <span style="color: <%= freq === 'La 5 min' ? 'var(--a-warning-bright)' : freq === 'Zilnic' ? 'var(--a-success-bright)' : 'var(--a-primary)' %>"><%= freq %></span>
        </td>
      </tr>
    <% }); %>
  </tbody>
</table>

<div class="a-card" style="margin-top: 24px; padding: 16px;">
  <h3 style="margin-bottom: 8px;">Manual Triggers</h3>
  <p class="a-text-muted" style="font-size: 13px; margin-bottom: 12px;">Trigger manual pentru joburi specifice.</p>
  <form method="POST" action="/admin/test-cron/review-prompt" style="display: inline;" data-confirm="Rulezi manual review prompt cron?">
    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
    <button type="submit" class="a-btn a-btn-sm">Review Prompt Cron</button>
  </form>
</div>

<%- include('partials/layout-bottom') %>
