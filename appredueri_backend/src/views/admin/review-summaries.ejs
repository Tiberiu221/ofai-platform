<%- include('partials/layout-top', { pageTitle: 'Review Summaries', activePage: 'review-summaries' }) %>

<h1>Review Summaries</h1>
<div class="note">
  Sistemul generează summary-uri prin batch la fiecare 2 zile. Adminul poate rula manual aici.
</div>

<% if (message) { %>
  <div class="message"><%= message %></div>
<% } %>
<% if (error) { %>
  <div class="error"><%= error %></div>
<% } %>

<form method="post" action="/admin/review-summaries/run-batch" class="batch-form">
  <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
  <label>
    Limită business-uri (opțional):
    <input type="number" name="limit" min="0" placeholder="0 = toate" />
  </label>
  <button type="submit" class="button">Rulează batch acum</button>
</form>

<% if (!businesses || businesses.length === 0) { %>
  <p>Nu există business-uri în sistem.</p>
<% } else { %>
  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>Business</th>
        <th>Oraș</th>
        <th>Categorie</th>
        <th>Reviews</th>
        <th>Status</th>
        <th>Generat la</th>
        <th>Ultim review (valid)</th>
        <th>Snippet</th>
        <th>Acțiuni</th>
      </tr>
    </thead>
    <tbody>
      <% businesses.forEach(function(b) { %>
        <tr>
          <td><%= b.id %></td>
          <td><%= b.name %></td>
          <td><%= b.city_name %></td>
          <td><%= b.category_name %></td>
          <td><%= b.review_count %></td>
          <td>
            <% if (b.status === "fresh") { %>
              <span class="tag tag-fresh">OK</span>
            <% } else if (b.status === "stale") { %>
              <span class="tag tag-stale">Necesită update</span>
            <% } else if (b.status === "missing") { %>
              <span class="tag tag-missing">Lipsește</span>
            <% } else { %>
              <span class="tag tag-insufficient">Insuficiente</span>
            <% } %>
          </td>
          <td><%= b.generated_at ? new Date(b.generated_at).toLocaleString("ro-RO") : "-" %></td>
          <td>
            <% if (b.latest_valid_review_id) { %>
              #<%= b.latest_valid_review_id %>
            <% } else { %>
              -
            <% } %>
          </td>
          <td><%= b.summary_snippet || "-" %></td>
          <td>
            <form method="post" action="/admin/review-summaries/<%= b.id %>/regenerate" style="display:inline;">
              <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
              <button type="submit" class="button button-small warning">Regenerare</button>
            </form>
            <form method="post" action="/admin/review-summaries/<%= b.id %>/clear" style="display:inline;" data-confirm="Sigur vrei să ștergi cache-ul?">
              <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
              <button type="submit" class="button button-small danger">Șterge cache</button>
            </form>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
  <%- include('partials/pagination', { pagination, baseUrl: '/admin/review-summaries', currentQuery: '' }) %>
<% } %>

<%- include('partials/layout-bottom') %>
