<%- include('partials/layout-top', { pageTitle: 'Push Notifications', activePage: 'push-notifications', loadChartJs: true }) %>

<div class="a-page-header">
  <h1>Push Notifications</h1>
</div>

<!-- Send Notification -->
<h2>Trimite notificare</h2>
<div class="a-card" style="padding: 24px; margin-bottom: 24px;">
  <div style="margin-bottom: 16px;">
    <label style="font-weight: 600; font-size: 13px; display: block; margin-bottom: 6px;">Template rapid</label>
    <div style="display: flex; gap: 8px; flex-wrap: wrap;">
      <button type="button" class="a-btn a-btn-sm" onclick="fillTemplate('offer')" style="font-size: 12px;">🔥 Ofertă nouă</button>
      <button type="button" class="a-btn a-btn-sm" onclick="fillTemplate('flash')" style="font-size: 12px;">⚡ Flash Deal</button>
      <button type="button" class="a-btn a-btn-sm" onclick="fillTemplate('digest')" style="font-size: 12px;">📬 Digest săptămânal</button>
      <button type="button" class="a-btn a-btn-sm" onclick="fillTemplate('welcome')" style="font-size: 12px;">👋 Bun venit</button>
      <button type="button" class="a-btn a-btn-sm" onclick="fillTemplate('promo')" style="font-size: 12px;">🎁 Promoție specială</button>
      <button type="button" class="a-btn a-btn-sm" onclick="fillTemplate('review')" style="font-size: 12px;">⭐ Lasă o recenzie</button>
      <button type="button" class="a-btn a-btn-sm" onclick="fillTemplate('reengagement')" style="font-size: 12px;">💤 Re-engagement</button>
      <button type="button" class="a-btn a-btn-sm" onclick="fillTemplate('test')" style="font-size: 12px;">🧪 Test simplu</button>
    </div>
  </div>

  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;">
    <div>
      <label style="font-weight: 600; font-size: 13px; display: block; margin-bottom: 6px;">Titlu</label>
      <input type="text" id="push-title" placeholder="Titlul notificării..." style="width: 100%; padding: 8px 12px; background: var(--a-bg-input, #1a1a2e); border: 1px solid var(--a-border, #2a2a4a); border-radius: 6px; color: var(--a-text); font-size: 14px;">
    </div>
    <div>
      <label style="font-weight: 600; font-size: 13px; display: block; margin-bottom: 6px;">Destinatar</label>
      <div style="display: flex; gap: 8px;">
        <select id="push-target-type" onchange="toggleTargetId()" style="flex: 1; padding: 8px 12px; background: var(--a-bg-input, #1a1a2e); border: 1px solid var(--a-border, #2a2a4a); border-radius: 6px; color: var(--a-text); font-size: 14px;">
          <option value="user">User specific</option>
          <option value="all">Toți userii</option>
          <option value="city">Oraș</option>
        </select>
        <input type="number" id="push-target-id" placeholder="User ID" value="1" style="width: 100px; padding: 8px 12px; background: var(--a-bg-input, #1a1a2e); border: 1px solid var(--a-border, #2a2a4a); border-radius: 6px; color: var(--a-text); font-size: 14px;">
      </div>
    </div>
  </div>

  <div style="margin-bottom: 16px;">
    <label style="font-weight: 600; font-size: 13px; display: block; margin-bottom: 6px;">Mesaj</label>
    <textarea id="push-body" rows="2" placeholder="Corpul notificării..." style="width: 100%; padding: 8px 12px; background: var(--a-bg-input, #1a1a2e); border: 1px solid var(--a-border, #2a2a4a); border-radius: 6px; color: var(--a-text); font-size: 14px; resize: vertical;"></textarea>
  </div>

  <div style="display: flex; align-items: center; gap: 12px;">
    <button type="button" id="push-send-btn" onclick="sendPushNotification()" class="a-btn a-btn-primary" style="font-size: 14px;">
      Trimite notificarea
    </button>
    <span id="push-result" style="font-size: 13px;"></span>
  </div>
</div>

<script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
var pushTemplates = {
  offer: {
    title: '🔥 Ofertă nouă!',
    body: 'Restaurant Bella Italia — 30% reducere la toate pastele, doar azi!'
  },
  flash: {
    title: '⚡ Flash Deal — Se termină în 2 ore!',
    body: 'Salon Beauty Queen: Manichiură + Pedichiură la doar 49 RON (era 120 RON)'
  },
  digest: {
    title: '📬 Rezumatul tău săptămânal',
    body: '12 oferte noi în Cluj-Napoca! Descoperă reducerile de la business-urile tale preferate.'
  },
  welcome: {
    title: '👋 Bine ai venit pe OFAI!',
    body: 'Descoperă cele mai bune oferte din orașul tău. Setează preferințele pentru notificări personalizate.'
  },
  promo: {
    title: '🎁 Promoție exclusivă!',
    body: 'Doar azi: 50% reducere la prima comandă la Coffee Shop Downtown. Folosește codul OFAI50.'
  },
  review: {
    title: '⭐ Cum a fost experiența ta?',
    body: 'Ai vizitat recent Pizzeria Roma. Lasă o recenzie și ajută comunitatea!'
  },
  reengagement: {
    title: '💤 Ne-ai lipsit!',
    body: 'Au apărut 8 oferte noi de când nu ai mai fost pe OFAI. Descoperă ce ai ratat!'
  },
  test: {
    title: '🧪 Notificare de test',
    body: 'Aceasta este o notificare de test din panoul de admin OFAI.'
  }
};

function fillTemplate(key) {
  var t = pushTemplates[key];
  if (t) {
    document.getElementById('push-title').value = t.title;
    document.getElementById('push-body').value = t.body;
  }
}

function toggleTargetId() {
  var type = document.getElementById('push-target-type').value;
  var idInput = document.getElementById('push-target-id');
  if (type === 'all') {
    idInput.style.display = 'none';
  } else {
    idInput.style.display = '';
    idInput.placeholder = type === 'user' ? 'User ID' : 'City ID';
  }
}

function sendPushNotification() {
  var title = document.getElementById('push-title').value.trim();
  var body = document.getElementById('push-body').value.trim();
  var targetType = document.getElementById('push-target-type').value;
  var targetId = document.getElementById('push-target-id').value;
  var resultEl = document.getElementById('push-result');
  var btn = document.getElementById('push-send-btn');

  if (!title || !body) {
    resultEl.innerHTML = '<span style="color: var(--a-danger);">Completează titlul și mesajul</span>';
    return;
  }

  btn.disabled = true;
  btn.textContent = 'Se trimite...';
  resultEl.innerHTML = '';

  var csrfMeta = document.querySelector('meta[name="csrf-token"]');
  var csrf = csrfMeta ? csrfMeta.getAttribute('content') : '';

  var payload = { title: title, body: body, targetType: targetType };
  if (targetType !== 'all') payload.targetId = parseInt(targetId);

  fetch('/admin/push-notifications/send', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf },
    body: JSON.stringify(payload)
  })
    .then(function(r) { return r.json(); })
    .then(function(data) {
      btn.disabled = false;
      btn.textContent = 'Trimite notificarea';
      if (data.success) {
        resultEl.innerHTML = '<span style="color: var(--a-success-bright);">✅ Trimis! ' + data.sent + ' livrate, ' + data.failed + ' eșuate (din ' + data.tokensCount + ' tokens)</span>';
      } else {
        resultEl.innerHTML = '<span style="color: var(--a-danger);">❌ ' + (data.error || 'Eroare necunoscută') + '</span>';
      }
    })
    .catch(function(err) {
      btn.disabled = false;
      btn.textContent = 'Trimite notificarea';
      resultEl.innerHTML = '<span style="color: var(--a-danger);">❌ Eroare: ' + err.message + '</span>';
    });
}
</script>

<!-- Token Health -->
<h2>Token Health</h2>
<div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 24px;">
  <div class="a-card" style="text-align: center; padding: 20px;">
    <div style="font-size: 28px; font-weight: 700;"><%= stats.totalTokens %></div>
    <div class="a-text-muted" style="font-size: 12px;">Total tokens</div>
  </div>
  <div class="a-card" style="text-align: center; padding: 20px;">
    <div style="font-size: 28px; font-weight: 700; color: var(--a-success-bright);"><%= stats.activeTokens %></div>
    <div class="a-text-muted" style="font-size: 12px;">Active</div>
  </div>
  <div class="a-card" style="text-align: center; padding: 20px;">
    <div style="font-size: 28px; font-weight: 700; color: var(--a-warning-bright);"><%= stats.staleTokens %></div>
    <div class="a-text-muted" style="font-size: 12px;">Stale (>90 zile)</div>
  </div>
  <div class="a-card" style="text-align: center; padding: 20px;">
    <div style="font-size: 28px; font-weight: 700; color: var(--a-text-muted);"><%= stats.totalTokens - stats.activeTokens %></div>
    <div class="a-text-muted" style="font-size: 12px;">Inactive</div>
  </div>
</div>

<!-- Platform Breakdown -->
<% if (platformBreakdown.length > 0) { %>
<h2>Distributie Platforme</h2>
<table style="margin-bottom: 24px;">
  <thead>
    <tr>
      <th>Platforma</th>
      <th>Total tokens</th>
      <th>Active</th>
      <th>Inactive</th>
    </tr>
  </thead>
  <tbody>
    <% platformBreakdown.forEach(function(p) { %>
      <tr>
        <td>
          <% if (p.platform === 'android') { %>
            <span style="color: #22c55e; font-weight: 500;">Android</span>
          <% } else if (p.platform === 'ios') { %>
            <span style="color: #3b82f6; font-weight: 500;">iOS</span>
          <% } else { %>
            <span style="color: #f59e0b; font-weight: 500;">Web</span>
          <% } %>
        </td>
        <td><%= p.cnt %></td>
        <td style="color: var(--a-success-bright);"><%= p.active_cnt %></td>
        <td style="color: var(--a-text-muted);"><%= parseInt(p.cnt) - parseInt(p.active_cnt) %></td>
      </tr>
    <% }); %>
  </tbody>
</table>
<% } %>

<!-- Notification Stats (30 days) -->
<h2>Notificari (30 zile)</h2>
<div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 24px;">
  <div class="a-card" style="text-align: center; padding: 20px;">
    <div style="font-size: 28px; font-weight: 700;"><%= stats.recentNotifs %></div>
    <div class="a-text-muted" style="font-size: 12px;">Trimise (30 zile)</div>
  </div>
  <div class="a-card" style="text-align: center; padding: 20px;">
    <div style="font-size: 28px; font-weight: 700; color: var(--a-success-bright);"><%= stats.totalSuccess %></div>
    <div class="a-text-muted" style="font-size: 12px;">Livrate</div>
  </div>
  <div class="a-card" style="text-align: center; padding: 20px;">
    <div style="font-size: 28px; font-weight: 700; color: var(--a-danger);"><%= stats.totalFailures %></div>
    <div class="a-text-muted" style="font-size: 12px;">Esuate</div>
  </div>
  <div class="a-card" style="text-align: center; padding: 20px;">
    <div style="font-size: 28px; font-weight: 700; color: <%= parseFloat(stats.deliveryRate) < 90 ? 'var(--a-warning-bright)' : 'var(--a-success-bright)' %>;"><%= stats.deliveryRate %>%</div>
    <div class="a-text-muted" style="font-size: 12px;">Rata livrare</div>
  </div>
</div>

<!-- By Type -->
<% if (notifsByType.length > 0) { %>
<h2>Per tip (30 zile)</h2>
<table style="margin-bottom: 24px;">
  <thead>
    <tr>
      <th>Tip target</th>
      <th>Trimise</th>
      <th>Tokens</th>
      <th>Succes</th>
      <th>Esuat</th>
      <th>Rata</th>
    </tr>
  </thead>
  <tbody>
    <% notifsByType.forEach(function(n) { %>
      <% var total = parseInt(n.total_success) + parseInt(n.total_failures); var rate = total > 0 ? ((parseInt(n.total_success) / total) * 100).toFixed(1) : '100.0'; %>
      <tr>
        <td style="font-weight: 500;"><%= n.target_type %></td>
        <td><%= n.cnt %></td>
        <td><%= n.total_tokens %></td>
        <td style="color: var(--a-success-bright);"><%= n.total_success %></td>
        <td style="color: var(--a-danger);"><%= n.total_failures %></td>
        <td style="color: <%= parseFloat(rate) < 90 ? 'var(--a-warning-bright)' : 'var(--a-success-bright)' %>;"><%= rate %>%</td>
      </tr>
    <% }); %>
  </tbody>
</table>
<% } %>

<!-- Daily Chart -->
<% if (dailyNotifs.length > 0) { %>
<h2>Trend zilnic (30 zile)</h2>
<div class="a-card">
  <div style="position: relative; height: 260px; overflow: hidden; min-width: 0;">
    <canvas id="chart-push-daily"></canvas>
  </div>
</div>

<script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
requestAnimationFrame(function() { requestAnimationFrame(function() {
  var data = <%- JSON.stringify(dailyNotifs) %>;
  new Chart(document.getElementById('chart-push-daily'), {
    type: 'line',
    data: {
      labels: data.map(function(d) { return new Date(d.day).toLocaleDateString('ro-RO', { day: 'numeric', month: 'short' }); }),
      datasets: [
        { label: 'Livrate', data: data.map(function(d) { return parseInt(d.successes); }), borderColor: '#22c55e', backgroundColor: 'rgba(34,197,94,0.1)', fill: true, tension: 0.3 },
        { label: 'Esuate', data: data.map(function(d) { return parseInt(d.failures); }), borderColor: '#ef4444', backgroundColor: 'rgba(239,68,68,0.1)', fill: true, tension: 0.3 }
      ]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: { legend: { labels: { color: '#9ca3af' } } },
      scales: {
        x: { ticks: { color: '#9ca3af' }, grid: { color: 'rgba(255,255,255,0.05)' } },
        y: { ticks: { color: '#9ca3af' }, grid: { color: 'rgba(255,255,255,0.05)' } }
      }
    }
  });
}); });
</script>
<% } %>

<div class="a-card" style="margin-top: 24px; padding: 16px;">
  <p class="a-text-muted" style="font-size: 13px; margin: 0;">
    Total notificari din toate timpurile: <strong><%= stats.totalNotifs %></strong>
  </p>
</div>

<%- include('partials/layout-bottom') %>
