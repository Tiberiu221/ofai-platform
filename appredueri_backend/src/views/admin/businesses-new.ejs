<%- include('partials/layout-top', { pageTitle: 'Business nou', activePage: 'businesses' }) %>

<a href="/admin/businesses" class="back-link">&laquo; Înapoi la lista de business-uri</a>

<h1>Business nou</h1>

<form method="post" action="/admin/businesses/new">
  <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
  <label for="name">Nume business</label>
  <input type="text" id="name" name="name" required />

  <label for="city_id">Oraș</label>
  <select id="city_id" name="city_id" required>
    <option value="">Alege oraș...</option>
    <% cities.forEach(function(c) { %>
      <option value="<%= c.id %>"><%= c.name %></option>
    <% }); %>
  </select>

  <label for="category_id">Categorie</label>
  <select id="category_id" name="category_id" required>
    <option value="">Alege categorie...</option>
    <% categories.forEach(function(cat) { %>
      <option value="<%= cat.id %>"><%= cat.name %></option>
    <% }); %>
  </select>

  <label for="address">Adresă</label>
  <textarea id="address" name="address" required></textarea>

  <label for="description">Descriere</label>
  <textarea id="description" name="description" rows="3"></textarea>

  <label for="lat">Lat</label>
  <input type="text" id="lat" name="lat" />

  <label for="lng">Lng</label>
  <input type="text" id="lng" name="lng" />

  <label for="phone">Telefon</label>
  <input type="text" id="phone" name="phone" />

  <label for="website">Website</label>
  <input type="text" id="website" name="website" />

  <button type="submit">Salvează business</button>
</form>

<%- include('partials/layout-bottom') %>
