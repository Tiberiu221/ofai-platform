<%- include('partials/layout-top', { pageTitle: 'Cereri Business', activePage: 'business-requests' }) %>

<h1>Cereri Business</h1>

<% if (typeof requests !== 'undefined') { %>
  <% var urlParams = new URLSearchParams(typeof __query !== 'undefined' ? __query : ''); %>
<% } %>

<% if (typeof requests === 'undefined' || requests.length === 0) { %>
  <p>Nu există cereri de business.</p>
<% } else { %>
  <p style="color: #9ca3af; font-size: 13px;">
    <%= requests.filter(function(r) { return r.status === 'pending'; }).length %> cereri în așteptare
    &bull;
    <%= requests.length %> total
    &bull;
    Click pe un rând pentru detalii
  </p>

  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>Nume Business</th>
        <th>Categorie</th>
        <th>Oraș</th>
        <th>User</th>
        <th>AI Score</th>
        <th>Flags</th>
        <th>Status</th>
        <th>Data</th>
        <th style="width: 180px;">Acțiuni</th>
      </tr>
    </thead>
    <tbody>
      <% requests.forEach(function(r, idx) { %>
        <tr class="clickable" onclick="toggleDetails(<%= idx %>)">
          <td><%= r.id %></td>
          <td><strong><%= r.name %></strong></td>
          <td><%= r.category_name || '—' %></td>
          <td><%= r.city_name || '—' %></td>
          <td>
            <%= r.user_email %>
            <% if (r.user_first_name) { %>
              <br><small style="color: #9ca3af;"><%= r.user_first_name %> <%= r.user_last_name %></small>
            <% } %>
          </td>
          <td>
            <% if (r.ai_score === null || r.ai_score === undefined) { %>
              <span class="score-badge score-none">N/A</span>
            <% } else if (r.ai_score >= 70) { %>
              <span class="score-badge score-high"><%= r.ai_score %></span>
            <% } else if (r.ai_score >= 40) { %>
              <span class="score-badge score-medium"><%= r.ai_score %></span>
            <% } else { %>
              <span class="score-badge score-low"><%= r.ai_score %></span>
            <% } %>
          </td>
          <td>
            <% var flags = []; %>
            <% try { flags = typeof r.ai_flags === 'string' ? JSON.parse(r.ai_flags) : (r.ai_flags || []); } catch(e) {} %>
            <% flags.forEach(function(f) { %>
              <span class="flag-tag"><%= f %></span>
            <% }); %>
            <% if (flags.length === 0) { %><span style="color: #6b7280;">—</span><% } %>
          </td>
          <td>
            <span class="status-badge status-<%= r.status %>">
              <%= r.status === 'pending' ? 'În așteptare' : r.status === 'approved' ? 'Aprobat' : 'Respins' %>
            </span>
          </td>
          <td><%= new Date(r.created_at).toLocaleDateString('ro-RO') %></td>
          <td onclick="event.stopPropagation()">
            <% if (r.status === 'pending') { %>
              <form action="/admin/business-requests/<%= r.id %>/approve" method="POST" style="display: inline;" data-confirm="Aprobă business-ul <%= r.name.replace(/'/g, "\\'") %>?">
                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                <button type="submit" class="btn-approve">Aprobă</button>
              </form>
              <button class="btn-reject" data-reject-id="<%= r.id %>" data-reject-name="<%= r.name %>">Respinge</button>
            <% } else if (r.status === 'approved' && r.business_id) { %>
              <a href="/admin/businesses/<%= r.business_id %>/edit" class="button button-small secondary">Vezi business</a>
            <% } else { %>
              <span style="color: #6b7280; font-size: 12px;">—</span>
            <% } %>
          </td>
        </tr>
        <!-- Details row -->
        <tr class="details-row" id="details-<%= idx %>">
          <td colspan="10">
            <div class="detail-grid">
              <div>
                <div class="detail-label">Adresă</div>
                <div class="detail-value"><%= r.address || '—' %></div>
              </div>
              <div>
                <div class="detail-label">Telefon</div>
                <div class="detail-value"><%= r.phone || '—' %></div>
              </div>
              <div>
                <div class="detail-label">Website</div>
                <div class="detail-value">
                  <% if (r.website) { %>
                    <a href="<%= r.website %>" target="_blank" rel="noopener" style="color: #60a5fa;"><%= r.website %></a>
                  <% } else { %>—<% } %>
                </div>
              </div>
              <div>
                <div class="detail-label">Descriere</div>
                <div class="detail-value"><%= r.description || '—' %></div>
              </div>
            </div>
            <% if (r.ai_reasoning) { %>
              <div class="ai-reasoning">
                <strong>AI Reasoning:</strong> <%= r.ai_reasoning %>
              </div>
            <% } %>
            <% if (r.admin_notes) { %>
              <div style="margin-top: 8px; padding: 8px 12px; background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.2); border-radius: 6px; font-size: 13px; color: #fca5a5;">
                <strong>Motiv respingere:</strong> <%= r.admin_notes %>
              </div>
            <% } %>
            <% if (r.reviewed_at) { %>
              <div style="margin-top: 6px; font-size: 11px; color: #6b7280;">
                Revizuit la: <%= new Date(r.reviewed_at).toLocaleString('ro-RO') %>
                <% if (r.reviewer_email) { %> de <%= r.reviewer_email %><% } %>
              </div>
            <% } %>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
  <%- include('partials/pagination', { pagination, baseUrl: '/admin/business-requests', currentQuery: '' }) %>
<% } %>

<!-- Reject Modal -->
<div class="modal-overlay" id="reject-modal">
  <div class="modal-box">
    <h3>Respinge cererea</h3>
    <p style="color: #9ca3af; font-size: 13px; margin: 0 0 12px;" id="reject-modal-name"></p>
    <form id="reject-form" method="POST">
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
      <textarea name="reason" placeholder="Motiv respingere (opțional)..." maxlength="500"></textarea>
      <div class="modal-actions">
        <button type="button" class="button secondary" onclick="closeRejectModal()">Anulează</button>
        <button type="submit" class="btn-reject" style="padding: 6px 16px; font-size: 14px;">Respinge</button>
      </div>
    </form>
  </div>
</div>

<script>
  function toggleDetails(idx) {
    var row = document.getElementById('details-' + idx);
    row.style.display = row.style.display === 'table-row' ? 'none' : 'table-row';
  }

  function openRejectModal(id, name) {
    document.getElementById('reject-modal-name').textContent = 'Business: ' + name;
    document.getElementById('reject-form').action = '/admin/business-requests/' + id + '/reject';
    document.getElementById('reject-modal').classList.add('active');
  }

  function closeRejectModal() {
    document.getElementById('reject-modal').classList.remove('active');
  }

  // Close modal on overlay click
  document.getElementById('reject-modal').addEventListener('click', function(e) {
    if (e.target === this) closeRejectModal();
  });

  // Event delegation for reject buttons (safe from XSS)
  document.querySelectorAll('.btn-reject[data-reject-id]').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      e.stopPropagation();
      openRejectModal(this.dataset.rejectId, this.dataset.rejectName);
    });
  });
</script>

<%- include('partials/layout-bottom') %>
