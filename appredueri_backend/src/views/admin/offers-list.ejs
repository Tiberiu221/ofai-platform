<%- include('partials/layout-top', { pageTitle: 'Oferte', activePage: 'offers' }) %>

<div class="a-page-header">
  <h1>Oferte</h1>
  <a href="/admin/offers/new" class="a-btn">+ Adaugă ofertă nouă</a>
</div>

<form method="get" action="/admin/offers" class="filters">
  <div class="filters-row">
    <label>
      Oraș
      <select name="city_id">
        <option value="">Toate</option>
        <% (cities || []).forEach(function(c) { %>
          <option value="<%= c.id %>" <%= String(filters.city_id) === String(c.id) ? "selected" : "" %>><%= c.name %></option>
        <% }); %>
      </select>
    </label>

    <label>
      Categorie
      <select name="category_id">
        <option value="">Toate</option>
        <% (categories || []).forEach(function(cat) { %>
          <option value="<%= cat.id %>" <%= String(filters.category_id) === String(cat.id) ? "selected" : "" %>><%= cat.name %></option>
        <% }); %>
      </select>
    </label>

    <label>
      Business
      <select name="business_id">
        <option value="">Toate</option>
        <% (businesses || []).forEach(function(b) { %>
          <option value="<%= b.id %>" <%= String(filters.business_id) === String(b.id) ? "selected" : "" %>>
            <%= b.city_name %> - <%= b.category_name %> - <%= b.name %>
          </option>
        <% }); %>
      </select>
    </label>
  </div>

  <div class="filters-row">
    <label>
      Caută
      <input type="text" name="q" value="<%= filters.q || "" %>" placeholder="Titlu, descriere sau business..." />
    </label>

    <label>
      Activă
      <select name="is_active">
        <option value="">Toate</option>
        <option value="1" <%= filters.is_active === "1" ? "selected" : "" %>>Doar active</option>
        <option value="0" <%= filters.is_active === "0" ? "selected" : "" %>>Doar inactive</option>
      </select>
    </label>

    <div class="filters-actions">
      <button type="submit" class="button">Aplică filtre</button>
      <a href="/admin/offers" class="button secondary">Resetează</a>
    </div>
  </div>
</form>

<% if (!offers || offers.length === 0) { %>
  <p>Nu există oferte pentru filtrele curente.</p>
<% } else { %>
  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>Titlu</th>
        <th>Business</th>
        <th>Oraș</th>
        <th>Categorie</th>
        <th>Reducere</th>
        <th>Activă</th>
        <th>Acțiuni</th>
      </tr>
    </thead>
    <tbody>
      <% offers.forEach(function(o) { %>
        <tr>
          <td><%= o.id %></td>
          <td><%= o.title %></td>
          <td><%= o.business_name %></td>
          <td><%= o.city_name %></td>
          <td><%= o.category_name %></td>
          <td>
            <% if (o.discount_type === "percent") { %>
              <%= o.discount_value %>%
            <% } else { %>
              <%= o.discount_value %> lei
            <% } %>
          </td>
          <td>
            <% if (o.is_active) { %>
              <span class="tag tag-on">DA</span>
            <% } else { %>
              <span class="tag tag-off">NU</span>
            <% } %>
          </td>
          <td class="actions-cell">
            <!-- Buton Editează -->
            <a href="/admin/offers/<%= o.id %>/edit" class="button button-small secondary">
              Editează
            </a>

            <!-- Buton Activează / Dezactivează -->
            <form method="post" action="/admin/offers/<%= o.id %>/toggle-active" style="display:inline;">
              <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
              <button type="submit" class="button button-small">
                <%= o.is_active ? "Dezactivează" : "Activează" %>
              </button>
            </form>

            <!-- Buton Șterge -->
            <form method="post" action="/admin/offers/<%= o.id %>/delete" style="display:inline;" data-confirm="Sigur vrei să ștergi această ofertă? Această acțiune este definitivă.">
              <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
              <button type="submit" class="button button-small" style="background:#dc2626;">
                Șterge
              </button>
            </form>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
  <% const _qs = Object.entries(filters || {}).filter(([k,v]) => v).map(([k,v]) => k + '=' + encodeURIComponent(v)).join('&'); %>
  <%- include('partials/pagination', { pagination, baseUrl: '/admin/offers', currentQuery: _qs }) %>
<% } %>

<%- include('partials/layout-bottom') %>
