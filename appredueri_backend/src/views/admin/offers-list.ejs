<%- include('partials/layout-top', { pageTitle: 'Oferte', activePage: 'offers' }) %>

<div class="a-page-header">
  <h1>Oferte</h1>
  <div style="display: flex; gap: 8px;">
    <a href="/admin/export/offers" class="a-btn a-btn-secondary a-btn-sm">Export CSV</a>
    <a href="/admin/offers/new" class="a-btn">+ Adauga oferta noua</a>
  </div>
</div>

<form method="get" action="/admin/offers" class="filters">
  <div class="filters-row">
    <label>
      Oraș
      <select name="city_id">
        <option value="">Toate</option>
        <% (cities || []).forEach(function(c) { %>
          <option value="<%= c.id %>" <%= String(filters.city_id) === String(c.id) ? "selected" : "" %>><%= c.name %></option>
        <% }); %>
      </select>
    </label>

    <label>
      Categorie
      <select name="category_id">
        <option value="">Toate</option>
        <% (categories || []).forEach(function(cat) { %>
          <option value="<%= cat.id %>" <%= String(filters.category_id) === String(cat.id) ? "selected" : "" %>><%= cat.name %></option>
        <% }); %>
      </select>
    </label>

    <label>
      Business
      <select name="business_id">
        <option value="">Toate</option>
        <% (businesses || []).forEach(function(b) { %>
          <option value="<%= b.id %>" <%= String(filters.business_id) === String(b.id) ? "selected" : "" %>>
            <%= b.city_name %> - <%= b.category_name %> - <%= b.name %>
          </option>
        <% }); %>
      </select>
    </label>
  </div>

  <div class="filters-row">
    <label>
      Caută
      <input type="text" name="q" value="<%= filters.q || "" %>" placeholder="Titlu, descriere sau business..." />
    </label>

    <label>
      Activă
      <select name="is_active">
        <option value="">Toate</option>
        <option value="1" <%= filters.is_active === "1" ? "selected" : "" %>>Doar active</option>
        <option value="0" <%= filters.is_active === "0" ? "selected" : "" %>>Doar inactive</option>
      </select>
    </label>

    <label>
      Moderare
      <select name="moderation_status">
        <option value="">Toate</option>
        <option value="auto_approved" <%= filters.moderation_status === "auto_approved" ? "selected" : "" %>>Auto-aprobate</option>
        <option value="pending_review" <%= filters.moderation_status === "pending_review" ? "selected" : "" %>>In asteptare</option>
        <option value="approved" <%= filters.moderation_status === "approved" ? "selected" : "" %>>Aprobate manual</option>
        <option value="rejected" <%= filters.moderation_status === "rejected" ? "selected" : "" %>>Respinse</option>
      </select>
    </label>

    <div class="filters-actions">
      <button type="submit" class="button">Aplică filtre</button>
      <a href="/admin/offers" class="button secondary">Resetează</a>
    </div>
  </div>
</form>

<% if (!offers || offers.length === 0) { %>
  <p>Nu există oferte pentru filtrele curente.</p>
<% } else { %>
  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>Titlu</th>
        <th>Business</th>
        <th>Oraș</th>
        <th>Categorie</th>
        <th>Reducere</th>
        <th>Moderare</th>
        <th>AI Score</th>
        <th>Activă</th>
        <th>Acțiuni</th>
      </tr>
    </thead>
    <tbody>
      <% offers.forEach(function(o) { %>
        <tr>
          <td><%= o.id %></td>
          <td><%= o.title %></td>
          <td><%= o.business_name %></td>
          <td><%= o.city_name %></td>
          <td><%= o.category_name %></td>
          <td>
            <% if (o.discount_type === 'percentage' && o.discount_value) { %>
              -<%= o.discount_value %>%
            <% } else if (o.discount_type === 'fixed' && o.discount_value) { %>
              -<%= o.discount_value %> RON
            <% } else if (o.discount_value) { %>
              <%= o.discount_value %> (<%= o.discount_type || '—' %>)
            <% } else { %>
              <%= o.discount_type || '—' %>
            <% } %>
          </td>
          <td>
            <% if (o.moderation_status === 'pending_review') { %>
              <span class="status-badge status-pending">In asteptare</span>
            <% } else if (o.moderation_status === 'approved') { %>
              <span class="status-badge status-approved">Aprobat</span>
            <% } else if (o.moderation_status === 'rejected') { %>
              <span class="status-badge status-rejected">Respins</span>
            <% } else { %>
              <span class="status-badge status-approved">Auto</span>
            <% } %>
          </td>
          <td>
            <% if (o.ai_score === null || o.ai_score === undefined) { %>
              <span class="score-badge score-none">—</span>
            <% } else if (o.ai_score >= 70) { %>
              <span class="score-badge score-high"><%= o.ai_score %></span>
            <% } else if (o.ai_score >= 40) { %>
              <span class="score-badge score-medium"><%= o.ai_score %></span>
            <% } else { %>
              <span class="score-badge score-low"><%= o.ai_score %></span>
            <% } %>
          </td>
          <td>
            <% if (o.is_active) { %>
              <span class="tag tag-on">DA</span>
            <% } else { %>
              <span class="tag tag-off">NU</span>
            <% } %>
          </td>
          <td class="actions-cell">
            <!-- Buton Editează -->
            <a href="/admin/offers/<%= o.id %>/edit" class="button button-small secondary">
              Editează
            </a>

            <!-- Buton Activează / Dezactivează -->
            <form method="post" action="/admin/offers/<%= o.id %>/toggle-active" style="display:inline;">
              <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
              <button type="submit" class="button button-small">
                <%= o.is_active ? "Dezactivează" : "Activează" %>
              </button>
            </form>

            <!-- Buton Șterge -->
            <form method="post" action="/admin/offers/<%= o.id %>/delete" style="display:inline;" data-confirm="Sigur vrei să ștergi această ofertă? Această acțiune este definitivă.">
              <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
              <button type="submit" class="button button-small" style="background:#dc2626;">
                Șterge
              </button>
            </form>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
  <% const _qs = Object.entries(filters || {}).filter(([k,v]) => v).map(([k,v]) => k + '=' + encodeURIComponent(v)).join('&'); %>
  <%- include('partials/pagination', { pagination, baseUrl: '/admin/offers', currentQuery: _qs }) %>
<% } %>

<%- include('partials/layout-bottom') %>
