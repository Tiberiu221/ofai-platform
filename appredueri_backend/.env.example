# Database
DATABASE_URL=postgres://user:password@host:5432/database

# JWT Secret (used for both JWT tokens and CSRF protection — use a strong random string in production!)
JWT_SECRET=REDACTED

# Admin Panel Credentials
ADMIN_USER=admin
ADMIN_PASSWORD=secure-admin-password

# Cloudinary (for image storage)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=REDACTED

# Sentry (error tracking)
# Get your DSN from https://sentry.io
SENTRY_DSN=REDACTED
# SENTRY_DEBUG=true  # Uncomment to enable Sentry in development

# Resend (email service)
# Get your API key from https://resend.com
RESEND_API_KEY=re_xxxxxxxxx
FROM_EMAIL=OFAI <noreply@ofai.ro>

# Environment
NODE_ENV=development
# NODE_ENV=production

# Port (optional, default 4000)
PORT=4000

# Anthropic Claude (AI Review Summarization)
# Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-REDACTED
LLM_MODEL=claude-haiku-4-5-20251001
LLM_MAX_TOKENS=300
LLM_TEMPERATURE=0.3

# Firebase Cloud Messaging (push notifications)
# Get service account JSON from Firebase Console > Project Settings > Service Accounts
# Paste the ENTIRE JSON file contents as a single-line string
FIREBASE_ADMINSDK_JSON={"project_id":"...","private_key":"...","client_email":"..."}

# n8n Webhook URL (workflow automation)
N8N_WEBHOOK_URL=https://your-n8n-instance.up.railway.app

# ─── Stripe (REQUIRED for billing features) ───
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ─── Tier Gating (fail-closed) ───
# Tier gating is ON by default. Uncomment below to disable (dev/debug only):
# TIER_GATING_DISABLED=true

# ─── CSRF ───
# Separate CSRF secret (falls back to JWT_SECRET if not set)
# CSRF_SECRET=REDACTED

# ─── Google OAuth ───
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
