      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        710,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst esc = (s) => String(s ?? '').replace(/[&<>\"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[c]));\nconst shell = (title, body, ctaText, ctaUrl) => `\n<div style=\"font-family:Inter,Arial,sans-serif;max-width:560px;margin:0 auto;background:#0f1115;color:#e5e7eb;border-radius:12px;overflow:hidden\">\n  <div style=\"background:#FB923C;color:#0f1115;padding:18px 24px;font-size:20px;font-weight:700\">OFAI</div>\n  <div style=\"padding:24px\">\n    <h2 style=\"margin:0 0 12px;font-size:20px;color:#fff\">${title}</h2>\n    ${body}\n    <p style=\"margin:24px 0 0\"><a href=\"${ctaUrl}\" style=\"background:#FB923C;color:#0f1115;text-decoration:none;padding:12px 20px;border-radius:8px;font-weight:600;display:inline-block\">${ctaText}</a></p>\n  </div>\n  <div style=\"padding:14px 24px;font-size:12px;color:#9ca3af;border-top:1px solid #1f2937\">Primești acest email pentru că ai un cont pe ofai.ro. <a href=\"https://ofai.ro/account\" style=\"color:#9ca3af\">Preferințe</a></div>\n</div>`;\nconst u = $input.first().json;\nconst source = $('Webhook').first().json.body?.source || 'email';\nconst name = u.first_name ? esc(u.first_name) : 'bun venit';\nconst body = `\n  <p>Salut, ${name}! Contul tău OFAI e gata${source.startsWith('google') ? ' (te-ai conectat cu Google)' : ''}.</p>\n  <ol style=\"padding-left:18px;line-height:1.7\">\n    <li><b>Explorează</b> ofertele active din orașul tău.</li>\n    <li><b>Salvează</b> ofertele la favorite ca să nu le pierzi.</li>\n    <li><b>Urmărește</b> business-urile preferate și primești notificare la oferte noi.</li>\n  </ol>`;\nreturn [{ json: {\n  to: u.email,\n  subject: 'Bun venit pe OFAI 🎉',\n  html: shell('Bun venit pe OFAI', body, 'Vezi ofertele de azi', 'https://ofai.ro/oferte'),\n  user_id: u.id, source,\n} }];"
      },
      "id": "92edd181-f84c-4149-a7ed-0d271a1fb060",
      "name": "Build Welcome Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        940,
