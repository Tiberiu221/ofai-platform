        "url": "https://api.resend.com/emails",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ from: 'OFAI <noreply@ofai.ro>', to: $json.to, subject: $json.subject, html: $json.html }) }}",
        "options": {
          "timeout": 10000
